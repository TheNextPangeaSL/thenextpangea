# Copy to .env for local development (.env is gitignored).
#
# Public URL of the AWS Lambda Function URL that relays the contact form
# through SES. PUBLIC_ prefix means Astro inlines it into the browser bundle,
# which is fine and intended: this URL is public. No credential ever goes here.
PUBLIC_CONTACT_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.eu-west-1.on.aws/
