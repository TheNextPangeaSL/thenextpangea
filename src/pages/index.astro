---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Services from "@/components/Services.astro";
import FunctionalAreas from "@/components/FunctionalAreas.astro";
import ProjectsCarousel from "@/components/ProjectsCarousel.astro";
import Approach from "@/components/Approach.astro";
import Contact from "@/components/Contact.astro";
---

<Layout
    title="TheNextPangea S.L. — Expertos en Tecnologías eXponenciales"
    description="TheNextPangea es una empresa de base tecnológica experta en tecnologías eXponenciales. Combinamos IA, Big Data, Fabricación Avanzada, NanoTecnología, BioTecnología y más para crear productos tecnológicos innovadores para la industria."
>
    <!-- Fixed Navigation Bar -->
    <Navbar slot="nav" />

    <!-- Hero Section – Full viewport with ocean background -->
    <Hero />

    <!-- About Section – Company overview, mission, stats & clients marquee -->
    <About />

    <!-- Technologies & Products Section – 3 pillars + 2 spin-offs -->
    <Services />

    <!-- Functional Areas – AF1-AF6 BACSI mapping -->
    <FunctionalAreas />

    <!-- Projects Carousel – 9 showcased projects -->
    <ProjectsCarousel />

    <!-- Research Projects Section – Featured I+D+i projects summary -->
    <Approach />

    <!-- Contact Section – Form and contact info -->
    <Contact />
</Layout>
