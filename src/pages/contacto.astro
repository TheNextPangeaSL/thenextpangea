---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";

const base = import.meta.env.BASE_URL;
const vcfUrl = `${base}TheNextPangea.vcf`;
---

<Layout
  title="Contacto — TheNextPangea"
  description="Guarda el contacto de TheNextPangea directamente en tu agenda."
>
  <Navbar slot="nav" />

  <section class="min-h-dvh flex items-center justify-center px-4 py-24 bg-gradient-to-b from-pangea-dark-blue to-pangea-dark-blue/95 relative overflow-hidden">
    <!-- Decorative blurred circles -->
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-pangea-sky-blue/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-pangea-calm-blue/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-md">
      <!-- Card -->
      <div class="bg-white/[0.06] backdrop-blur-xl border border-white/10 rounded-2xl p-8 sm:p-10 shadow-2xl text-center">
        <!-- Logo -->
        <img
          src={`${base}Logo/TNP_logo_WHITE.png`}
          alt="TheNextPangea"
          class="h-12 w-auto mx-auto mb-8"
        />

        <!-- Contact info -->
        <div class="space-y-4 text-pangea-white/80 text-sm leading-relaxed mb-8">
          <!-- Email -->
          <a href="mailto:contact@thenextpangea.com" class="flex items-center gap-3 justify-center hover:text-pangea-sky-blue transition-colors">
            <svg class="w-5 h-5 shrink-0 text-pangea-sky-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            contact@thenextpangea.com
          </a>

          <!-- Web -->
          <a href="https://www.thenextpangea.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 justify-center hover:text-pangea-sky-blue transition-colors">
            <svg class="w-5 h-5 shrink-0 text-pangea-sky-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.73-3.418" />
            </svg>
            www.thenextpangea.com
          </a>

          <!-- Phones -->
          <div class="flex items-center gap-3 justify-center">
            <svg class="w-5 h-5 shrink-0 text-pangea-sky-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>
              <a href="tel:+34625869737" class="hover:text-pangea-sky-blue transition-colors">+34 625 869 737</a>
              <span class="mx-1.5 text-pangea-white/30">·</span>
              <a href="tel:+34636858110" class="hover:text-pangea-sky-blue transition-colors">+34 636 858 110</a>
            </span>
          </div>

          <!-- Address -->
          <a href="https://maps.app.goo.gl/uaTi3twJSRmUZpWM6" target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 justify-center hover:text-pangea-sky-blue transition-colors">
            <svg class="w-5 h-5 shrink-0 text-pangea-sky-blue mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>Residencia La Granda SN<br/>33418 · Gozón · Asturias</span>
          </a>
        </div>

        <!-- Download button -->
        <button
          id="download-btn"
          type="button"
          class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-pangea-sky-blue text-pangea-dark-blue font-semibold text-sm tracking-wide hover:bg-pangea-sky-blue/90 active:scale-[0.98] transition-all duration-200 shadow-lg shadow-pangea-sky-blue/20 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          Guardar Contacto
        </button>

        <p class="mt-4 text-xs text-pangea-white/40">
          Se añadirá a tu agenda de contactos
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ vcfUrl }}>
    // Auto-redirect to the real .vcf file — the OS handles it natively
    // (iOS opens Contacts, Android prompts "Open with Contacts")
    window.location.href = vcfUrl;

    // Fallback: manual button in case auto-redirect is blocked
    document.getElementById('download-btn').addEventListener('click', () => {
      window.location.href = vcfUrl;
    });
  </script>
</Layout>
