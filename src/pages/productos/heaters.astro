---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("heaters")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #AC2423 */
const ACCENT_LIGHT = "#D44A49";
const ACCENT_DARK = "#8B1D1C";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Ciencia de Materiales", i18nKey: "heaters.hero.tag1" },
  { label: "Electrónica Impresa", i18nKey: "heaters.hero.tag2" },
];

const heroChips = [
  { label: "Zonificación térmica", i18nKey: "heaters.hero.chip1" },
  { label: "Integración estructural", i18nKey: "heaters.hero.chip2" },
  { label: "60–250 °C", i18nKey: "heaters.hero.chip3" },
];

/* ── Feature cards ─────────────────────────────────── */
const features = [
  {
    title: "Zonificación térmica a medida",
    titleI18n: "heaters.features.f1.title",
    desc: "Diseño de pistas calefactables y zonificación térmica adaptable desde pequeñas áreas de reparación hasta grandes superficies complejas e irregulares.",
    descI18n: "heaters.features.f1.desc",
    icon: "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z",
  },
  {
    title: "Integración estructural directa",
    titleI18n: "heaters.features.f2.title",
    desc: "Integración sobre o dentro de superficies metálicas o termoplásticas, con bajo espesor y mínima interferencia estructural. Compatible con geometrías planas y curvadas.",
    descI18n: "heaters.features.f2.desc",
    icon: "M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25",
  },
  {
    title: "Homogeneidad térmica superior",
    titleI18n: "heaters.features.f3.title",
    desc: "Operación segura en rango 60–250 °C. Distribución de temperatura superior frente a mantas comerciales, sin franjas ni diferencias térmicas apreciables.",
    descI18n: "heaters.features.f3.desc",
    icon: "M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z",
  },
  {
    title: "Control de alta precisión",
    titleI18n: "heaters.features.f4.title",
    desc: "Rampas rápidas, estabilidad sostenida y variaciones inferiores a 0,05 °C. Compatible con alimentación estándar y controladores térmicos a medida.",
    descI18n: "heaters.features.f4.desc",
    icon: "M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75",
  },
];

/* ── Evidence items ────────────────────────────────── */
const evidenceItems = [
  {
    src: `${base}images/heaters-01-120.png`,
    alt: "Homogeneidad térmica · 122°C",
    altI18n: "heaters.evidence.img1.alt",
    caption: "Homogeneidad térmica · 122°C. Distribución uniforme sin franjas térmicas.",
    captionI18n: "heaters.evidence.img1.caption",
  },
  {
    src: `${base}images/heaters-02-230.png`,
    alt: "Estabilidad térmica en régimen estacionario (~230°C)",
    altI18n: "heaters.evidence.img2.alt",
    caption: "Estabilidad térmica en régimen estacionario (~230°C). Variación < 0,05°C bajo condiciones de validación.",
    captionI18n: "heaters.evidence.img2.caption",
  },
];

/* ── Solution bullets ──────────────────────────────── */
const solutionBullets = [
  { text: "Calentadores resistivos serigrafiados basados en materiales carbonosos flexibles, integrables directamente sobre superficies funcionales.", i18n: "heaters.solution.bullet1" },
  { text: "Arquitectura multicapa: tintas resistivas con capas dieléctricas, conductoras y de protección mecánica/química.", i18n: "heaters.solution.bullet2" },
  { text: "Geometrías a medida, planas o curvadas, con bajo espesor y mínima interferencia estructural.", i18n: "heaters.solution.bullet3" },
  { text: "Rango operativo 60–250 °C con máxima homogeneidad térmica y variaciones inferiores a 0,05 °C.", i18n: "heaters.solution.bullet4" },
];

/* ── Architecture layers ──────────────────────────── */
const architectureLayers = [
  { name: "Capa de protección mecánica/química", color: "#AC2423" },
  { name: "Capa conductora", color: "#D44A49" },
  { name: "Tintas resistivas calefactables", color: "#E86B6A" },
  { name: "Capa dieléctrica", color: "#F09090" },
  { name: "Substrato (metal / termoplástico)", color: "#8B1D1C" },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF2", title: "Infraestructura técnica e integración funcional", description: "Integración de gestión térmica directamente en superficies estructurales metálicas o poliméricas de la base. Soluciones de bajo espesor, adaptables a geometrías reales, para infraestructuras técnicas y sistemas operativos." },
  { code: "AF4", title: "Protección de la Fuerza", description: "Aplicaciones de anti-hielo y acondicionamiento térmico localizado en superficies críticas. Control preciso y uniforme para minimizar riesgos operativos en condiciones ambientales exigentes." },
  { code: "AF6", title: "Sostenimiento y mantenimiento avanzado", description: "Soluciones térmicas para reparación de composites, curado de adhesivos y mesas de proceso (AFP / preencintado), con estabilidad, repetibilidad y control de uniformidad." },
];

const capacidadDestacada = {
  code: "Capacidades diferenciales",
  title: "Gestión térmica estructural con homogeneidad superior",
  description: "Diseño de pistas calefactables a medida y zonificación térmica para superficies complejas. Comparativas internas frente a soluciones comerciales muestran una distribución homogénea sin franjas térmicas y variaciones inferiores a 0,05 °C bajo condiciones de validación definidas.",
  note: "Integrable con sistemas eléctricos existentes o controladores desarrollados a medida según requisitos operativos.",
};

/* ── Helper: check icon SVG ────────────────────────── */
const checkIconPath = "M4.5 12.75l6 6 9-13.5";
---

<Layout
  title="HEATERS · TheNextPangea"
  description="Calentadores serigrafiados integrables con control térmico de alta precisión. Diseño, fabricación y validación de calentadores resistivos para integración directa sobre superficies metálicas o termoplásticas."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="HEATERS"
      backgroundImage={`${base}images/Heaters.png`}
      tags={heroTags}
      titleI18n="heaters.hero.title"
      subtitle="Diseño, fabricación y validación de calentadores resistivos serigrafiados para integración directa sobre o dentro de superficies metálicas o termoplásticas, con operación segura y uniforme entre 60 y 250 °C."
      subtitleI18n="heaters.hero.subtitle"
      chips={heroChips}
      backI18n="heaters.hero.back"
      ctaPrimaryI18n="heaters.hero.cta.primary"
    >
      <span class="product-gradient-text">Calentadores serigrafiados integrables</span> con control térmico de alta precisión
    </ProductHero>

    <!-- ════════════════ EL RETO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-red-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="heaters.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="heaters.challenge.title">
            Integrar gestión térmica con <span class="product-gradient-text">precisión estructural</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="heaters.challenge.p1">
              En aplicaciones aeronáuticas e industriales, el calentamiento debe integrarse directamente en <strong class="font-semibold">superficies funcionales reales</strong>, metálicas o termoplásticas, sin añadir volumen, peso ni complejidad innecesaria.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="heaters.challenge.p2">No basta con alcanzar una temperatura objetivo: se requiere uniformidad, estabilidad y control preciso, incluso en geometrías planas o curvadas y bajo condiciones exigentes de operación.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="heaters.challenge.p3">Las soluciones convencionales suelen implicar <strong class="font-semibold text-slate-700">resistencias externas, sistemas voluminosos</strong> o integraciones complejas que afectan a la arquitectura del sistema.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="heaters.challenge.p4">El desafío no es simplemente generar calor, sino <strong class="font-semibold text-slate-700">integrarlo de forma estructural, eficiente y repetible</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="mb-6 reveal">
            <SectionLabel label="La solución" i18nKey="heaters.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
            <div class="flex-1 reveal delay-100">
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-6" data-i18n-html="heaters.solution.title">
                Gestión térmica integrada mediante <span class="product-gradient-text">electrónica impresa avanzada</span>
              </h3>
              <div class="space-y-4">
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="heaters.solution.p1">
                  <strong class="font-semibold text-slate-700">HEATERS</strong> es una familia de calentadores resistivos serigrafiados, basados en materiales carbonosos flexibles y diseñados para su integración directa sobre o dentro de superficies metálicas o termoplásticas.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="heaters.solution.p2">
                  La arquitectura combina tintas resistivas con capas funcionales dieléctricas, conductoras y de protección mecánica/química, permitiendo desarrollar geometrías a medida, planas o curvadas, con bajo espesor y mínima interferencia estructural.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="heaters.solution.p3">
                  El sistema opera de forma segura en un rango de 60–250 °C, ofreciendo máxima homogeneidad térmica. Comparativas internas frente a mantas comerciales muestran una distribución de temperatura superior, sin franjas ni diferencias térmicas apreciables.
                </p>
              </div>

              <!-- Solution bullets -->
              <ul class="mt-8 space-y-3">
                {solutionBullets.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={checkIconPath} /></svg>
                    <span class="text-sm text-slate-600" data-i18n={item.i18n}>{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Architecture layers visualization -->
            <div class="flex-shrink-0 w-full lg:w-5/12 reveal delay-200">
              <div class="product-glass rounded-2xl p-6 sm:p-8">
                <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8 text-center" data-i18n="heaters.solution.arch.title">
                  Arquitectura multicapa
                </h4>
                <div class="heaters-layers-stack space-y-3 max-w-xs mx-auto">
                  {architectureLayers.map((layer, i) => (
                    <div
                      class="heaters-layer relative rounded-lg px-4 py-3 text-center text-sm font-semibold text-white shadow-md transition-all duration-300 hover:scale-[1.03] hover:shadow-lg cursor-default"
                      style={`background: ${layer.color}; animation-delay: ${i * 0.12}s; box-shadow: 0 2px 10px ${layer.color}40;`}
                    >
                      <span data-i18n={`heaters.solution.arch.layer${i + 1}`}>{layer.name}</span>
                    </div>
                  ))}
                </div>
                <p class="text-xs text-slate-400 text-center mt-6" data-i18n="heaters.solution.arch.caption">
                  Sección transversal esquemática de la arquitectura HEATERS
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ KEY FEATURES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-red-50/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="Capacidades clave" i18nKey="heaters.features.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4" data-i18n-html="heaters.features.title">
            Electrónica impresa para <span class="product-gradient-text">gestión térmica avanzada</span>
          </h2>
          <p class="text-lg text-slate-500 mb-12 reveal delay-200" data-i18n="heaters.features.subtitle">
            Tecnología de serigrafiado sobre materiales carbonosos flexibles con integración estructural directa.
          </p>

          <div class="grid sm:grid-cols-2 gap-6 reveal delay-200">
            {features.map((f) => (
              <div class="product-card group">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background: ${ACCENT}15;`}>
                    <svg class="w-5 h-5" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg>
                  </div>
                  <h3 class="font-bold text-slate-800" data-i18n={f.titleI18n}>{f.title}</h3>
                </div>
                <p class="text-sm text-slate-500 leading-relaxed" data-i18n={f.descI18n}>{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ APLICACIONES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Aplicaciones" i18nKey="heaters.applications.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4 reveal" data-i18n-html="heaters.applications.title">
            Optimizada para aplicaciones <span class="product-gradient-text">exigentes</span>
          </h2>
          <p class="text-lg text-slate-500 reveal delay-100" data-i18n="heaters.applications.subtitle">
            Desde anti-hielo en bordes de ataque hasta mesas de preencintado y sistemas AFP con requerimientos de estabilidad, repetibilidad y control de uniformidad.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto reveal delay-200">
          {[
            { icon: "M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z", title: "Anti-hielo en bordes de ataque", titleI18n: "heaters.applications.app1.title", desc: "Calentamiento integrado para prevención de formación de hielo en superficies aerodinámicas críticas.", descI18n: "heaters.applications.app1.desc" },
            { icon: "M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z", title: "Mesas de preencintado", titleI18n: "heaters.applications.app2.title", desc: "Superficies de trabajo con temperatura controlada para procesos de layup y conformado de composites.", descI18n: "heaters.applications.app2.desc" },
            { icon: "M11.42 15.17l-5.1-3.26a.46.46 0 010-.82l5.1-3.26a.46.46 0 01.7.41v1.07l4.28-2.73a.46.46 0 01.7.41v6.38a.46.46 0 01-.7.41l-4.28-2.73v1.07a.46.46 0 01-.7.41z M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281", title: "Sistemas AFP y reparación", titleI18n: "heaters.applications.app3.title", desc: "Integración térmica en sistemas de colocación automática de fibra y reparación de composites con curado controlado.", descI18n: "heaters.applications.app3.desc" },
          ].map((app, i) => (
            <div class="product-card group !p-6 text-center reveal" style={i > 0 ? `animation-delay: ${i * 0.1}s` : undefined}>
              <div class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center mb-4" style={`background: ${ACCENT}12;`}>
                <svg class="w-7 h-7" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={app.icon} /></svg>
              </div>
              <h3 class="font-bold text-slate-800 mb-2" data-i18n={app.titleI18n}>{app.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={app.descI18n}>{app.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ EVIDENCIAS TÉRMICAS ════════════════ -->
    <section id="evidencias" class="relative py-24 sm:py-32 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 md:mb-20 max-w-2xl mx-auto">
          <SectionLabel label="Evidencias térmicas" i18nKey="heaters.evidence.label" class="mx-auto mb-5 reveal">
            <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg>
          </SectionLabel>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 reveal" data-i18n-html="heaters.evidence.title">
            Validación de <span class="product-gradient-text">homogeneidad y estabilidad</span> térmica
          </h2>
          <p class="text-slate-500 text-lg mt-4 reveal" data-i18n="heaters.evidence.subtitle">
            Resultados de ensayos reales que demuestran la distribución uniforme y la precisión del control térmico.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {evidenceItems.map((item, i) => (
            <div class="reveal" style={i > 0 ? `animation-delay:${i * 0.1}s` : undefined}>
              <button
                type="button"
                class="heaters-lightbox-trigger block w-full text-left cursor-pointer"
                data-img={item.src}
                data-caption={item.caption}
                aria-label={`Ampliar: ${item.alt}`}
              >
                <div class="product-card !p-0 overflow-hidden group">
                  <div class="aspect-[4/3] overflow-hidden relative">
                    <img
                      src={item.src}
                      alt={item.alt}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 flex items-center justify-center">
                      <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-white/90 backdrop-blur-sm rounded-full p-2.5 shadow-lg">
                        <svg class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" /></svg>
                      </span>
                    </div>
                  </div>
                  <div class="p-4">
                    <p class="text-sm text-slate-600 leading-relaxed" data-i18n={item.captionI18n}>{item.caption}</p>
                  </div>
                </div>
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ DEFENSA (BACSI) ════════════════ -->
    <BacsiApplications
      accent={ACCENT}
      i18nPrefix="heaters"
      titleI18n="heaters.defense.title"
      labelI18n="heaters.defense.label"
      applications={aplicacionesBacsi}
      featuredItem={capacidadDestacada}
      featuredI18nKey="capacidad"
      bgClass="bg-[#f5f7fa]"
    />

    <!-- ════════════════ CTA ════════════════ -->
    <ProductCTA
      accent={ACCENT}
      productName="HEATERS"
      i18nPrefix="heaters"
      description="Definimos geometría, rango térmico y arquitectura de capas según tus requisitos operativos."
      bgClass="bg-white"
    />

  </ProductPageWrapper>
</Layout>

<!-- ═══════ Lightbox overlay ═══════ -->
<div id="heaters-lightbox" class="fixed inset-0 z-[9999] hidden" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="heaters-lightbox-backdrop"></div>
  <div class="relative flex flex-col items-center justify-center w-full h-full p-4 sm:p-8">
    <button
      type="button"
      id="heaters-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white rounded-full p-2.5 transition-colors duration-200 cursor-pointer"
      aria-label="Cerrar visor"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <img
      id="heaters-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-xl shadow-2xl object-contain transition-transform duration-300"
    />
    <p id="heaters-lightbox-caption" class="mt-4 text-sm text-white/70 text-center max-w-xl"></p>
  </div>
</div>

<style>
  /* Lightbox */
  #heaters-lightbox.is-visible {
    display: flex;
    animation: heaters-lb-in 0.25s ease-out;
  }
  #heaters-lightbox.is-hiding {
    animation: heaters-lb-out 0.2s ease-in forwards;
  }
  @keyframes heaters-lb-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes heaters-lb-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  #heaters-lightbox.is-visible #heaters-lightbox-img {
    animation: heaters-lb-zoom 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes heaters-lb-zoom {
    from { transform: scale(0.92); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }

  /* ── Architecture layers animation ── */
  .heaters-layer {
    opacity: 0;
    animation: heaters-layer-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes heaters-layer-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  (function () {
    const lightbox = document.getElementById('heaters-lightbox');
    const lbImg = document.getElementById('heaters-lightbox-img') as HTMLImageElement | null;
    const lbCaption = document.getElementById('heaters-lightbox-caption');
    if (!lightbox || !lbImg || !lbCaption) return;

    function open(src: string, caption: string) {
      lbImg!.src = src;
      lbImg!.alt = caption;
      lbCaption!.textContent = caption;
      lightbox!.classList.remove('hidden', 'is-hiding');
      lightbox!.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.add('is-hiding');
      lightbox!.addEventListener('animationend', function handler() {
        lightbox!.classList.remove('is-visible', 'is-hiding');
        lightbox!.classList.add('hidden');
        document.body.style.overflow = '';
        lbImg!.src = '';
        lightbox!.removeEventListener('animationend', handler);
      });
    }

    // Open triggers
    document.querySelectorAll('.heaters-lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = (btn as HTMLElement).dataset.img || '';
        const caption = (btn as HTMLElement).dataset.caption || '';
        open(src, caption);
      });
    });

    // Close triggers
    document.getElementById('heaters-lightbox-close')?.addEventListener('click', close);
    document.getElementById('heaters-lightbox-backdrop')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox!.classList.contains('is-visible')) close();
    });
  })();
</script>
