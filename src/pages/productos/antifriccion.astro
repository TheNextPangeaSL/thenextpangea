<style>
  /* ── Metric cards animation ── */
  .af-metric-card {
    opacity: 0;
    animation: af-metric-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes af-metric-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Metric bar animation ── */
  .af-metric-bar {
    width: 0% !important;
    transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .af-metric-bar.af-bar-animate {
    width: var(--bar-target) !important;
  }
</style>

<script>
  // Animate metric bars on scroll into view
  (function () {
    const bars = document.querySelectorAll('.af-metric-bar');
    if (!bars.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // small delay so the browser paints 0-width first
          requestAnimationFrame(() => {
            (entry.target as HTMLElement).classList.add('af-bar-animate');
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    bars.forEach(bar => observer.observe(bar));
  })();
</script>
