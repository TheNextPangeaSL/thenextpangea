---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";
import JsonLd from "@/components/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/lib/schemas";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("antifriccion")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #5D3F87 */
const ACCENT_LIGHT = "#7E5BA8";
const ACCENT_DARK = "#4A2F6E";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Ciencia de materiales", i18nKey: "antifriccion.hero.tag1" },
  { label: "Nanomateriales", i18nKey: "antifriccion.hero.tag2" },
];

const heroChips = [
  { label: "Tribología", i18nKey: "antifriccion.hero.chip1" },
  { label: "Recubrimientos antifricción", i18nKey: "antifriccion.hero.chip2" },
  { label: "Ingeniería de superficies", i18nKey: "antifriccion.hero.chip3" },
];

/* ── Aplicaciones cards ─────────────────────────────── */
const aplicacionesCards = [
  {
    title: "Conjuntos rotativos",
    desc: "Rodamientos, ejes y elementos móviles bajo carga: menor fricción, menos calentamiento local y desgaste prematuro.",
    icon: "M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99",
  },
  {
    title: "Guías y sistemas lineales",
    desc: "Superficies de deslizamiento en ciclos repetitivos: estabilidad de funcionamiento y reducción de desgaste por contacto.",
    icon: "M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25",
  },
  {
    title: "Componentes críticos",
    desc: "Mecanismos y sistemas en condiciones exigentes: mejora del comportamiento tribológico y reducción de pérdidas de eficiencia.",
    icon: "M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281",
  },
];

/* ── Solution bullets ──────────────────────────────── */
const solutionBullets = [
  { text: "Formulaciones basadas en nanomateriales con reducción del COF del 85% (de 0,77 a 0,15).", i18n: "antifriccion.solution.bullet1" },
  { text: "Huella de desgaste reducida en un orden de magnitud (x10): de ~2 mm a ~0,3 mm.", i18n: "antifriccion.solution.bullet2" },
  { text: "Profundidad de huella reducida de 170–180 µm a 10–16 µm mediante perfilometría validada.", i18n: "antifriccion.solution.bullet3" },
  { text: "Formato sprayable o sobre liner para integración directa en procesos industriales.", i18n: "antifriccion.solution.bullet4" },
];

/* ── Metrics ───────────────────────────────────────── */
const metrics = [
  { label: "Reducción de COF", labelI18n: "antifriccion.metrics.cof.label", value: "↓ 85%", valueI18n: "antifriccion.metrics.cof.value", detail: "0,77 → 0,15", detailI18n: "antifriccion.metrics.cof.detail" },
  { label: "Huella de desgaste", labelI18n: "antifriccion.metrics.huella.label", value: "x10 menor", valueI18n: "antifriccion.metrics.huella.value", detail: "2 mm → 0,3 mm", detailI18n: "antifriccion.metrics.huella.detail" },
  { label: "Perfilometría", labelI18n: "antifriccion.metrics.perfil.label", value: "~94%", valueI18n: "antifriccion.metrics.perfil.value", detail: "170 µm → 10 µm", detailI18n: "antifriccion.metrics.perfil.detail" },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF2", title: "Infraestructura técnica y sistemas mecánicos", description: "Aplicación de recubrimientos antifricción en mecanismos, elementos móviles y sistemas mecánicos presentes en infraestructuras técnicas. Reducción de fricción y desgaste para mejorar fiabilidad operativa y estabilidad de funcionamiento." },
  { code: "AF4", title: "Protección de la Fuerza", description: "Mejora del comportamiento tribológico de componentes sometidos a fricción en equipos operativos y sistemas críticos, reduciendo calentamientos localizados, desgaste prematuro y pérdidas de eficiencia en operación." },
  { code: "AF6", title: "Sostenimiento y mantenimiento avanzado", description: "Reducción del desgaste en conjuntos mecánicos para aumentar la vida útil de componentes, disminuir intervenciones de mantenimiento y mejorar la disponibilidad de sistemas en operación continuada." },
];

/* ── BACSI compact items (banner) ─────────────── */
const bacsiItems = [
  { code: "AF2", title: "Infraestructura técnica", detail: "Sistemas mecánicos y elementos móviles" },
  { code: "AF4", title: "Protección de la Fuerza", detail: "Fiabilidad en sistemas críticos" },
  { code: "AF6", title: "Sostenimiento 4.0", detail: "Menos desgaste · mayor disponibilidad" },
];

/* ── Structured data ──────────────────────────────── */
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const productImageUrl = product.heroImage ? new URL(product.heroImage, Astro.site).href : undefined;
const productJsonLd = productSchema({
  name: product.name,
  description: product.tagline,
  url: productUrl,
  image: productImageUrl,
  category: categoryInfo?.label,
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: "Inicio", url: "https://bacsi.thenextpangea.com/" },
  { name: "Productos", url: "https://bacsi.thenextpangea.com/#products" },
  { name: product.name, url: productUrl },
]);
---

<Layout
  title="ANTIFRICCIÓN · TheNextPangea"
  description="Recubrimientos avanzados basados en nanomateriales para reducir fricción y desgaste en conjuntos mecánicos. Reducción del COF del 85%, huella de desgaste x10 menor y perfilometría optimizada."
  ogImage={product.heroImage}
  ogType="product"
>
  <Fragment slot="structured-data">
    <JsonLd data={productJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="ANTIFRICCIÓN"
      backgroundImage={`${base}images/Antifriccion.png`}
      tags={heroTags}
      titleI18n="antifriccion.hero.title"
      subtitle="Formulaciones basadas en nanomateriales diseñadas para disminuir el coeficiente de fricción, reducir la huella de desgaste y extender significativamente la vida útil de componentes críticos."
      subtitleI18n="antifriccion.hero.subtitle"
      chips={heroChips}
      backI18n="antifriccion.hero.back"
      ctaPrimaryI18n="antifriccion.hero.cta.primary"
    >
      <span class="product-gradient-text">Recubrimientos avanzados</span> para reducir fricción y desgaste en conjuntos mecánicos
    </ProductHero>

    <!-- ════════════════ EL RETO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-violet-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="antifriccion.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="antifriccion.challenge.title">
            Reducir fricción y desgaste sin comprometer <span class="product-gradient-text">tolerancias, fiabilidad ni mantenibilidad</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="antifriccion.challenge.p1">
              En conjuntos mecánicos sometidos a carga, vibración y ciclos intensivos, la fricción y el desgaste degradan el rendimiento y pueden provocar <strong class="font-semibold">pérdida de eficiencia, calentamientos locales</strong> y fallos prematuros.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.challenge.p2">No basta con "lubricar": en muchos casos se necesita una solución compatible con <strong class="font-semibold text-slate-700">tolerancias ajustadas</strong>, materiales diversos y condiciones operativas variables, sin introducir contaminantes ni aumentar la complejidad de mantenimiento.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.challenge.p3">Las alternativas convencionales (grasas, tratamientos estándar o cambios de material) no siempre son viables: pueden tener <strong class="font-semibold text-slate-700">durabilidad limitada</strong>, dependencia del entorno o requerir paradas frecuentes.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.challenge.p4">El desafío no es solo reducir el coeficiente de fricción, sino <strong class="font-semibold text-slate-700">proteger la superficie de forma estable y repetible</strong>, disminuyendo la huella y profundidad de desgaste y extendiendo la vida útil del conjunto.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="mb-6 reveal">
            <SectionLabel label="La solución" i18nKey="antifriccion.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
            <div class="flex-1 reveal delay-100">
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-6" data-i18n-html="antifriccion.solution.title">
                Recubrimientos nanoestructurados para <span class="product-gradient-text">control de fricción y desgaste</span> en sistemas mecánicos
              </h3>
              <div class="space-y-4">
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.solution.p1">
                  <strong class="font-semibold text-slate-700">ANTIFRICCIÓN</strong> es una línea de recubrimientos desarrollados por TNP a partir de <strong class="font-semibold text-slate-700">formulaciones basadas en nanomateriales</strong>, diseñada para mejorar el comportamiento tribológico de conjuntos mecánicos sometidos a fricción y desgaste intensivo.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.solution.p2">
                  La tecnología se basa en la <strong class="font-semibold text-slate-700">ingeniería de la interfaz de contacto</strong>: ajustamos la naturaleza y la concentración de aditivos para reducir la fricción y proteger de forma estable la superficie, incluso bajo cargas, vibración y ciclos repetitivos.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="antifriccion.solution.p3">
                  Para facilitar el despliegue industrial, el recubrimiento puede aplicarse en formato <strong class="font-semibold text-slate-700">sprayable</strong> o mediante <strong class="font-semibold text-slate-700">deposición previa sobre liner</strong>, permitiendo su integración en procesos existentes y su uso sobre diferentes geometrías y materiales.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="antifriccion.solution.p4">
                  La validación frente a piezas sin tratar confirma mejoras relevantes en fricción y desgaste, con impacto directo en la eficiencia y la vida útil de los componentes.
                </p>
              </div>
            </div>

            <!-- Metrics visualization -->
            <div class="flex-shrink-0 w-full lg:w-5/12 reveal delay-200">
              <div class="product-glass rounded-2xl p-6 sm:p-8">
                <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8 text-center" data-i18n="antifriccion.metrics.title">
                  Resultados de validación
                </h4>
                <div class="space-y-6">
                  {metrics.map((m, i) => (
                    <div class="af-metric-card relative rounded-xl p-5 bg-white/70 border border-slate-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.02]" style={`animation-delay: ${i * 0.12}s;`}>
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400" data-i18n={m.labelI18n}>{m.label}</span>
                        <span class="text-xs font-mono text-slate-400" data-i18n={m.detailI18n}>{m.detail}</span>
                      </div>
                      <div class="text-3xl font-extrabold" style={`color: ${ACCENT};`} data-i18n={m.valueI18n}>{m.value}</div>
                      <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div
                          class="af-metric-bar h-full rounded-full"
                          style={`background: linear-gradient(90deg, ${ACCENT}, ${ACCENT_LIGHT}); --bar-target: ${i === 0 ? '85' : i === 1 ? '90' : '94'}%;`}
                        ></div>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="mt-6 text-xs text-slate-400 text-center leading-relaxed" data-i18n="antifriccion.metrics.note">
                  Ensayos comparativos frente a piezas sin tratar. Resultados representativos; valores exactos dependen del material, carga y régimen de trabajo.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ APLICACIONES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-violet-50/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">

        <!-- Section title -->
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Aplicaciones" i18nKey="antifriccion.apps.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4 reveal" data-i18n-html="antifriccion.apps.title">
            Aplicaciones
          </h2>
        </div>

        <!-- Application cards -->
        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto reveal delay-200">
          {aplicacionesCards.map((app, i) => (
            <div class="product-card group !p-6 text-center reveal" style={i > 0 ? `animation-delay: ${i * 0.1}s` : undefined}>
              <div class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center mb-4" style={`background: ${ACCENT}12;`}>
                <svg class="w-7 h-7" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={app.icon} /></svg>
              </div>
              <h3 class="font-bold text-slate-800 mb-2" data-i18n={`antifriccion.app${i + 1}.title`}>{app.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={`antifriccion.app${i + 1}.desc`}>{app.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ════════════════ DEFENSA (BACSI) ════════════════ -->
    <section class="relative py-24 sm:py-32 overflow-hidden bg-[#f5f7fa]">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <div class="product-section-label mx-auto mb-5 reveal">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
            <span data-i18n="antifriccion.defense.label">Aplicaciones</span>
          </div>
          <h2
            class="reveal text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800"
            data-i18n-html="antifriccion.defense.title"
          >
            Aplicaciones en entorno <span class="product-gradient-text">Defensa (BACSI)</span>
          </h2>
        </div>

        <!-- Application cards grid -->
        <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          {aplicacionesBacsi.map((app, index) => (
            <div class="product-card" style={`animation-delay: ${index * 80 + 100}ms;`}>
              <span
                class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider mb-4"
                style={`background: ${ACCENT}; color: #fff;`}
                data-i18n={`antifriccion.defense.app${index + 1}.code`}
              >
                {app.code}
              </span>
              <h3
                class="text-lg font-bold text-slate-800 mb-3"
                data-i18n={`antifriccion.defense.app${index + 1}.title`}
              >
                {app.title}
              </h3>
              <p
                class="text-sm text-slate-500 leading-relaxed"
                data-i18n={`antifriccion.defense.app${index + 1}.desc`}
              >
                {app.description}
              </p>
            </div>
          ))}
        </div>

        <!-- BACSI banner -->
        <div class="mt-12 reveal delay-100 relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <!-- Glow -->
          <div class="absolute inset-0 opacity-20 pointer-events-none" style={`background: radial-gradient(circle at 20% 30%, ${ACCENT} 0%, transparent 55%);`}></div>

          <div class="relative">
            <!-- Header -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-6">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" data-i18n="antifriccion.defense.banner.label">Cobertura en BACSI</div>
                <div class="text-xl font-semibold text-slate-900" data-i18n="antifriccion.defense.banner.title">Casos de uso alineados con áreas funcionales</div>
              </div>
              <div class="hidden lg:block h-px bg-slate-200 flex-1"></div>
            </div>

            <!-- AF cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
              {bacsiItems.map((item, i) => (
                <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm hover:shadow-md transition">
                  <div class="text-xs font-bold tracking-wider text-slate-500 mb-1" data-i18n={`antifriccion.defense.banner.item${i + 1}.code`}>{item.code}</div>
