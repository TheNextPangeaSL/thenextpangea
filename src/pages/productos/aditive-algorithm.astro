---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";
import JsonLd from "@/components/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/lib/schemas";
import { Image } from "astro:assets";
import add2man1 from "@/assets/images/add2man_1.png";
import add2man2 from "@/assets/images/add2man_2.png";
import add2man3 from "@/assets/images/add2man_3.png";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("aditive-algorithm")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #286181 */
const ACCENT_LIGHT = "#4A8BA6";
const ACCENT_DARK = "#1C4A63";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Fabricación aditiva metálica", i18nKey: "add-algo.hero.tag1" },
  { label: "Simulación y optimización de proceso", i18nKey: "add-algo.hero.tag2" },
];

const heroChips = [
  { label: "Modelos FEM de proceso", i18nKey: "add-algo.hero.chip1" },
  { label: "Control adaptativo capa a capa", i18nKey: "add-algo.hero.chip2" },
  { label: "Optimización multiláser LPBF", i18nKey: "add-algo.hero.chip3" },
  { label: "Predicción termomecánica", i18nKey: "add-algo.hero.chip4" },
];

/* ── Capacidades diferenciales (feature cards) ─────── */
const featureCards = [
  {
    title: "Simulación termomecánica acoplada",
    titleI18n: "add-algo.capabilities.card1.title",
    desc: "Predicción simultánea del campo térmico, tensiones residuales y distorsiones geométricas durante el proceso de fabricación aditiva.",
    descI18n: "add-algo.capabilities.card1.desc",
  },
  {
    title: "Refinamiento adaptativo de malla",
    titleI18n: "add-algo.capabilities.card2.title",
    desc: "El solver concentra la resolución computacional en las zonas críticas del proceso para mejorar la precisión sin aumentar innecesariamente el coste de cálculo.",
    descI18n: "add-algo.capabilities.card2.desc",
  },
  {
    title: "Simulación directa desde G-code",
    titleI18n: "add-algo.capabilities.card3.title",
    desc: "Importación directa del código de máquina para simular trayectorias reales de fabricación y evitar etapas de preprocesado manual.",
    descI18n: "add-algo.capabilities.card3.desc",
  },
  {
    title: "HPC y optimización algorítmica",
    titleI18n: "add-algo.capabilities.card4.title",
    desc: "Ejecución paralela de simulaciones y algoritmos de optimización para explorar rápidamente el espacio de parámetros y reducir iteraciones experimentales.",
    descI18n: "add-algo.capabilities.card4.desc",
  },
];

/* ── Paquete de valor (includes grid) ──────────────── */
const valueIncludes = [
  { text: "Rediseño topológico y funcional", i18nKey: "add-algo.value.includes.item1" },
  { text: "Simulación numérica de validación", i18nKey: "add-algo.value.includes.item2" },
  { text: "Optimización de tensiones y distorsiones", i18nKey: "add-algo.value.includes.item3" },
  { text: "Estimación de impacto operativo", i18nKey: "add-algo.value.includes.item4" },
];

/* ── Aplicaciones estratégicas ─────────────────────── */
const strategicApps = [
  {
    title: "Repuestos y componentes aeronáuticos",
    titleI18n: "add-algo.apps.card1.title",
    desc: "Validación previa de geometrías complejas, reducción de riesgo en fabricación y aceleración del desarrollo de componentes críticos o repuestos avanzados.",
    descI18n: "add-algo.apps.card1.desc",
    icon: "M6 12 3.269 3.125A7.502 7.502 0 0 0 19.635 7.11l.002.005L12 12m0 0-3.27 8.875A7.502 7.502 0 0 0 19.635 7.11M12 12l6.365-4.89",
  },
  {
    title: "Componentes espaciales y térmicos",
    titleI18n: "add-algo.apps.card2.title",
    desc: "Optimización de estructuras ligeras y componentes con gestión térmica integrada, donde el rediseño funcional aporta rendimiento y reducción de masa.",
    descI18n: "add-algo.apps.card2.desc",
    icon: "M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418",
  },
  {
    title: "Industrialización de piezas AM",
    titleI18n: "add-algo.apps.card3.title",
    desc: "Paso de prototipo a proceso repetible mediante simulación, optimización de proceso y reducción de iteraciones experimentales.",
    descI18n: "add-algo.apps.card3.desc",
    icon: "M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF3", codeI18n: "add-algo.apps.bacsi.app1.code", title: "Optimización de procesos", titleI18n: "add-algo.apps.bacsi.app1.title", description: "Mejora del desarrollo y validación de procesos avanzados de fabricación.", descI18n: "add-algo.apps.bacsi.app1.desc" },
  { code: "AF5", codeI18n: "add-algo.apps.bacsi.app2.code", title: "Seguridad en la operación", titleI18n: "add-algo.apps.bacsi.app2.title", description: "Mayor previsibilidad del comportamiento del proceso y reducción del riesgo técnico en fabricación de componentes.", descI18n: "add-algo.apps.bacsi.app2.desc" },
  { code: "AF6", codeI18n: "add-algo.apps.bacsi.app3.code", title: "Sostenimiento 4.0", titleI18n: "add-algo.apps.bacsi.app3.title", description: "Apoyo a fabricación avanzada, reposición de piezas y digitalización del conocimiento de proceso.", descI18n: "add-algo.apps.bacsi.app3.desc" },
];

/* ── Structured data ──────────────────────────────── */
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const productImageUrl = product.heroImage ? new URL(product.heroImage, Astro.site).href : undefined;
const productJsonLd = productSchema({
  name: product.name,
  description: product.tagline,
  url: productUrl,
  image: productImageUrl,
  category: categoryInfo?.label,
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: "Inicio", url: "https://bacsi.thenextpangea.com/" },
  { name: "Productos", url: "https://bacsi.thenextpangea.com/productos/" },
  { name: product.name, url: productUrl },
]);
---

<Layout
  title="ADD2MAN · 61HEX · TheNextPangea"
  description="Simulación termomecánica y optimización algorítmica para fabricación aditiva metálica. ADD2MAN permite predecir el comportamiento del proceso y ajustar parámetros de forma adaptativa."
  ogImage={product.heroImage}
  ogType="product"
>
  <Fragment slot="structured-data">
    <JsonLd data={productJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="ADD2MAN"
      backgroundImage={`${base}images/add2man-bg.png`}
      tags={heroTags}
      tagSeparator="·"
      titleI18n="add-algo.hero.title"
      subtitle="ADD2MAN permite predecir el comportamiento del proceso antes de fabricar la primera capa y ajustar de forma adaptativa los parámetros de impresión para reducir defectos, acortar la cualificación y escalar la fabricación de componentes metálicos complejos."
      subtitleI18n="add-algo.hero.subtitle"
      chips={heroChips}
      backLabel="Volver a productos"
      backI18n="add-algo.hero.back"
      ctaPrimaryLabel="Solicitar más información"
      ctaPrimaryI18n="add-algo.hero.cta.primary"
      ctaPrimaryHref="#contacto"
    >
      <!-- Badge slot: 61HEX spin-off pills -->
      <span
        slot="badge"
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-white"
      >
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" /></svg>
        <span data-i18n="add-algo.hero.badge.61hex">61HEX</span>
      </span>
      <span
        slot="badge"
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-white"
      >
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0114 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L7.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 016 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L10 4.323V3a1 1 0 011-1z" /></svg>
        <span data-i18n="add-algo.hero.badge.spinoff">Spin-off de TheNextPangea</span>
      </span>
      Simulación termomecánica y optimización algorítmica para fabricación aditiva metálica
    </ProductHero>

    <!-- ════════════════ EL RETO OPERATIVO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">

        <!-- Challenge card -->
        <div class="max-w-5xl mx-auto">
          <div class="product-card !p-8 md:!p-12 relative overflow-hidden reveal">
            <div class="absolute left-0 top-0 bottom-0 w-1.5" style={`background: ${ACCENT};`}></div>
            <div class="pl-4">
              <div class="mb-4">
                <SectionLabel label="El reto operativo" i18nKey="add-algo.challenge.label">
                  <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
                </SectionLabel>
              </div>

              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="add-algo.challenge.title">
                Reducir prueba y error en fabricación aditiva metálica sin comprometer calidad, productividad ni trazabilidad
              </h2>

              <div class="space-y-5">
                <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="add-algo.challenge.p1">
                  En fabricación aditiva metálica, la validación de parámetros y geometrías complejas sigue dependiendo con frecuencia de iteraciones experimentales costosas, con riesgo de distorsión, acumulación térmica, fisuración o tensiones residuales que no siempre se identifican antes de fabricar.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="add-algo.challenge.p2">
                  Este enfoque ralentiza la cualificación de nuevos materiales, penaliza la industrialización de piezas críticas y dificulta escalar procesos cuando el requisito no es solo imprimir, sino fabricar con repetibilidad, control y evidencia técnica.
                </p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="add-algo.challenge.p3">
                  En sectores como defensa, espacio o energía, el reto no es únicamente producir una pieza compleja, sino hacerlo con <strong class="font-semibold text-slate-700">más previsibilidad, menos riesgo de fallo y mejor relación entre rendimiento, plazo y coste</strong>.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- La solución: 2 columns -->
        <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-5xl mx-auto">
          <div class="lg:col-span-6 reveal">
            <div class="flex items-center gap-4 mb-6">
              <SectionLabel label="La solución" i18nKey="add-algo.solution.label">
                <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
              </SectionLabel>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-5 leading-snug" data-i18n-html="add-algo.solution.title">
              Simulación termomecánica y optimización algorítmica para decidir mejor antes y durante el proceso
            </h3>

            <div class="space-y-5 text-slate-500 leading-relaxed">
              <p class="text-lg" data-i18n-html="add-algo.solution.p1">
                <strong class="font-semibold text-slate-700">ADD2MAN</strong> integra simulación avanzada de proceso con algoritmos de optimización para anticipar el comportamiento de la fabricación aditiva metálica antes de fabricar la primera capa.
              </p>
              <p class="text-base" data-i18n="add-algo.solution.p2">
                Su base tecnológica combina predicción de campo térmico, tensiones residuales y distorsiones geométricas con capacidades de ajuste adaptativo de parámetros y estrategias de optimización orientadas a mejorar la fabricabilidad, la estabilidad del proceso y la productividad.
              </p>
              <p class="text-base" data-i18n="add-algo.solution.p3">
                Este enfoque permite pasar de una lógica tradicional de prueba y error a un ciclo de desarrollo guiado por simulación, especialmente valioso en componentes de alto valor, procesos LPBF multi-láser y entornos donde la repetibilidad del proceso es un requisito crítico.
              </p>
            </div>
          </div>

          <div class="lg:col-span-6 reveal delay-200">
            <div class="product-card !p-5 !rounded-[1.8rem]">
              <Image
                src={add2man1}
                alt="Simulación y optimización algorítmica en fabricación aditiva metálica"
                class="w-full h-auto rounded-2xl"
                loading="lazy"
                format="webp"
              />
              <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                  <div class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500 mb-1" data-i18n="add-algo.solution.metric1.kicker">Base</div>
                  <div class="text-sm font-semibold text-slate-900" data-i18n="add-algo.solution.metric1.value">Simulación FEM</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                  <div class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500 mb-1" data-i18n="add-algo.solution.metric2.kicker">Control</div>
                  <div class="text-sm font-semibold text-slate-900" data-i18n="add-algo.solution.metric2.value">Optimización adaptativa</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                  <div class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500 mb-1" data-i18n="add-algo.solution.metric3.kicker">Impacto</div>
                  <div class="text-sm font-semibold text-slate-900" data-i18n="add-algo.solution.metric3.value">Menos iteración experimental</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════ CAPACIDADES DIFERENCIALES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <!-- Left column: text -->
          <div class="lg:col-span-5 reveal">
            <div class="mb-4">
              <SectionLabel label="Capacidades diferenciales" i18nKey="add-algo.capabilities.label">
                <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
              </SectionLabel>
            </div>

            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-6" data-i18n-html="add-algo.capabilities.title">
              Núcleo técnico de <span class="product-gradient-text">ADD2MAN</span>
            </h2>

            <p class="text-lg text-slate-500 leading-relaxed mb-8" data-i18n="add-algo.capabilities.desc">
              ADD2MAN combina simulación industrial a escala real, computación de alto rendimiento y optimización algorítmica para anticipar defectos, validar componentes y acelerar la industrialización de piezas metálicas complejas.
            </p>

            <div
              class="inline-flex items-center rounded-full px-4 py-2 text-xs font-bold uppercase tracking-[0.20em] text-white"
              style={`background: ${ACCENT};`}
              data-i18n="add-algo.capabilities.badge"
            >
              Software avanzado de 61HEX
            </div>
          </div>

          <!-- Right column: image + feature cards -->
          <div class="lg:col-span-7 space-y-6 reveal delay-200">
            <div class="product-card !p-5 !rounded-[1.8rem]">
              <Image
                src={add2man2}
                alt="Simulación FEM de componente optimizado"
                class="w-full h-auto rounded-2xl"
                loading="lazy"
                format="webp"
              />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {featureCards.map((card, i) => (
                <div class="product-card !p-6 !rounded-[1.8rem] reveal" style={i > 0 ? `animation-delay:${i * 0.08}s` : undefined}>
                  <h3 class="text-lg font-bold text-slate-800 mb-3" data-i18n={card.titleI18n}>{card.title}</h3>
                  <p class="text-sm text-slate-500 leading-relaxed" data-i18n={card.descI18n}>{card.desc}</p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ════════════════ PAQUETE DE VALOR ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <!-- Left column: text + metrics -->
          <div class="lg:col-span-5 reveal">
            <div class="mb-4">
              <SectionLabel label="Paquete de valor" i18nKey="add-algo.value.label">
