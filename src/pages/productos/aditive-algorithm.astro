---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("aditive-algorithm")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #286181 */
const ACCENT_LIGHT = "#4A8BA6";
const ACCENT_DARK = "#1C4A63";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Software", i18nKey: "add-algo.hero.tag1" },
  { label: "Simulación", i18nKey: "add-algo.hero.tag2" },
  { label: "Optimización", i18nKey: "add-algo.hero.tag3" },
];

const heroChips = [
  { label: "Algorithmic Manufacturing", i18nKey: "add-algo.hero.chip1" },
  { label: "Plataforma ADD2MAN", i18nKey: "add-algo.hero.chip2" },
  { label: "Simulación FEM", i18nKey: "add-algo.hero.chip3" },
  { label: "Control adaptativo", i18nKey: "add-algo.hero.chip4" },
];

/* ── Casos de aplicación ───────────────────────────── */
const applicationCases = [
  {
    title: "Ti6Al4V en WAAM",
    titleI18n: "add-algo.cases.c1.title",
    desc: "Los parámetros adaptativos eliminan defectos de fisuración que aparecen sistemáticamente con parámetros fijos, manteniendo la productividad del proceso.",
    descI18n: "add-algo.cases.c1.desc",
    icon: "M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085",
  },
  {
    title: "Aceros de herramienta en WLAM",
    titleI18n: "add-algo.cases.c2.title",
    desc: "El control algorítmico evita acumulaciones térmicas responsables de defectos y oxidación excesiva durante la fabricación.",
    descI18n: "add-algo.cases.c2.desc",
    icon: "M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z",
  },
  {
    title: "17-4PH en LPBF",
    titleI18n: "add-algo.cases.c3.title",
    desc: "La optimización multiláser reduce el tiempo de fabricación de 40 h 25' a 29 h 30' en el mismo build job, con calidad interna verificada mediante CT Scan.",
    descI18n: "add-algo.cases.c3.desc",
    icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "Simulación predictiva", title: "Predicción de defectos antes de fabricar", description: "La simulación termomecánica permite anticipar distorsiones, fisuraciones y tensiones residuales, eliminando iteraciones de fabricación costosas." },
  { code: "Optimización de proceso", title: "Parámetros adaptativos para componentes críticos", description: "El control algorítmico ajusta potencia y velocidad capa a capa, garantizando calidad metalúrgica en componentes para defensa y espacio." },
  { code: "Productividad", title: "Reducción de tiempos de fabricación", description: "La optimización multiláser reduce tiempos de fabricación más de un 25% sin comprometer la calidad, acelerando la disponibilidad de piezas." },
];

const capacidadDestacada = {
  code: "Capacidades diferenciales",
  title: "Algorithmic Manufacturing: de la simulación a la pieza certificada",
  description: "Integración de simulación termomecánica propietaria con optimización algorítmica de parámetros de proceso para producir componentes avanzados en sectores de alta exigencia.",
  note: "Aplicable a componentes críticos para defensa, espacio y energía con altos requisitos de fiabilidad y trazabilidad.",
};
---

<Layout
  title="ADITIVE ALGORITHM · TheNextPangea"
  description="Simulación termomecánica propietaria y optimización algorítmica de parámetros de proceso para fabricación aditiva metálica."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="ADITIVE ALGORITHM"
      tags={heroTags}
      titleI18n="add-algo.hero.title"
      subtitle="Algorithmic Manufacturing: simulación termomecánica propietaria integrada con optimización algorítmica de parámetros de proceso para eliminar el enfoque de prueba y error en fabricación aditiva metálica."
      subtitleI18n="add-algo.hero.subtitle"
      chips={heroChips}
      backI18n="add-algo.hero.back"
      ctaPrimaryI18n="add-algo.hero.cta.primary"
    >
      <span class="product-gradient-text">Simulación y optimización algorítmica</span> para fabricación aditiva metálica
    </ProductHero>

    <!-- ════════════════ EL RETO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="add-algo.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="add-algo.challenge.title">
            Eliminar el enfoque de <span class="product-gradient-text">prueba y error</span> en fabricación aditiva metálica
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="add-algo.challenge.p1">
              La fabricación aditiva metálica se enfrenta a un cuello de botella crítico: la <strong class="font-semibold">cualificación de materiales y procesos</strong> sigue dependiendo de ciclos iterativos de prueba y error que consumen meses de trabajo experimental.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="add-algo.challenge.p2">Fenómenos como la distorsión geométrica, la acumulación térmica, la fisuración o las tensiones residuales pueden comprometer la calidad de la pieza y son difíciles de predecir con los enfoques convencionales.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="add-algo.challenge.p3">Cuando la potencia láser y la velocidad de escaneo permanecen <strong class="font-semibold text-slate-700">constantes durante todo el proceso</strong>, no es posible compensar las variaciones geométricas ni el historial térmico acumulado capa a capa.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="add-algo.challenge.p4">Procesar geometrías complejas, cualificar nuevos materiales o producir componentes para sectores como defensa, espacio o energía exige un enfoque <strong class="font-semibold text-slate-700">guiado por simulación y optimización algorítmica</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ SIMULACIÓN Y CONTROL ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">

        <div class="max-w-4xl mx-auto mb-10">
          <div class="mb-6 reveal">
            <SectionLabel label="Plataforma ADD2MAN" i18nKey="add-algo.simulation.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h3 class="reveal delay-100 text-2xl sm:text-3xl font-bold tracking-tight text-slate-800" data-i18n-html="add-algo.simulation.title">
            Simulación y control de proceso <span class="product-gradient-text">algorítmico</span>
          </h3>
        </div>

        <div class="max-w-4xl mx-auto reveal delay-200">
          <div class="space-y-5">
            <p class="text-lg leading-relaxed text-slate-500" data-i18n-html="add-algo.simulation.p1">
              La plataforma propietaria <strong class="font-semibold text-slate-700">ADD2MAN</strong>, basada en modelos FEM de proceso aditivo, permite predecir fenómenos críticos como distorsión geométrica, acumulación térmica, fisuración o tensiones residuales.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="add-algo.simulation.p2">
              Esta capacidad de simulación se integra directamente con algoritmos de optimización que ajustan los parámetros de fabricación de forma dinámica durante la impresión.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="add-algo.simulation.p3">
              A diferencia de los enfoques convencionales, en los que potencia láser y velocidad de escaneo permanecen constantes, el control desarrollado por 61HEX adapta los parámetros capa a capa en función de la geometría y del historial térmico de la pieza.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="add-algo.simulation.p4">
              El ecosistema se completa con una tecnología patentada de optimización multiláser para LPBF, capaz de reducir los tiempos de fabricación más de un 25% frente a configuraciones estándar sin comprometer la calidad metalúrgica (densidad superior al 99,9%).
            </p>
          </div>

          <!-- Key metrics -->
          <div class="grid sm:grid-cols-3 gap-4 mt-12">
            {[
              { value: ">25%", label: "Reducción tiempo fabricación", sublabel: "Optimización multiláser LPBF" },
              { value: "99,9%", label: "Densidad metalúrgica", sublabel: "Calidad verificada por CT Scan" },
              { value: "Capa a capa", label: "Control adaptativo", sublabel: "Parámetros dinámicos en tiempo real" },
            ].map((m, i) => (
              <div class="product-card !p-5 text-center reveal" style={i > 0 ? `animation-delay:${i * 0.08}s` : undefined}>
                <div class="text-2xl font-extrabold mb-1" style={`color: ${ACCENT};`}>{m.value}</div>
                <div class="text-sm font-semibold text-slate-700">{m.label}</div>
                <div class="text-xs text-slate-400 mt-1">{m.sublabel}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ CASOS DE APLICACIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-50/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Aplicación estratégica" i18nKey="add-algo.cases.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4 reveal" data-i18n-html="add-algo.cases.title">
            Eficacia demostrada en <span class="product-gradient-text">materiales y procesos reales</span>
          </h2>
          <p class="text-lg text-slate-500 reveal delay-100" data-i18n="add-algo.cases.subtitle">
            La metodología ha demostrado su eficacia en distintos materiales y procesos aditivos.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto reveal delay-200">
          {applicationCases.map((app, i) => (
            <div class="product-card group !p-6 reveal" style={i > 0 ? `animation-delay: ${i * 0.1}s` : undefined}>
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4" style={`background: ${ACCENT}12;`}>
                <svg class="w-7 h-7" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={app.icon} /></svg>
              </div>
              <h3 class="font-bold text-slate-800 mb-2" data-i18n={app.titleI18n}>{app.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={app.descI18n}>{app.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ DEFENSA (BACSI) ════════════════ -->
    <BacsiApplications
      accent={ACCENT}
      i18nPrefix="add-algo"
      titleI18n="add-algo.defense.title"
      labelI18n="add-algo.defense.label"
      applications={aplicacionesBacsi}
      featuredItem={capacidadDestacada}
      featuredI18nKey="capacidad"
      bgClass="bg-[#f5f7fa]"
    />

    <!-- ════════════════ CTA ════════════════ -->
    <ProductCTA
      accent={ACCENT}
      productName="ADITIVE ALGORITHM"
      i18nPrefix="add-algo"
      description="Analizamos tu caso de uso, simulamos el comportamiento termomecánico y optimizamos los parámetros de fabricación para eliminar el enfoque de prueba y error."
      bgClass="bg-white"
    />

  </ProductPageWrapper>
</Layout>
