---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import {
  products,
  getProductBySlug,
  getProductsByCategory,
  getCategoryInfo,
  getProductTags,
  getProductUrl,
  isExternalProduct,
} from "@/data/products";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  /** Products with dedicated pages — excluded from dynamic routing */
  const dedicated = new Set(["dxter", "planifai", "imagia", "heaters", "antifriccion", "buscai", "fast-reporting-tool", "fpgas", "sensorica", "arquea", "fabricacion-aditiva"]);
  return products
    .filter((p) => !dedicated.has(p.slug))
    .map((product) => ({
      params: { slug: product.slug },
    }));
};

const base = import.meta.env.BASE_URL;

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect(`${base}404`);
}

const categoryInfo = getCategoryInfo(product.category);
const productTags = getProductTags(product);
const relatedProducts = getProductsByCategory(product.category).filter(
  (p) => p.slug !== product.slug
);

/* ── Accent colours ────────────────────────────────── */
const ACCENT = product.hexColor;

function lighten(hex: string, amount = 50): string {
  const r = Math.min(255, parseInt(hex.slice(1, 3), 16) + amount);
  const g = Math.min(255, parseInt(hex.slice(3, 5), 16) + amount);
  const b = Math.min(255, parseInt(hex.slice(5, 7), 16) + amount);
  return `#${r.toString(16).padStart(2, "0")}${g.toString(16).padStart(2, "0")}${b.toString(16).padStart(2, "0")}`;
}
function darken(hex: string, amount = 25): string {
  const r = Math.max(0, parseInt(hex.slice(1, 3), 16) - amount);
  const g = Math.max(0, parseInt(hex.slice(3, 5), 16) - amount);
  const b = Math.max(0, parseInt(hex.slice(5, 7), 16) - amount);
  return `#${r.toString(16).padStart(2, "0")}${g.toString(16).padStart(2, "0")}${b.toString(16).padStart(2, "0")}`;
}

const ACCENT_LIGHT = lighten(ACCENT);
const ACCENT_DARK = darken(ACCENT);

/* ── Hero tags (from product tag metadata) ─────────── */
const heroTags = productTags.map((t) => ({
  label: t.label,
  i18nKey: `${product.slug}.hero.tag.${t.id}`,
}));

/* ── Feature icon paths (cycling set of generic icons) */
const featureIcons = [
  "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z",
  "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
  "M11.42 15.17l-5.42 3.17 1.03-6.02-4.38-4.27 6.06-.88L11.42 1.5l2.71 5.67 6.06.88-4.38 4.27 1.03 6.02z",
  "M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342",
];
---

<Layout
  title={`${product.name} · TheNextPangea`}
  description={product.tagline}
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName={product.name}
      backgroundImage={product.heroImage ? `${base}${product.heroImage.replace(/^\//, "")}` : undefined}
      tags={heroTags}
      subtitle={product.tagline}
    >
      <span class="product-gradient-text">{product.name}</span>
    </ProductHero>

    <!-- ════════════════ DESCRIPTION ════════════════ -->
    {product.description && (
      <section class="relative py-24 sm:py-32 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
          <div class="max-w-4xl mx-auto">
            <SectionLabel label={categoryInfo?.label ?? "Producto"} class="mb-6 reveal">
              <svg slot="icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={product.icon} />
              </svg>
            </SectionLabel>

            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-6 text-slate-800 reveal">
              Sobre <span class="product-gradient-text">{product.name}</span>
            </h2>

            <p class="text-lg text-slate-500 leading-relaxed reveal">
              {product.description}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- ════════════════ FEATURES ════════════════ -->
    {product.features.length > 0 && (
      <section id="features" class="relative py-24 sm:py-32 bg-[#f8f9fb] overflow-hidden product-grid-pattern">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
          <div class="text-center mb-16 max-w-2xl mx-auto">
            <SectionLabel label="Características principales" class="mx-auto mb-5 reveal">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
              </svg>
            </SectionLabel>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-slate-800 reveal">
              ¿Qué hace único a <span class="product-gradient-text">{product.name}</span>?
            </h2>
          </div>

          <div class={`grid gap-6 ${product.features.length <= 2 ? "sm:grid-cols-2 max-w-4xl mx-auto" : product.features.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4"}`}>
            {product.features.map((f, i) => (
              <div class="product-card reveal" style={i > 0 ? `animation-delay:${i * 0.08}s` : undefined}>
                <div class="product-icon-box product-icon-box-light mb-5">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={featureIcons[i % featureIcons.length]} />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-800 mb-2">{f.title}</h3>
                <p class="text-sm text-slate-500 leading-relaxed">{f.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ════════════════ CTA ════════════════ -->
    <ProductCTA
      accent={ACCENT}
      productName={product.name}
      i18nPrefix={product.slug}
      description={`Contacta con nuestro equipo para conocer cómo ${product.name} puede transformar tus procesos.`}
      bgClass={product.features.length > 0 ? "bg-white" : "bg-[#f5f7fa]"}
    />

    <!-- ════════════════ RELATED PRODUCTS ════════════════ -->
    {relatedProducts.length > 0 && (
      <section class="relative py-20 bg-white border-t border-slate-200/60 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
          <div class="flex items-center justify-between mb-12">
            <div>
              <span class="reveal text-xs font-bold uppercase tracking-[0.15em] mb-2 block" style={`color: ${ACCENT};`}>
                Más en {categoryInfo?.label}
              </span>
              <h2 class="reveal text-2xl sm:text-3xl font-bold tracking-tight text-slate-800">
                Productos Relacionados
              </h2>
            </div>
            <a
              href={`${base}#projects-carousel`}
              class="reveal hidden sm:inline-flex items-center gap-2 text-sm font-semibold transition-colors duration-200"
              style={`color: ${ACCENT};`}
            >
              Ver todos
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            {relatedProducts.slice(0, 4).map((rp, index) => (
              <a
                href={getProductUrl(rp, base)}
                class="product-card group reveal"
                style={`animation-delay: ${index * 80 + 100}ms;`}
                {...(isExternalProduct(rp) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background: ${rp.hexColor}12;`}>
                  <svg class="w-5 h-5" style={`color: ${rp.hexColor};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={rp.icon} />
                  </svg>
                </div>
                <h3 class="text-base font-bold text-slate-800 mb-1 group-hover:text-slate-600 transition-colors">{rp.name}</h3>
                <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">{rp.tagline}</p>
                <div class="mt-4 flex items-center gap-1 text-xs font-semibold transition-colors" style={`color: ${rp.hexColor};`}>
                  <span>Ver producto</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

  </ProductPageWrapper>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>