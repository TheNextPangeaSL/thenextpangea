---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import { products, categories, getProductBySlug, getProductsByCategory, getCategoryInfo, getProductTags, getProductUrl, isExternalProduct } from "@/data/products";
import type { GetStaticPaths } from "astro";

const base = import.meta.env.BASE_URL;

export const getStaticPaths: GetStaticPaths = () => {
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
};

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect(`${base}404`);
}

const categoryInfo = getCategoryInfo(product.category);
const productTags = getProductTags(product);
const relatedProducts = getProductsByCategory(product.category).filter(
  (p) => p.slug !== product.slug
);
---

<Layout
  title={`${product.name} — TheNextPangea`}
  description={product.tagline}
>
  <Navbar slot="nav" />

  <!-- ════════════════════════════════════════════════════════════
       HERO SECTION
       ════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden bg-pangea-dark-blue">
    <!-- Background abstract pattern -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-br from-pangea-dark-blue via-pangea-dark-blue/95 to-pangea-classic-blue/30"></div>
      <!-- Grid pattern overlay -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>'); background-size: 60px 60px;"></div>
      <!-- Decorative orbs -->
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full blur-3xl" style={`background: ${product.hexColor}08;`}></div>
      <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full bg-pangea-classic-blue/5 blur-3xl"></div>
      <!-- Accent line -->
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-pangea-sky-blue/20 to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 section-container px-6 sm:px-10 pb-16 pt-40 w-full">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-pangea-calm-blue/50 mb-8 animate-fade-in" aria-label="Breadcrumb">
        <a href={base} class="hover:text-pangea-sky-blue transition-colors duration-200">Home</a>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span class="hover:text-pangea-sky-blue transition-colors duration-200">Productos</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-pangea-white/70">{product.name}</span>
      </nav>

      <div class="flex flex-col lg:flex-row items-end justify-between gap-10">
        <div class="flex-1 max-w-3xl">
          <!-- Category badge + Tags -->
          <div class="flex flex-wrap items-center gap-3 mb-6 animate-fade-in" style="animation-delay: 0.1s;">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center" style={`background: ${product.hexColor}15;`}>
                <svg class="w-4 h-4" style={`color: ${product.hexColor};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={product.icon} />
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-[0.2em]" style={`color: ${product.hexColor};`}>
                {categoryInfo?.label}
              </span>
            </div>
            {productTags.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="w-px h-4 bg-pangea-white/20 mx-1 hidden sm:block" aria-hidden="true"></span>
                {productTags.map((tag) => (
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold leading-none ${tag.color} ${tag.textColor}`}>
                    {tag.label}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Product name -->
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tight text-pangea-white mb-5 animate-fade-in-up" style="animation-delay: 0.2s;">
            {product.name}
          </h1>

          <!-- Tagline -->
          <p class="text-lg sm:text-xl md:text-2xl font-light text-pangea-calm-blue/80 leading-relaxed animate-fade-in-up" style="animation-delay: 0.35s;">
            {product.tagline}
          </p>
        </div>

        <!-- Floating icon (desktop only) -->
        <div class="hidden lg:flex items-center justify-center w-32 h-32 rounded-3xl border border-pangea-white/10 animate-fade-in" style={`background: linear-gradient(135deg, ${product.hexColor}10, ${product.hexColor}05); animation-delay: 0.4s;`}>
          <svg class="w-16 h-16" style={`color: ${product.hexColor}60;`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.75">
            <path stroke-linecap="round" stroke-linejoin="round" d={product.icon} />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       DESCRIPTION SECTION
       ════════════════════════════════════════════════════════════ -->
  <section class="relative section-padding bg-pangea-white overflow-hidden">
    <!-- Decorative -->
    <div class="absolute top-0 right-0 w-[300px] h-[300px] bg-pangea-calm-blue/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>

    <div class="section-container relative z-10">
      <div class="max-w-4xl mx-auto">
        <!-- Section label -->
        <div class="flex items-center gap-3 mb-8 reveal">
          <div class="w-10 h-1 rounded-full" style={`background: ${product.hexColor};`}></div>
          <span class="text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue">Descripción General</span>
        </div>

        <!-- Main description -->
        {product.description ? (
          <div class="reveal delay-100">
            <p class="text-lg md:text-xl leading-relaxed text-pangea-dark-blue/80 font-light">
              {product.description}
            </p>
          </div>
        ) : (
          <div class="reveal delay-100 rounded-2xl border-2 border-dashed border-pangea-calm-blue/20 p-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-pangea-calm-blue/10 flex items-center justify-center mx-auto mb-5">
              <svg class="w-8 h-8 text-pangea-calm-blue/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-pangea-dark-blue mb-2">Contenido en desarrollo</h3>
            <p class="text-pangea-classic-blue/60 max-w-md mx-auto">
              La información detallada sobre este producto estará disponible próximamente. Contacta con nosotros para más información.
            </p>
            <a href={`${base}#contact`} class="inline-flex items-center gap-2 mt-6 px-6 py-3 rounded-full bg-pangea-classic-blue text-pangea-white text-sm font-semibold hover:bg-pangea-dark-blue transition-colors duration-300">
              Contáctanos
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       FEATURES SECTION (only if has features)
       ════════════════════════════════════════════════════════════ -->
  {product.features.length > 0 && (
    <section class="relative section-padding bg-pangea-dark-blue overflow-hidden">
      <!-- Decorative -->
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>'); background-size: 60px 60px;"></div>
      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full blur-3xl" style={`background: ${product.hexColor}06;`}></div>
      <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] rounded-full bg-pangea-classic-blue/5 blur-3xl"></div>

      <div class="section-container relative z-10">
        <!-- Section header -->
        <div class="text-center mb-16 md:mb-20">
          <span class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] mb-4" style={`color: ${product.hexColor};`}>
            Características Principales
          </span>
          <h2 class="reveal delay-100 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-pangea-white">
            ¿Qué hace a <span style={`color: ${product.hexColor};`}>{product.name}</span> único?
          </h2>
        </div>

        <!-- Features grid -->
        <div class={`grid gap-6 md:gap-8 ${product.features.length <= 2 ? 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto' : product.features.length === 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1 md:grid-cols-2'}`}>
          {product.features.map((feature, index) => (
            <div
              class="reveal group relative rounded-2xl border border-pangea-white/[0.08] p-8 md:p-10 transition-all duration-500 hover:border-pangea-white/15 hover:bg-pangea-white/[0.03]"
              style={`animation-delay: ${index * 100 + 100}ms; transition-delay: ${index * 50}ms;`}
            >
              {/* Number indicator */}
              <div class="flex items-center gap-4 mb-6">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-black border border-pangea-white/10" style={`background: ${product.hexColor}12; color: ${product.hexColor};`}>
                  {String(index + 1).padStart(2, "0")}
                </div>
                <div class="flex-1 h-px bg-gradient-to-r from-pangea-white/10 to-transparent"></div>
              </div>

              {/* Feature title */}
              <h3 class="text-xl font-bold text-pangea-white mb-4 group-hover:text-pangea-sky-blue transition-colors duration-300">
                {feature.title}
              </h3>

              {/* Feature description */}
              <p class="text-sm md:text-base text-pangea-calm-blue/70 leading-relaxed font-light">
                {feature.description}
              </p>

              {/* Hover accent line */}
              <div class="absolute bottom-0 left-8 right-8 h-px bg-gradient-to-r from-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" style={`background: linear-gradient(to right, transparent, ${product.hexColor}40, transparent);`}></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════════════════════
       CTA SECTION
       ════════════════════════════════════════════════════════════ -->
  <section class="relative section-padding overflow-hidden" style={`background: linear-gradient(135deg, ${product.hexColor}08, ${product.hexColor}03);`}>
    <div class="section-container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="reveal">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-pangea-dark-blue mb-5">
            ¿Interesado en <span style={`color: ${product.hexColor};`}>{product.name}</span>?
          </h2>
          <p class="text-lg text-pangea-classic-blue/70 mb-8 font-light">
            Contacta con nuestro equipo para conocer cómo esta tecnología puede transformar tus procesos.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={`${base}#contact`}
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-pangea-classic-blue text-pangea-white font-semibold text-sm tracking-wide uppercase shadow-pangea hover:shadow-pangea-lg hover:bg-pangea-dark-blue transition-all duration-300"
            >
              Solicitar información
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <a
              href={`${base}#services`}
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-transparent text-pangea-classic-blue font-semibold text-sm tracking-wide uppercase border-2 border-pangea-classic-blue/30 hover:border-pangea-classic-blue hover:bg-pangea-classic-blue/5 transition-all duration-300"
            >
              Ver todos los productos
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       RELATED PRODUCTS
       ════════════════════════════════════════════════════════════ -->
  {relatedProducts.length > 0 && (
    <section class="relative section-padding bg-pangea-white overflow-hidden border-t border-pangea-light-grey/50">
      <div class="section-container relative z-10">
        <!-- Section header -->
        <div class="flex items-center justify-between mb-12">
          <div>
            <span class="reveal text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-2 block">
              Más en {categoryInfo?.label}
            </span>
            <h2 class="reveal delay-100 text-2xl md:text-3xl font-bold tracking-tight text-pangea-dark-blue">
              Productos Relacionados
            </h2>
          </div>
          <a
            href={base}
            class="reveal hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-pangea-classic-blue hover:text-pangea-dark-blue transition-colors duration-200"
          >
            Ver todos
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Related products grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {relatedProducts.slice(0, 4).map((rp, index) => (
            <a
              href={getProductUrl(rp, import.meta.env.BASE_URL)}
              class="reveal group relative rounded-2xl border border-pangea-light-grey/60 p-6 transition-all duration-300 hover:shadow-pangea-lg hover:-translate-y-1 hover:border-pangea-calm-blue/30 bg-pangea-white"
              style={`animation-delay: ${index * 80 + 100}ms;`}
              {...(isExternalProduct(rp) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background: ${rp.hexColor}12;`}>
                <svg class="w-5 h-5" style={`color: ${rp.hexColor};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={rp.icon} />
                </svg>
              </div>
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-base font-bold text-pangea-dark-blue group-hover:text-pangea-classic-blue transition-colors duration-200">
                  {rp.name}
                </h3>

              </div>
              <p class="text-xs text-pangea-classic-blue/60 leading-relaxed line-clamp-2">
                {rp.tagline}
              </p>
              <div class="mt-4 flex items-center gap-1 text-xs font-semibold text-pangea-classic-blue/40 group-hover:text-pangea-classic-blue transition-colors duration-200">
                <span>Ver producto</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* line-clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
