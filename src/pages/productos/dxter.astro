<script define:vars={{ accent }}>
  // ══════════════════════════════════════════════════════
  // "Cómo funciona" — Proceso de decisión visualization
  // ══════════════════════════════════════════════════════
  (function() {
    const canvas = document.getElementById('dxter-viz-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const label = document.getElementById('dxter-viz-label');
    const dots = Array.from(document.querySelectorAll('.dxter-viz-dot'));

    const ACCENT = accent;
    let labels = ['Paso 1 � Datos observados', 'Paso 2 � Modelo + incertidumbre', 'Paso 3 � Funci�n de adquisici�n'];
    // Update labels on locale change
    window.addEventListener('locale-changed', (e) => {
      const loc = e.detail && e.detail.locale || 'es';
      const t = window.__pangea_translations;
      if (t && t[loc]) {
        labels = [
          t[loc]['dxter.canvas.label0'] || labels[0],
          t[loc]['dxter.canvas.label1'] || labels[1],
          t[loc]['dxter.canvas.label2'] || labels[2],
        ];
        if (typeof updateDots === 'function') updateDots();
      }
    });

    let W, H, dpr;
    let currentStep = 0;
    let progress = 0;
    let animFrame;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function hexToRgb(hex) {
      return { r: parseInt(hex.slice(1,3),16), g: parseInt(hex.slice(3,5),16), b: parseInt(hex.slice(5,7),16) };
    }
    const accentRgb = hexToRgb(ACCENT);

    const dataPoints = [
      { x: 0.08, y: 0.65 }, { x: 0.22, y: 0.42 }, { x: 0.35, y: 0.55 },
      { x: 0.52, y: 0.28 }, { x: 0.68, y: 0.48 }, { x: 0.82, y: 0.35 },
      { x: 0.92, y: 0.58 },
    ];

    function gpMean(t) {
      return 0.55 - 0.15 * Math.sin(t * Math.PI * 2.2) - 0.08 * Math.cos(t * Math.PI * 4.5 + 1) + 0.05 * Math.sin(t * Math.PI * 6);
    }
    function gpStd(t) {
      let minDist = 1;
      for (const p of dataPoints) minDist = Math.min(minDist, Math.abs(t - p.x));
      return 0.04 + 0.12 * Math.min(1, minDist * 4);
    }
    function acqFn(t) {
      return gpStd(t) * 1.8 + (1 - gpMean(t)) * 0.3;
    }

    function drawBg() {
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.roundRect(0, 0, W, H, 12);
      ctx.fill();
      ctx.strokeStyle = 'rgba(0,0,0,0.06)';
      ctx.lineWidth = 1;
      const step = 40;
      for (let x = step; x < W; x += step) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
      for (let y = step; y < H; y += step) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
    }

    function tx(v) { return 40 + v * (W - 80); }
    function ty(v) { return 30 + v * (H - 60); }
    function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

    function drawStep0(p) {
      const count = Math.floor(p * dataPoints.length) + (p >= 1 ? 0 : 1);
      for (let i = 0; i < Math.min(count, dataPoints.length); i++) {
        const dp = dataPoints[i];
        const appear = Math.min(1, (p * dataPoints.length - i) * 2);
        const scale = easeOut(Math.min(1, appear));
        const r = 6 * scale;
        const grad = ctx.createRadialGradient(tx(dp.x), ty(dp.y), 0, tx(dp.x), ty(dp.y), r * 4);
        grad.addColorStop(0, `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.25 * appear})`);
        grad.addColorStop(1, 'transparent');
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(tx(dp.x), ty(dp.y), r * 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = ACCENT;
        ctx.beginPath(); ctx.arc(tx(dp.x), ty(dp.y), r, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = `rgba(255,255,255,${0.8 * appear})`;
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(tx(dp.x), ty(dp.y), r + 2, 0, Math.PI * 2); ctx.stroke();
      }
    }

    function drawStep1(p) {
      drawStep0(1);
      const ep = easeOut(p);
      const steps = 120;
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        if (i === 0) ctx.moveTo(tx(t), ty(gpMean(t) - gpStd(t) * ep));
        else ctx.lineTo(tx(t), ty(gpMean(t) - gpStd(t) * ep));
      }
      for (let i = steps; i >= 0; i--) {
        const t = i / steps;
        ctx.lineTo(tx(t), ty(gpMean(t) + gpStd(t) * ep));
      }
      ctx.closePath();
      ctx.fillStyle = `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.12 * ep})`;
      ctx.fill();
      ctx.beginPath();
      ctx.lineWidth = 3;
      ctx.strokeStyle = `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.9 * ep})`;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        if (i === 0) ctx.moveTo(tx(t), ty(gpMean(t)));
        else ctx.lineTo(tx(t), ty(gpMean(t)));
      }
      ctx.stroke();
    }

    function drawStep2(p) {
      drawStep1(1);
      const ep = easeOut(p);
      const steps = 120;
      ctx.beginPath();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = `rgba(255,180,60,${0.8 * ep})`;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const yPos = ty(0.85 - acqFn(t) * 0.6 * ep);
        if (i === 0) ctx.moveTo(tx(t), yPos);
        else ctx.lineTo(tx(t), yPos);
      }
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const yPos = ty(0.85 - acqFn(t) * 0.6 * ep);
        if (i === 0) ctx.moveTo(tx(t), yPos);
        else ctx.lineTo(tx(t), yPos);
      }
      ctx.lineTo(tx(1), ty(0.85));
      ctx.lineTo(tx(0), ty(0.85));
      ctx.closePath();
      ctx.fillStyle = `rgba(255,180,60,${0.06 * ep})`;
      ctx.fill();
      if (p > 0.5) {
        const cAlpha = easeOut((p - 0.5) * 2);
        for (const cx of [0.15, 0.45]) {
          const cy = 0.85 - acqFn(cx) * 0.6;
          const glowR = 14 + 4 * Math.sin(Date.now() / 400);
          const grad = ctx.createRadialGradient(tx(cx), ty(cy), 0, tx(cx), ty(cy), glowR);
          grad.addColorStop(0, `rgba(255,180,60,${0.5 * cAlpha})`);
          grad.addColorStop(1, 'transparent');
          ctx.fillStyle = grad;
          ctx.beginPath(); ctx.arc(tx(cx), ty(cy), glowR, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = `rgba(255,180,60,${cAlpha})`;
          ctx.beginPath();
          const s = 6;
          ctx.moveTo(tx(cx), ty(cy) - s); ctx.lineTo(tx(cx) + s, ty(cy));
          ctx.lineTo(tx(cx), ty(cy) + s); ctx.lineTo(tx(cx) - s, ty(cy));
          ctx.closePath(); ctx.fill();
        }
      }
    }

    function updateDots() {
      dots.forEach((d, i) => {
        if (i === currentStep) {
          d.style.background = ACCENT;
          d.style.boxShadow = `0 0 0 4px ${ACCENT}30`;
          d.style.transform = 'scale(1.3)';
        } else {
          d.style.background = 'rgba(148,163,184,0.4)';
          d.style.boxShadow = 'none';
          d.style.transform = 'scale(1)';
        }
      });
      if (label) label.textContent = labels[currentStep];
    }

    let lastTime = 0;
    const STEP_DURATION = 3500;
    const ANIM_DURATION = 1200;
    let stepStartTime = 0;
    let hoverPaused = false;

    function animate(time) {
      if (!lastTime) { lastTime = time; stepStartTime = time; }
      const elapsed = time - stepStartTime;
      progress = Math.min(1, elapsed / ANIM_DURATION);
      resize();
      drawBg();
      if (currentStep === 0) drawStep0(progress);
      else if (currentStep === 1) drawStep1(progress);
      else drawStep2(progress);
      if (elapsed > STEP_DURATION && !hoverPaused) {
        currentStep = (currentStep + 1) % 3;
        stepStartTime = time;
        progress = 0;
        updateDots();
        updateStepCards();
      }
      animFrame = requestAnimationFrame(animate);
    }

    dots.forEach((d, i) => {
      d.addEventListener('click', () => {
        currentStep = i;
        stepStartTime = performance.now();
        progress = 0;
        updateDots();
        updateStepCards();
      });
    });

    // Step card hover ? control canvas visualization
    const stepCards = document.querySelectorAll('.dxter-step-card[data-viz-step]');

    function updateStepCards() {
      stepCards.forEach((card, i) => {
        const idx = parseInt(card.getAttribute('data-viz-step'));
        if (idx === currentStep) {
          card.classList.add('dxter-step-active');
        } else {
          card.classList.remove('dxter-step-active');
        }
      });
    }

    stepCards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        const step = parseInt(card.getAttribute('data-viz-step'));
        hoverPaused = true;
        currentStep = step;
        stepStartTime = performance.now();
        progress = 0;
        updateDots();
        updateStepCards();
      });
      card.addEventListener('mouseleave', () => {
        hoverPaused = false;
        stepStartTime = performance.now();
      });
    });

    updateStepCards();

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!prefersReduced.matches) {
      updateDots();
      animFrame = requestAnimationFrame(animate);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(animFrame);
      else { lastTime = 0; animFrame = requestAnimationFrame(animate); }
    });
  })();
</script>
