---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import WorkflowInfographic from "@/components/WorkflowInfographic.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";
import JsonLd from "@/components/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/lib/schemas";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("dxter")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #198D8F */
const ACCENT_LIGHT = "#4abfbd";
const ACCENT_DARK = "#1f8584";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia Artificial", i18nKey: "dxter.hero.tag1" },
  { label: "Data Utilities", i18nKey: "dxter.hero.tag2" },
  { label: "Optimización avanzada", i18nKey: "dxter.hero.tag3" },
];

const heroChips = [
  { label: "Optimización multiobjetivo", i18nKey: "dxter.hero.chip1" },
  { label: "Decisión asistida", i18nKey: "dxter.hero.chip2" },
  { label: "Exploración + explotación", i18nKey: "dxter.hero.chip3" },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF3", title: "GIC y optimización de procesos", description: "Optimización cuantitativa de procesos, reglas y restricciones operativas. Evaluación de alternativas bajo múltiples variables para mejorar productividad y reducir tiempos de ciclo." },
  { code: "AF6", title: "Sostenimiento basado en datos", description: "Priorización y planificación inteligente de ensayos, validaciones y configuraciones para maximizar disponibilidad operativa y optimizar el uso de recursos." },
  { code: "Transversal", title: "Decisión asistida con incertidumbre", description: "Recomendaciones basadas en modelos probabilísticos con estimación explícita de incertidumbre para apoyar decisiones técnicas en escenarios complejos y con recursos limitados." },
];

const simulacionAvanzada = {
  code: "Simulación avanzada",
  title: "Exploración paramétrica y validación en entornos simulados complejos",
  description: "Ajuste inteligente de parámetros y escenarios en espacios de alta dimensión, con cuantificación de incertidumbre antes de la validación operativa. Permite comparar configuraciones, priorizar alternativas y reducir iteraciones físicas en entornos donde la exploración exhaustiva no es viable.",
  note: "Aplicable a procesos de validación técnica, análisis de escenarios y entrenamiento avanzado bajo restricciones operativas reales.",
};

/* ── Structured data ──────────────────────────────── */
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const productImageUrl = product.heroImage ? new URL(product.heroImage, Astro.site).href : undefined;
const productJsonLd = productSchema({
  name: product.name,
  description: product.tagline,
  url: productUrl,
  image: productImageUrl,
  category: categoryInfo?.label,
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: "Inicio", url: "https://bacsi.thenextpangea.com/" },
  { name: "Productos", url: "https://bacsi.thenextpangea.com/productos/" },
  { name: product.name, url: productUrl },
]);
---

<Layout
  title="DxTER · TheNextPangea"
  description="Plataforma de optimización paramétrica con IA para acelerar la validación, exploración de alternativas y decisión técnica en sistemas complejos bajo restricciones reales."
  ogImage={product.heroImage}
  ogType="product"
>
  <Fragment slot="structured-data">
    <JsonLd data={productJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="DxTER"
      backgroundImage={`${base}images/dxter-bg.png`}
      tags={heroTags}
      titleI18n="dxter.hero.title"
      subtitle="Acelera la toma de decisiones en entornos complejos mediante modelos con estimación de incertidumbre y selección inteligente de candidatos."
      subtitleI18n="dxter.hero.subtitle"
      chips={heroChips}
      backI18n="dxter.hero.back"
      ctaPrimaryI18n="dxter.hero.cta.primary"
    >
      <span class="product-gradient-text">Optimización inteligente</span> para sistemas complejos bajo restricciones reales
    </ProductHero>

    <!-- ════════════════ EL RETO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#d5f5f3]/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="dxter.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="dxter.challenge.title">
            Optimizar cuando el espacio de decisión es <span class="product-gradient-text">inabarcable</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="dxter.challenge.p1">
              En numerosos procesos técnicos y estratégicos, la decisión no depende de una sola variable, sino de <strong class="font-semibold">decenas de parámetros interdependientes</strong> que deben ajustarse simultáneamente bajo restricciones reales.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="dxter.challenge.p2">Tiempo disponible, recursos limitados, requisitos de seguridad, rendimiento esperado o coste operativo actúan como condicionantes que reducen el margen de error.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="dxter.challenge.p3">Cuando además existen <strong class="font-semibold text-slate-700">múltiples objetivos</strong>, como maximizar rendimiento, minimizar coste, reducir riesgo o mejorar disponibilidad, el espacio de búsqueda crece de forma exponencial.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="dxter.challenge.p4">Explorar manualmente todas las combinaciones no es viable. Y avanzar mediante ensayo–error implica ciclos largos, alto coste y riesgo. La necesidad no es solo decidir: es <strong class="font-semibold text-slate-700">encontrar la solución óptima de forma acelerada y fundamentada</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="mb-6 reveal">
            <SectionLabel label="La solución" i18nKey="dxter.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
            <div class="flex-1 reveal delay-100">
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-6" data-i18n-html="dxter.solution.title">
                Exploración y optimización <span class="product-gradient-text">inteligente</span> del espacio de soluciones
              </h3>
              <div class="space-y-4">
                <p class="text-base leading-relaxed text-slate-500" data-i18n-html="dxter.solution.p1"><strong class="font-semibold text-slate-700">DxTER</strong> es una plataforma basada en Inteligencia Artificial diseñada para <strong class="font-semibold text-slate-700">acelerar la búsqueda de configuraciones óptimas</strong> en problemas con múltiples parámetros y múltiples objetivos.</p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="dxter.solution.p2">En lugar de evaluar alternativas de forma secuencial o manual, DxTER modeliza el comportamiento del sistema, estima la incertidumbre asociada y propone de forma iterativa las combinaciones más prometedoras dentro del espacio de decisión.</p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="dxter.solution.p3">Esto permite reducir drásticamente el número de ensayos necesarios, evaluar compromisos entre objetivos contrapuestos y converger más rápido hacia soluciones viables y óptimas.</p>
                <p class="text-base leading-relaxed text-slate-500" data-i18n="dxter.solution.p4">Es aplicable a la optimización de procesos, ajuste estratégico de configuraciones, diseño experimental avanzado y validación paramétrica en entornos simulados.</p>
              </div>
            </div>

            <div class="flex-shrink-0 w-full lg:w-6/12 reveal delay-200">
              <WorkflowInfographic accent={ACCENT} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ CÓMO FUNCIONA ════════════════ -->
    <section id="como-funciona" class="relative py-24 sm:py-32 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 md:mb-20 max-w-2xl mx-auto">
          <SectionLabel label="Proceso de optimización" i18nKey="dxter.process.label" class="mx-auto mb-5 reveal" />
          <h2 class="reveal text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800" data-i18n-html="dxter.process.title">
            Cómo <span class="product-gradient-text">funciona</span>
          </h2>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
          <!-- Steps -->
          <div class="flex-1 space-y-10">
            {[
              { i18nTitle: "dxter.process.step1.title", title: "Capturar evidencias", i18nDesc: "dxter.process.step1.desc", desc: "Integra resultados observados (ensayos, simulaciones o métricas operativas) y define variables, restricciones y objetivos. El sistema estructura el espacio de búsqueda en torno a factores medibles y respuestas cuantificables." },
              { i18nTitle: "dxter.process.step2.title", title: "Construir un modelo con incertidumbre", i18nDesc: "dxter.process.step2.desc", desc: "Ajusta un modelo probabilístico (Proceso Gaussiano) que actúa como modelo sustituto del sistema real. Este modelo permite predecir resultados en configuraciones no evaluadas y cuantificar explícitamente la incertidumbre en regiones poco exploradas." },
              { i18nTitle: "dxter.process.step3.title", title: "Optimización bayesiana y selección de candidatos", i18nDesc: "dxter.process.step3.desc", desc: "Optimiza una función de adquisición que equilibra exploración (incertidumbre) y explotación (rendimiento previsto). El sistema propone las configuraciones más informativas y viables bajo las restricciones operativas definidas." },
            ].map((step, i) => (
              <div class={`reveal ${i > 0 ? `delay-${i}00` : ''} flex gap-5 product-step-card`} data-viz-step={String(i)}>
                <div
                  class="flex-shrink-0 w-16 h-16 rounded-2xl flex items-center justify-center text-2xl font-extrabold text-white shadow-lg"
                  style={`background: ${ACCENT}; box-shadow: 0 4px 14px ${ACCENT}33;`}
                >
                  {i + 1}
                </div>
                <div>
                  <h3 class="text-lg font-bold text-slate-800 mb-2" data-i18n={step.i18nTitle}>{step.title}</h3>
                  <p class="text-sm text-slate-500 leading-relaxed" data-i18n={step.i18nDesc}>{step.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Canvas visualization -->
          <div class="flex-shrink-0 w-full lg:w-5/12">
            <div class="reveal product-glass rounded-2xl p-6">
              <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6 text-center" data-i18n="dxter.process.viz.title">
                Proceso de decisión (visualización)
              </h4>
              <div class="relative">
                <canvas id="dxter-viz-canvas" class="w-full rounded-xl" style="aspect-ratio: 16/9;"></canvas>
                <div class="absolute top-3 left-4">
                  <span id="dxter-viz-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-600"></span>
                </div>
              </div>
              <div class="mt-5 flex justify-center gap-3">
                <button class="dxter-viz-dot w-2.5 h-2.5 rounded-full transition-all duration-300" data-step="0" aria-label="Paso 1"></button>
                <button class="dxter-viz-dot w-2.5 h-2.5 rounded-full transition-all duration-300" data-step="1" aria-label="Paso 2"></button>
                <button class="dxter-viz-dot w-2.5 h-2.5 rounded-full transition-all duration-300" data-step="2" aria-label="Paso 3"></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ THE OPTIMIZATION GAME ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden" id="optimization-game">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="reveal max-w-4xl mx-auto product-card !p-8 md:!p-12 relative overflow-hidden">
          <div class="absolute inset-0 pointer-events-none" style={`background: radial-gradient(600px 220px at 10% 20%, ${ACCENT}14 0%, transparent 60%);`}></div>
          <div class="relative flex flex-col md:flex-row items-center gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <span class="product-section-label !text-[10px] !py-1 !px-3"><span data-i18n="dxter.game.label">Demo interactiva</span></span>
                <span class="text-sm font-semibold" style={`color: ${ACCENT};`}><span data-i18n="dxter.game.name">The Optimization Game</span></span>
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-slate-800 mb-4" data-i18n="dxter.game.title">
                Entiende DxTER en 60 segundos: encuentra la solución óptima con presupuesto limitado
              </h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n="dxter.game.desc">Un mini-juego tipo grid con dificultad creciente que te enfrenta a un espacio de búsqueda amplio y recursos limitados. Cada nivel aumenta la complejidad y obliga a decidir dónde probar para converger hacia una solución única y óptima.</p>
            </div>
            <div class="flex-shrink-0">
              <a href="https://game.dxter.ai/" target="_blank" rel="noopener noreferrer" class="btn-product !font-bold !text-sm !tracking-wide !uppercase">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                <span data-i18n="dxter.game.cta">Abrir juego</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ DEFENSA (BACSI) ════════════════ -->
    <BacsiApplications
      accent={ACCENT}
      i18nPrefix="dxter"
      titleI18n="dxter.defense.title"
      labelI18n="dxter.defense.label"
      applications={aplicacionesBacsi}
      featuredItem={simulacionAvanzada}
      featuredI18nKey="sim"
      bgClass="bg-white"
    />

    <!-- ════════════════ CTA ════════════════ -->
    <ProductCTA
      accent={ACCENT}
      productName="DxTER"
      i18nPrefix="dxter"
      description="Podemos preparar una demo guiada con tus variables, restricciones y objetivos, y estimar el impacto en tiempo, coste y número de ensayos."
      bgClass="bg-[#f5f7fa]"
    />

  </ProductPageWrapper>
</Layout>

<!-- Dxter-specific scoped styles (canvas viz dots) -->
<style>
  .dxter-viz-dot {
    background: rgba(148, 163, 184, 0.4);
  }
</style>

<script define:vars={{ accent: ACCENT }}>
  // ══════════════════════════════════════════════════════
  // "Cómo funciona" — Proceso de decisión visualization
  // ══════════════════════════════════════════════════════
  (function () {
    const canvas = document.getElementById("dxter-viz-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    const label = document.getElementById("dxter-viz-label");
    const dots = Array.from(document.querySelectorAll(".dxter-viz-dot"));

    const ACCENT = accent;
    let labels = [
      "Paso 1 — Datos observados",
      "Paso 2 — Modelo + incertidumbre",
      "Paso 3 — Función de adquisición",
    ];

    window.addEventListener("locale-changed", (e) => {
      const loc = (e.detail && e.detail.locale) || "es";
      const t = window.__pangea_translations;
      if (t && t[loc]) {
        labels = [
          t[loc]["dxter.canvas.label0"] || labels[0],
          t[loc]["dxter.canvas.label1"] || labels[1],
          t[loc]["dxter.canvas.label2"] || labels[2],
        ];
        if (typeof updateDots === "function") updateDots();
      }
    });

    let W, H, dpr;
    let currentStep = 0;
    let progress = 0;
    let animFrame;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function hexToRgb(hex) {
      return {
        r: parseInt(hex.slice(1, 3), 16),
        g: parseInt(hex.slice(3, 5), 16),
        b: parseInt(hex.slice(5, 7), 16),
      };
    }
    const accentRgb = hexToRgb(ACCENT);

    const dataPoints = [
      { x: 0.08, y: 0.65 },
      { x: 0.22, y: 0.42 },
      { x: 0.35, y: 0.55 },
      { x: 0.52, y: 0.28 },
      { x: 0.68, y: 0.48 },
      { x: 0.82, y: 0.35 },
      { x: 0.92, y: 0.58 },
    ];

    function gpMean(t) {
      return (
        0.55 -
        0.15 * Math.sin(t * Math.PI * 2.2) -
        0.08 * Math.cos(t * Math.PI * 4.5 + 1) +
        0.05 * Math.sin(t * Math.PI * 6)
      );
    }
    function gpStd(t) {
      let minDist = 1;
      for (const p of dataPoints)
        minDist = Math.min(minDist, Math.abs(t - p.x));
      return 0.04 + 0.12 * Math.min(1, minDist * 4);
    }
    function acqFn(t) {
      return gpStd(t) * 1.8 + (1 - gpMean(t)) * 0.3;
    }

    function drawBg() {
      ctx.fillStyle = "#ffffff";
      ctx.beginPath();
      ctx.roundRect(0, 0, W, H, 12);
      ctx.fill();
      ctx.strokeStyle = "rgba(0,0,0,0.06)";
      ctx.lineWidth = 1;
      const step = 40;
      for (let x = step; x < W; x += step) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, H);
        ctx.stroke();
      }
      for (let y = step; y < H; y += step) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
      }
    }

    function tx(v) {
      return 40 + v * (W - 80);
    }
    function ty(v) {
      return 30 + v * (H - 60);
    }
    function easeOut(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function drawStep0(p) {
      const count =
        Math.floor(p * dataPoints.length) + (p >= 1 ? 0 : 1);
      for (let i = 0; i < Math.min(count, dataPoints.length); i++) {
        const dp = dataPoints[i];
        const appear = Math.min(1, (p * dataPoints.length - i) * 2);
        const scale = easeOut(Math.min(1, appear));
        const r = 6 * scale;
        const grad = ctx.createRadialGradient(
          tx(dp.x), ty(dp.y), 0, tx(dp.x), ty(dp.y), r * 4
        );
        grad.addColorStop(
          0,
          `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.25 * appear})`
        );
        grad.addColorStop(1, "transparent");
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(tx(dp.x), ty(dp.y), r * 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = ACCENT;
        ctx.beginPath();
        ctx.arc(tx(dp.x), ty(dp.y), r, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = `rgba(255,255,255,${0.8 * appear})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(tx(dp.x), ty(dp.y), r + 2, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    function drawStep1(p) {
      drawStep0(1);
      const ep = easeOut(p);
      const steps = 120;
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        if (i === 0) ctx.moveTo(tx(t), ty(gpMean(t) - gpStd(t) * ep));
        else ctx.lineTo(tx(t), ty(gpMean(t) - gpStd(t) * ep));
      }
      for (let i = steps; i >= 0; i--) {
        const t = i / steps;
        ctx.lineTo(tx(t), ty(gpMean(t) + gpStd(t) * ep));
      }
      ctx.closePath();
      ctx.fillStyle = `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.12 * ep})`;
      ctx.fill();
      ctx.beginPath();
      ctx.lineWidth = 3;
      ctx.strokeStyle = `rgba(${accentRgb.r},${accentRgb.g},${accentRgb.b},${0.9 * ep})`;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        if (i === 0) ctx.moveTo(tx(t), ty(gpMean(t)));
        else ctx.lineTo(tx(t), ty(gpMean(t)));
      }
      ctx.stroke();
    }

    function drawStep2(p) {
      drawStep1(1);
      const ep = easeOut(p);
      const steps = 120;
      ctx.beginPath();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = `rgba(255,180,60,${0.8 * ep})`;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const yPos = ty(0.85 - acqFn(t) * 0.6 * ep);
        if (i === 0) ctx.moveTo(tx(t), yPos);
        else ctx.lineTo(tx(t), yPos);
      }
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const yPos = ty(0.85 - acqFn(t) * 0.6 * ep);
        if (i === 0) ctx.moveTo(tx(t), yPos);
        else ctx.lineTo(tx(t), yPos);
      }
      ctx.lineTo(tx(1), ty(0.85));
      ctx.lineTo(tx(0), ty(0.85));
      ctx.closePath();
      ctx.fillStyle = `rgba(255,180,60,${0.06 * ep})`;
      ctx.fill();
      if (p > 0.5) {
        const cAlpha = easeOut((p - 0.5) * 2);
        for (const cx of [0.15, 0.45]) {
          const cy = 0.85 - acqFn(cx) * 0.6;
          const glowR = 14 + 4 * Math.sin(Date.now() / 400);
          const grad = ctx.createRadialGradient(
            tx(cx), ty(cy), 0, tx(cx), ty(cy), glowR
          );
          grad.addColorStop(
            0,
            `rgba(255,180,60,${0.5 * cAlpha})`
          );
          grad.addColorStop(1, "transparent");
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(tx(cx), ty(cy), glowR, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = `rgba(255,180,60,${cAlpha})`;
          ctx.beginPath();
          const s = 6;
          ctx.moveTo(tx(cx), ty(cy) - s);
          ctx.lineTo(tx(cx) + s, ty(cy));
          ctx.lineTo(tx(cx), ty(cy) + s);
          ctx.lineTo(tx(cx) - s, ty(cy));
          ctx.closePath();
          ctx.fill();
        }
      }
    }

    function updateDots() {
      dots.forEach((d, i) => {
        if (i === currentStep) {
          d.style.background = ACCENT;
          d.style.boxShadow = `0 0 0 4px ${ACCENT}30`;
          d.style.transform = "scale(1.3)";
        } else {
          d.style.background = "rgba(148,163,184,0.4)";
          d.style.boxShadow = "none";
          d.style.transform = "scale(1)";
        }
      });
      if (label) label.textContent = labels[currentStep];
    }

    let lastTime = 0;
    const STEP_DURATION = 3500;
    const ANIM_DURATION = 1200;
    let stepStartTime = 0;
    let hoverPaused = false;

    function animate(time) {
      if (!lastTime) {
        lastTime = time;
        stepStartTime = time;
      }
      const elapsed = time - stepStartTime;
      progress = Math.min(1, elapsed / ANIM_DURATION);

      resize();
      drawBg();

      if (currentStep === 0) drawStep0(progress);
      else if (currentStep === 1) drawStep1(progress);
      else drawStep2(progress);

      if (elapsed > STEP_DURATION && !hoverPaused) {
        currentStep = (currentStep + 1) % 3;
        stepStartTime = time;
        progress = 0;
        updateDots();
        updateStepCards();
      }
      animFrame = requestAnimationFrame(animate);
    }

    dots.forEach((d, i) => {
      d.addEventListener("click", () => {
        currentStep = i;
        stepStartTime = performance.now();
        progress = 0;
        updateDots();
        updateStepCards();
      });
    });

    const stepCards = document.querySelectorAll(
      ".product-step-card[data-viz-step]"
    );

    function updateStepCards() {
      stepCards.forEach((card) => {
        const idx = parseInt(card.getAttribute("data-viz-step"));
        card.classList.toggle("product-step-active", idx === currentStep);
      });
    }

    stepCards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        const step = parseInt(card.getAttribute("data-viz-step"));
        hoverPaused = true;
        currentStep = step;
        stepStartTime = performance.now();
        progress = 0;
        updateDots();
        updateStepCards();
      });
      card.addEventListener("mouseleave", () => {
        hoverPaused = false;
        stepStartTime = performance.now();
      });
    });

    updateStepCards();

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );
    if (!prefersReduced.matches) {
      updateDots();
      animFrame = requestAnimationFrame(animate);
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) cancelAnimationFrame(animFrame);
      else {
        lastTime = 0;
        animFrame = requestAnimationFrame(animate);
      }
    });
  })();
</script>
