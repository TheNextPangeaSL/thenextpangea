    border-color: color-mix(in srgb, var(--accent) 40%, #d1d5db);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  #buscai-flow .buscai-step-n {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  #buscai-flow .buscai-step-t {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    line-height: 1.3;
  }

  /* ── Slide stage ─────────────────────────────────── */
  #buscai-flow .buscai-stage {
    max-width: 900px;
    margin: 28px auto 0 auto;
    min-height: 610px;
    position: relative;
  }

  #buscai-flow .buscai-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  #buscai-flow .buscai-slide.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  #buscai-flow .buscai-slide-media {
    background: #f3f4f6;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
  }

  #buscai-flow .buscai-slide-media img {
    width: 100%;
    height: 380px;
    object-fit: contain;
    object-position: center center;
    display: block;
    background: #f3f4f6;
  }

  #buscai-flow .buscai-slide-text {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
  }

  #buscai-flow .buscai-badge {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: white;
