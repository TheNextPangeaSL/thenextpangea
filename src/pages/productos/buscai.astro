---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("buscai")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #D4A017 */
const ACCENT_LIGHT = "#E8C547";
const ACCENT_DARK = "#B8860B";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia artificial", i18nKey: "buscai.hero.tag1" },
  { label: "Gestión del conocimiento", i18nKey: "buscai.hero.tag2" },
];

const heroChips = [
  { label: "Arquitectura RAG", i18nKey: "buscai.hero.chip1" },
  { label: "Comprensión visual documental", i18nKey: "buscai.hero.chip2" },
  { label: "On-premise", i18nKey: "buscai.hero.chip3" },
];

/* ── Slider steps ──────────────────────────────────── */
const sliderSteps = [
  {
    num: "01",
    label: "Incidencia en mantenimiento",
    image: `${base}images/buscai-problema.png`,
    imageAlt: "Técnico de mantenimiento con una duda técnica entre manuales y documentación",
    badge: "Paso 1 · Incidencia en mantenimiento",
    title: "La duda es muy específica. La documentación, enorme.",
    desc: "El técnico necesita un dato muy concreto dentro de manuales y procedimientos extensos. La información existe, pero localizarla manualmente ralentiza la intervención.",
  },
  {
    num: "02",
    label: "Consulta a BUSCAI",
    image: `${base}images/buscai-solucion.png`,
    imageAlt: "Técnico de mantenimiento con la idea de usar BUSCAI",
    badge: "Paso 2 · Consulta a BUSCAI",
    title: "La búsqueda se convierte en una conversación natural",
    desc: "En lugar de buscar documento a documento, plantea la duda directamente a BUSCAI mediante una interacción natural.",
  },
  {
    num: "03",
    label: "Comprensión documental",
    image: `${base}images/buscai-procesamiento.jpg`,
    imageAlt: "Procesamiento estructural de una página técnica por BUSCAI",
    badge: "Paso 3 · Comprensión documental",
    title: "BUSCAI no solo indexa texto: comprende el documento completo",
    desc: "La plataforma procesa texto, tablas, figuras y diagramas, preservando el contexto para recuperar conocimiento útil con precisión.",
  },
  {
    num: "04",
    label: "Respuesta operativa",
    image: `${base}images/buscai-chat.png`,
    imageAlt: "Interfaz de chat de BUSCAI respondiendo a una consulta técnica",
    badge: "Paso 4 · Respuesta operativa",
    title: "Respuesta precisa, trazable y dentro de un entorno seguro",
    desc: "BUSCAI responde en segundos y enlaza a la fuente original, manteniendo la documentación dentro del entorno seguro del cliente.",
  },
];

/* ── Metric cards ──────────────────────────────────── */
const metricCards = [
  { kicker: "Seguridad", title: "100% on-premise", copy: "La documentación puede permanecer dentro de la infraestructura del cliente." },
  { kicker: "Comprensión", title: "Texto + tablas + figuras", copy: "Interpreta estructuras documentales complejas y no solo texto plano." },
  { kicker: "Trazabilidad", title: "Respuesta con fuente", copy: "Cada respuesta puede vincularse directamente a la documentación original." },
  { kicker: "Operatividad", title: "Menos tiempo de búsqueda", copy: "Reduce búsquedas manuales y acelera la resolución de dudas técnicas." },
];

/* ── Application cards ─────────────────────────────── */
const applicationCards = [
  {
    title: "Consulta operativa de documentación técnica",
    desc: "Acceso en lenguaje natural a manuales, procedimientos, boletines técnicos e informes, reduciendo tiempos de búsqueda y facilitando la localización de información crítica en entornos operativos.",
  },
  {
    title: "Soporte a mantenimiento y sostenimiento",
    desc: "Recuperación ágil de procedimientos, esquemas, tablas y documentación histórica para acelerar diagnósticos, intervenciones MRO y operaciones de sostenimiento con mayor trazabilidad.",
  },
  {
    title: "Explotación segura del conocimiento interno",
    desc: "Conversión de repositorios documentales en bases de conocimiento interactivas bajo control de la organización, con despliegue on-premise para entornos sensibles o clasificados.",
  },
];

/* ── BACSI coverage cards ──────────────────────────── */
const bacsiCards = [
  { code: "AF3", title: "GIC y optimización de procesos", desc: "Explotación ágil del conocimiento documental para mejorar procesos, acceso a información y toma de decisiones." },
  { code: "AF5", title: "Seguridad en la operación", desc: "Consulta rápida de procedimientos críticos, instrucciones y documentación operativa en escenarios sensibles." },
  { code: "AF6", title: "Sostenimiento 4.0", desc: "Acceso inteligente a manuales de mantenimiento, históricos técnicos y documentación de soporte a flota." },
];
---

<Layout
  title="BUSCAI · TheNextPangea"
  description="Plataforma de recuperación inteligente de información técnica basada en arquitecturas RAG que transforma repositorios documentales en bases de conocimiento interactivas."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="BUSCAI"
      tags={heroTags}
      tagSeparator="·"
      subtitle="BuscAI transforma repositorios documentales complejos en una base de conocimiento interactiva, permitiendo consultar manuales, procedimientos y documentación técnica directamente en lenguaje natural, con máxima precisión y trazabilidad hacia la fuente original."
      chips={heroChips}
      backgroundImage={`${base}images/buscai-bg.png`}
    >
      Plataforma de recuperación inteligente de información técnica
    </ProductHero>


    <!-- ════════════════ EL RETO OPERATIVO ════════════════ -->
    <section class="relative py-20 lg:py-28 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="bg-white border border-gray-200 rounded-lg p-8 md:p-12 shadow-sm relative overflow-hidden reveal">
          <!-- Left accent bar -->
          <div class="absolute left-0 top-0 bottom-0 w-1.5" style={`background: ${ACCENT};`}></div>

          <div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4 pl-4">
            El reto operativo
          </div>

          <div class="pl-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-6 leading-snug">
              Explotar conocimiento técnico disperso en grandes repositorios documentales
            </h2>

            <div class="max-w-4xl space-y-4 text-gray-700 leading-relaxed">
              <p>
                En entornos industriales y operativos, gran parte del conocimiento crítico reside en
                <strong>manuales técnicos, procedimientos, diagramas, tablas e informes históricos</strong>,
                distribuidos en grandes volúmenes de documentación heterogénea.
              </p>
              <p>
                Localizar la información adecuada en el momento preciso suele requerir
                <strong>búsquedas manuales lentas, revisión de múltiples fuentes y validación cruzada</strong>,
                lo que penaliza la eficiencia operativa y retrasa la toma de decisiones.
              </p>
              <p>
                Los sistemas tradicionales basados únicamente en OCR no son suficientes cuando la información
                relevante está embebida en <strong>estructuras complejas, layouts técnicos o relaciones visuales</strong>
                entre tablas, esquemas y bloques documentales.
              </p>
              <p>
                El desafío no es solo digitalizar documentos, sino
                <strong>convertirlos en conocimiento accesible, contextualizado y trazable</strong>
                para su explotación ágil en escenarios reales de operación y mantenimiento.
              </p>
            </div>
          </div>
        </div>

        <!-- ── LA SOLUCIÓN ── -->
        <div class="mt-14 reveal delay-100">
          <div class="flex items-center gap-4 mb-8">
            <h3 class="text-sm font-bold uppercase tracking-wider" style={`color: ${ACCENT};`}>
              La solución
            </h3>
            <div class="h-px bg-gray-200 flex-1"></div>
          </div>

          <div class="max-w-4xl">
            <h4 class="text-xl md:text-2xl font-semibold text-gray-900 mb-5">
              La forma segura de convertir documentación compleja en respuestas operativas
            </h4>

            <div class="max-w-none space-y-5 text-gray-700 leading-relaxed">
              <p>
                <strong>BUSCAI</strong> es una plataforma de recuperación de información híbrida que transforma
                repositorios documentales estáticos en <strong>bases de conocimiento interactivas</strong>,
                consultables directamente en lenguaje natural.
              </p>
              <p>
                La solución se apoya en arquitecturas <strong>RAG (Retrieval-Augmented Generation)</strong>,
                combinando recuperación semántica, búsqueda textual clásica y orquestación mediante
                <strong>Grandes Modelos de Lenguaje (LLM)</strong> para ofrecer respuestas precisas listas para su uso operativo.
              </p>
              <p>
                A diferencia de los enfoques OCR convencionales, BUSCAI incorpora
                <strong>visión por computador y técnicas de Deep Learning</strong> para analizar el layout documental,
                interpretar tablas, diagramas y estructuras complejas, y preservar el contexto espacial y semántico
                de la información técnica.
              </p>
              <p>
                Esta aproximación permite reducir drásticamente los tiempos de búsqueda manual, eliminar horas improductivas
                y mejorar la capacidad de respuesta de los equipos, especialmente en entornos donde el acceso rápido a
                procedimientos críticos impacta directamente en la operatividad.
              </p>
              <p>
                La plataforma ha sido concebida bajo una arquitectura <strong>Privacy-First</strong>: los documentos
                originales permanecen bajo control de la organización, habilitando despliegues
                <strong>100% on-premise</strong> para datos sensibles o clasificados, así como esquemas híbridos con
                fragmentos anonimizados cuando el contexto lo permite.
              </p>
              <p>
                Su diseño modular y escalable permite adaptar dinámicamente la capacidad de proceso según la carga operativa
                de cada componente, garantizando <strong>rendimiento, confidencialidad y trazabilidad completa hacia la fuente original</strong>.
              </p>
            </div>
          </div>

          <!-- ── 4-STEP SLIDER ── -->
          <div class="mt-12 max-w-5xl mx-auto">
            <div class="relative rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden" id="buscai-flow">

              <!-- Header -->
              <div class="px-5 pt-5 pb-4 border-b border-gray-100 bg-gray-50/70">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-500 mb-1">
                      Flujo de uso
                    </div>
                    <div class="text-lg md:text-xl font-semibold text-gray-900 max-w-3xl">
                      De una duda técnica a una respuesta trazable, segura y lista para actuar
                    </div>
                  </div>

                  <div class="hidden sm:flex items-center gap-2">
                    <button type="button"
                            class="buscai-nav h-9 w-9 inline-flex items-center justify-center rounded-full border border-gray-200 text-gray-500 hover:text-gray-900 hover:border-gray-300 transition cursor-pointer"
                            data-dir="-1"
                            aria-label="Paso anterior">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                    </button>
                    <button type="button"
                            class="buscai-nav h-9 w-9 inline-flex items-center justify-center rounded-full border border-gray-200 text-gray-500 hover:text-gray-900 hover:border-gray-300 transition cursor-pointer"
                            data-dir="1"
                            aria-label="Paso siguiente">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Step pills -->
              <div class="px-5 pt-4">
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                  {sliderSteps.map((step, i) => (
                    <button class={`buscai-step-btn${i === 0 ? " active" : ""}`} data-step={i} type="button">
                      <span class="buscai-step-n">{step.num}</span>
                      <span class="buscai-step-t">{step.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- Slides -->
              <div class="px-5 pt-5 pb-5">
                <div class="relative buscai-stage">
                  {sliderSteps.map((step, i) => (
                    <article class={`buscai-slide${i === 0 ? " active" : ""}`} data-step={i}>
                      <div class="buscai-slide-media">
                        <img src={step.image} alt={step.imageAlt} loading={i === 0 ? "eager" : "lazy"} />
                      </div>
                      <div class="buscai-slide-text">
                        <div class="buscai-badge">{step.badge}</div>
                        <h5 class="buscai-title">{step.title}</h5>
                        <p class="buscai-desc">{step.desc}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ VALOR DIFERENCIAL ════════════════ -->
    <section class="relative py-20 lg:py-24 bg-white overflow-hidden" id="highlights">
      <div class="max-w-6xl mx-auto px-6 sm:px-10">

        <!-- Header -->
        <div class="flex items-center gap-4 mb-10 reveal">
          <div class="h-px bg-gray-200 flex-1"></div>
          <h2 class="text-sm font-bold uppercase tracking-widest text-center" style={`color: ${ACCENT};`}>
            Valor diferencial
          </h2>
          <div class="h-px bg-gray-200 flex-1"></div>
        </div>

        <div class="relative overflow-hidden rounded-3xl border border-gray-200 bg-gray-50/70 p-6 md:p-8 lg:p-10 reveal delay-100">
          <!-- Decorative glow -->
          <div class="absolute inset-0 opacity-20 pointer-events-none"
               style={`background: radial-gradient(circle at 18% 20%, color-mix(in srgb, ${ACCENT} 30%, transparent) 0%, transparent 42%), radial-gradient(circle at 86% 78%, color-mix(in srgb, ${ACCENT} 18%, transparent) 0%, transparent 36%);`}>
          </div>

          <div class="relative">
            <!-- Intro -->
            <div class="max-w-3xl mb-8 lg:mb-10">
              <div class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500 mb-3">
                Capacidades clave
              </div>
              <h3 class="text-2xl md:text-3xl font-semibold tracking-tight text-gray-900 mb-4">
                Inteligencia documental segura, trazable y preparada para operación real
              </h3>
              <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                BUSCAI combina comprensión visual documental, recuperación híbrida y despliegue seguro
                para transformar repositorios técnicos complejos en conocimiento accesible y accionable.
              </p>
            </div>

            <!-- Metric cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5">
              {metricCards.map((card) => (
                <article class="buscai-metric-card">
                  <div class="buscai-metric-kicker">{card.kicker}</div>
                  <div class="buscai-metric-title">{card.title}</div>
                  <p class="buscai-metric-copy">{card.copy}</p>
                </article>
              ))}
            </div>

            <!-- Value block -->
            <div class="mt-6 lg:mt-8 buscai-value-panel">
              <div class="buscai-value-kicker">Valor diferencial</div>
              <p class="buscai-value-text">
                <strong>BUSCAI no es un buscador documental convencional.</strong>
                Comprende documentación técnica compleja, procesa texto y elementos visuales, preserva el contexto
                de cada página y permite responder preguntas operativas con trazabilidad a la fuente, en un
                <strong>entorno seguro donde la información permanece bajo control del cliente</strong>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ APLICACIONES ════════════════ -->
    <section class="relative py-20 lg:py-24 bg-white overflow-hidden" id="aplicaciones">
      <div class="max-w-6xl mx-auto px-6 sm:px-10">

        <!-- Header -->
        <div class="flex items-center gap-4 mb-10 reveal">
          <div class="h-px bg-gray-200 flex-1"></div>
          <h2 class="text-sm font-bold text-slate-800 uppercase tracking-widest text-center">
            Aplicaciones
          </h2>
          <div class="h-px bg-gray-200 flex-1"></div>
        </div>

        <!-- Application cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal delay-100">
          {applicationCards.map((card) => (
            <div class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm hover:shadow-md transition">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{card.title}</h3>
              <p class="text-sm text-gray-700 leading-relaxed">{card.desc}</p>
            </div>
          ))}
        </div>

        <!-- BACSI banner -->
        <div class="mt-12 relative overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-8 reveal delay-200">
          <div class="absolute inset-0 opacity-20 pointer-events-none"
               style={`background: radial-gradient(circle at 20% 30%, ${ACCENT} 0%, transparent 55%);`}>
          </div>

          <div class="relative">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-6">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
                  Cobertura en BACSI
                </div>
                <div class="text-xl font-semibold text-gray-900">
                  Casos de uso alineados con áreas funcionales
                </div>
              </div>
              <div class="hidden lg:block h-px bg-gray-200 flex-1"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
              {bacsiCards.map((card) => (
                <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition">
                  <div class="text-xs font-bold tracking-wider text-gray-500 mb-1">{card.code}</div>
                  <div class="text-sm font-semibold text-gray-900">{card.title}</div>
                  <div class="text-xs text-gray-600 mt-1">{card.desc}</div>
                </div>
              ))}
            </div>

            <div class="border-l-2 pl-4 text-sm text-gray-700"
                 style={`border-color: ${ACCENT};`}>
              <strong>BUSCAI</strong> convierte documentación técnica compleja en conocimiento operativo accesible,
              trazable y seguro, acelerando la consulta de procedimientos, el soporte a mantenimiento y la explotación
              eficiente del conocimiento en entornos BACSI.
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ════════════════ CTA ════════════════ -->
    <section class="relative py-20 lg:py-28 overflow-hidden" style="background: #0F172A;">
      <div class="max-w-4xl mx-auto px-6 sm:px-10 text-center relative z-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 tracking-tight text-white">
          ¿Quieres transformar tu documentación en conocimiento accesible?
        </h2>
        <p class="text-lg text-blue-100 leading-relaxed mb-10 max-w-2xl mx-auto font-light">
          Podemos desplegar BUSCAI sobre tus repositorios documentales y preparar una demostración adaptada a tus
          manuales técnicos, procedimientos operativos y casos de uso reales.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={`${base}#contact`}
             class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold tracking-wide text-[#0F172A] bg-white hover:bg-blue-50 transition-all rounded-sm shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
            Contactar
          </a>
          <button
            type="button"
            disabled
            class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold tracking-wide text-white bg-white/10 hover:bg-white/15 border border-white/15 transition-all rounded-sm cursor-not-allowed opacity-60">
            Descargar dossier
          </button>
        </div>
      </div>
    </section>

  </ProductPageWrapper>
</Layout>

<style>
  /* ── Slider step buttons ─────────────────────────── */
  #buscai-flow .buscai-step-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #fff;
    transition: all 0.25s ease;
    text-align: left;
    cursor: pointer;
  }

  #buscai-flow .buscai-step-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, #d1d5db);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  #buscai-flow .buscai-step-btn.active {
    background: color-mix(in srgb, var(--accent) 8%, white);
    border-color: color-mix(in srgb, var(--accent) 40%, #d1d5db);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  #buscai-flow .buscai-step-n {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  #buscai-flow .buscai-step-t {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    line-height: 1.3;
  }

  /* ── Slide stage ─────────────────────────────────── */
  #buscai-flow .buscai-stage {
    max-width: 900px;
    margin: 28px auto 0 auto;
    min-height: 610px;
    position: relative;
  }

  #buscai-flow .buscai-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  #buscai-flow .buscai-slide.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  #buscai-flow .buscai-slide-media {
    background: #f3f4f6;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
  }

  #buscai-flow .buscai-slide-media img {
    width: 100%;
    height: 380px;
    object-fit: contain;
    object-position: center center;
    display: block;
    background: #f3f4f6;
  }

  #buscai-flow .buscai-slide-text {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
  }

  #buscai-flow .buscai-badge {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: white;
    padding: 6px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 78%, rgba(255, 255, 255, 0.08));
    margin-bottom: 10px;
  }

