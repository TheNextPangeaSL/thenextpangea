  }
  .buscai-arch-arrow {
    opacity: 0;
    animation: buscai-arch-arrow-in 0.4s ease forwards;
    animation-delay: 0.3s;
  }
  @keyframes buscai-arch-arrow-in {
    from { opacity: 0; }
    to   { opacity: 0.5; }
  }

  /* ── Chat messages entrance ─────────────────────── */
  .buscai-chat-msg {
    opacity: 0;
    animation: buscai-chat-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes buscai-chat-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Chat steps stagger ─────────────────────────── */
  .buscai-chat-step {
    opacity: 0;
    animation: buscai-step-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes buscai-step-in {
    from { opacity: 0; transform: translateX(-8px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── Typing dots ────────────────────────────────── */
  .buscai-typing-dot {
    animation: buscai-typing 1.4s infinite;
  }
  @keyframes buscai-typing {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30%           { opacity: 1; transform: translateY(-3px); }
  }

  /* ── Chat scrollbar ─────────────────────────────── */
  .buscai-chat-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .buscai-chat-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .buscai-chat-scroll::-webkit-scrollbar-thumb {
    background: rgba(124, 58, 237, 0.3);
    border-radius: 999px;
  }

  /* ── Feature card hover line ────────────────────── */
  .buscai-feature-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 3px;
    height: 60%;
    border-radius: 999px;
    background: #7C3AED;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .buscai-feature-card:hover::before {
