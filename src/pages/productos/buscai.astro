---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("buscai")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #7C3AED */
const ACCENT_LIGHT = "#A78BFA";
const ACCENT_DARK = "#5B21B6";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia Artificial", i18nKey: "buscai.hero.tag1" },
  { label: "RAG Pipeline", i18nKey: "buscai.hero.tag2" },
  { label: "NLP / LLM", i18nKey: "buscai.hero.tag3" },
];

const heroChips = [
  { label: "Búsqueda híbrida", i18nKey: "buscai.hero.chip1" },
  { label: "Visión por computador", i18nKey: "buscai.hero.chip2" },
  { label: "On-premise / Cloud", i18nKey: "buscai.hero.chip3" },
  { label: "Privacy-First", i18nKey: "buscai.hero.chip4" },
];

/* ── Feature cards (5 from new content) ────────────── */
const features = [
  {
    title: "Optimización Operativa y Ahorro de Costes",
    desc: "La rápida localización de información elimina las horas improductivas de búsqueda manual. Reduce drásticamente los tiempos de inactividad, optimiza los gastos operativos (OPEX) y maximiza la eficiencia general de los equipos.",
    icon: "M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z",
    highlight: "Aplicado en la flota de cazas F-18, donde acelera el acceso a procedimientos críticos y transforma tiempos de espera en intervenciones efectivas.",
  },
  {
    title: "Comprensión Visual y Semántica Avanzada",
    desc: "Mediante Deep Learning, el sistema no solo extrae texto, sino que interpreta la estructura visual del documento. Preserva de forma intacta el contexto espacial y semántico de la información técnica.",
    icon: "M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
    highlight: null,
  },
  {
    title: "Búsqueda Híbrida Inteligente",
    desc: "Fusiona la búsqueda semántica con la búsqueda textual clásica para garantizar la máxima relevancia. Un agente LLM orquesta el proceso, entregando respuestas exactas listas para la toma de decisiones.",
    icon: "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z",
    highlight: null,
  },
  {
    title: "Soberanía del Dato y Confidencialidad",
    desc: "Arquitectura Privacy-First. Los documentos originales permanecen siempre bajo el control de la organización (On-Premise). Permite procesamiento dual adaptativo: ejecución 100% local para datos sensibles o inferencia externa mediante fragmentos estrictamente anonimizados.",
    icon: "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
    highlight: null,
  },
  {
    title: "Escalabilidad Modular y Elástica",
    desc: "Arquitectura diseñada para adaptarse dinámicamente a la demanda operativa. Cada componente del sistema puede replicarse y escalar de forma independiente según la carga de trabajo, garantizando siempre un rendimiento óptimo.",
    icon: "M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3",
    highlight: null,
  },
];

/* ── How it works steps ────────────────────────────── */
const howItWorksSteps = [
  {
    title: "Ingesta documental",
    desc: "Los documentos corporativos se ingestan y procesan automáticamente. Técnicas de visión por computador analizan el layout visual para comprender tablas, diagramas y estructuras complejas.",
    icon: "M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776",
  },
  {
    title: "Búsqueda híbrida",
    desc: "El usuario consulta en lenguaje natural. El motor fusiona búsqueda semántica y textual clásica para maximizar la relevancia. Un agente LLM orquesta el proceso completo.",
    icon: "m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z",
  },
  {
    title: "Respuesta fundamentada",
    desc: "Se genera una respuesta clara y precisa, referenciando páginas y documentos originales. Total trazabilidad hacia la fuente para cada dato entregado.",
    icon: "M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z",
  },
];

/* ── Chat demo messages ────────────────────────────── */
const chatMessages = [
  {
    role: "user" as const,
    text: "¿Cuáles son los pasos para desmontar la cúpula del F-18?",
    time: "14:32",
  },
  {
    role: "assistant" as const,
    text: "",
    time: "14:32",
    structured: true,
    intro: "Según el <strong>Manual Técnico TO 1F-18A-2-30</strong> (Capítulo 12, Sección 3, pp. 12-42 a 12-47), el procedimiento de desmontaje de la cúpula (canopy) del F/A-18 consta de los siguientes pasos:",
    steps: [
      { num: 1, title: "Despresurización de la cabina", detail: "Verificar que el sistema de presurización está en OFF. Abrir la válvula de alivio manual (panel lateral izquierdo, posición L3-14). Esperar a lectura de 0 PSI." },
      { num: 2, title: "Desconexión del sistema de detonación", detail: "Desactivar el cordón detonante MDC (Miniature Detonation Cord) siguiendo el procedimiento de seguridad E-204. Colocar pin de seguridad (flagged) en el actuador del canopy jettison." },
      { num: 3, title: "Desbloqueo mecánico", detail: "Accionar las manetas de bloqueo delanteras (2 uds.) girando 90° en sentido antihorario. Repetir con las manetas traseras (2 uds.). Verificar indicador visual en posición UNLOCKED (banda amarilla visible)." },
      { num: 4, title: "Desconexión de actuadores hidráulicos", detail: "Purgar presión residual del circuito hidráulico HYD-2. Desconectar los conectores rápidos de los actuadores de elevación (izquierdo y derecho)." },
      { num: 5, title: "Izado y retirada", detail: "Instalar el útil de izado específico NSN 1560-01-234-5678 en los cuatro puntos de anclaje. Elevar verticalmente 15 cm y verificar ausencia de interferencias. Trasladar a caballete de soporte." },
    ],
    refs: [
      { doc: "TO 1F-18A-2-30", pages: "pp. 12-42 a 12-47", confidence: 96 },
      { doc: "Procedimiento de Seguridad E-204", pages: "pp. 4-8", confidence: 91 },
      { doc: "Catálogo herramientas NSP-380", pages: "p. 23", confidence: 88 },
    ],
    warning: "Este procedimiento requiere personal cualificado NAMF Level III y supervisión de QA. Consulte siempre la revisión vigente del manual antes de ejecutar.",
  },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF5", title: "Seguridad en la operación", description: "Acceso rápido y contextualizado a normativas, procedimientos de seguridad y documentación técnica crítica para apoyar decisiones operativas con información verificable y trazable." },
  { code: "AF3", title: "GIC y gestión del conocimiento", description: "Centralización y búsqueda inteligente del conocimiento técnico acumulado: lecciones aprendidas, informes de inspección, manuales de mantenimiento y documentación de flotas." },
  { code: "AF6", title: "Sostenimiento y documentación técnica", description: "Localización inmediata de procedimientos, históricos de intervención y documentación normativa para reducir tiempos de búsqueda y mejorar la eficiencia del sostenimiento." },
];

const capacidadDestacada = {
  code: "Capacidad diferencial",
  title: "Inteligencia documental para entornos operativos complejos",
  description: "BUSCAI transforma bases documentales extensas y heterogéneas en un activo de conocimiento accesible, buscable y accionable. Reduce drásticamente el tiempo de localización de información técnica crítica y garantiza que las respuestas estén siempre fundamentadas en la documentación oficial de la organización.",
  note: "Aplicable a entornos con alta densidad documental: mantenimiento de flotas, gestión de calidad, operaciones y logística.",
};



/* ── Helper: check icon SVG ────────────────────────── */
const checkIconPath = "M4.5 12.75l6 6 9-13.5";
---

<Layout
  title="BUSCAI · TheNextPangea"
  description="Plataforma de inteligencia documental basada en arquitecturas RAG que convierte repositorios estáticos en bases de conocimiento interactivas, consultables en lenguaje natural."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="BUSCAI"
      tags={heroTags}
      subtitle="Plataforma de inteligencia documental basada en arquitecturas RAG que convierte repositorios estáticos en bases de conocimiento interactivas, consultables directamente en lenguaje natural."
      chips={heroChips}
      backgroundImage={`${base}images/BuscAI.png`}
    >
      <span class="product-gradient-text">Inteligencia documental</span> para entornos operativos críticos
    </ProductHero>



    <!-- ════════════════ DESCRIPCIÓN GENERAL ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-violet-50/30 rounded-full blur-3xl -translate-y-1/3 translate-x-1/3 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-violet-50/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-5xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="Qué es BuscAI" i18nKey="buscai.about.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
            <!-- Left text block -->
            <div class="flex-1 reveal delay-100">
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8 leading-tight">
                De repositorios estáticos a <span class="product-gradient-text">bases de conocimiento interactivas</span>
              </h2>
              <div class="space-y-5">
                <p class="text-lg leading-relaxed text-slate-600">
                  La gestión y explotación ágil del conocimiento en grandes volúmenes de documentación técnica es un reto crítico para la operatividad. <strong class="font-semibold text-slate-800">BuscAI</strong> es una plataforma de inteligencia documental apoyada en arquitecturas <strong class="font-semibold text-slate-800">RAG</strong> (Retrieval-Augmented Generation) que convierte repositorios estáticos en bases de conocimiento interactivas, consultables directamente en lenguaje natural.
                </p>
                <p class="text-base leading-relaxed text-slate-500">
                  A diferencia de los sistemas OCR convencionales, BuscAI integra técnicas de <strong class="font-semibold text-slate-700">visión por computador</strong> y <strong class="font-semibold text-slate-700">Grandes Modelos de Lenguaje (LLM)</strong> para analizar el layout o disposición visual de los documentos. Esto le permite comprender y contextualizar tablas, diagramas y estructuras complejas, garantizando a las organizaciones la explotación de sus datos no estructurados con máxima precisión y total trazabilidad hacia la fuente original.
                </p>
              </div>
            </div>

            <!-- Right: architecture diagram -->
            <div class="flex-shrink-0 w-full lg:w-5/12 reveal delay-200">
              <div class="buscai-arch-diagram relative rounded-2xl bg-gradient-to-br from-slate-50 to-violet-50/50 border border-slate-200 p-6 sm:p-8">
                <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6 text-center">Arquitectura RAG</h4>

                <!-- Pipeline flow -->
                <div class="space-y-4">
                  <!-- Ingesta -->
                  <div class="buscai-arch-node flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-100 shadow-sm" style="animation-delay: 0.1s;">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT}12;`}>
                      <svg class="w-5 h-5" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
                    </div>
                    <div>
                      <div class="text-sm font-bold text-slate-800">Documentos</div>
                      <div class="text-xs text-slate-400">PDF, Word, Imágenes, Excel</div>
                    </div>
                  </div>

                  <div class="flex justify-center"><svg class="w-5 h-5 text-violet-300 buscai-arch-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg></div>

                  <!-- Vision + LLM -->
                  <div class="buscai-arch-node flex items-center gap-3 p-3 rounded-xl bg-white border border-violet-100 shadow-sm" style="animation-delay: 0.25s;">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT}18;`}>
                      <svg class="w-5 h-5" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    </div>
                    <div>
                      <div class="text-sm font-bold text-slate-800">Visión + LLM</div>
                      <div class="text-xs text-slate-400">Análisis de layout, tablas, diagramas</div>
                    </div>
                  </div>

                  <div class="flex justify-center"><svg class="w-5 h-5 text-violet-300 buscai-arch-arrow" style="animation-delay: 0.1s;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg></div>

                  <!-- Vector DB -->
                  <div class="buscai-arch-node flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-100 shadow-sm" style="animation-delay: 0.4s;">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT}12;`}>
                      <svg class="w-5 h-5" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
                    </div>
                    <div>
                      <div class="text-sm font-bold text-slate-800">Vector DB</div>
                      <div class="text-xs text-slate-400">Embeddings semánticos indexados</div>
                    </div>
                  </div>

                  <div class="flex justify-center"><svg class="w-5 h-5 text-violet-300 buscai-arch-arrow" style="animation-delay: 0.2s;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg></div>

                  <!-- Respuesta -->
                  <div class="buscai-arch-node flex items-center gap-3 p-3 rounded-xl border shadow-sm" style={`background: ${ACCENT}08; border-color: ${ACCENT}30; animation-delay: 0.55s;`}>
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT}; color: white;`}>
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /></svg>
                    </div>
                    <div>
                      <div class="text-sm font-bold text-slate-800">Respuesta fundamentada</div>
                      <div class="text-xs text-slate-400">Con trazabilidad a fuente original</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ CARACTERÍSTICAS + DEMO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-14">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Características" i18nKey="buscai.features.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4">
            Capacidades que transforman la <span class="product-gradient-text">gestión documental</span>
          </h2>
          <p class="text-lg text-slate-500 max-w-2xl mx-auto reveal delay-200">
            Tecnología de IA de última generación aplicada a la explotación de datos no estructurados.
          </p>
        </div>

        <div class="grid lg:grid-cols-[1fr,1.15fr] gap-8 lg:gap-10 items-start">
          <!-- Feature cards (compact) -->
          <div class="space-y-3 reveal delay-100">
            {features.map((f, i) => (
              <div class="buscai-feature-card group relative rounded-xl bg-white border border-slate-200 p-4 transition-all duration-300 hover:border-violet-200 hover:shadow-lg hover:shadow-violet-500/5 cursor-default">
                <div class="flex gap-3.5 items-start">
                  <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT}10;`}>
