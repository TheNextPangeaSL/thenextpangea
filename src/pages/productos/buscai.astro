---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("buscai")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #D4A017 */
const ACCENT_LIGHT = "#E8C547";
const ACCENT_DARK = "#B8860B";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia artificial", i18nKey: "buscai.hero.tag1" },
  { label: "Gestión del conocimiento", i18nKey: "buscai.hero.tag2" },
];

const heroChips = [
  { label: "Arquitectura RAG", i18nKey: "buscai.hero.chip1" },
  { label: "Comprensión visual documental", i18nKey: "buscai.hero.chip2" },
  { label: "On-premise", i18nKey: "buscai.hero.chip3" },
];

/* ── Slider steps ──────────────────────────────────── */
const sliderSteps = [
  {
    num: "01",
    label: "Incidencia en mantenimiento",
    labelI18n: "buscai.slider.step1.label",
    image: `${base}images/buscai-problema.png`,
    imageAlt: "Técnico de mantenimiento con una duda técnica entre manuales y documentación",
    imageAltI18n: "buscai.slider.step1.alt",
    badge: "Paso 1 · Incidencia en mantenimiento",
    badgeI18n: "buscai.slider.step1.badge",
    title: "La duda es muy específica. La documentación, enorme.",
    titleI18n: "buscai.slider.step1.title",
    desc: "El técnico necesita un dato muy concreto dentro de manuales y procedimientos extensos. La información existe, pero localizarla manualmente ralentiza la intervención.",
    descI18n: "buscai.slider.step1.desc",
  },
  {
    num: "02",
    label: "Consulta a BUSCAI",
    labelI18n: "buscai.slider.step2.label",
    image: `${base}images/buscai-solucion.png`,
    imageAlt: "Técnico de mantenimiento con la idea de usar BUSCAI",
    imageAltI18n: "buscai.slider.step2.alt",
    badge: "Paso 2 · Consulta a BUSCAI",
    badgeI18n: "buscai.slider.step2.badge",
    title: "La búsqueda se convierte en una conversación natural",
    titleI18n: "buscai.slider.step2.title",
    desc: "En lugar de buscar documento a documento, plantea la duda directamente a BUSCAI mediante una interacción natural.",
    descI18n: "buscai.slider.step2.desc",
  },
  {
    num: "03",
    label: "Comprensión documental",
    labelI18n: "buscai.slider.step3.label",
    image: `${base}images/buscai-procesamiento.jpg`,
    imageAlt: "Procesamiento estructural de una página técnica por BUSCAI",
    imageAltI18n: "buscai.slider.step3.alt",
    badge: "Paso 3 · Comprensión documental",
    badgeI18n: "buscai.slider.step3.badge",
    title: "BUSCAI no solo indexa texto: comprende el documento completo",
    titleI18n: "buscai.slider.step3.title",
    desc: "La plataforma procesa texto, tablas, figuras y diagramas, preservando el contexto para recuperar conocimiento útil con precisión.",
    descI18n: "buscai.slider.step3.desc",
  },
  {
    num: "04",
    label: "Respuesta operativa",
    labelI18n: "buscai.slider.step4.label",
    image: `${base}images/buscai-chat.png`,
    imageAlt: "Interfaz de chat de BUSCAI respondiendo a una consulta técnica",
    imageAltI18n: "buscai.slider.step4.alt",
    badge: "Paso 4 · Respuesta operativa",
    badgeI18n: "buscai.slider.step4.badge",
    title: "Respuesta precisa, trazable y dentro de un entorno seguro",
    titleI18n: "buscai.slider.step4.title",
    desc: "BUSCAI responde en segundos y enlaza a la fuente original, manteniendo la documentación dentro del entorno seguro del cliente.",
    descI18n: "buscai.slider.step4.desc",
  },
];

/* ── Metric cards ──────────────────────────────────── */
const metricCards = [
  { kicker: "Seguridad", kickerI18n: "buscai.metrics.m1.kicker", title: "100% on-premise", titleI18n: "buscai.metrics.m1.title", copy: "La documentación puede permanecer dentro de la infraestructura del cliente.", copyI18n: "buscai.metrics.m1.copy" },
  { kicker: "Comprensión", kickerI18n: "buscai.metrics.m2.kicker", title: "Texto + tablas + figuras", titleI18n: "buscai.metrics.m2.title", copy: "Interpreta estructuras documentales complejas y no solo texto plano.", copyI18n: "buscai.metrics.m2.copy" },
  { kicker: "Trazabilidad", kickerI18n: "buscai.metrics.m3.kicker", title: "Respuesta con fuente", titleI18n: "buscai.metrics.m3.title", copy: "Cada respuesta puede vincularse directamente a la documentación original.", copyI18n: "buscai.metrics.m3.copy" },
  { kicker: "Operatividad", kickerI18n: "buscai.metrics.m4.kicker", title: "Menos tiempo de búsqueda", titleI18n: "buscai.metrics.m4.title", copy: "Reduce búsquedas manuales y acelera la resolución de dudas técnicas.", copyI18n: "buscai.metrics.m4.copy" },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF3", title: "GIC y optimización de procesos", description: "Explotación ágil del conocimiento documental para mejorar procesos, acceso a información y toma de decisiones." },
  { code: "AF5", title: "Seguridad en la operación", description: "Consulta rápida de procedimientos críticos, instrucciones y documentación operativa en escenarios sensibles." },
  { code: "AF6", title: "Sostenimiento 4.0", description: "Acceso inteligente a manuales de mantenimiento, históricos técnicos y documentación de soporte a flota." },
];

const casoUsoDestacado = {
  code: "Caso de uso destacado",
  title: "Consulta operativa de documentación técnica",
  description: "BUSCAI convierte documentación técnica compleja en conocimiento operativo accesible, trazable y seguro, acelerando la consulta de procedimientos, el soporte a mantenimiento y la explotación eficiente del conocimiento en entornos BACSI.",
  note: "Aplicable a manuales técnicos, procedimientos operativos, boletines, informes históricos y cualquier repositorio documental en entornos sensibles o clasificados.",
};

/* ── Application cards ─────────────────────────────── */
const applicationCards = [
  {
    title: "Consulta operativa de documentación técnica",
    titleI18n: "buscai.apps.app1.title",
    desc: "Acceso en lenguaje natural a manuales, procedimientos, boletines técnicos e informes, reduciendo tiempos de búsqueda y facilitando la localización de información crítica en entornos operativos.",
    descI18n: "buscai.apps.app1.desc",
  },
  {
    title: "Soporte a mantenimiento y sostenimiento",
    titleI18n: "buscai.apps.app2.title",
    desc: "Recuperación ágil de procedimientos, esquemas, tablas y documentación histórica para acelerar diagnósticos, intervenciones MRO y operaciones de sostenimiento con mayor trazabilidad.",
    descI18n: "buscai.apps.app2.desc",
  },
  {
    title: "Explotación segura del conocimiento interno",
    titleI18n: "buscai.apps.app3.title",
    desc: "Conversión de repositorios documentales en bases de conocimiento interactivas bajo control de la organización, con despliegue on-premise para entornos sensibles o clasificados.",
    descI18n: "buscai.apps.app3.desc",
  },
];
---

<Layout
  title="BUSCAI · TheNextPangea"
  description="Plataforma de recuperación inteligente de información técnica basada en arquitecturas RAG que transforma repositorios documentales en bases de conocimiento interactivas."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="BUSCAI"
      backgroundImage={`${base}images/buscai-bg.png`}
      tags={heroTags}
      tagSeparator="·"
      titleI18n="buscai.hero.title"
      subtitle="BuscAI transforma repositorios documentales complejos en una base de conocimiento interactiva, permitiendo consultar manuales, procedimientos y documentación técnica directamente en lenguaje natural, con máxima precisión y trazabilidad hacia la fuente original."
      subtitleI18n="buscai.hero.subtitle"
      chips={heroChips}
      backLabel="Volver a productos"
      backI18n="buscai.hero.back"
      ctaPrimaryLabel="Solicitar más información"
      ctaPrimaryI18n="buscai.hero.cta.primary"
    >
      Plataforma de recuperación inteligente de información técnica
    </ProductHero>


    <!-- ════════════════ EL RETO OPERATIVO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" style={`background: color-mix(in srgb, ${ACCENT} 15%, transparent);`} aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="buscai.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="buscai.challenge.title">
            Explotar conocimiento técnico disperso en <span class="product-gradient-text">grandes repositorios documentales</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="buscai.challenge.p1">
              En entornos industriales y operativos, gran parte del conocimiento crítico reside en
              <strong class="font-semibold">manuales técnicos, procedimientos, diagramas, tablas e informes históricos</strong>,
              distribuidos en grandes volúmenes de documentación heterogénea.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.challenge.p2">
              Localizar la información adecuada en el momento preciso suele requerir
              <strong class="font-semibold text-slate-700">búsquedas manuales lentas, revisión de múltiples fuentes y validación cruzada</strong>,
              lo que penaliza la eficiencia operativa y retrasa la toma de decisiones.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.challenge.p3">
              Los sistemas tradicionales basados únicamente en OCR no son suficientes cuando la información
              relevante está embebida en <strong class="font-semibold text-slate-700">estructuras complejas, layouts técnicos o relaciones visuales</strong>
              entre tablas, esquemas y bloques documentales.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.challenge.p4">
              El desafío no es solo digitalizar documentos, sino
              <strong class="font-semibold text-slate-700">convertirlos en conocimiento accesible, contextualizado y trazable</strong>
              para su explotación ágil en escenarios reales de operación y mantenimiento.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-6 reveal">
            <SectionLabel label="La solución" i18nKey="buscai.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h3 class="reveal delay-100 text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-6" data-i18n-html="buscai.solution.title">
            La forma segura de convertir documentación compleja en <span class="product-gradient-text">respuestas operativas</span>
          </h3>

          <div class="reveal delay-200 space-y-4">
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.solution.p1">
              <strong class="font-semibold text-slate-700">BUSCAI</strong> es una plataforma de recuperación de información híbrida que transforma
              repositorios documentales estáticos en <strong class="font-semibold text-slate-700">bases de conocimiento interactivas</strong>,
              consultables directamente en lenguaje natural.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.solution.p2">
              La solución se apoya en arquitecturas <strong class="font-semibold text-slate-700">RAG (Retrieval-Augmented Generation)</strong>,
              combinando recuperación semántica, búsqueda textual clásica y orquestación mediante
              <strong class="font-semibold text-slate-700">Grandes Modelos de Lenguaje (LLM)</strong> para ofrecer respuestas precisas listas para su uso operativo.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.solution.p3">
              A diferencia de los enfoques OCR convencionales, BUSCAI incorpora
              <strong class="font-semibold text-slate-700">visión por computador y técnicas de Deep Learning</strong> para analizar el layout documental,
              interpretar tablas, diagramas y estructuras complejas, y preservar el contexto espacial y semántico
              de la información técnica.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="buscai.solution.p4">
              Esta aproximación permite reducir drásticamente los tiempos de búsqueda manual, eliminar horas improductivas
              y mejorar la capacidad de respuesta de los equipos, especialmente en entornos donde el acceso rápido a
              procedimientos críticos impacta directamente en la operatividad.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.solution.p5">
              La plataforma ha sido concebida bajo una arquitectura <strong class="font-semibold text-slate-700">Privacy-First</strong>: los documentos
              originales permanecen bajo control de la organización, habilitando despliegues
              <strong class="font-semibold text-slate-700">100% on-premise</strong> para datos sensibles o clasificados, así como esquemas híbridos con
              fragmentos anonimizados cuando el contexto lo permite.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="buscai.solution.p6">
              Su diseño modular y escalable permite adaptar dinámicamente la capacidad de proceso según la carga operativa
              de cada componente, garantizando <strong class="font-semibold text-slate-700">rendimiento, confidencialidad y trazabilidad completa hacia la fuente original</strong>.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ FLUJO DE USO (4-STEP SLIDER) ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <SectionLabel label="Flujo de uso" i18nKey="buscai.flow.label" class="mx-auto mb-5 reveal">
            <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
          </SectionLabel>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-slate-800 reveal" data-i18n-html="buscai.flow.title">
            De una duda técnica a una <span class="product-gradient-text">respuesta trazable</span>
          </h2>
          <p class="text-slate-500 text-lg reveal" data-i18n="buscai.flow.subtitle">
            De una duda técnica a una respuesta trazable, segura y lista para actuar
          </p>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="relative product-glass rounded-2xl overflow-hidden" id="buscai-flow">

            <!-- Header with nav arrows -->
            <div class="px-5 pt-5 pb-4 border-b border-slate-100 bg-slate-50/70">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 mb-1" data-i18n="buscai.flow.header.label">
                    Flujo de uso
                  </div>
                  <div class="text-lg md:text-xl font-semibold text-slate-800 max-w-3xl" data-i18n="buscai.flow.header.title">
                    De una duda técnica a una respuesta trazable, segura y lista para actuar
                  </div>
                </div>

                <div class="hidden sm:flex items-center gap-2">
                  <button type="button"
                          class="buscai-nav h-9 w-9 inline-flex items-center justify-center rounded-full border border-slate-200 text-slate-500 hover:text-slate-900 hover:border-slate-300 transition cursor-pointer"
                          data-dir="-1"
                          aria-label="Paso anterior"
                          data-i18n-aria="buscai.flow.nav.prev">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                  </button>
                  <button type="button"
                          class="buscai-nav h-9 w-9 inline-flex items-center justify-center rounded-full border border-slate-200 text-slate-500 hover:text-slate-900 hover:border-slate-300 transition cursor-pointer"
                          data-dir="1"
                          aria-label="Paso siguiente"
                          data-i18n-aria="buscai.flow.nav.next">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- Step pills -->
            <div class="px-5 pt-4">
              <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
                {sliderSteps.map((step, i) => (
                  <button class={`buscai-step-btn${i === 0 ? " active" : ""}`} data-step={i} type="button">
                    <span class="buscai-step-n">{step.num}</span>
                    <span class="buscai-step-t" data-i18n={step.labelI18n}>{step.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Slides -->
            <div class="px-5 pt-5 pb-5">
              <div class="relative buscai-stage">
                {sliderSteps.map((step, i) => (
                  <article class={`buscai-slide${i === 0 ? " active" : ""}`} data-step={i}>
                    <div class="buscai-slide-media">
                      <img src={step.image} alt={step.imageAlt} loading={i === 0 ? "eager" : "lazy"} data-i18n-alt={step.imageAltI18n} />
                    </div>
                    <div class="buscai-slide-text">
                      <div class="buscai-badge" data-i18n={step.badgeI18n}>{step.badge}</div>
                      <h5 class="buscai-title" data-i18n={step.titleI18n}>{step.title}</h5>
                      <p class="buscai-desc" data-i18n={step.descI18n}>{step.desc}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ VALOR DIFERENCIAL ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f8f9fb] overflow-hidden" id="highlights">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <SectionLabel label="Valor diferencial" i18nKey="buscai.highlights.label" class="mx-auto mb-5 reveal" />
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-slate-800 reveal" data-i18n-html="buscai.highlights.title">
            Inteligencia documental <span class="product-gradient-text">segura y trazable</span>
          </h2>
          <p class="text-slate-500 text-lg reveal" data-i18n="buscai.highlights.subtitle">
            BUSCAI combina comprensión visual documental, recuperación híbrida y despliegue seguro
            para transformar repositorios técnicos complejos en conocimiento accesible y accionable.
          </p>
        </div>

        <!-- Metric cards -->
        <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6 reveal">
          {metricCards.map((card, i) => (
            <div class="product-card" style={i > 0 ? `animation-delay:${i * 0.08}s` : undefined}>
              <div class="text-xs font-bold uppercase tracking-wider mb-3" style={`color: ${ACCENT};`} data-i18n={card.kickerI18n}>{card.kicker}</div>
              <div class="text-2xl font-bold text-slate-800 mb-3 tracking-tight" data-i18n={card.titleI18n}>{card.title}</div>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={card.copyI18n}>{card.copy}</p>
            </div>
          ))}
        </div>

        <!-- Value block -->
        <div class="mt-8 reveal delay-100">
          <div class="product-card !p-8 md:!p-10 relative overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-2xl" style={`background: ${ACCENT};`}></div>
            <div class="pl-4">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3" data-i18n="buscai.highlights.value.kicker">Valor diferencial</div>
              <p class="text-base md:text-lg text-slate-600 leading-relaxed" data-i18n-html="buscai.highlights.value.text">
                <strong class="font-semibold text-slate-800">BUSCAI no es un buscador documental convencional.</strong>
                Comprende documentación técnica compleja, procesa texto y elementos visuales, preserva el contexto
                de cada página y permite responder preguntas operativas con trazabilidad a la fuente, en un
                <strong class="font-semibold text-slate-800">entorno seguro donde la información permanece bajo control del cliente</strong>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ════════════════ APLICACIONES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden" id="aplicaciones">
