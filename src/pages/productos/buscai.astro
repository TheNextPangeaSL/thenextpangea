<script>
  (function () {
    const flow = document.getElementById("buscai-flow");
    if (!flow) return;

    const btns = flow.querySelectorAll<HTMLButtonElement>(".buscai-step-btn");
    const slides = flow.querySelectorAll<HTMLElement>(".buscai-slide");
    const navs = flow.querySelectorAll<HTMLButtonElement>(".buscai-nav");
    let current = 0;
    const total = slides.length;

    function goTo(idx: number) {
      if (idx < 0) idx = total - 1;
      if (idx >= total) idx = 0;

      btns.forEach((b) => b.classList.remove("active"));
      slides.forEach((s) => s.classList.remove("active"));

      btns[idx]?.classList.add("active");
      slides[idx]?.classList.add("active");
      current = idx;
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = parseInt(btn.dataset.step ?? "0", 10);
        goTo(step);
      });
    });

    navs.forEach((nav) => {
      nav.addEventListener("click", () => {
        const dir = parseInt(nav.dataset.dir ?? "1", 10);
        goTo(current + dir);
      });
    });
  })();
</script>
