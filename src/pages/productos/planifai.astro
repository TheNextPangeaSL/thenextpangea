---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";
import JsonLd from "@/components/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/lib/schemas";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("planifai")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #F47321 */
const ACCENT_LIGHT = "#F9A56C";
const ACCENT_DARK = "#D45E10";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia Artificial", i18nKey: "planifai.hero.tag1" },
  { label: "Optimización", i18nKey: "planifai.hero.tag2" },
];

const heroChips = [
  { label: "Predicción de demanda", i18nKey: "planifai.hero.chip1" },
  { label: "Optimización multiobjetivo", i18nKey: "planifai.hero.chip2" },
  { label: "Re-scheduling dinámico", i18nKey: "planifai.hero.chip3" },
];

/* ── Feature cards ─────────────────────────────────── */
const features = [
  { num: "01", keyword: "Predicción", keywordI18n: "planifai.features.f1.keyword", title: "Previsión de Demanda Multi-Modelo", titleI18n: "planifai.features.f1.title", desc: "Combina múltiples modelos de previsión con selección automática y reentrenamiento continuo para elegir el mejor modelo para cada artículo.", descI18n: "planifai.features.f1.desc", icon: "M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" },
  { num: "02", keyword: "Modelado", keywordI18n: "planifai.features.f2.keyword", title: "Modelado de Procesos Basado en Restricciones", titleI18n: "planifai.features.f2.title", desc: "Permite describir la problemática real del sistema objetivo y sus restricciones dentro del algoritmo, asegurando que el plan generado cumple todas las condiciones operativas.", descI18n: "planifai.features.f2.desc", icon: "M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0L12 17.25 6.429 14.25m11.142 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25" },
  { num: "03", keyword: "Optimización", keywordI18n: "planifai.features.f3.keyword", title: "Optimización Multi-Objetivo de Recursos", titleI18n: "planifai.features.f3.title", desc: "A partir de las predicciones y el modelo, calcula la mejor asignación de recursos optimizando múltiples objetivos simultáneamente.", descI18n: "planifai.features.f3.desc", icon: "M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6.75" },
  { num: "04", keyword: "Resiliencia", keywordI18n: "planifai.features.f4.keyword", title: "Replanificación Adaptativa", titleI18n: "planifai.features.f4.title", desc: "Ante cambios en la planificación original óptima, realiza el mínimo número de modificaciones para mantener la optimización, evitando replanificar desde cero y los costes asociados.", descI18n: "planifai.features.f4.desc", icon: "M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" },
];

/* ── Pillar list items ─────────────────────────────── */
const pillar1Items = [
  { text: "Múltiples modelos estadísticos y de deep learning adaptados a cada patrón de demanda", i18n: "planifai.pillar1.li1" },
  { text: "Selección automática de modelo con reentrenamiento continuo por artículo", i18n: "planifai.pillar1.li2" },
  { text: "Gestiona demandas intermitentes, estacionales, tendenciales y erráticas", i18n: "planifai.pillar1.li3" },
];

const pillar2Items = [
  { text: "Describe la problemática real y las restricciones del sistema objetivo dentro del algoritmo", i18n: "planifai.pillar2.li1" },
  { text: "Modelado de restricciones: capacidad de máquinas, materiales, turnos, dependencias, calendarios…", i18n: "planifai.pillar2.li2" },
  { text: "Garantiza que el plan generado es ejecutable y cumple todas las condiciones operativas", i18n: "planifai.pillar2.li3" },
];

const pillar3Items = [
  { text: "Optimización multi-objetivo: disponibilidad, coste, plazo y uso de recursos", i18n: "planifai.pillar3.li1" },
  { text: "Asignación simultánea de tareas a líneas, equipos y personal bajo restricciones reales", i18n: "planifai.pillar3.li2" },
  { text: "Minimizar tiempos de inactividad y cuellos de botella en la planificación", i18n: "planifai.pillar3.li3" },
];

const pillar4Items = [
  { text: "Realiza el mínimo número de cambios sobre el plan original para mantener la optimización", i18n: "planifai.pillar4.li1" },
  { text: "Evita replanificar desde cero y los costes de material aprovisionado, personal trasladado, etc.", i18n: "planifai.pillar4.li2" },
  { text: "Tratamiento probabilístico de la incertidumbre para decisiones robustas", i18n: "planifai.pillar4.li3" },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF3", title: "Planificación de producción y sostenimiento", description: "Optimización de los planes de producción y mantenimiento bajo restricciones reales de capacidad, recursos y calendarios. Asignación óptima de tareas en líneas, equipos y personal para maximizar disponibilidad operativa." },
  { code: "AF6", title: "Gestión logística y cadena de suministro", description: "Predicción de demanda de repuestos y materiales con modelos avanzados para consumos intermitentes y erráticos. Optimización de niveles de stock, aprovisionamiento y distribución para reducir costes y evitar roturas." },
  { code: "Transversal", title: "Optimización del mantenimiento de flotas", description: "Planificación y re-scheduling inteligente del mantenimiento de flotas de activos críticos (aeronaves, vehículos, sistemas). Maximización de la disponibilidad operativa mediante asignación multi-objetivo de recursos limitados." },
];

const casoUsoDestacado = {
  code: "Caso de uso destacado",
  title: "Plan de mantenimiento de la flota de aeronaves del Ejército del Aire y del Espacio",
  description: "PlanifAI ha sido aplicada con éxito en la optimización del plan de mantenimiento de la flota de aeronaves F-18 del Ejército del Aire y del Espacio, demostrando que la optimización no solo mejora procesos productivos convencionales, sino también la gestión estratégica de activos de alta criticidad.",
  note: "Aplicable a flotas de vehículos, equipamientos, sistemas de armas y cualquier activo donde la disponibilidad operativa sea crítica y los recursos limitados.",
};

/* ── Helper: check icon SVG ────────────────────────── */
const checkIconPath = "M4.5 12.75l6 6 9-13.5";

/* ── Structured data ──────────────────────────────── */
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const productImageUrl = product.heroImage ? new URL(product.heroImage, Astro.site).href : undefined;
const productJsonLd = productSchema({
  name: product.name,
  description: product.tagline,
  url: productUrl,
  image: productImageUrl,
  category: categoryInfo?.label,
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: "Inicio", url: "https://bacsi.thenextpangea.com/" },
  { name: "Productos", url: "https://bacsi.thenextpangea.com/#products" },
  { name: product.name, url: productUrl },
]);
---

<Layout
  title="PlanifAI · TheNextPangea"
  description="Plataforma integrada de optimización de recursos que combina predicción de demanda, modelado de procesos y optimización multi-objetivo para transformar datos operativos en decisiones óptimas."
  ogImage={product.heroImage}
  ogType="product"
>
  <Fragment slot="structured-data">
    <JsonLd data={productJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="PLANIFAI"
      backgroundImage={`${base}images/PlanifAI.png`}
      tags={heroTags}
      tagSeparator="·"
      titleI18n="planifai.hero.title"
      subtitle="Plataforma integrada que combina predicción, modelado operativo y planificación avanzada para transformar datos en decisiones robustas basadas en criterios cuantitativos."
      subtitleI18n="planifai.hero.subtitle"
      chips={heroChips}
      backLabel="Volver a productos"
      backI18n="planifai.hero.back"
      ctaPrimaryLabel="Solicitar más información"
      ctaPrimaryI18n="planifai.hero.cta.primary"
    >
      Planificación predictiva de recursos en entornos complejos
    </ProductHero>



    <!-- ════════════════ CAPACIDADES CLAVE ════════════════ -->
    <section id="como-funciona" class="relative py-24 sm:py-32 bg-[#f8f9fb] overflow-hidden product-grid-pattern">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <SectionLabel label="Los 4 Pilares" i18nKey="planifai.features.label" class="mx-auto mb-5 reveal">
            <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
          </SectionLabel>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-slate-800 reveal" data-i18n-html="planifai.features.title">
            Los 4 pilares de <span class="product-gradient-text">PlanifAI</span>
          </h2>
          <p class="text-slate-500 text-lg reveal" data-i18n="planifai.features.subtitle">
            Desde la predicción de demanda hasta la resiliencia operativa — cubriendo todo el ciclo de planificación inteligente.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map((f, i) => (
            <div class="product-card reveal" style={i > 0 ? `animation-delay:${i * 0.08}s` : undefined}>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-3xl font-black tracking-tighter" style={`color: ${ACCENT}; opacity: 0.25;`}>{f.num}</span>
                <span class="text-xs font-bold uppercase tracking-wider" style={`color: ${ACCENT};`} data-i18n={f.keywordI18n}>{f.keyword}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-800 mb-2" data-i18n={f.titleI18n}>{f.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={f.descI18n}>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ CUATRO PILARES ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        <div class="text-center mb-20 max-w-2xl mx-auto">
          <SectionLabel label="La plataforma PlanifAI" i18nKey="planifai.pillars.label" class="mx-auto mb-5 reveal" />
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-slate-800 reveal" data-i18n-html="planifai.pillars.title">
            Cuatro pilares de <span class="product-gradient-text">planificación inteligente</span>
          </h2>
          <p class="text-slate-500 text-lg reveal" data-i18n="planifai.pillars.subtitle">
            Cuatro pilares que impulsan decisiones inteligentes en la cadena de suministro, desde la previsión hasta la resiliencia operativa.
          </p>
        </div>

        <!-- Pilar 1: Predicción -->
        <div class="mb-24 reveal">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="product-icon-box product-icon-box-brand">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider" style={`color: ${ACCENT};`} data-i18n="planifai.pillar1.tag">Predicción</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-4" data-i18n="planifai.pillar1.title">Previsión de demanda multi-modelo</h3>
              <p class="text-slate-500 leading-relaxed mb-6" data-i18n="planifai.pillar1.desc">Predecir la demanda de miles de artículos con un solo modelo es imposible — cada artículo tiene patrones de consumo únicos. PlanifAI combina múltiples modelos de previsión (Temporal Fusion Transformers, Autoencoders, Arima, Croston, Modelos personalizados …) con un motor de selección inteligente y reentrenamiento continuo para seleccionar automáticamente el mejor modelo para cada artículo.</p>
              <ul class="space-y-3">
                {pillar1Items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={checkIconPath} /></svg>
                    <span class="text-sm text-slate-600" data-i18n={item.i18n}>{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Demand diversity + Model arsenal visual -->
            <div class="relative">
              <div class="product-glass rounded-2xl p-6 relative z-10">
                <!-- Diversidad de Demanda -->
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3" data-i18n="planifai.pillar1.viz.title">Diversidad de demanda</div>
                <div class="grid grid-cols-2 gap-2 mb-5">
                  {[
                    { name: "Bearing A-12", type: "Estacional", typeI18n: "planifai.pillar1.viz.type.seasonal", pts: "0,20 10,16 20,10 30,6 40,4 50,8 60,14 70,20", clr: "#3b82f6" },
                    { name: "Hydraulic Valve", type: "Intermitente", typeI18n: "planifai.pillar1.viz.type.intermittent", pts: "0,18 8,18 12,4 20,18 35,18 39,6 48,18 60,18 64,3 70,18", clr: "#f59e0b" },
                    { name: "Electronic Module", type: "Tendencial", typeI18n: "planifai.pillar1.viz.type.trend", pts: "0,22 10,20 20,17 30,14 40,11 50,8 60,5 70,3", clr: "#10b981" },
                    { name: "Turbine Blade", type: "Errática", typeI18n: "planifai.pillar1.viz.type.erratic", pts: "0,12 8,4 16,20 24,8 32,16 40,3 48,18 56,6 64,14 70,10", clr: "#ef4444" },
                    { name: "Seal Kit B-07", type: "Estacional", typeI18n: "planifai.pillar1.viz.type.seasonal", pts: "0,18 10,14 20,8 30,5 40,3 50,7 60,12 70,18", clr: "#3b82f6" },
                    { name: "Avionics Unit", type: "Tendencial", typeI18n: "planifai.pillar1.viz.type.trend", pts: "0,24 10,21 20,18 30,15 40,12 50,9 60,6 70,2", clr: "#10b981" },
                  ].map((item) => (
                    <div class="bg-slate-50/80 rounded-lg p-2.5 border border-slate-100 flex items-center justify-between gap-2">
                      <div class="min-w-0">
                        <div class="text-[11px] font-bold text-slate-700 truncate">{item.name}</div>
                        <div class="text-[10px] font-semibold" style={`color: ${item.clr};`} data-i18n={item.typeI18n}>{item.type}</div>
                      </div>
                      <svg class="w-16 h-6 flex-shrink-0" viewBox="0 0 70 24">
                        <polyline points={item.pts} fill="none" stroke={item.clr} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                  ))}
                </div>
                <!-- Arsenal de Modelos -->
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3" data-i18n="planifai.pillar1.viz.legend1">Arsenal de modelos</div>
                <div class="grid grid-cols-3 gap-2">
                  {[
                    { name: "Prophet", type: "Estadístico", typeI18n: "planifai.pillar1.viz.model.statistical", bg: "bg-indigo-50", border: "border-indigo-100", tc: "text-indigo-600" },
                    { name: "ARIMA", type: "Estadístico", typeI18n: "planifai.pillar1.viz.model.statistical", bg: "bg-indigo-50", border: "border-indigo-100", tc: "text-indigo-600" },
                    { name: "TFT", type: "Deep Learning", typeI18n: "planifai.pillar1.viz.model.deeplearning", bg: "bg-orange-50", border: "border-orange-100", tc: "text-orange-600" },
                    { name: "Autoencoder", type: "Deep Learning", typeI18n: "planifai.pillar1.viz.model.deeplearning", bg: "bg-orange-50", border: "border-orange-100", tc: "text-orange-600" },
                    { name: "Tu modelo", nameI18n: "planifai.pillar1.viz.model.yours.name", type: "El que ya usas", typeI18n: "planifai.pillar1.viz.model.yours", bg: "bg-emerald-50", border: "border-emerald-100", tc: "text-emerald-600" },
                    { name: "…", type: "Personalizable", typeI18n: "planifai.pillar1.viz.model.custom", bg: "bg-slate-50", border: "border-slate-200 border-dashed", tc: "text-slate-400" },
                  ].map((m) => (
                    <div class={`text-center p-2 rounded-lg border ${m.bg} ${m.border}`}>
                      <div class="text-[11px] font-bold text-slate-700" data-i18n={m.nameI18n}>{m.name}</div>
                      <div class={`text-[9px] font-semibold ${m.tc}`} data-i18n={m.typeI18n}>{m.type}</div>
                    </div>
                  ))}
                </div>
                <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-xl flex items-center gap-2">
                  <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span class="text-xs text-green-800 font-medium" data-i18n="planifai.pillar1.viz.result">Selección automática del mejor modelo por artículo con reentrenamiento continuo</span>
                </div>
              </div>
              <div class="absolute -inset-3 bg-gradient-to-br from-[#dae6ff] to-[#f0f4ff] rounded-3xl -z-10 opacity-60"></div>
            </div>
          </div>
        </div>

        <!-- Pilar 2: Modelado -->
        <div class="mb-24 reveal">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <!-- Constraint builder + Gantt visual (left) -->
            <div class="order-2 lg:order-1 relative">
              <div class="product-glass rounded-2xl p-6 relative z-10">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1" data-i18n="planifai.pillar2.viz.title">Constructor de restricciones</div>
                <div class="text-[10px] text-slate-400 mb-4" data-i18n="planifai.pillar2.viz.subtitle">Sin restricciones el plan parece rápido — pero es imposible de ejecutar</div>
                <!-- 4 constraint toggles -->
                <div class="grid grid-cols-2 gap-2 mb-5">
                  {[
                    { name: "Precedencia", nameI18n: "planifai.pillar2.viz.constraint1.name", sub: "Dependencias entre tareas", subI18n: "planifai.pillar2.viz.constraint1.sub", count: "8", icon: "M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" },
                    { name: "Capacidad", nameI18n: "planifai.pillar2.viz.constraint2.name", sub: "1 tarea por máquina", subI18n: "planifai.pillar2.viz.constraint2.sub", count: "3", icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" },
                    { name: "Material", nameI18n: "planifai.pillar2.viz.constraint3.name", sub: "Materiales a tiempo", subI18n: "planifai.pillar2.viz.constraint3.sub", count: "12", icon: "M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" },
                    { name: "Descanso", nameI18n: "planifai.pillar2.viz.constraint4.name", sub: "Turnos de personal", subI18n: "planifai.pillar2.viz.constraint4.sub", count: "4", icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" },
                  ].map((c) => (
                    <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                      <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style={`background: ${ACCENT};`}>
                        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="text-[11px] font-bold text-slate-800" data-i18n={c.nameI18n}>{c.name}</div>
