---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("arquea")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #22C55E */
const ACCENT_LIGHT = "#4ADE80";
const ACCENT_DARK = "#16A34A";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Biotecnología", i18nKey: "arquea.hero.tag1" },
  { label: "Bioseguridad", i18nKey: "arquea.hero.tag2" },
];

const heroChips = [
  { label: "Detección rápida", i18nKey: "arquea.hero.chip1" },
  { label: "Alta sensibilidad", i18nKey: "arquea.hero.chip2" },
  { label: "Resultados trazables", i18nKey: "arquea.hero.chip3" },
  { label: "Detección microbiológica", i18nKey: "arquea.hero.chip4" },
];

/* ── Strategic applications ────────────────────────── */
const strategicApps = [
  {
    title: "Vigilancia microbiológica de riesgo",
    titleI18n: "arquea.strategic.app1.title",
    desc: "Evolución de la plataforma hacia detección temprana de agentes biológicos de interés estratégico o patógenos de alto impacto, con tiempos de respuesta compatibles con alerta temprana.",
    descI18n: "arquea.strategic.app1.desc",
    icon: "M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  },
  {
    title: "Protección de infraestructuras críticas",
    titleI18n: "arquea.strategic.app2.title",
    desc: "Aplicación en puntos sensibles como agua, superficies de contacto, centros logísticos o instalaciones estratégicas donde una señal microbiológica temprana puede prevenir una interrupción mayor.",
    descI18n: "arquea.strategic.app2.desc",
    icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 7.5h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z",
  },
  {
    title: "Capacidades desplegables",
    titleI18n: "arquea.strategic.app3.title",
    desc: "Progresión hacia formatos modulares o semiportátiles que permitan monitorización microbiológica próxima al punto de uso con captura digital y trazabilidad operativa.",
    descI18n: "arquea.strategic.app3.desc",
    icon: "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
  },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF2", title: "Infraestructura técnica", description: "Apoyo a vigilancia microbiológica de sistemas y activos críticos." },
  { code: "AF4", title: "Protección de la Fuerza", description: "Capacidades de alerta temprana ante incidentes biológicos o contaminación." },
  { code: "AF6", title: "Sostenimiento 4.0", description: "Digitalización del dato microbiológico y soporte a protocolos de respuesta." },
];

const capacidadDestacada = {
  code: "Spin-off biotecnológica",
  title: "Contribución a protección, resiliencia y alerta temprana",
  description: "ARQUEA conecta detección rápida, digitalización y trazabilidad microbiológica, y se posiciona como una base tecnológica con potencial para reforzar capacidades de bioseguridad en entorno defensa.",
  note: "Spin-off biotecnológica de TheNextPangea con aplicación actual validada en entorno civil y líneas activas de I+D orientadas a estándares de defensa y bioseguridad.",
};
---

<Layout
  title="ARQUEA · TheNextPangea"
  description="Detección microbiológica avanzada para bioseguridad y protección estratégica. Plataforma orientada a la identificación rápida y fiable de microorganismos en entornos críticos."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="ARQUEA"
      backgroundImage={`${base}images/arquea/arquea_2.png`}
      tags={heroTags}
      titleI18n="arquea.hero.title"
      subtitle="Plataforma orientada a la identificación rápida y fiable de microorganismos en entornos críticos, con aplicación actual en seguridad alimentaria y arquitectura escalable hacia bioseguridad y defensa biológica."
      subtitleI18n="arquea.hero.subtitle"
      chips={heroChips}
      backI18n="arquea.hero.back"
      ctaPrimaryI18n="arquea.hero.cta.primary"
    >
      <span class="product-gradient-text">Detección microbiológica avanzada</span> para bioseguridad y protección estratégica
    </ProductHero>

    <!-- ════════════════ ACTIVO COMERCIAL ACTUAL – LifeTrace® ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-emerald-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="Activo comercial actual" i18nKey="arquea.lifetrace.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-6" data-i18n-html="arquea.lifetrace.title">
            LifeTrace® <span class="product-gradient-text">Surface Listeria Kit</span>
          </h2>

          <p class="text-lg text-slate-500 mb-12 max-w-3xl reveal delay-200" data-i18n="arquea.lifetrace.intro">
            La plataforma ya cuenta con una expresión comercial clara en seguridad alimentaria: detección rápida, operación guiada por app y un formato orientado a despliegue ágil en entorno productivo.
          </p>

          <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
            <!-- Stats + badges -->
            <div class="flex-1 reveal delay-200">
              <div class="grid sm:grid-cols-2 gap-6 mb-8">
                <!-- Stat: response time -->
                <div class="product-card group !p-6">
                  <p class="text-xs font-bold uppercase tracking-wider mb-2" style={`color: ${ACCENT};`} data-i18n="arquea.lifetrace.stat1.label">Tiempo de respuesta</p>
                  <p class="text-3xl font-extrabold text-slate-800 mb-1">&lt; 60 min</p>
                  <p class="text-sm text-slate-500" data-i18n="arquea.lifetrace.stat1.desc">Resultado operativo frente a métodos mucho más lentos.</p>
                </div>
                <!-- Stat: format -->
                <div class="product-card group !p-6">
                  <p class="text-xs font-bold uppercase tracking-wider mb-2" style={`color: ${ACCENT};`} data-i18n="arquea.lifetrace.stat2.label">Formato</p>
                  <p class="text-3xl font-extrabold text-slate-800 mb-1">Kit + app</p>
                  <p class="text-sm text-slate-500" data-i18n="arquea.lifetrace.stat2.desc">Uso guiado, captura de dato y lectura digital del resultado.</p>
                </div>
              </div>
              <!-- Badge -->
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold" style={`background: ${ACCENT}12; color: ${ACCENT};`}>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                <span data-i18n="arquea.lifetrace.badge">Spin-off validada en entorno civil</span>
              </div>
            </div>

            <!-- LifeTrace Kit image -->
            <div class="flex-shrink-0 w-full lg:w-5/12 reveal delay-300">
              <div class="relative group">
                <div class="absolute -inset-4 sm:-inset-6 rounded-[28px] blur-2xl pointer-events-none transition-opacity duration-500 opacity-40 group-hover:opacity-60" style={`background: radial-gradient(ellipse at center, ${ACCENT}25, transparent 70%);`} aria-hidden="true"></div>
                <div class="relative bg-white rounded-2xl shadow-[0_20px_70px_-15px_rgba(0,0,0,0.12)] border border-slate-200/80 overflow-hidden transition-shadow duration-500 group-hover:shadow-[0_25px_80px_-15px_rgba(0,0,0,0.18)]">
                  <img
                    src={`${base}images/arquea/arquea_1.png`}
                    alt="LifeTrace Surface Listeria Kit con app"
                    class="w-full h-auto transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                    loading="lazy"
                    data-i18n-alt="arquea.lifetrace.img.alt"
                  />
                </div>
                <div class="mx-8 sm:mx-12 h-4 bg-gradient-to-b from-slate-900/[0.04] to-transparent rounded-b-3xl" aria-hidden="true"></div>
              </div>
              <p class="text-sm text-slate-400 text-center mt-4" data-i18n="arquea.lifetrace.img.caption">LifeTrace® Surface Listeria Kit — Detección rápida con trazabilidad digital.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ EL RETO OPERATIVO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="absolute top-0 left-0 w-[400px] h-[400px] bg-emerald-50/30 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="arquea.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="arquea.challenge.title">
            Detectar amenazas microbiológicas <span class="product-gradient-text">antes de que se conviertan en incidentes operativos</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="arquea.challenge.p1">
              En entornos críticos, la detección microbiológica sigue dependiendo con frecuencia de <strong class="font-semibold">procesos lentos, centralizados y altamente dependientes de laboratorio</strong>, lo que limita la capacidad de reacción cuando el tiempo hasta resultado es determinante.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="arquea.challenge.p2">En seguridad alimentaria, agua, logística sensible o infraestructuras estratégicas, una contaminación biológica no detectada a tiempo puede comprometer continuidad operativa, activar protocolos de contención costosos y generar impacto sanitario y reputacional.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="arquea.challenge.p3">En escenarios de bioseguridad y defensa biológica, el reto va más allá del análisis: se necesita <strong class="font-semibold text-slate-700">detección rápida, fiable, trazable y progresivamente desplegable</strong>, para convertir la señal microbiológica en una decisión accionable.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="mb-6 reveal">
            <SectionLabel label="La solución" i18nKey="arquea.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-800 mb-8 reveal delay-100" data-i18n-html="arquea.solution.title">
            Detección microbiológica <span class="product-gradient-text">rápida, digital y orientada a operación</span>
          </h3>

          <div class="reveal delay-200 space-y-5 max-w-4xl mb-14">
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="arquea.solution.p1">
              <strong class="font-semibold text-slate-700">ARQUEA</strong> combina biología molecular, automatización y lectura digital para ofrecer una plataforma de detección microbiológica enfocada en identificar de forma rápida y fiable microorganismos en matrices complejas.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="arquea.solution.p2">
              Su base tecnológica ya se expresa en un caso de uso real: análisis in situ, tiempos de respuesta muy inferiores a los métodos tradicionales, operación simplificada y generación de resultados trazables que facilitan una respuesta más temprana.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n="arquea.solution.p3">
              Ese punto de partida convierte a ARQUEA en una plataforma con recorrido natural hacia aplicaciones de bioseguridad y defensa biológica, donde la rapidez de análisis y la calidad de la evidencia microbiológica son capacidades críticas.
            </p>
          </div>

          <!-- Solution image + stat cards -->
          <div class="max-w-5xl mx-auto reveal delay-300">
            <div class="relative group">
              <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-b from-emerald-200/20 via-slate-200/10 to-transparent rounded-[28px] blur-2xl pointer-events-none" aria-hidden="true"></div>
              <div class="relative bg-white rounded-2xl shadow-[0_20px_70px_-15px_rgba(0,0,0,0.12)] border border-slate-200/80 overflow-hidden transition-shadow duration-500 group-hover:shadow-[0_25px_80px_-15px_rgba(0,0,0,0.18)]">
                <img
                  src={`${base}images/arquea/arquea_3.png`}
                  alt="Panel de resultados y reporte digital de ARQUEA"
                  class="w-full h-auto transition-transform duration-700 ease-out group-hover:scale-[1.015]"
                  loading="lazy"
                  data-i18n-alt="arquea.solution.img.alt"
                />
              </div>
              <div class="mx-8 sm:mx-12 h-4 bg-gradient-to-b from-slate-900/[0.04] to-transparent rounded-b-3xl" aria-hidden="true"></div>
            </div>

            <!-- Stat cards below image -->
            <div class="grid sm:grid-cols-3 gap-4 mt-8">
              {[
                { label: "Lectura", value: "Digital y trazable", i18nLabel: "arquea.solution.stat1.label", i18nValue: "arquea.solution.stat1.value" },
                { label: "Uso", value: "Operación guiada", i18nLabel: "arquea.solution.stat2.label", i18nValue: "arquea.solution.stat2.value" },
                { label: "Salida", value: "Resultado accionable", i18nLabel: "arquea.solution.stat3.label", i18nValue: "arquea.solution.stat3.value" },
              ].map((stat) => (
                <div class="product-card group !p-5 text-center">
                  <p class="text-xs font-bold uppercase tracking-wider mb-1" style={`color: ${ACCENT};`} data-i18n={stat.i18nLabel}>{stat.label}</p>
                  <p class="text-sm font-semibold text-slate-800" data-i18n={stat.i18nValue}>{stat.value}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ APLICACIONES ESTRATÉGICAS ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Aplicaciones estratégicas" i18nKey="arquea.strategic.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-4 reveal" data-i18n-html="arquea.strategic.title">
            Aplicaciones <span class="product-gradient-text">estratégicas</span>
          </h2>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto reveal delay-200">
          {strategicApps.map((app, i) => (
            <div class="product-card group !p-6 text-center reveal" style={i > 0 ? `animation-delay: ${i * 0.1}s` : undefined}>
              <div class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center mb-4" style={`background: ${ACCENT}12;`}>
                <svg class="w-7 h-7" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={app.icon} /></svg>
              </div>
              <h3 class="font-bold text-slate-800 mb-2" data-i18n={app.titleI18n}>{app.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed" data-i18n={app.descI18n}>{app.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ ENCAJE BACSI ════════════════ -->
    <BacsiApplications
      accent={ACCENT}
      i18nPrefix="arquea"
      titleI18n="arquea.bacsi.title"
      labelI18n="arquea.bacsi.label"
      applications={aplicacionesBacsi}
      featuredItem={capacidadDestacada}
      featuredI18nKey="capacidad"
      bgClass="bg-white"
    />

    <!-- ════════════════ DESCUBRE ARQUEA ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="Spin-off biotecnológica" i18nKey="arquea.discover.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" /><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-6 reveal delay-100" data-i18n-html="arquea.discover.title">
            Descubre <span class="product-gradient-text">ARQUEA Biological Innovations</span>
          </h2>

          <p class="text-lg text-slate-500 mb-10 max-w-2xl mx-auto reveal delay-200" data-i18n="arquea.discover.desc">
            Si quieres ver en detalle qué hace ARQUEA y cómo funciona la plataforma, explora su web oficial con información completa sobre LifeTrace®, el sistema de detección microbiológica rápida, su arquitectura tecnológica y sus aplicaciones actuales.
          </p>

          <div class="reveal delay-300">
            <a
              href="https://arquea.bio/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm tracking-wide transition-all duration-300 hover:shadow-lg"
              style={`background: ${ACCENT}; color: #fff;`}
            >
              <span data-i18n="arquea.discover.cta">Visitar web de Arquea</span>
