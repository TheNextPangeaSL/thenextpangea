<!-- ═══════ Lightbox overlay ═══════ -->
<div id="imagia-lightbox" class="fixed inset-0 z-[9999] hidden" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="imagia-lightbox-backdrop"></div>
  <div class="relative flex flex-col items-center justify-center w-full h-full p-4 sm:p-8">
    <button
      type="button"
      id="imagia-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white rounded-full p-2.5 transition-colors duration-200 cursor-pointer"
      aria-label="Cerrar visor"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <img
      id="imagia-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-xl shadow-2xl object-contain transition-transform duration-300"
    />
    <p id="imagia-lightbox-caption" class="mt-4 text-sm text-white/70 text-center max-w-xl"></p>
  </div>
</div>

<style>
  /* Lightbox */
  #imagia-lightbox.is-visible {
    display: flex;
    animation: imagia-lb-in 0.25s ease-out;
  }
  #imagia-lightbox.is-hiding {
    animation: imagia-lb-out 0.2s ease-in forwards;
  }
  @keyframes imagia-lb-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes imagia-lb-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  #imagia-lightbox.is-visible #imagia-lightbox-img {
    animation: imagia-lb-zoom 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes imagia-lb-zoom {
    from { transform: scale(0.92); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }

  /* ── Lifecycle ── */

  /* Card stagger entrance */
  .ilc-card {
    opacity: 0;
    transform: translateY(12px);
    animation: ilcCardIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes ilcCardIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Card hover sync states */
  .ilc-card-inner { transition: all 0.2s ease; }
  .ilc-card.is-dimmed .ilc-card-inner { opacity: 0.35; }
  .ilc-card.is-active .ilc-card-inner {
    border-color: transparent;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }

  /* Ring entrance */
  .ilc-ring {
    opacity: 0;
    animation: ilcRingIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
  }
  @keyframes ilcRingIn {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Chevron fade-in */
  .ilc-chevron {
    opacity: 0;
    animation: ilcFade 0.3s ease forwards;
  }

  /* Ring node hover states */
  .ilc-ring-node { cursor: pointer; }
  .ilc-node-glow { transition: opacity 0.25s ease; }
  .ilc-node-border { transition: stroke-width 0.25s ease; }
  .ilc-ring-node.is-active .ilc-node-glow { opacity: 0.15 !important; }
  .ilc-ring-node.is-active .ilc-node-border { stroke-width: 3.5; }
  .ilc-ring-node.is-dimmed { opacity: 0.25; transition: opacity 0.25s ease; }

  /* Arc active state */
  .ilc-arc { transition: stroke-opacity 0.25s ease, stroke-width 0.25s ease; }
  .ilc-arc.is-active { stroke-opacity: 0.5; stroke-width: 5; }

  @keyframes ilcFade {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ilc-card { animation: none; opacity: 1; transform: none; }
    .ilc-ring { animation: none; opacity: 1; transform: none; }
    .ilc-chevron { animation: none; opacity: 1; }
  }
</style>

<script>
  (function () {
    const lightbox = document.getElementById('imagia-lightbox');
    const lbImg = document.getElementById('imagia-lightbox-img') as HTMLImageElement | null;
    const lbCaption = document.getElementById('imagia-lightbox-caption');
    if (!lightbox || !lbImg || !lbCaption) return;

    function open(src: string, caption: string) {
      lbImg!.src = src;
      lbImg!.alt = caption;
      lbCaption!.textContent = caption;
      lightbox!.classList.remove('hidden', 'is-hiding');
      lightbox!.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.add('is-hiding');
      lightbox!.addEventListener('animationend', function handler() {
        lightbox!.classList.remove('is-visible', 'is-hiding');
        lightbox!.classList.add('hidden');
        document.body.style.overflow = '';
        lbImg!.src = '';
        lightbox!.removeEventListener('animationend', handler);
      });
    }

    // Open triggers
    document.querySelectorAll('.imagia-lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = (btn as HTMLElement).dataset.img || '';
        const caption = (btn as HTMLElement).dataset.caption || '';
        open(src, caption);
      });
    });

    // Close triggers
    document.getElementById('imagia-lightbox-close')?.addEventListener('click', close);
    document.getElementById('imagia-lightbox-backdrop')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox!.classList.contains('is-visible')) close();
    });

    // ── Lifecycle: card ↔ ring hover sync ──
    const ilcCards = document.querySelectorAll('.ilc-card[data-step]');
    const ilcNodes = document.querySelectorAll('.ilc-ring-node[data-step]');
    const ilcArcs  = document.querySelectorAll('.ilc-arc[data-step]');

    function ilcActivate(stepId: string) {
      ilcCards.forEach((c) => {
        const el = c as HTMLElement;
        if (el.dataset.step === stepId) {
          el.classList.add('is-active');
          el.classList.remove('is-dimmed');
        } else {
          el.classList.remove('is-active');
          el.classList.add('is-dimmed');
        }
      });
      ilcNodes.forEach((n) => {
        const el = n as HTMLElement;
        if (el.dataset.step === stepId) {
          el.classList.add('is-active');
          el.classList.remove('is-dimmed');
        } else {
          el.classList.remove('is-active');
          el.classList.add('is-dimmed');
        }
      });
      ilcArcs.forEach((a) => {
        const el = a as HTMLElement;
        if (el.dataset.step === stepId) {
          el.classList.add('is-active');
        } else {
          el.classList.remove('is-active');
        }
      });
    }

    function ilcDeactivate() {
      ilcCards.forEach((c) => { c.classList.remove('is-active', 'is-dimmed'); });
      ilcNodes.forEach((n) => { n.classList.remove('is-active', 'is-dimmed'); });
      ilcArcs.forEach((a) => { a.classList.remove('is-active'); });
    }

    ilcCards.forEach((card) => {
      card.addEventListener('mouseenter', () => ilcActivate((card as HTMLElement).dataset.step || ''));
      card.addEventListener('mouseleave', ilcDeactivate);
    });

    ilcNodes.forEach((node) => {
      node.addEventListener('mouseenter', () => ilcActivate((node as SVGElement).dataset.step || ''));
      node.addEventListener('mouseleave', ilcDeactivate);
    });

  })();
</script>
