          </p>
        </div>

        <!-- ── Two columns: cards + ring ── -->
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 max-w-6xl mx-auto items-center">

          <!-- Left: compact cards -->
          <div class="w-full lg:w-[55%] space-y-3">
            {lifecycleSteps.map((s, i) => (
              <div
                class="ilc-card group"
                style={`animation-delay:${i * 0.06}s;`}
                data-step={s.step}
              >
                <div class="ilc-card-inner relative bg-white rounded-xl border border-slate-200/80 px-5 py-3.5 transition-all duration-200 hover:border-transparent hover:shadow-[0_4px_24px_rgba(0,0,0,0.07)] cursor-default overflow-hidden">

