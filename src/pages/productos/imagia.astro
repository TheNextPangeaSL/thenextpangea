---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";
import JsonLd from "@/components/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/lib/schemas";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";

import imgImagia1 from "@/assets/images/imagia/Imagia 1 - Detección automática de delaminación en rudder mediante métodos supervisados. Se analizan las señales en las tres dimensiones del ultrasonido.png";
import imgImagia2 from "@/assets/images/imagia/Imagia 2 - Galería de datos que permite previsualización en miniatura, navegación, filtrado y selección.png";
import imgImagia3 from "@/assets/images/imagia/Imagia 3 - Ensayo original sin preprocesado.png";
import imgImagia4 from "@/assets/images/imagia/Imagia 4 - Ensayo tras preprocesado TNP.png";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("imagia")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #1FA971 */
const ACCENT_LIGHT = "#4FC991";
const ACCENT_DARK = "#0F8B58";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Visión por Computador", i18nKey: "imagia.hero.tag1" },
  { label: "Deep Learning", i18nKey: "imagia.hero.tag2" },
  { label: "Datos Industriales", i18nKey: "imagia.hero.tag3" },
];

const heroChips = [
  { label: "Cloud y on-premise", i18nKey: "imagia.hero.chip1" },
  { label: "Deep Learning avanzado", i18nKey: "imagia.hero.chip2" },
  { label: "Fácil de usar", i18nKey: "imagia.hero.chip3" },
  { label: "Plataforma ligera", i18nKey: "imagia.hero.chip4" },
];

/* ── Evidence items ────────────────────────────────── */
const optimizedImg1 = await getImage({ src: imgImagia1, format: "webp", quality: 80 });
const optimizedImg2 = await getImage({ src: imgImagia2, format: "webp", quality: 80 });
const optimizedImg3 = await getImage({ src: imgImagia3, format: "webp", quality: 80 });
const optimizedImg4 = await getImage({ src: imgImagia4, format: "webp", quality: 80 });

const evidenceItems = [
  {
    src: optimizedImg1.src,
    alt: "Detección automática de delaminación en rudder con IMAGIA",
    altI18n: "imagia.evidence.img1.alt",
    caption: "Detección automática de delaminación en rudder mediante métodos supervisados. Se analizan las señales en las tres dimensiones del ultrasonido.",
    captionI18n: "imagia.evidence.img1.caption",
  },
  {
    src: optimizedImg3.src,
    alt: "Ensayo original sin preprocesado",
    altI18n: "imagia.evidence.img2.alt",
    caption: "Ensayo original sin preprocesado.",
    captionI18n: "imagia.evidence.img2.caption",
  },
  {
    src: optimizedImg4.src,
    alt: "Ensayo tras preprocesado TNP",
    altI18n: "imagia.evidence.img3.alt",
    caption: "Ensayo tras preprocesado TNP.",
    captionI18n: "imagia.evidence.img3.caption",
  },
];

/* ── Solution bullets ──────────────────────────────── */
const solutionBullets = [
  { text: "Cloud y on-premise: despliegue flexible adaptado a los requisitos de seguridad y conectividad de cada organización.", i18n: "imagia.solution.bullet1" },
  { text: "Plataforma web ligera: accesible desde cualquier navegador, sin instalaciones pesadas ni hardware especializado.", i18n: "imagia.solution.bullet2" },
  { text: "Interfaz intuitiva: operadores e ingenieros pueden gestionar datos, entrenar modelos y validar resultados sin necesidad de programar.", i18n: "imagia.solution.bullet3" },
  { text: "Deep Learning avanzado: técnicas estado del arte para casos complejos de detección y clasificación.", i18n: "imagia.solution.bullet4" },
];

/* ── Gestión de datos: formatos soportados ─────────── */
const dataFormats = [
  { name: "Ultrasonidos de transmisión", icon: "M9.348 14.652a3.75 3.75 0 0 1 0-5.304m5.304 0a3.75 3.75 0 0 1 0 5.304m-7.425 2.121a6.75 6.75 0 0 1 0-9.546m9.546 0a6.75 6.75 0 0 1 0 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788" },
  { name: "Ultrasonidos Pulso-Eco", icon: "M3.75 12h1.5m13.5 0h1.5m-16.5 3.75h1.5m13.5 0h1.5M5.636 5.636l1.06 1.06m10.608 10.608 1.06 1.06M5.636 18.364l1.06-1.06m10.608-10.608 1.06-1.06M12 2.25v1.5m0 16.5v1.5M8.25 12a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0Z" },
  { name: "Tomografías", icon: "M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" },
  { name: "Termografías", icon: "M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" },
  { name: "Radiografías", icon: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" },
];

/* ── Ciclo AI Lifecycle ────────────────────────────── */
const lifecycleSteps = [
  {
    step: 0,
    title: "Definición del caso de uso",
    description: "Análisis del problema, selección de la estrategia de modelado y definición del pipeline de preprocesado adaptado al tipo de dato y dominio específico.",
    detail: "Configuración de parámetros iniciales y criterios de éxito medibles.",
    color: "#059669",
    icon: "M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z",
  },
  {
    step: 1,
    title: "Recopilar e importar datos",
    description: "Importación masiva de datos industriales en múltiples formatos. La plataforma homogeneíza las fuentes y genera predicciones automáticas iniciales.",
    detail: "Soporte nativo para ultrasonidos, tomografías, termografías y radiografías.",
    color: "#2563EB",
    icon: "M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776",
  },
  {
    step: 2,
    title: "Validación y etiquetado",
    description: "Revisión y corrección de las pre-anotaciones generadas automáticamente. Los operadores validan, ajustan y enriquecen el etiquetado con herramientas intuitivas.",
    detail: "Aceleración del etiquetado hasta 10x frente a procesos manuales.",
    color: "#0891B2",
    icon: "M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z",
  },
  {
    step: 3,
    title: "Entrenamiento del modelo",
    description: "Entrenamiento de modelos de Deep Learning sobre los datos validados. IMAGIA selecciona y ajusta arquitecturas estado del arte para cada caso de uso.",
    detail: "Técnicas SOTA: segmentación, detección de objetos, clasificación.",
    color: "#7C3AED",
    icon: "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z",
  },
  {
    step: 4,
    title: "Despliegue del modelo",
    description: "Publicación del modelo entrenado como generador de pre-anotaciones para nuevos datos. Integración directa en el flujo de trabajo de inspección.",
    detail: "Despliegue en minutos, sin intervención de equipos de infraestructura.",
    color: "#DC2626",
    icon: "M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z",
  },
];

// ── Ring diagram layout (pentagon – 5 steps) ──
const RING_CX = 200, RING_CY = 200, RING_R = 135;
const ringPos = lifecycleSteps.map((_, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { x: Math.round(RING_CX + RING_R * Math.cos(a)), y: Math.round(RING_CY + RING_R * Math.sin(a)) };
});
const ringLabels = ["Caso de uso", "Importación", "Validación", "Entrenamiento", "Despliegue"];
const labelPos = [
  { dx: 0, dy: -28, anchor: "middle" },
  { dx: 28, dy: 5, anchor: "start" },
  { dx: 22, dy: 28, anchor: "start" },
  { dx: -22, dy: 28, anchor: "end" },
  { dx: -28, dy: 5, anchor: "end" },
];
const arrowMids = Array.from({length: 5}, (_, i) => {
  const a = (-54 + i * 72) * Math.PI / 180;
  return { x: Math.round(RING_CX + RING_R * Math.cos(a)), y: Math.round(RING_CY + RING_R * Math.sin(a)), rot: -54 + i * 72 + 90 };
});

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF5", title: "Seguridad en la operación", description: "Inspección automatizada basada en imagen para detectar anomalías en áreas operativas: revisión de superficies críticas, identificación temprana de degradación y apoyo a decisiones de intervención con evidencias trazables." },
  { code: "AF6", title: "Sostenimiento 4.0 y mantenimiento predictivo", description: "Detección temprana de defectos para priorizar inspecciones, anticipar fallos y reducir tiempos de análisis. Mejora la disponibilidad operativa con criterios objetivos y consistentes." },
  { code: "AF4", title: "Protección de la Fuerza", description: "Procesamiento de imágenes de inspección y sensórica visual para reforzar vigilancia técnica de infraestructuras sensibles, con detección de patrones anómalos y soporte a la toma de decisiones." },
];

const evidenciaDestacada = {
  code: "Evidencia técnica",
  title: "De la imagen a la decisión: validación, auditoría y mejora continua",
  description: "IMAGIA integra importación de datos desde distintas fuentes, homogeneización y gestión del etiquetado para construir modelos adaptados al entorno operativo. La plataforma permite validar resultados, registrar evidencias y mantener trazabilidad completa, facilitando auditoría técnica y decisiones proactivas en control de calidad e inspección.",
  note: "Aplicable a inspecciones rutinarias y extraordinarias, control de calidad y análisis post-incidente en infraestructuras y activos críticos.",
};

/* ── Helper: check icon SVG ────────────────────────── */
const checkIconPath = "M4.5 12.75l6 6 9-13.5";

/* ── Structured data (SEO) ─────────────────────────── */
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const productImageUrl = product.heroImage ? new URL(product.heroImage, Astro.site).href : undefined;
const productJsonLd = productSchema({
  name: product.name,
  description: product.tagline,
  url: productUrl,
  image: productImageUrl,
  category: categoryInfo?.label,
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: "Inicio", url: "https://bacsi.thenextpangea.com/" },
  { name: "Productos", url: "https://bacsi.thenextpangea.com/#products" },
  { name: product.name, url: productUrl },
]);
---

<Layout
  title="IMAGIA · TheNextPangea"
  description="Aceleración de etiquetado y generación de modelos de visión por computador. Plataforma para procesar datos industriales de visión automáticamente mediante algoritmos de IA."
  ogImage={product.heroImage}
  ogType="product"
>
  <Fragment slot="structured-data">
    <JsonLd data={productJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="IMAGIA"
      backgroundImage={`${base}images/Imagia.png`}
      tags={heroTags}
      titleI18n="imagia.hero.title"
      subtitle="Plataforma para procesar datos industriales de visión automáticamente mediante algoritmos de IA."
      subtitleI18n="imagia.hero.subtitle"
      chips={heroChips}
      backI18n="imagia.hero.back"
      ctaPrimaryI18n="imagia.hero.cta.primary"
    >
      <span class="product-gradient-text">Aceleración de etiquetado</span> y generación de modelos de visión por computador
    </ProductHero>

    <!-- ════════════════ EL RETO ════════════════ -->
    <section class="relative py-24 sm:py-32 bg-white overflow-hidden product-grid-pattern">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-violet-50/40 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="mb-8 reveal">
            <SectionLabel label="El reto operativo" i18nKey="imagia.challenge.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>

          <h2 class="reveal delay-100 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-8" data-i18n-html="imagia.challenge.title">
            Detectar defectos críticos con <span class="product-gradient-text">rapidez, precisión y trazabilidad</span>
          </h2>

          <div class="reveal delay-200 space-y-5">
            <p class="text-lg md:text-xl leading-relaxed text-slate-800/80" data-i18n-html="imagia.challenge.p1">
              En entornos industriales y de defensa, la inspección visual de activos críticos depende tradicionalmente de <strong class="font-semibold">revisiones manuales intensivas</strong>, con alta carga operativa y variabilidad en los resultados.
            </p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="imagia.challenge.p2">Microfisuras, corrosión, deformaciones o anomalías superficiales pueden pasar desapercibidas cuando existen grandes volúmenes de imágenes, condiciones ambientales variables o limitaciones de tiempo.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="imagia.challenge.p3">La necesidad no es solo inspeccionar, sino <strong class="font-semibold text-slate-700">detectar de forma temprana y consistente</strong> defectos estructurales que puedan comprometer seguridad, disponibilidad o sostenimiento operativo.</p>
            <p class="text-base leading-relaxed text-slate-500" data-i18n-html="imagia.challenge.p4">Aumentar la frecuencia de inspección sin incrementar proporcionalmente los recursos exige <strong class="font-semibold text-slate-700">automatización inteligente, precisión técnica y capacidad de adaptación</strong> a cada entorno operativo.</p>
          </div>

          <!-- Data formats supported -->
          <div class="mt-14">
            <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6 text-center reveal" data-i18n="imagia.data.subtitle">Soporte nativo para los principales tipos de ensayo no destructivo utilizados en la industria</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 reveal delay-200">
              {dataFormats.map((fmt, fmtIdx) => (
                <div class="product-card !p-5 flex flex-col items-center gap-3 text-center group hover:scale-[1.03] transition-transform">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center" style={`background: ${ACCENT}12;`}>
                    <svg class="w-6 h-6" style={`color: ${ACCENT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={fmt.icon} /></svg>
                  </div>
                  <span class="text-sm font-semibold text-slate-700 leading-tight" data-i18n={`imagia.data.format${fmtIdx + 1}`}>{fmt.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════ LA SOLUCIÓN ════════════════ -->
    <section class="imagia-solution relative py-24 sm:py-32 bg-[#f5f7fa] overflow-hidden">
      <!-- Decorative background elements -->
      <div class="absolute top-16 left-0 w-72 h-72 bg-gradient-to-br from-slate-200/40 to-transparent rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-gradient-to-tl from-slate-200/30 to-transparent rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">

        <!-- ── Centered header ── -->
        <div class="max-w-3xl mx-auto text-center mb-14">
          <div class="mb-6 reveal flex justify-center">
            <SectionLabel label="La solución" i18nKey="imagia.solution.label">
              <svg slot="icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
            </SectionLabel>
          </div>
          <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800 mb-5 reveal delay-100" data-i18n-html="imagia.solution.title">
            Inspección visual automatizada para detección <span class="product-gradient-text">temprana y trazable</span> de defectos
          </h3>
          <p class="text-lg text-slate-500 max-w-2xl mx-auto reveal delay-200" data-i18n-html="imagia.solution.p1">
            <strong class="font-semibold text-slate-700">IMAGIA</strong> es una plataforma de visión artificial diseñada para automatizar la inspección y mejorar la consistencia en la detección de defectos en activos críticos.
          </p>
        </div>

        <!-- ── Browser mockup (hero image) ── -->
        <div class="max-w-5xl mx-auto mb-16 reveal delay-200">
          <button
            type="button"
            class="imagia-lightbox-trigger group block w-full text-left cursor-pointer"
            data-img={optimizedImg2.src}
            data-caption="Galería de datos que permite previsualización en miniatura, navegación, filtrado y selección."
            aria-label="Ampliar imagen de la plataforma IMAGIA"
          >
            <div class="imagia-browser-frame relative">
              <!-- Outer glow -->
              <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-b from-slate-300/20 via-slate-200/10 to-transparent rounded-[28px] blur-2xl pointer-events-none" aria-hidden="true"></div>

              <!-- Browser window -->
              <div class="relative bg-white rounded-xl sm:rounded-2xl shadow-[0_20px_70px_-15px_rgba(0,0,0,0.15)] border border-slate-200/80 overflow-hidden transition-shadow duration-500 group-hover:shadow-[0_25px_80px_-15px_rgba(0,0,0,0.2)]">

                <!-- Browser chrome / title bar -->
                <div class="flex items-center gap-2 px-4 py-2.5 sm:py-3 bg-gradient-to-b from-slate-50 to-slate-100/80 border-b border-slate-200/80">
                  <!-- Traffic lights -->
                  <div class="flex items-center gap-1.5 mr-3">
