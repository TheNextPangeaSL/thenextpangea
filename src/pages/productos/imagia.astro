                      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h4 class="text-[14px] font-bold text-slate-800 leading-snug" data-i18n={`imagia.lifecycle.step${s.step}.title`}>{s.title}</h4>
                        <span class="text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded-full flex-shrink-0" style={`color:${s.color}; background:${s.color}0a;`}>{s.step + 1}</span>
                      </div>
                      <p class="text-xs text-slate-500 leading-relaxed" data-i18n={`imagia.lifecycle.step${s.step}.desc`}>{s.description}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Right: Ring diagram (desktop only) -->
          <div class="hidden lg:flex lg:w-[45%] justify-center">
            <svg class="ilc-ring w-full max-w-[420px]" viewBox="-50 -15 500 430" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagrama circular del ciclo de vida IA">

              {/* Background ring track */}
              <circle cx={RING_CX} cy={RING_CY} r={RING_R} stroke="#e2e8f0" stroke-width="2.5" fill="none" />

              {/* Colored arc segments */}
              {lifecycleSteps.map((s, i) => {
                const next = (i + 1) % 5;
                return (
                  <path
                    d={`M ${ringPos[i].x},${ringPos[i].y} A ${RING_R},${RING_R} 0 0,1 ${ringPos[next].x},${ringPos[next].y}`}
                    stroke={s.color} stroke-opacity="0.18" stroke-width="3" fill="none"
                    class="ilc-arc" data-step={s.step}
                  />
                );
              })}

              {/* Directional chevrons at midpoints */}
              {arrowMids.map((a, i) => (
                <g transform={`translate(${a.x},${a.y}) rotate(${a.rot})`} class="ilc-chevron" style={`animation-delay:${0.6 + i * 0.06}s;`}>
                  <path d="M-3.5,-4.5 L3,0 L-3.5,4.5" stroke="#94a3b8" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              ))}

              {/* Step nodes */}
              {lifecycleSteps.map((s, i) => {
                const p = ringPos[i];
                const lp = labelPos[i];
                return (
                  <g class="ilc-ring-node" data-step={s.step}>
                    {/* Glow (visible on hover/active) */}
                    <circle cx={p.x} cy={p.y} r="26" fill={s.color} opacity="0" class="ilc-node-glow" />
                    {/* White bg */}
                    <circle cx={p.x} cy={p.y} r="20" fill="white" />
                    {/* Colored ring */}
                    <circle cx={p.x} cy={p.y} r="20" fill="none" stroke={s.color} stroke-width="2.5" class="ilc-node-border" />
                    {/* Inner tint */}
                    <circle cx={p.x} cy={p.y} r="14" fill={s.color} opacity="0.06" />
                    {/* Number */}
                    <text x={p.x} y={p.y + 1} text-anchor="middle" dominant-baseline="middle" fill={s.color} font-size="14" font-weight="800" font-family="system-ui, -apple-system, sans-serif">{i + 1}</text>
                    {/* Label */}
                    <text x={p.x + lp.dx} y={p.y + lp.dy} text-anchor={lp.anchor} fill="#64748b" font-size="10" font-weight="600" font-family="system-ui, -apple-system, sans-serif" data-i18n={`imagia.lifecycle.ring${i}`}>{ringLabels[i]}</text>
                  </g>
                );
              })}

              {/* Center: cycle icon + text */}
              <circle cx="200" cy="200" r="38" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1" />
              <g transform="translate(200, 188)">
                <path transform="scale(1.2) translate(-10, -10)" fill="#94a3b8" fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
              </g>
              <text x="200" y="213" text-anchor="middle" fill="#94a3b8" font-size="8.5" font-weight="700" letter-spacing="1.5" font-family="system-ui, -apple-system, sans-serif" data-i18n="imagia.lifecycle.ringCenter">CICLO IA</text>
            </svg>
          </div>

        </div>

      </div>
    </section>

