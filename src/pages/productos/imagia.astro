<!-- ═══════ Lightbox overlay ═══════ -->
<div id="imagia-lightbox" class="fixed inset-0 z-[9999] hidden" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="imagia-lightbox-backdrop"></div>
  <div class="relative flex flex-col items-center justify-center w-full h-full p-4 sm:p-8">
    <button
      type="button"
      id="imagia-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white rounded-full p-2.5 transition-colors duration-200 cursor-pointer"
      aria-label="Cerrar visor"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <img
      id="imagia-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-xl shadow-2xl object-contain transition-transform duration-300"
    />
    <p id="imagia-lightbox-caption" class="mt-4 text-sm text-white/70 text-center max-w-xl"></p>
  </div>
</div>

<style>
  /* Lightbox */
  #imagia-lightbox.is-visible {
    display: flex;
    animation: imagia-lb-in 0.25s ease-out;
  }
  #imagia-lightbox.is-hiding {
    animation: imagia-lb-out 0.2s ease-in forwards;
  }
  @keyframes imagia-lb-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes imagia-lb-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  #imagia-lightbox.is-visible #imagia-lightbox-img {
    animation: imagia-lb-zoom 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes imagia-lb-zoom {
    from { transform: scale(0.92); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }

  /* ── Lifecycle ── */
  .ilc-track {
    stroke-dasharray: 942;
    stroke-dashoffset: 942;
    animation: ilc-draw 1.8s ease-out 0.3s forwards;
  }
  @keyframes ilc-draw {
    to { stroke-dashoffset: 0; }
  }

  .ilc-arc {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: ilc-arc-draw 2.5s ease-out 0.8s forwards;
  }
  @keyframes ilc-arc-draw {
    to { stroke-dashoffset: 0; }
  }

  .ilc-node {
    opacity: 0;
    animation: ilc-node-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes ilc-node-in {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.6); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  /* Highlighted state (via JS data-active) */
  .ilc-node[data-active="true"] {
    z-index: 30;
  }
  .ilc-node[data-active="true"] > div:nth-child(2) {
    transform: scale(1.2);
    box-shadow: 0 0 28px var(--node-color, #6B7280);
  }
  .ilc-node[data-active="true"] .ilc-node-ring {
    opacity: 1 !important;
    transform: scale(1.55);
  }
  .ilc-node[data-active="true"] .ilc-node-label {
    opacity: 1 !important;
  }

  /* Dim siblings when one is active */
  .ilc-ring.has-active .ilc-node:not([data-active="true"]) > div:nth-child(2) {
    opacity: 0.4;
    filter: grayscale(0.5);
  }
</style>

<script>
  (function () {
    const lightbox = document.getElementById('imagia-lightbox');
    const lbImg = document.getElementById('imagia-lightbox-img') as HTMLImageElement | null;
    const lbCaption = document.getElementById('imagia-lightbox-caption');
    if (!lightbox || !lbImg || !lbCaption) return;

    function open(src: string, caption: string) {
      lbImg!.src = src;
      lbImg!.alt = caption;
      lbCaption!.textContent = caption;
      lightbox!.classList.remove('hidden', 'is-hiding');
      lightbox!.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.add('is-hiding');
      lightbox!.addEventListener('animationend', function handler() {
        lightbox!.classList.remove('is-visible', 'is-hiding');
        lightbox!.classList.add('hidden');
        document.body.style.overflow = '';
        lbImg!.src = '';
        lightbox!.removeEventListener('animationend', handler);
      });
    }

    // Open triggers
    document.querySelectorAll('.imagia-lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = (btn as HTMLElement).dataset.img || '';
        const caption = (btn as HTMLElement).dataset.caption || '';
        open(src, caption);
      });
    });

    // Close triggers
    document.getElementById('imagia-lightbox-close')?.addEventListener('click', close);
    document.getElementById('imagia-lightbox-backdrop')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox!.classList.contains('is-visible')) close();
    });

    // ── Lifecycle hover interaction ──
    const ring = document.querySelector('.ilc-ring');
    const steps = document.querySelectorAll('.ilc-step');
    const nodes = document.querySelectorAll('.ilc-node');

    function activateStep(stepId: string) {
      ring?.classList.add('has-active');
      steps.forEach((el) => {
        if ((el as HTMLElement).dataset.step === stepId) {
          el.classList.add('!border-slate-200', '!bg-white', '!shadow-lg');
        } else {
          (el as HTMLElement).style.opacity = '0.45';
        }
      });
      nodes.forEach((el) => {
        (el as HTMLElement).dataset.active = (el as HTMLElement).dataset.step === stepId ? 'true' : 'false';
      });
    }

    function deactivateAll() {
      ring?.classList.remove('has-active');
      steps.forEach((el) => {
        el.classList.remove('!border-slate-200', '!bg-white', '!shadow-lg');
        (el as HTMLElement).style.opacity = '';
      });
      nodes.forEach((el) => {
        (el as HTMLElement).dataset.active = 'false';
      });
    }

    steps.forEach((step) => {
      step.addEventListener('mouseenter', () => activateStep((step as HTMLElement).dataset.step || ''));
      step.addEventListener('mouseleave', deactivateAll);
    });

    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => activateStep((node as HTMLElement).dataset.step || ''));
      node.addEventListener('mouseleave', deactivateAll);
    });
  })();
</script>
