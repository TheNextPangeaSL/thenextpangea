---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import ProductPageWrapper from "@/components/product/ProductPageWrapper.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import SectionLabel from "@/components/product/SectionLabel.astro";
import BacsiApplications from "@/components/product/BacsiApplications.astro";
import ProductCTA from "@/components/product/ProductCTA.astro";
import { getProductBySlug, getCategoryInfo } from "@/data/products";

const base = import.meta.env.BASE_URL;
const product = getProductBySlug("fpgas")!;
const categoryInfo = getCategoryInfo(product.category);

const ACCENT = product.hexColor;       /* #0c7907 */
const ACCENT_LIGHT = "#15a30e";
const ACCENT_DARK = "#096306";

/* ── Hero data ─────────────────────────────────────── */
const heroTags = [
  { label: "Inteligencia Artificial", i18nKey: "fpgas.hero.tag1" },
  { label: "Hardware Embebido", i18nKey: "fpgas.hero.tag2" },
];

const heroChips = [
  { label: "Aceleración en FPGA", i18nKey: "fpgas.hero.chip1" },
  { label: "Procesamiento en tiempo real", i18nKey: "fpgas.hero.chip2" },
  { label: "Fusión de sensores", i18nKey: "fpgas.hero.chip3" },
  { label: "Hardware reconfigurable", i18nKey: "fpgas.hero.chip4" },
];

/* ── Comparison table data ─────────────────────────── */
const comparisonRows = [
  { label: "Tamaño típico para integración (mm)", hailo: "22 × 42", jetson: "69.6 × 45", fpga: "77 × 60", fpgaHighlight: false },
  { label: "Consumo", hailo: "Bajo", jetson: "Medio", fpga: "Mínimo", fpgaHighlight: true },
  { label: "Potencia para modelos complejos", hailo: "Media", jetson: "Muy alta", fpga: "Adaptable", fpgaHighlight: false },
  { label: "Latencia", hailo: "Baja", jetson: "Baja", fpga: "Mínima", fpgaHighlight: true },
  { label: "Flexibilidad de modelos", hailo: "Media", jetson: "Alta", fpga: "Baja / variable", fpgaHighlight: false },
  { label: "Esfuerzo de portado", hailo: "Medio", jetson: "Bajo", fpga: "Alto", fpgaHighlight: false },
  { label: "Determinismo y robustez", hailo: "Media", jetson: "Media", fpga: "Muy alta", fpgaHighlight: true },
  { label: "Coste", hailo: "$", jetson: "$$", fpga: "$$ - $$$", fpgaHighlight: false },
];

/* ── Aplicaciones BACSI ────────────────────────────── */
const aplicacionesBacsi = [
  { code: "AF3", title: "GIC y optimización de procesos", description: "IA embebida para análisis local de datos, automatización operativa y soporte a decisiones en tiempo real." },
  { code: "AF4", title: "Protección de la Fuerza", description: "Procesamiento embarcado de visión y sensores para vigilancia, detección y respuesta rápida en sistemas autónomos y distribuidos." },
  { code: "AF6", title: "Sostenimiento 4.0", description: "Sensórica inteligente y algoritmos embebidos para monitorización, diagnóstico y mantenimiento con mayor autonomía operativa." },
];

const capacidadDestacada = {
  code: "Capacidad diferencial",
  title: "Inteligencia artificial embebida en hardware para aplicaciones críticas",
  description: "FPGAs permite desplegar inteligencia artificial directamente en hardware embebido, priorizando latencia mínima, determinismo y eficiencia energética en aplicaciones críticas de visión, sensórica y autonomía embarcada.",
  note: "Aplicable a sistemas autónomos, sensores inteligentes, UAVs y plataformas embarcadas donde la respuesta en tiempo real y la continuidad operativa son críticas.",
};
---

<Layout
  title="Edge AI / FPGAs · TheNextPangea"
  description="Arquitecturas de IA desplegadas directamente en hardware embebido capaces de procesar datos en tiempo real con latencia mínima, autonomía operativa y alta eficiencia energética."
>
  <Navbar slot="nav" />

  <ProductPageWrapper accent={ACCENT} accentLight={ACCENT_LIGHT} accentDark={ACCENT_DARK}>

    <!-- ════════════════ HERO ════════════════ -->
    <ProductHero
      accent={ACCENT}
      productName="EDGE AI · FPGA"
      backgroundImage={`${base}images/fpgas-bg.png`}
      tags={heroTags}
      tagSeparator="·"
      titleI18n="fpgas.hero.title"
      subtitle="Arquitecturas de IA desplegadas directamente en hardware embebido capaces de procesar datos en tiempo real con latencia mínima, autonomía operativa y alta eficiencia energética."
      subtitleI18n="fpgas.hero.subtitle"
      chips={heroChips}
      backI18n="fpgas.hero.back"
      ctaPrimaryLabel="Solicitar más información"
      ctaPrimaryI18n="fpgas.hero.cta.primary"
    >
      Inteligencia artificial embebida para dispositivos autónomos
    </ProductHero>

    <!-- ════════════════ EL RETO + LA SOLUCIÓN ════════════════ -->
    <section class="relative py-20 lg:py-28 bg-white overflow-hidden border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">

        <!-- ── El reto operativo ── -->
        <div class="bg-white border border-slate-200 rounded-lg p-8 md:p-12 shadow-sm relative overflow-hidden reveal">
          <div class="absolute left-0 top-0 bottom-0 w-1.5" style={`background: color-mix(in srgb, ${ACCENT} 60%, white);`}></div>

          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4 pl-4" data-i18n="fpgas.challenge.label">
            El reto operativo
          </div>

          <div class="pl-4">
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-900 mb-6 leading-snug" data-i18n="fpgas.challenge.title">
              Ejecutar inteligencia artificial directamente en el dispositivo
            </h2>

            <div class="max-w-4xl space-y-4 text-slate-700 leading-relaxed">
              <p data-i18n-html="fpgas.challenge.p1">
                Muchas aplicaciones de inteligencia artificial dependen de
                <strong class="font-semibold">infraestructuras cloud o centros de datos</strong> para procesar grandes volúmenes de información.
                Sin embargo, en entornos operativos reales, especialmente en sistemas autónomos o embarcados,
                esta dependencia no siempre es viable.
              </p>

              <p data-i18n-html="fpgas.challenge.p2">
                Los dispositivos deben ser capaces de <strong class="font-semibold">procesar datos localmente</strong>,
                cerca del sensor y en tiempo real, incluso en escenarios con conectividad limitada
                o inexistente.
              </p>

              <p data-i18n-html="fpgas.challenge.p3">
                Esto introduce desafíos técnicos importantes: los sistemas deben ofrecer
                <strong class="font-semibold">baja latencia, consumo energético reducido y comportamiento determinista</strong>,
                manteniendo al mismo tiempo capacidad suficiente para ejecutar modelos de IA complejos.
              </p>

              <p data-i18n-html="fpgas.challenge.p4">
                Las arquitecturas convencionales no siempre cumplen estos requisitos,
                especialmente cuando se busca integrar inteligencia artificial directamente en
                <strong class="font-semibold">plataformas compactas, sensores inteligentes o sistemas autónomos distribuidos</strong>.
              </p>

              <p data-i18n-html="fpgas.challenge.p5">
                El reto no es únicamente ejecutar modelos de IA, sino
                <strong class="font-semibold">hacerlo de forma eficiente, fiable y embebida en el propio sistema</strong>,
                permitiendo decisiones rápidas directamente en el entorno operativo.
              </p>
            </div>
          </div>
        </div>

        <!-- ── La solución ── -->
        <div class="mt-14">
          <div class="flex items-center gap-4 mb-8 reveal">
            <h3 class="text-sm font-bold uppercase tracking-wider" style={`color: color-mix(in srgb, ${ACCENT} 60%, white);`} data-i18n="fpgas.solution.label">
              La solución
            </h3>
            <div class="h-px bg-slate-200 flex-1"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

            <!-- TEXTO -->
            <div class="lg:col-span-6 reveal">
