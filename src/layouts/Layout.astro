---
import "../styles/global.css";
import { Image } from 'astro:assets';
import tnpLogoFooter from '@/assets/Logo/TNP_logo_WHITE.png';
import CookieConsent from "@/components/CookieConsent.astro";
import ParticleNetwork from "@/components/ParticleNetwork.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { organizationSchema } from "@/lib/schemas";
import {
    products,
    categories,
    getProductsByCategory,
    getProductUrl,
    isExternalProduct,
} from "@/data/products";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    ogType?: "website" | "product";
    noindex?: boolean;
}

const {
    title = "TheNextPangea S.L. — Expertos en Tecnologías eXponenciales",
    description = "TheNextPangea es una empresa de base tecnológica experta en tecnologías eXponenciales. Combinamos IA, Big Data, Fabricación Avanzada, NanoTecnología, BioTecnología y más para crear productos tecnológicos innovadores para la industria.",
    ogImage,
    ogType = "website",
    noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage
    ? new URL(ogImage, Astro.site).href
    : new URL("/og/og-default.png", Astro.site).href;
const robotsContent = noindex ? "noindex, follow" : "index, follow";
const isSubPage = Astro.url.pathname.includes("/productos/") || Astro.url.pathname.includes("/proyectos-de-investigacion") || Astro.url.pathname.includes("/politica-de-cookies") || Astro.url.pathname.includes("/aviso-legal") || Astro.url.pathname.includes("/politica-privacidad") || Astro.url.pathname.includes("/contacto");
const sectionHref = (hash: string) => (isSubPage ? `${base}${hash}` : hash);

// Footer product helpers
const pUrl = (slug: string) => {
    const p = products.find(pr => pr.slug === slug);
    return p ? getProductUrl(p, import.meta.env.BASE_URL) : '#';
};
const pExt = (slug: string) => {
    const p = products.find(pr => pr.slug === slug);
    return p && isExternalProduct(p) ? { target: "_blank" as const, rel: "noopener noreferrer" } : {};
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content="TheNextPangea S.L." />
        <meta name="robots" content={robotsContent} />
        <meta name="language" content="Spanish" />
        <meta http-equiv="content-language" content="es" />
        <meta name="generator" content={Astro.generator} />

        <!-- Canonical + hreflang -->
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="es" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType === "product" ? "product" : "website"} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content="TheNextPangea" />
        <meta property="og:locale" content="es_ES" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        <!-- Favicon – use the anagram as favicon -->
        <link
            rel="icon"
            type="image/png"
            href={`${import.meta.env.BASE_URL}Logo/TNP_anagrama_WHITE.png`}
        />

        <!-- Self-hosted fonts (see global.css for @font-face) -->
        <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

        <title>{title}</title>

        <!-- Structured Data: Organization (every page) -->
        <JsonLd data={organizationSchema()} />
        <slot name="structured-data" />
    </head>

    <body
        class="min-h-dvh flex flex-col bg-pangea-white text-pangea-dark-blue font-inter antialiased selection:bg-pangea-calm-blue/30 selection:text-pangea-dark-blue"
    >
        <!-- Skip to content link for accessibility -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-pangea-dark-blue focus:text-pangea-white focus:text-sm focus:font-semibold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-pangea-sky-blue"
        >
            Saltar al contenido
        </a>

        <!-- Navigation -->
        <slot name="nav" />

        <!-- Main Content -->
        <main id="main-content" class="flex-1">
            <slot />
        </main>

        <!-- Footer -->
        <footer class="relative w-full bg-pangea-dark-blue text-pangea-white overflow-hidden">
            <ParticleNetwork />
            <!-- Upper footer -->
            <div class="max-w-7xl mx-auto px-6 sm:px-10 py-14">
                <div
                    class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-12 md:gap-8"
                >
                    <!-- Brand column -->
                    <div class="flex flex-col gap-5">
                        <Image src={tnpLogoFooter} alt="TheNextPangea" class="h-10 w-auto self-start" width={200} height={40} loading="lazy" />
                        <p
                            class="text-sm text-pangea-white/70 leading-relaxed max-w-xs"
                            data-i18n="footer.description"
                        >
                            Expertos en tecnologías eXponenciales aplicadas
                            a defensa, energía e industria. Creamos activos
                            intangibles de alto valor.
                        </p>
                    </div>

                    <!-- Quick links column -->
                    <div class="flex flex-col gap-4">
                        <h4
                            class="text-xs font-bold uppercase tracking-widest text-pangea-sky-blue"
                            data-i18n="footer.quickLinks"
                        >
                            Enlaces Rápidos
                        </h4>
                        <nav
                            class="flex flex-col gap-2.5 text-sm text-pangea-white/65"
                        >
                            <a
                                href={sectionHref("#about")}
                                class="hover:text-pangea-white transition-colors duration-200"
                                data-i18n="nav.about"
                            >
                                Sobre Nosotros
                            </a>
                            <a
                                href={sectionHref("#services")}
                                class="hover:text-pangea-white transition-colors duration-200"
                                data-i18n="nav.technologies"
                            >
                                Tecnologías
                            </a>
                            <a
                                href={sectionHref("#research")}
                                class="hover:text-pangea-white transition-colors duration-200"
                                data-i18n="nav.research"
                            >
                                I+D
                            </a>
                            <a
                                href={sectionHref("#contact")}
                                class="hover:text-pangea-white transition-colors duration-200"
                                data-i18n="nav.contact"
                            >
                                Contacto
                            </a>
                        </nav>
                    </div>

                    <!-- Products column -->
                    <div
                        class="flex flex-col gap-4 md:col-span-3 lg:col-span-2"
                    >
                        <h4
                            class="text-xs font-bold uppercase tracking-widest text-pangea-sky-blue"
                        >
                            Productos
                        </h4>
                        <div class="grid grid-cols-2 gap-x-8 gap-y-4 text-sm text-pangea-white/65">
                            <!-- Left column -->
                            <div class="flex flex-col gap-1.5">
                                <span class="text-[11px] font-semibold uppercase tracking-wider text-pangea-white/40 mb-0.5">Inteligencia Artificial</span>
                                <a href={pUrl('dxter')} class="hover:text-pangea-white transition-colors duration-200" {...pExt('dxter')}>DxTER</a>
                                <a href={pUrl('planifai')} class="hover:text-pangea-white transition-colors duration-200">PlanifAI</a>
                                <a href={pUrl('buscai')} class="hover:text-pangea-white transition-colors duration-200">BuscAI</a>
                                <a href={pUrl('imagia')} class="hover:text-pangea-white transition-colors duration-200">IMAGIA</a>
                                <a href={pUrl('fast-reporting-tool')} class="hover:text-pangea-white transition-colors duration-200">Fast Reporting Tool</a>
                                <a href={pUrl('fpgas')} class="hover:text-pangea-white transition-colors duration-200">Edge AI / FPGAs</a>
                            </div>
                            <!-- Right column -->
                            <div class="flex flex-col gap-1.5">
                                <span class="text-[11px] font-semibold uppercase tracking-wider text-pangea-white/40 mb-0.5">Ciencia de Materiales</span>
                                <a href={pUrl('sensorica')} class="hover:text-pangea-white transition-colors duration-200">Sensorica</a>
                                <a href={pUrl('heaters')} class="hover:text-pangea-white transition-colors duration-200">Heaters</a>
                                <a href={pUrl('antifriccion')} class="hover:text-pangea-white transition-colors duration-200">Antifricción</a>

                                <span class="text-[11px] font-semibold uppercase tracking-wider text-pangea-white/40 mt-3 mb-0.5">Fabricación Aditiva</span>
                                <a href={pUrl('aditive-algorithm')} class="hover:text-pangea-white transition-colors duration-200">Aditive Algorithm</a>
                                <a href={pUrl('aditive-manufacturing')} class="hover:text-pangea-white transition-colors duration-200">Aditive Manufacturing</a>

                                <span class="text-[11px] font-semibold uppercase tracking-wider text-pangea-white/40 mt-3 mb-0.5">Biotecnología</span>
                                <a href={pUrl('arquea')} class="hover:text-pangea-white transition-colors duration-200" {...pExt('arquea')}>ARQUEA</a>
                            </div>
                        </div>
                        <a
                            href={sectionHref('#products')}
                            class="text-sm text-pangea-sky-blue hover:text-pangea-white transition-colors duration-200 inline-flex items-center gap-1.5 mt-1"
                        >
                            Ver todos los productos <span class="text-base">→</span>
                        </a>
                    </div>

                    <!-- Contact column -->
                    <div class="flex flex-col gap-4">
                        <h4
                            class="text-xs font-bold uppercase tracking-widest text-pangea-sky-blue"
                            data-i18n="footer.contact"
                        >
                            Contacto
                        </h4>
                        <div
                            class="flex flex-col gap-2.5 text-sm text-pangea-white/65"
                        >
                            <a
                                href="mailto:contact@thenextpangea.com"
                                class="hover:text-pangea-white transition-colors duration-200 inline-flex items-center gap-2"
                            >
                                <svg
                                    class="w-4 h-4 shrink-0"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                                    ></path>
                                </svg>
                                contact@thenextpangea.com
                            </a>
                            <a
                                href="https://www.linkedin.com/company/thenextpangea"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-pangea-white transition-colors duration-200 inline-flex items-center gap-2"
                            >
                                <svg
                                    class="w-4 h-4 shrink-0"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                    ></path>
                                </svg>
                                LinkedIn
                            </a>
                            <p class="inline-flex items-center gap-2">
                                <svg
                                    class="w-4 h-4 shrink-0"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                                    ></path>
                                </svg>
                                <span data-i18n="footer.location"
                                    >Asturias, España</span
                                >
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="border-t border-pangea-classic-blue/30">
                <div
                    class="max-w-7xl mx-auto px-6 sm:px-10 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-pangea-white/50"
                >
                    <p>
                        &copy; {new Date().getFullYear()}
                        <span data-i18n="footer.copyright"
                            >TheNextPangea S.L. · Todos los derechos reservados.</span
                        >
                    </p>
                    <div class="flex items-center gap-4 flex-wrap justify-center">
                        <a
                            href={`${base}aviso-legal/`}
                            class="hover:text-pangea-white transition-colors duration-200"
                            data-i18n="footer.legal"
                        >
                            Aviso Legal
                        </a>
                        <span class="text-pangea-classic-blue/30">&middot;</span
                        >
                        <a
                            href={`${base}politica-privacidad/`}
                            class="hover:text-pangea-white transition-colors duration-200"
                            data-i18n="footer.privacy"
                        >
                            Política de Privacidad
                        </a>
                        <span class="text-pangea-classic-blue/30">&middot;</span
                        >
                        <a
                            href={`${base}politica-de-cookies/`}
                            class="hover:text-pangea-white transition-colors duration-200"
                            data-i18n="footer.cookies"
                        >
                            Cookies
                        </a>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Intersection Observer for scroll reveal animations -->
        <script>
            function initReveal() {
                const revealClasses = [
                    ".reveal",
                    ".reveal-left",
                    ".reveal-right",
                    ".reveal-scale",
                ];

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
                );

                revealClasses.forEach((cls) => {
                    document.querySelectorAll(cls).forEach((el) => {
                        observer.observe(el);
                    });
                });
            }

            // Run on initial load
            document.addEventListener("DOMContentLoaded", initReveal);
            // Run on Astro page transitions
            document.addEventListener("astro:page-load", initReveal);
        </script>

        <!-- Navbar scroll behavior -->
        <script>
            function initNavbar() {
                const navbar = document.getElementById("navbar");
                if (!navbar) return;

                let lastScroll = 0;

                window.addEventListener("scroll", () => {
                    const currentScroll = window.scrollY;

                    if (currentScroll > 80) {
                        navbar.classList.add("nav-scrolled");
                    } else {
                        navbar.classList.remove("nav-scrolled");
                    }

                    lastScroll = currentScroll;
                });
            }

            document.addEventListener("DOMContentLoaded", initNavbar);
            document.addEventListener("astro:page-load", initNavbar);
        </script>

        <!-- Cookie Consent -->
        <CookieConsent />

        <!-- i18n initialization -->
        <script>
            import { initI18n, translations } from "@/i18n/index";

            // Expose translations globally for components that need them (e.g., dynamic tag rendering)
            (window as any).__pangea_translations = translations;

            function startI18n() {
                initI18n();
            }

            document.addEventListener("DOMContentLoaded", startI18n);
            document.addEventListener("astro:page-load", startI18n);
        </script>
    </body>
</html>
