---
/**
 * Reusable "Aplicaciones en Defensa (BACSI)" section for product pages.
 *
 * Renders a grid of application cards + a highlighted featured-item card.
 * Colour comes from the product-page CSS custom properties and the `accent` prop
 * (needed for inline badge styles).
 */

interface BacsiApp {
  code: string;
  title: string;
  description: string;
}

interface FeaturedItem {
  code: string;
  title: string;
  description: string;
  note: string;
}

interface Props {
  accent: string;
  i18nPrefix: string;
  applications: BacsiApp[];
  featuredItem: FeaturedItem;
  featuredI18nKey: string;
  bgClass?: string;
  titleI18n: string;
  labelI18n: string;
}

const {
  accent,
  i18nPrefix,
  applications,
  featuredItem,
  featuredI18nKey,
  bgClass = "bg-white",
  titleI18n,
  labelI18n,
} = Astro.props;
---

<section class={`relative py-24 sm:py-32 overflow-hidden ${bgClass}`}>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <div class="product-section-label mx-auto mb-5 reveal">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <span data-i18n={labelI18n}>Aplicaciones</span>
      </div>
      <h2
        class="reveal text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-800"
        data-i18n-html={titleI18n}
      >
        Aplicaciones en entorno <span class="product-gradient-text">Defensa (BACSI)</span>
      </h2>
    </div>

    <!-- Application cards grid -->
    <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {applications.map((app, index) => (
        <div class="product-card" style={`animation-delay: ${index * 80 + 100}ms;`}>
          <span
            class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider mb-4"
            style={`background: ${accent}; color: #fff;`}
            data-i18n={`${i18nPrefix}.defense.app${index + 1}.code`}
          >
            {app.code}
          </span>
          <h3
            class="text-lg font-bold text-slate-800 mb-3"
            data-i18n={`${i18nPrefix}.defense.app${index + 1}.title`}
          >
            {app.title}
          </h3>
          <p
            class="text-sm text-slate-500 leading-relaxed"
            data-i18n={`${i18nPrefix}.defense.app${index + 1}.desc`}
          >
            {app.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Featured item -->
    <div class="reveal delay-100">
      <div class="product-card !p-8 md:!p-10">
        <div class="flex flex-col md:flex-row gap-6 md:gap-10">
          <div class="flex-1">
            <span
              class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider mb-4"
              style={`background: ${accent}; color: #fff;`}
              data-i18n={`${i18nPrefix}.defense.${featuredI18nKey}.code`}
            >
              {featuredItem.code}
            </span>
            <h3
              class="text-lg font-bold text-slate-800 mb-3"
              data-i18n={`${i18nPrefix}.defense.${featuredI18nKey}.title`}
            >
              {featuredItem.title}
            </h3>
            <p
              class="text-sm text-slate-500 leading-relaxed"
              data-i18n={`${i18nPrefix}.defense.${featuredI18nKey}.desc`}
            >
              {featuredItem.description}
            </p>
          </div>
          <div class="flex-shrink-0 md:w-1/3 flex items-center">
            <p
              class="text-xs text-slate-400 leading-relaxed italic border-l-2 pl-4"
              style={`border-color: ${accent}44;`}
              data-i18n={`${i18nPrefix}.defense.${featuredI18nKey}.note`}
            >
              {featuredItem.note}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
