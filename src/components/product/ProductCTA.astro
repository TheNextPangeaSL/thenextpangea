---
/**
 * Reusable CTA (Call-to-Action) section for product pages.
 *
 * Renders a heading with the product name in gradient text,
 * a description paragraph, action buttons (contact, dossier, all products)
 * and a QR-code placeholder.
 */

interface Props {
  accent: string;
  productName: string;
  i18nPrefix: string;
  description: string;
  bgClass?: string;
}

const {
  accent,
  productName,
  i18nPrefix,
  description,
  bgClass = "bg-[#f5f7fa]",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<section class={`relative py-24 sm:py-32 overflow-hidden ${bgClass}`}>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="reveal">
        <div class="grid md:grid-cols-[1fr_auto] gap-10 items-center">
          <!-- Text + buttons -->
          <div class="text-center md:text-left">
            <h2
              class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-800 mb-5"
              data-i18n-html={`${i18nPrefix}.cta.title`}
            >
              ¿Quieres evaluar <span class="product-gradient-text">{productName}</span> en tu caso de uso?
            </h2>

            <p
              class="text-lg text-slate-500 mb-8"
              data-i18n={`${i18nPrefix}.cta.desc`}
            >
              {description}
            </p>

            <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-4">
              <!-- Contact -->
              <a
                href={`${base}#contact`}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm tracking-wide transition-all duration-300 hover:shadow-lg"
                style={`background: ${accent}; color: #fff;`}
              >
                <span data-i18n={`${i18nPrefix}.cta.button`}>Contactar</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>

              <!-- Dossier (disabled) -->
              <button
                type="button"
                disabled
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm tracking-wide border border-slate-200 transition-all duration-300 text-slate-400 bg-white cursor-not-allowed"
              >
                <svg class="w-5 h-5 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 2l5 5h-5V4zm-2.5 9.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5zm0 3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5z" />
                </svg>
                <span data-i18n={`${i18nPrefix}.cta.button.disabled`}>Descargar dossier</span>
              </button>

              <!-- All products -->
              <a
                href={`${base}#products`}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm tracking-wide border border-slate-300 text-slate-600 transition-all duration-300 hover:bg-slate-100 hover:border-slate-400"
                data-i18n={`${i18nPrefix}.cta.button.secondary`}
              >
                Ver todos los productos
              </a>
            </div>
          </div>

          <!-- QR placeholder -->
          <div class="flex flex-col items-center gap-3 shrink-0">
            <div class="w-36 h-36 bg-white rounded-2xl shadow-md border border-slate-200 flex items-center justify-center p-3">
              <div class="w-full h-full rounded-lg bg-slate-50 flex flex-col items-center justify-center gap-2">
                <svg class="w-10 h-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.75h.75v.75H6v-.75ZM6 16.5h.75v.75H6v-.75ZM16.125 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.125h.75v.75h-.75v-.75ZM19.125 13.5h.75v.75h-.75v-.75ZM19.125 19.125h.75v.75h-.75v-.75ZM16.125 16.125h.75v.75h-.75v-.75Z" />
                </svg>
                <span
                  class="text-[9px] font-semibold text-slate-300 uppercase tracking-wider"
                  data-i18n={`${i18nPrefix}.cta.qr.label`}
                >
                  QR vCard
                </span>
              </div>
            </div>
            <span
              class="text-xs text-slate-400 font-medium"
              data-i18n={`${i18nPrefix}.cta.qr.scan`}
            >
              Escanea para contactar
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
