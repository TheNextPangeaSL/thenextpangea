---
/**
 * Reusable CTA (Call-to-Action) section for product pages.
 *
 * Renders a heading with the product name in gradient text,
 * a description paragraph, and action buttons (contact, dossier, all products).
 */

interface Props {
  accent: string;
  productName: string;
  i18nPrefix: string;
  description: string;
  descriptionI18nPrefix?: string;
  bgClass?: string;
}

const {
  accent,
  productName,
  i18nPrefix,
  description,
  descriptionI18nPrefix,
  bgClass = "bg-[#f5f7fa]",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<section class={`relative py-24 sm:py-32 overflow-hidden ${bgClass}`}>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="reveal">
        <div class="gap-10 items-center">
          <!-- Text + buttons -->
          <div class="text-center md:text-left">
            <h2
              class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-800 mb-5"
              data-i18n-html={`${i18nPrefix}.cta.title`}
            >
              ¿Quieres evaluar <span class="product-gradient-text">{productName}</span> en tu caso de uso?
            </h2>

            <p
              class="text-lg text-slate-500 mb-8"
              data-i18n={`${i18nPrefix}.cta.desc`}
            >
              {descriptionI18nPrefix
                ? <><span data-i18n={`${descriptionI18nPrefix}.prefix`}>Contacta con nuestro equipo para conocer cómo</span> {productName} <span data-i18n={`${descriptionI18nPrefix}.suffix`}>puede transformar tus procesos.</span></>
                : description}
            </p>

            <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-4">
              <!-- Contact -->
              <a
                href={`${base}#contact`}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm tracking-wide transition-all duration-300 hover:shadow-lg"
                style={`background: ${accent}; color: #fff;`}
              >
                <span data-i18n={`${i18nPrefix}.cta.button`}>Contactar</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
