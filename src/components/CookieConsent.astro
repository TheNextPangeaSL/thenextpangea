---
// Cookie Consent Banner & Preferences Modal
// Supports: Necessary (always on), Functional, Analytics (Google Analytics), Marketing
const base = import.meta.env.BASE_URL;
---

<!-- Cookie Banner (bottom bar) -->
<div
    id="cookie-banner"
    class="fixed bottom-0 inset-x-0 z-[9999] translate-y-full transition-transform duration-500 ease-out"
    role="dialog"
    aria-label="Cookie consent"
>
    <div class="bg-pangea-dark-blue/[0.97] backdrop-blur-xl border-t border-pangea-white/10 shadow-2xl">
        <div class="max-w-7xl mx-auto px-5 sm:px-10 py-5 sm:py-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
                <!-- Icon + Text -->
                <div class="flex items-start gap-3 flex-1 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-pangea-classic-blue/15 flex items-center justify-center shrink-0 mt-0.5">
                        <svg class="w-5 h-5 text-pangea-calm-blue" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M21.598 11.064a1.006 1.006 0 0 0-.854-.172A2.938 2.938 0 0 1 20 11c-1.654 0-3-1.346-3-3 0-.217.031-.444.099-.716a1.004 1.004 0 0 0-1.29-1.162 3.075 3.075 0 0 1-.808.128c-1.654 0-3-1.346-3-3a2.92 2.92 0 0 1 .142-.894 1.006 1.006 0 0 0-1.17-1.297C6.108 2.096 2 6.795 2 12c0 5.514 4.486 10 10 10s10-4.486 10-10a1.006 1.006 0 0 0-.402-.936ZM12 20c-4.411 0-8-3.589-8-8a7.962 7.962 0 0 1 6.006-7.75A5.006 5.006 0 0 0 15 8.25a5.01 5.01 0 0 0 3.24-1.182A4.977 4.977 0 0 0 21.861 11H21.8c-.016.1-.041.196-.041.3A8.009 8.009 0 0 1 12 20Zm-3-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-2 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-pangea-white/90 leading-relaxed" data-i18n="cookies.banner.text">
                            Usamos cookies para mejorar tu experiencia de navegación, analizar el tráfico del sitio y personalizar el contenido. Puedes aceptar todas, rechazar las no esenciales o configurar tus preferencias.
                        </p>
                        <a
                            href={`${base}politica-de-cookies/`}
                            class="text-xs text-pangea-sky-blue/70 hover:text-pangea-sky-blue transition-colors mt-1 inline-block"
                            data-i18n="cookies.banner.moreInfo"
                        >
                            Más información sobre cookies →
                        </a>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center gap-2.5 shrink-0 w-full sm:w-auto">
                    <button
                        id="cookie-reject-all"
                        class="flex-1 sm:flex-none px-4 py-2.5 rounded-lg text-xs font-semibold text-pangea-white/70 border border-pangea-white/15 hover:border-pangea-white/30 hover:text-pangea-white bg-transparent transition-all duration-200"
                        data-i18n="cookies.banner.rejectAll"
                    >
                        Rechazar
                    </button>
                    <button
                        id="cookie-customize"
                        class="flex-1 sm:flex-none px-4 py-2.5 rounded-lg text-xs font-semibold text-pangea-white/90 border border-pangea-white/20 hover:border-pangea-classic-blue/40 hover:text-pangea-calm-blue bg-pangea-white/[0.06] hover:bg-pangea-white/[0.1] transition-all duration-200"
                        data-i18n="cookies.banner.customize"
                    >
                        Configurar
                    </button>
                    <button
                        id="cookie-accept-all"
                        class="flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs font-semibold text-pangea-white bg-pangea-classic-blue hover:bg-pangea-classic-blue/90 transition-all duration-200 shadow-lg shadow-pangea-classic-blue/20"
                        data-i18n="cookies.banner.acceptAll"
                    >
                        Aceptar todo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cookie Preferences Modal -->
<div
    id="cookie-modal"
    class="fixed inset-0 z-[10000] hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Cookie preferences"
>
    <!-- Backdrop -->
    <div id="cookie-modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

    <!-- Panel -->
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div
            id="cookie-modal-panel"
            class="relative w-full max-w-lg max-h-[85vh] bg-pangea-white border border-pangea-dark-blue/10 rounded-2xl shadow-2xl flex flex-col opacity-0 scale-95 transition-all duration-300"
        >
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-pangea-dark-blue/10 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center">
                        <svg class="w-[18px] h-[18px] text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                        </svg>
                    </div>
                    <h2 class="text-base font-bold text-pangea-dark-blue" data-i18n="cookies.modal.title">
                        Preferencias de Cookies
                    </h2>
                </div>
                <button
                    id="cookie-modal-close"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-pangea-dark-blue/40 hover:text-pangea-dark-blue hover:bg-pangea-dark-blue/5 transition-all duration-200"
                    aria-label="Close"
                >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body (scrollable) -->
            <div class="flex-1 overflow-y-auto px-6 py-5 space-y-4 cookie-modal-scroll">
                <p class="text-sm text-pangea-dark-blue/60 leading-relaxed" data-i18n="cookies.modal.description">
                    Configura qué cookies deseas permitir. Las cookies necesarias no pueden desactivarse ya que son imprescindibles para el funcionamiento del sitio.
                </p>

                <!-- Necessary -->
                <div class="cookie-category rounded-xl border border-pangea-dark-blue/10 overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3.5 bg-pangea-dark-blue/[0.03]">
                        <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                                </svg>
                            </div>
                            <div>
                                <span class="text-sm font-semibold text-pangea-dark-blue" data-i18n="cookies.cat.necessary">Necesarias</span>
                                <span class="ml-2 text-[10px] font-medium text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded" data-i18n="cookies.cat.alwaysActive">Siempre activas</span>
                            </div>
                        </div>
                        <button class="cookie-cat-toggle text-pangea-dark-blue/30 hover:text-pangea-dark-blue/60 transition-colors" data-target="necessary-detail">
                            <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                            </svg>
                        </button>
                    </div>
                    <div id="necessary-detail" class="hidden px-4 pb-4 pt-1">
                        <p class="text-xs text-pangea-dark-blue/50 leading-relaxed" data-i18n="cookies.cat.necessary.desc">
                            Las cookies necesarias garantizan funciones indispensables para el funcionamiento del sitio web. No almacenan datos de identificación personal y no pueden desactivarse.
                        </p>
                    </div>
                </div>

                <!-- Functional -->
                <div class="cookie-category rounded-xl border border-pangea-dark-blue/10 overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3.5 bg-pangea-dark-blue/[0.03]">
                        <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-lg bg-pangea-classic-blue/10 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5 text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93s.844.083 1.168-.142l.748-.56a1.125 1.125 0 0 1 1.586.142l.773.773a1.125 1.125 0 0 1 .14 1.587l-.559.748a1.108 1.108 0 0 0-.142 1.168c.166.396.506.71.93.78l.893.15c.543.09.94.559.94 1.109v1.093c0 .55-.397 1.02-.94 1.11l-.894.149a1.108 1.108 0 0 0-.93.78 1.108 1.108 0 0 0 .142 1.168l.56.748a1.125 1.125 0 0 1-.142 1.586l-.773.773a1.125 1.125 0 0 1-1.587.14l-.748-.559a1.108 1.108 0 0 0-1.168-.142c-.396.166-.71.506-.78.93l-.15.893c-.09.543-.559.94-1.109.94h-1.093a1.125 1.125 0 0 1-1.11-.94l-.149-.894a1.108 1.108 0 0 0-.78-.93 1.108 1.108 0 0 0-1.168.142l-.748.56a1.125 1.125 0 0 1-1.586-.142l-.773-.773a1.125 1.125 0 0 1-.14-1.587l.559-.748c.225-.3.262-.694.142-1.168a1.108 1.108 0 0 0-.93-.78l-.893-.15A1.125 1.125 0 0 1 3 12.547v-1.093c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.764-.384.93-.78a1.108 1.108 0 0 0-.142-1.168l-.56-.748a1.125 1.125 0 0 1 .142-1.586l.773-.773a1.125 1.125 0 0 1 1.587-.14l.748.559c.3.225.694.262 1.168.142.396-.166.71-.506.78-.93l.15-.893Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-pangea-dark-blue" data-i18n="cookies.cat.functional">Funcionales</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <label class="cookie-switch cookie-switch-light">
                                <input type="checkbox" data-cookie-cat="functional" />
                                <span class="cookie-switch-slider"></span>
                            </label>
                            <button class="cookie-cat-toggle text-pangea-dark-blue/30 hover:text-pangea-dark-blue/60 transition-colors" data-target="functional-detail">
                                <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div id="functional-detail" class="hidden px-4 pb-4 pt-1">
                        <p class="text-xs text-pangea-dark-blue/50 leading-relaxed" data-i18n="cookies.cat.functional.desc">
                            Las cookies funcionales permiten recordar preferencias como el idioma seleccionado, mejorando tu experiencia de navegación.
                        </p>
                    </div>
                </div>

                <!-- Analytics -->
                <div class="cookie-category rounded-xl border border-pangea-dark-blue/10 overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3.5 bg-pangea-dark-blue/[0.03]">
                        <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-lg bg-amber-500/10 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                                </svg>
                            </div>
                            <div>
                                <span class="text-sm font-semibold text-pangea-dark-blue" data-i18n="cookies.cat.analytics">Analíticas</span>
                                <span class="ml-2 text-[10px] font-medium text-pangea-dark-blue/30">Google Analytics</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <label class="cookie-switch cookie-switch-light">
                                <input type="checkbox" data-cookie-cat="analytics" />
                                <span class="cookie-switch-slider"></span>
                            </label>
                            <button class="cookie-cat-toggle text-pangea-dark-blue/30 hover:text-pangea-dark-blue/60 transition-colors" data-target="analytics-detail">
                                <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div id="analytics-detail" class="hidden px-4 pb-4 pt-1">
                        <p class="text-xs text-pangea-dark-blue/50 leading-relaxed" data-i18n="cookies.cat.analytics.desc">
                            Las cookies analíticas de Google Analytics nos ayudan a comprender cómo interactúan los visitantes con el sitio web, proporcionando información anónima sobre métricas como número de visitas, páginas más visitadas y fuentes de tráfico.
                        </p>
                    </div>
                </div>

                <!-- Marketing -->
                <div class="cookie-category rounded-xl border border-pangea-dark-blue/10 overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3.5 bg-pangea-dark-blue/[0.03]">
                        <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-lg bg-purple-500/10 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38a.813.813 0 0 1-1.072-.286l-.267-.443a10.066 10.066 0 0 1-.906-2.624m2.38-4.52a13.87 13.87 0 0 0 0-5.32m0 5.32c2.577.217 5.073.69 7.433 1.397.407.121.846-.049 1.028-.432l.317-.666a.813.813 0 0 0-.137-.92 24.383 24.383 0 0 0-8.641-6.088m0 6.709a24.324 24.324 0 0 1 0-6.709m0 0c-2.577-.217-5.073-.69-7.433-1.397a.813.813 0 0 0-1.028.432l-.317.666a.813.813 0 0 0 .137.92 24.383 24.383 0 0 0 8.641 6.088" />
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-pangea-dark-blue" data-i18n="cookies.cat.marketing">Marketing</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <label class="cookie-switch cookie-switch-light">
                                <input type="checkbox" data-cookie-cat="marketing" />
                                <span class="cookie-switch-slider"></span>
                            </label>
                            <button class="cookie-cat-toggle text-pangea-dark-blue/30 hover:text-pangea-dark-blue/60 transition-colors" data-target="marketing-detail">
                                <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div id="marketing-detail" class="hidden px-4 pb-4 pt-1">
                        <p class="text-xs text-pangea-dark-blue/50 leading-relaxed" data-i18n="cookies.cat.marketing.desc">
                            Las cookies de marketing se utilizan para rastrear visitantes y mostrar anuncios relevantes y atractivos. Incluyen servicios como YouTube y Vimeo para contenido multimedia integrado.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between gap-3 px-6 py-4 border-t border-pangea-dark-blue/10 shrink-0">
                <button
                    id="cookie-modal-reject"
                    class="px-4 py-2.5 rounded-lg text-xs font-semibold text-pangea-dark-blue/60 border border-pangea-dark-blue/15 hover:border-pangea-dark-blue/30 hover:text-pangea-dark-blue bg-transparent transition-all duration-200"
                    data-i18n="cookies.modal.rejectAll"
                >
                    Rechazar todo
                </button>
                <div class="flex items-center gap-2.5">
                    <button
                        id="cookie-modal-save"
                        class="px-5 py-2.5 rounded-lg text-xs font-semibold text-pangea-classic-blue border border-pangea-classic-blue/30 bg-pangea-classic-blue/[0.08] hover:bg-pangea-classic-blue/15 transition-all duration-200"
                        data-i18n="cookies.modal.save"
                    >
                        Guardar preferencias
                    </button>
                    <button
                        id="cookie-modal-accept"
                        class="px-5 py-2.5 rounded-lg text-xs font-semibold text-pangea-white bg-pangea-classic-blue hover:bg-pangea-classic-blue/90 transition-all duration-200 shadow-lg shadow-pangea-classic-blue/20"
                        data-i18n="cookies.modal.acceptAll"
                    >
                        Aceptar todo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating "Manage Cookies" pill (shown after consent is given) -->
<button
    id="cookie-settings-pill"
    class="fixed bottom-4 left-4 z-[9998] hidden items-center gap-2 px-3.5 py-2 rounded-full bg-pangea-dark-blue/90 border border-pangea-white/10 text-pangea-white/60 hover:text-pangea-white hover:border-pangea-white/25 backdrop-blur-lg shadow-lg transition-all duration-300 text-xs font-medium group"
    aria-label="Cookie settings"
>
    <svg class="w-3.5 h-3.5 text-pangea-white/40 group-hover:text-pangea-calm-blue transition-colors" viewBox="0 0 24 24" fill="currentColor">
        <path d="M21.598 11.064a1.006 1.006 0 0 0-.854-.172A2.938 2.938 0 0 1 20 11c-1.654 0-3-1.346-3-3 0-.217.031-.444.099-.716a1.004 1.004 0 0 0-1.29-1.162 3.075 3.075 0 0 1-.808.128c-1.654 0-3-1.346-3-3a2.92 2.92 0 0 1 .142-.894 1.006 1.006 0 0 0-1.17-1.297C6.108 2.096 2 6.795 2 12c0 5.514 4.486 10 10 10s10-4.486 10-10a1.006 1.006 0 0 0-.402-.936ZM12 20c-4.411 0-8-3.589-8-8a7.962 7.962 0 0 1 6.006-7.75A5.006 5.006 0 0 0 15 8.25a5.01 5.01 0 0 0 3.24-1.182A4.977 4.977 0 0 0 21.861 11H21.8c-.016.1-.041.196-.041.3A8.009 8.009 0 0 1 12 20Zm-3-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-2 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>
    </svg>
    <span data-i18n="cookies.settingsPill">Cookies</span>
</button>

<!-- Styles -->
<style>
    /* Toggle switch */
    .cookie-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
        flex-shrink: 0;
    }
    .cookie-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .cookie-switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 999px;
        transition: all 0.25s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .cookie-switch-slider::before {
        content: "";
        position: absolute;
        height: 14px;
        width: 14px;
        left: 2px;
        bottom: 2px;
        background-color: rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        transition: all 0.25s ease;
    }
    .cookie-switch input:checked + .cookie-switch-slider {
        background-color: rgba(51, 102, 153, 0.35);
        border-color: rgba(51, 102, 153, 0.5);
    }
    .cookie-switch input:checked + .cookie-switch-slider::before {
        transform: translateX(16px);
        background-color: #88B0D8;
    }

    /* Scrollbar for modal body */
    .cookie-modal-scroll::-webkit-scrollbar {
        width: 4px;
    }
    .cookie-modal-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .cookie-modal-scroll::-webkit-scrollbar-thumb {
        background: rgba(31, 48, 66, 0.1);
        border-radius: 999px;
    }

    /* Light mode toggle for modal */
    .cookie-switch-light .cookie-switch-slider {
        background-color: rgba(31, 48, 66, 0.12);
        border-color: rgba(31, 48, 66, 0.15);
    }
    .cookie-switch-light .cookie-switch-slider::before {
        background-color: rgba(31, 48, 66, 0.3);
    }
    .cookie-switch-light input:checked + .cookie-switch-slider {
        background-color: rgba(51, 102, 153, 0.2);
        border-color: rgba(51, 102, 153, 0.35);
    }
    .cookie-switch-light input:checked + .cookie-switch-slider::before {
        transform: translateX(16px);
        background-color: #336699;
    }
</style>

<!-- Script -->
<script>
    const COOKIE_KEY = "pangea_cookie_consent";
    const GA_ID = "G-XXXXXXXXXX"; // Replace with actual GA4 Measurement ID

    interface CookieConsent {
        necessary: boolean;
        functional: boolean;
        analytics: boolean;
        marketing: boolean;
        timestamp: number;
    }

    function getConsent(): CookieConsent | null {
        try {
            const raw = localStorage.getItem(COOKIE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch {
            return null;
        }
    }

    function setConsent(consent: CookieConsent) {
        localStorage.setItem(COOKIE_KEY, JSON.stringify(consent));
        applyConsent(consent);
    }

    function applyConsent(consent: CookieConsent) {
        // Google Analytics
        if (consent.analytics) {
            enableGA();
        } else {
            disableGA();
        }

        // Dispatch event for other scripts to listen
        window.dispatchEvent(new CustomEvent("cookie-consent-updated", { detail: consent }));
    }

    function enableGA() {
        if (GA_ID === "G-XXXXXXXXXX") return; // Skip if not configured

        // Check if already loaded
        if (document.querySelector(`script[src*="googletagmanager.com/gtag"]`)) return;

        // Load gtag.js
        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(script);

        // Initialize gtag
        (window as any).dataLayer = (window as any).dataLayer || [];
        function gtag(...args: any[]) {
            (window as any).dataLayer.push(arguments);
        }
        (window as any).gtag = gtag;
        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });
    }

    function disableGA() {
        // Set opt-out flag
        if (GA_ID !== "G-XXXXXXXXXX") {
            (window as any)[`ga-disable-${GA_ID}`] = true;
        }
        // Remove cookies
        document.cookie.split(";").forEach((c) => {
            const name = c.trim().split("=")[0];
            if (name.startsWith("_ga") || name.startsWith("_gid") || name.startsWith("_gat")) {
                document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/;domain=${window.location.hostname}`;
                document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/;`;
            }
        });
    }

    function initCookieConsent() {
        const banner = document.getElementById("cookie-banner");
        const modal = document.getElementById("cookie-modal");
        const modalBackdrop = document.getElementById("cookie-modal-backdrop");
        const modalPanel = document.getElementById("cookie-modal-panel");
        const settingsPill = document.getElementById("cookie-settings-pill");
        if (!banner || !modal || !settingsPill) return;

        const consent = getConsent();

        if (consent) {
            // Already consented — apply and show settings pill
            applyConsent(consent);
            settingsPill.classList.remove("hidden");
            settingsPill.classList.add("flex");
        } else {
            // Show banner after a small delay
            setTimeout(() => {
                banner.classList.remove("translate-y-full");
                banner.classList.add("translate-y-0");
            }, 1000);
        }

        // Accept All (banner)
        document.getElementById("cookie-accept-all")?.addEventListener("click", () => {
            setConsent({ necessary: true, functional: true, analytics: true, marketing: true, timestamp: Date.now() });
            hideBanner();
            showPill();
        });

        // Reject All (banner)
        document.getElementById("cookie-reject-all")?.addEventListener("click", () => {
            setConsent({ necessary: true, functional: false, analytics: false, marketing: false, timestamp: Date.now() });
            hideBanner();
            showPill();
        });

        // Customize (banner)
        document.getElementById("cookie-customize")?.addEventListener("click", () => {
            hideBanner();
            openModal();
        });

        // Modal close
        document.getElementById("cookie-modal-close")?.addEventListener("click", closeModal);
        modalBackdrop?.addEventListener("click", closeModal);

        // Modal Accept All
        document.getElementById("cookie-modal-accept")?.addEventListener("click", () => {
            setConsent({ necessary: true, functional: true, analytics: true, marketing: true, timestamp: Date.now() });
            closeModal();
            showPill();
        });

        // Modal Reject All
        document.getElementById("cookie-modal-reject")?.addEventListener("click", () => {
            setConsent({ necessary: true, functional: false, analytics: false, marketing: false, timestamp: Date.now() });
            closeModal();
            showPill();
        });

        // Modal Save
        document.getElementById("cookie-modal-save")?.addEventListener("click", () => {
            const functional = (modal.querySelector('[data-cookie-cat="functional"]') as HTMLInputElement)?.checked ?? false;
            const analytics = (modal.querySelector('[data-cookie-cat="analytics"]') as HTMLInputElement)?.checked ?? false;
            const marketing = (modal.querySelector('[data-cookie-cat="marketing"]') as HTMLInputElement)?.checked ?? false;
            setConsent({ necessary: true, functional, analytics, marketing, timestamp: Date.now() });
            closeModal();
            showPill();
        });

        // Settings pill → open modal
        settingsPill.addEventListener("click", () => {
            openModal();
        });

        // Category toggle (expand/collapse details)
        document.querySelectorAll(".cookie-cat-toggle").forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = (btn as HTMLElement).dataset.target;
                if (!targetId) return;
                const target = document.getElementById(targetId);
                if (!target) return;
                target.classList.toggle("hidden");
                const chevron = btn.querySelector("svg");
                if (chevron) {
                    chevron.style.transform = target.classList.contains("hidden") ? "" : "rotate(180deg)";
                }
            });
        });

        function hideBanner() {
            banner.classList.remove("translate-y-0");
            banner.classList.add("translate-y-full");
        }

        function showPill() {
            settingsPill.classList.remove("hidden");
            settingsPill.classList.add("flex");
        }

        function openModal() {
            // Sync checkboxes with current consent
            const current = getConsent();
            if (current) {
                const fc = modal.querySelector('[data-cookie-cat="functional"]') as HTMLInputElement;
                const ac = modal.querySelector('[data-cookie-cat="analytics"]') as HTMLInputElement;
                const mc = modal.querySelector('[data-cookie-cat="marketing"]') as HTMLInputElement;
                if (fc) fc.checked = current.functional;
                if (ac) ac.checked = current.analytics;
                if (mc) mc.checked = current.marketing;
            }

            modal.classList.remove("hidden");
            requestAnimationFrame(() => {
                modalBackdrop!.classList.remove("opacity-0");
                modalBackdrop!.classList.add("opacity-100");
                modalPanel!.classList.remove("opacity-0", "scale-95");
                modalPanel!.classList.add("opacity-100", "scale-100");
            });
            document.body.style.overflow = "hidden";
        }

        function closeModal() {
            modalBackdrop!.classList.remove("opacity-100");
            modalBackdrop!.classList.add("opacity-0");
            modalPanel!.classList.remove("opacity-100", "scale-100");
            modalPanel!.classList.add("opacity-0", "scale-95");
            setTimeout(() => {
                modal.classList.add("hidden");
                document.body.style.overflow = "";
                // If no consent yet, show banner again
                if (!getConsent()) {
                    banner.classList.remove("translate-y-full");
                    banner.classList.add("translate-y-0");
                }
            }, 300);
        }
    }

    document.addEventListener("DOMContentLoaded", initCookieConsent);
    document.addEventListener("astro:page-load", initCookieConsent);
</script>
