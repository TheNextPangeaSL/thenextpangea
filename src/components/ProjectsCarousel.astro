        onelinerKey: "projects.p1.oneliner",
        bullet1Key: "projects.p1.bullet1",
        bullet2Key: "projects.p1.bullet2",
        bullet3Key: "projects.p1.bullet3",
        nameDefault: "DxTER",
        categoryDefault: "IA · OPTIMIZACIÓN",
