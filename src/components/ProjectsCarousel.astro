        slug: "imagia",
        nameKey: "projects.p4.name",
        categoryKey: "projects.p4.category",
        afKey: "projects.p4.af",
        onelinerKey: "projects.p4.oneliner",
        bullet1Key: "projects.p4.bullet1",
        bullet2Key: "projects.p4.bullet2",
        bullet3Key: "projects.p4.bullet3",
        nameDefault: "IMAGIA",
        categoryDefault: "IA · VISIÓN",
        afDefault: "AF5",
        onelinerDefault: "IA para inspección visual y defectos",
        bullet1Default: "Detección de anomalías",
