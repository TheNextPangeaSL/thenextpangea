    "IA · OPTIMIZACIÓN": "ia",
    "IA · DOCUMENTAL": "ia",
    "IA · VISIÓN": "ia",
    "IA · SIMULACIÓN": "ia",
    "DIGITALIZACIÓN": "digital",
    "EDGE AI": "edge-ai",
    "MATERIALES": "materiales",
    "FABRICACIÓN AVANZADA": "fab-avanzada",
    "SOFTWARE · SIMULACIÓN": "fab-avanzada",
    "BIOTECNOLOGÍA": "bio",
};

interface CarouselCategoryFilter {
    id: string;
    label: string;
    labelEn: string;
    icon: string;
}
