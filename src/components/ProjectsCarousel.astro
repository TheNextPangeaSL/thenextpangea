        categoryKey: "projects.p3.category",
        afKey: "projects.p3.af",
        onelinerKey: "projects.p3.oneliner",
        bullet1Key: "projects.p3.bullet1",
        bullet2Key: "projects.p3.bullet2",
        bullet3Key: "projects.p3.bullet3",
        nameDefault: "BuscAI",
        categoryDefault: "IA · DOCUMENTAL",
        afDefault: "AF3 / AF6",
        onelinerDefault: "Inteligencia documental (RAG) trazable",
        bullet1Default: "Consulta en lenguaje natural",
        bullet2Default: "Comprensión de layout (tablas/planos)",
        bullet3Default: "Despliegue on-premise",
    },
    {
