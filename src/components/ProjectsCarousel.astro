---
// Projects Carousel – Horizontal scrollable carousel with 9 project cards
// Each card: visual header, category badge, AF badge, name, one-liner, 3 bullets, CTA

import { getProductBySlug, getProductUrl, isExternalProduct, functionalAreas, afProductMapping } from "../data/products";

/** Extract AF numbers from a string like "AF3 / AF6" → [3,6] */
function parseAfs(afStr: string): number[] {
    return [...afStr.matchAll(/AF(\d)/g)].map(m => Number(m[1]));
}

interface ProjectCard {
    id: string;
    slug: string;
    nameKey: string;
    categoryKey: string;
    afKey: string;
    onelinerKey: string;
    bullet1Key: string;
    bullet2Key: string;
    bullet3Key: string;
    nameDefault: string;
    categoryDefault: string;
    afDefault: string;
    onelinerDefault: string;
    bullet1Default: string;
    bullet2Default: string;
    bullet3Default: string;
}

/** Map raw categoryDefault values to filter groups */
