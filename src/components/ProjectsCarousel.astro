---

<section
    id="projects-carousel"
    class="relative section-padding bg-pangea-light-grey/20 overflow-hidden"
>
    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-8 md:mb-12">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-3"
                data-i18n="projects.label"
            >
                Productos
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="projects.title"
                    >Productos en el stand</span
                >{" "}
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="projects.titleHighlight">BACSI 2026</span
                >
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-3 delay-200"
                data-i18n="projects.subtitle"
            >
                Explora nuestras soluciones tecnológicas y accede a la ficha
                completa de cada producto.
            </p>
            <div class="reveal divider mx-auto mt-4 delay-300"></div>
        </div>

        <!-- AF Functional Area Filters -->
        <div class="reveal flex flex-wrap items-center justify-center gap-2 mb-8 delay-350" id="carousel-af-filters">
            <button class="carousel-filter-btn active" data-af-filter="all" type="button">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" />
                </svg>
                <span data-i18n="products.filterAll">Todos</span>
                <span class="carousel-filter-count">{projectCards.length}</span>
            </button>
            {functionalAreas.map((af) => {
                const count = projectCards.filter(c => parseAfs(c.afDefault).includes(af.id)).length;
                if (count === 0) return null;
                return (
                    <button
                        class="carousel-filter-btn"
                        data-af-filter={String(af.id)}
                        type="button"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d={af.icon} />
                        </svg>
                        <span data-i18n={`products.af.${af.id}`} data-i18n-es={af.label} data-i18n-en={af.labelEn}>{af.label}</span>
                        <span class="carousel-filter-count">{count}</span>
                    </button>
                );
            })}
        </div>

        <!-- No results message -->
        <p class="text-center text-pangea-classic-blue/50 text-sm py-6 hidden" id="carousel-no-results" data-i18n="products.noResults">
            No hay productos para este filtro
        </p>

        <!-- Carousel Wrapper -->
        <div class="reveal delay-300 relative">
            <!-- Navigation Buttons -->
            <button
                id="carousel-prev"
                class="absolute -left-3 sm:-left-4 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-white border border-pangea-light-grey/60 shadow-md flex items-center justify-center text-pangea-dark-blue hover:bg-pangea-classic-blue hover:text-white hover:border-pangea-classic-blue transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
                aria-label="Anterior"
                data-i18n-aria-label="projects.prev"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                </svg>
            </button>

            <button
                id="carousel-next"
                class="absolute -right-3 sm:-right-4 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-white border border-pangea-light-grey/60 shadow-md flex items-center justify-center text-pangea-dark-blue hover:bg-pangea-classic-blue hover:text-white hover:border-pangea-classic-blue transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
                aria-label="Siguiente"
                data-i18n-aria-label="projects.next"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                </svg>
            </button>

            <!-- Scrollable Track -->
            <div
                id="carousel-track"
                class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-1 px-1 carousel-hide-scrollbar"
            >
                {
                    projectCards.map((card) => {
                        const product = getProductBySlug(card.slug);
                        const hexColor = product?.hexColor ?? "#336699";
                        const heroImage = product?.heroImage;
                        const iconPath = product?.icon;
                        const productUrl = product ? getProductUrl(product) : "#contact";
                        const isExternal = product ? isExternalProduct(product) : false;
                        return (
                        <a
                            href={productUrl}
                            {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            class="snap-start shrink-0 w-[280px] sm:w-[300px] md:w-[320px] bg-white rounded-2xl border border-pangea-light-grey/60 overflow-hidden flex flex-col hover:shadow-md hover:-translate-y-1 transition-all duration-300 group"
                            style={`--product-color: ${hexColor}; --product-color-10: ${hexColor}18; --product-color-border: ${hexColor}40`}
                            data-product-card
                            data-card-afs={parseAfs(card.afDefault).join(",")}
                        >
                            {/* Visual header */}
                            {heroImage ? (
                                <div class="relative w-full h-36">
                                    <img
                                        src={heroImage}
                                        alt={card.nameDefault}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0" style={`background: ${hexColor}18`} />
                                </div>
                            ) : (
                                <div
                                    class="relative w-full h-36 flex items-center justify-center"
                                    style={`background: linear-gradient(135deg, ${hexColor}12, ${hexColor}28)`}
                                >
                                    {iconPath && (
                                        <svg
                                            class="w-16 h-16 opacity-60"
                                            style={`color: ${hexColor}`}
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="1.2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d={iconPath}
                                            />
                                        </svg>
                                    )}
                                </div>
                            )}

                            {/* Content */}
                            <div class="p-5 pt-3 flex flex-col flex-1">
                            {/* Badges row */}
                            <div class="flex items-center gap-2 mb-3">
                                <span
                                    class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider"
                                    style={`background: ${hexColor}14; color: ${hexColor}`}
                                    data-i18n={card.categoryKey}
                                >
                                    {card.categoryDefault}
                                </span>
                                <span
                                    class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider"
                                    style={`background: ${hexColor}0D; color: ${hexColor}CC`}
                                    data-i18n={card.afKey}
                                >
                                    {card.afDefault}
                                </span>
                            </div>

                            {/* Project name */}
                            <h3
                                class="text-base font-bold mb-1.5"
                                style={`color: ${hexColor}`}
                                data-i18n={card.nameKey}
                            >
                                {card.nameDefault}
                            </h3>

                            {/* One-liner */}
                            <p
                                class="text-[13px] text-pangea-dark-blue/60 leading-relaxed mb-4"
                                data-i18n={card.onelinerKey}
                            >
                                {card.onelinerDefault}
                            </p>

                            {/* Bullet points */}
                            <ul class="flex flex-col gap-1.5 mt-auto mb-4">
                                {[card.bullet1Key, card.bullet2Key, card.bullet3Key].map(
                                    (bKey, bi) => (
                                        <li class="flex items-start gap-2 text-[12px] text-pangea-dark-blue/70">
                                            <svg
                                                class="w-3.5 h-3.5 shrink-0 mt-0.5"
                                                style={`color: ${hexColor}`}
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="m4.5 12.75 6 6 9-13.5"
                                                />
                                            </svg>
                                            <span data-i18n={bKey}>
                                                {bi === 0
                                                    ? card.bullet1Default
                                                    : bi === 1
                                                      ? card.bullet2Default
                                                      : card.bullet3Default}
                                            </span>
                                        </li>
                                    ),
                                )}
                            </ul>

                            {/* CTA */}
                            <span
                                class="inline-flex items-center gap-1.5 text-[12px] font-semibold group-hover:text-pangea-dark-blue transition-colors duration-200"
                                style={`color: ${hexColor}`}
                            >
                                <span data-i18n="projects.viewCard">
                                    Ver ficha
                                </span>
                                <svg
                                    class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25"
                                    />
                                </svg>
                            </span>
                            </div>
                        </a>
                        );
                    })
                }
            </div>

            <!-- Dots indicator (generated dynamically by JS based on visible pages) -->
            <div
                id="carousel-dots"
                class="flex justify-center gap-1.5 mt-4"
                aria-hidden="true"
            >
            </div>
        </div>
    </div>
</section>

<style>
    .carousel-hide-scrollbar {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .carousel-hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    [data-product-card]:hover {
        border-color: var(--product-color-border);
    }

    /* Filtered card animation */
    [data-product-card] {
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    [data-product-card].carousel-card-hidden {
        display: none !important;
    }

    /* ── Carousel AF filter pills ───────────────────────── */
    .carousel-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1;
        border-radius: 9999px;
        border: 1.5px solid rgba(0, 0, 0, 0.08);
        background: white;
        color: #64748b;
        cursor: pointer;
        transition: all 0.25s ease;
        white-space: nowrap;
    }
    .carousel-filter-btn:hover {
        border-color: rgba(0, 0, 0, 0.15);
        color: #334155;
        background: #f8fafc;
    }
    .carousel-filter-btn.active {
        background: #1a3a5c;
        color: white;
        border-color: #1a3a5c;
        box-shadow: 0 2px 8px rgba(26, 58, 92, 0.22);
    }
    .carousel-filter-btn.active .carousel-filter-count {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }
    .carousel-filter-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.25rem;
        height: 1.25rem;
        padding: 0 0.3rem;
        font-size: 0.625rem;
        font-weight: 700;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.06);
        color: #94a3b8;
        transition: all 0.25s ease;
    }
</style>

<script>
    function initCarousel() {
        const track = document.getElementById("carousel-track") as HTMLElement | null;
        const prevBtn = document.getElementById("carousel-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("carousel-next") as HTMLButtonElement | null;
        const dotsContainer = document.getElementById("carousel-dots") as HTMLElement | null;
        const filtersContainer = document.getElementById("carousel-af-filters");
        const noResults = document.getElementById("carousel-no-results");

        if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

        const allCards = Array.from(track.querySelectorAll<HTMLElement>("[data-product-card]"));
        if (allCards.length === 0) return;

        let currentIndex = 0;
        let activeFilter = "all";

        /** Returns only cards that are currently visible (not filtered out) */
        function getVisibleCards(): HTMLElement[] {
            return allCards.filter(c => !c.classList.contains("carousel-card-hidden"));
        }

        function getCardWidth(): number {
            const visible = getVisibleCards();
            if (visible.length === 0) return 320;
            const card = visible[0];
            const style = getComputedStyle(track!);
            const gap = parseFloat(style.gap) || 20;
            return card.offsetWidth + gap;
        }

        function getVisibleCount(): number {
            const trackWidth = track!.offsetWidth;
            const cardWidth = getCardWidth();
            return Math.max(1, Math.floor(trackWidth / cardWidth));
        }

        function buildDots() {
            const visible = getVisibleCards();
            const visibleCount = getVisibleCount();
            const totalPages = Math.max(1, visible.length - visibleCount + 1);
            dotsContainer!.innerHTML = "";
            for (let i = 0; i < totalPages; i++) {
                const dot = document.createElement("button");
                dot.className =
                    "carousel-dot rounded-full transition-all duration-200 " +
                    (i === currentIndex
                        ? "bg-pangea-classic-blue w-6 h-2"
                        : "bg-pangea-light-grey w-2 h-2");
                dot.dataset.index = String(i);
                dot.setAttribute("aria-label", `Página ${i + 1} de ${totalPages}`);
                dot.addEventListener("click", () => scrollToIndex(i));
                dotsContainer!.appendChild(dot);
            }
        }

        function scrollToIndex(index: number) {
            const visible = getVisibleCards();
            const maxIndex = Math.max(0, visible.length - getVisibleCount());
            currentIndex = Math.max(0, Math.min(index, maxIndex));
            // Calculate scroll position from visible cards
            const cardWidth = getCardWidth();
            track!.scrollTo({ left: currentIndex * cardWidth, behavior: "smooth" });
            updateControls();
        }

        function updateControls() {
            const visible = getVisibleCards();
            const maxIndex = Math.max(0, visible.length - getVisibleCount());
            prevBtn!.disabled = currentIndex <= 0;
            nextBtn!.disabled = currentIndex >= maxIndex;

            const dots = dotsContainer!.querySelectorAll(".carousel-dot");
            dots.forEach((dot, i) => {
                const isActive = i === currentIndex;
                dot.className =
                    "carousel-dot rounded-full transition-all duration-200 " +
                    (isActive
                        ? "bg-pangea-classic-blue w-6 h-2"
                        : "bg-pangea-light-grey w-2 h-2");
            });
        }

        /** Apply AF filter: show/hide cards, reset carousel */
        function applyFilter(af: string) {
            activeFilter = af;

            allCards.forEach(card => {
                const cardAfs = (card.dataset.cardAfs || "").split(",").filter(Boolean);
                const shouldShow = af === "all" || cardAfs.includes(af);
                card.classList.toggle("carousel-card-hidden", !shouldShow);
            });

            // Show/hide no-results
            const visible = getVisibleCards();
            if (noResults) {
                noResults.classList.toggle("hidden", visible.length > 0);
            }

            // Reset scroll position and rebuild carousel
            currentIndex = 0;
            track!.scrollTo({ left: 0, behavior: "auto" });
            buildDots();
            updateControls();

            // Update button states
            if (filtersContainer) {
                filtersContainer.querySelectorAll<HTMLButtonElement>(".carousel-filter-btn").forEach(btn => {
                    btn.classList.toggle("active", btn.dataset.afFilter === af);
                });
            }
        }

        // Attach filter click handlers
        if (filtersContainer) {
            filtersContainer.querySelectorAll<HTMLButtonElement>(".carousel-filter-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    const af = btn.dataset.afFilter;
                    if (!af) return;
                    if (af === activeFilter && af !== "all") {
                        // Toggle off → back to all
                        applyFilter("all");
                    } else {
                        applyFilter(af);
                    }
                });
            });
        }

        prevBtn.addEventListener("click", () => scrollToIndex(currentIndex - 1));
        nextBtn.addEventListener("click", () => scrollToIndex(currentIndex + 1));

        // Rebuild dots on resize
        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                buildDots();
                updateControls();
            }, 150);
        });

        // Update on scroll (manual drag/swipe)
        let scrollTimer: ReturnType<typeof setTimeout>;
        track.addEventListener("scroll", () => {
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(() => {
                const cardWidth = getCardWidth();
                if (cardWidth > 0) {
                    currentIndex = Math.round(track!.scrollLeft / cardWidth);
                    updateControls();
                }
            }, 80);
        });

        buildDots();
        updateControls();
    }

    // Run on page load and after Astro view transitions
    document.addEventListener("DOMContentLoaded", initCarousel);
    document.addEventListener("astro:page-load", initCarousel);
</script>
