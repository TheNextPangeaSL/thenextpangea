---
// Projects Carousel – Horizontal scrollable carousel with 9 project cards
// Each card: visual header, category badge, AF badge, name, one-liner, 3 bullets, CTA

import { getProductBySlug, getProductUrl, isExternalProduct, functionalAreas, afProductMapping } from "../data/products";

/** Extract AF numbers from a string like "AF3 / AF6" → [3,6] */
function parseAfs(afStr: string): number[] {
    return [...afStr.matchAll(/AF(\d)/g)].map(m => Number(m[1]));
}

interface ProjectCard {
    id: string;
    slug: string;
    nameKey: string;
    categoryKey: string;
    afKey: string;
    onelinerKey: string;
    bullet1Key: string;
    bullet2Key: string;
    bullet3Key: string;
    nameDefault: string;
    categoryDefault: string;
    afDefault: string;
    onelinerDefault: string;
    bullet1Default: string;
    bullet2Default: string;
    bullet3Default: string;
}

const projectCards: ProjectCard[] = [
    {
        id: "p1",
        slug: "dxter",
        nameKey: "projects.p1.name",
        categoryKey: "projects.p1.category",
        afKey: "projects.p1.af",
        onelinerKey: "projects.p1.oneliner",
        bullet1Key: "projects.p1.bullet1",
        bullet2Key: "projects.p1.bullet2",
        bullet3Key: "projects.p1.bullet3",
        nameDefault: "DxTER",
        categoryDefault: "IA · OPTIMIZACIÓN",
        afDefault: "AF3 / AF6",
        onelinerDefault: "Optimización inteligente bajo restricciones reales",
        bullet1Default: "Optimización bayesiana",
        bullet2Default: "Decisión asistida con incertidumbre",
        bullet3Default: "Menos iteraciones, más velocidad",
