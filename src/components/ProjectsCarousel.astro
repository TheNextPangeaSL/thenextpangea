        afKey: "projects.p2.af",
        onelinerKey: "projects.p2.oneliner",
        bullet1Key: "projects.p2.bullet1",
        bullet2Key: "projects.p2.bullet2",
        bullet3Key: "projects.p2.bullet3",
        nameDefault: "PlanifAI",
        categoryDefault: "IA · OPTIMIZACIÓN",
        afDefault: "AF3 / AF6",
        onelinerDefault: "Planificación y optimización de recursos",
        bullet1Default: "Predicción + planificación integrada",
        bullet2Default: "Optimización multiobjetivo",
        bullet3Default: "Replanificación ante imprevistos",
    },
