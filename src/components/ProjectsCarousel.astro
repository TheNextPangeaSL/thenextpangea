        onelinerKey: "projects.p5.oneliner",
        bullet1Key: "projects.p5.bullet1",
        bullet2Key: "projects.p5.bullet2",
        bullet3Key: "projects.p5.bullet3",
        nameDefault: "Fast Reporting",
