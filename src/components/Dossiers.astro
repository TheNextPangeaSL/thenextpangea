    description: string;
    filename: string;
    language: string;
    iconPath: string;
    accentColor: string;
}

const dossiers: Dossier[] = [
    {
        title: "Digital Technologies",
        description:
            "Explore our capabilities in AI, IoT, data analytics, and software engineering — driving digital transformation across industries.",
        filename: "TNP Dossier - Digital Technologies ENG.pdf",
        language: "EN",
        iconPath:
            "M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25",
