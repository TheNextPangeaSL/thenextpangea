---
// Technologies section – 3 technology pillars + 2 strategic spin-offs
// Replaces the previous hexagonal diagram with a cleaner card-based layout
import {
    products,
    getProductUrl,
    isExternalProduct,
    findProductByName,
} from "@/data/products";

interface SubCap {
    titleKey: string;
    descKey: string;
    titleDefault: string;
    descDefault: string;
}

interface Pillar {
    titleKey: string;
    descKey: string;
    titleDefault: string;
    descDefault: string;
    subs: SubCap[];
    productsKey: string;
    productsDefault: string;
    icon: string;
    accent: string;
}

interface Spinoff {
    labelKey: string;
    nameKey: string;
    badgeKey: string;
    descKey: string;
    nameDefault: string;
    badgeDefault: string;
    descDefault: string;
    feats: { key: string; default: string }[];
    accent: string;
    url: string;
}

const pillars: Pillar[] = [
    {
        titleKey: "tech.pillar1.title",
        descKey: "tech.pillar1.desc",
        titleDefault: "Inteligencia Artificial",
        descDefault:
            "De datos a decisiones en entornos exigentes: optimización, visión e inteligencia documental con despliegue flexible (incl. on-premise).",
        subs: [
            {
                titleKey: "tech.pillar1.sub1.title",
                descKey: "tech.pillar1.sub1.desc",
                titleDefault: "Optimización",
                descDefault:
                    "planificación y asignación bajo restricciones y escenarios.",
            },
            {
                titleKey: "tech.pillar1.sub2.title",
                descKey: "tech.pillar1.sub2.desc",
                titleDefault: "Visión",
                descDefault: "inspección asistida y detección de anomalías.",
            },
            {
                titleKey: "tech.pillar1.sub3.title",
                descKey: "tech.pillar1.sub3.desc",
                titleDefault: "Inteligencia documental",
                descDefault:
                    "búsqueda híbrida con trazabilidad a la fuente.",
            },
        ],
        productsKey: "tech.pillar1.products",
        productsDefault: "PLANIFAI,BUSCAI,IMAGIA,DxTER",
        icon: "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z",
        accent: "pangea-classic-blue",
    },
    {
        titleKey: "tech.pillar2.title",
        descKey: "tech.pillar2.desc",
        titleDefault: "Ciencia de Materiales",
        descDefault:
            "Materiales funcionales, electrónica impresa y gestión térmica para sensores integrables, durabilidad y eficiencia.",
        subs: [
            {
                titleKey: "tech.pillar2.sub1.title",
                descKey: "tech.pillar2.sub1.desc",
                titleDefault: "Electrónica impresa",
                descDefault: "sensórica ligera e integrable.",
            },
            {
                titleKey: "tech.pillar2.sub2.title",
                descKey: "tech.pillar2.sub2.desc",
                titleDefault: "Gestión térmica",
                descDefault: "calentadores serigrafiados y control térmico.",
            },
            {
                titleKey: "tech.pillar2.sub3.title",
                descKey: "tech.pillar2.sub3.desc",
                titleDefault: "Recubrimientos",
                descDefault:
                    "films y coatings funcionales para entornos exigentes.",
            },
        ],
        productsKey: "tech.pillar2.products",
        productsDefault: "SENSORICA,HEATERS,ANTIFRICCIÓN,FPGAs (Edge)",
        icon: "M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25",
        accent: "pangea-sky-blue",
    },
    {
        titleKey: "tech.pillar3.title",
        descKey: "tech.pillar3.desc",
        titleDefault: "Biotecnología",
        descDefault:
            "Detección microbiológica y vigilancia biológica para respuesta temprana y control operativo.",
        subs: [
            {
                titleKey: "tech.pillar3.sub1.title",
                descKey: "tech.pillar3.sub1.desc",
                titleDefault: "Detección microbiológica",
                descDefault: "identificación rápida y trazable.",
            },
            {
                titleKey: "tech.pillar3.sub2.title",
                descKey: "tech.pillar3.sub2.desc",
                titleDefault: "Vigilancia biológica",
                descDefault: "enfoque portable y operativo.",
            },
        ],
        productsKey: "tech.pillar3.products",
        productsDefault: "Arquea",
        icon: "M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 0-6.23.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5",
        accent: "pangea-calm-blue",
    },
];

const spinoffs: Spinoff[] = [
    {
        labelKey: "tech.spinoff1.label",
        nameKey: "tech.spinoff1.name",
        badgeKey: "tech.spinoff1.badge",
        descKey: "tech.spinoff1.desc",
        nameDefault: "61HEX",
        badgeDefault: "Additive · Industrialización",
        descDefault:
            "Industrialización de fabricación aditiva metálica mediante integración de software, ingeniería de proceso y células productivas orientadas a producción certificable.",
        feats: [
            {
                key: "tech.spinoff1.feat1",
                default: "Software de productividad y calidad",
            },
            {
                key: "tech.spinoff1.feat2",
                default: "Ingeniería de proceso y tooling",
            },
            {
                key: "tech.spinoff1.feat3",
                default: "Células productivas escalables",
            },
        ],
        accent: "pangea-classic-blue",
        url: "https://61hex.com/",
    },
    {
        labelKey: "tech.spinoff2.label",
        nameKey: "tech.spinoff2.name",
        badgeKey: "tech.spinoff2.badge",
        descKey: "tech.spinoff2.desc",
        nameDefault: "Arquea",
        badgeDefault: "Bio · Detección rápida",
        descDefault:
            "Tecnología de detección molecular rápida y portable orientada a vigilancia microbiológica y protección de infraestructuras críticas.",
        feats: [
            {
                key: "tech.spinoff2.feat1",
                default: "Minutos sin cultivo",
            },
            {
                key: "tech.spinoff2.feat2",
                default: "Portable para campo",
            },
            {
                key: "tech.spinoff2.feat3",
                default: "Digital para auditoría",
            },
        ],
        accent: "pangea-sky-blue",
        url: "https://arquea.bio/es/",
    },
];
---

<section
    id="services"
    class="relative min-h-dvh flex flex-col justify-center section-padding bg-pangea-light-grey/20 overflow-hidden"
>
    <!-- Background decorative elements -->
    <div
        class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute top-1/4 -right-40 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-1/4 -left-40 w-[400px] h-[400px] rounded-full bg-pangea-classic-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-8 md:mb-12">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-3"
                data-i18n="tech.label"
            >
                Tecnologías
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="tech.title"
                    >3 pilares tecnológicos y</span
                >{" "}
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="tech.titleHighlight"
                    >2 spin-offs estratégicas</span
                >
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-3 delay-200"
                data-i18n="tech.subtitle"
            >
                Capacidades propias reforzadas por un ecosistema deep-tech
                especializado.
            </p>
            <div class="reveal divider mx-auto mt-4 delay-300"></div>
        </div>

        <!-- 3 Technology Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            {
                pillars.map((pillar, i) => (
                    <div
                        class:list={[
                            "reveal",
                            `delay-${(i + 1) * 100}`,
                            "group bg-white rounded-2xl border border-pangea-light-grey/60 p-6 md:p-7 flex flex-col",
                            "hover:shadow-lg transition-all duration-300",
                            `hover:border-${pillar.accent}/30`,
                        ]}
                    >
                        {/* Icon + Title */}
                        <div class="flex items-center gap-3 mb-4">
                            <div
                                class:list={[
                                    "w-10 h-10 rounded-xl flex items-center justify-center shrink-0",
                                    `bg-${pillar.accent}/10`,
                                ]}
                            >
                                <svg
                                    class:list={[
                                        "w-5 h-5",
                                        `text-${pillar.accent}`,
                                    ]}
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={pillar.icon}
                                    />
                                </svg>
                            </div>
                            <h3
                                class="text-lg font-bold text-pangea-dark-blue"
                                data-i18n={pillar.titleKey}
                            >
                                {pillar.titleDefault}
                            </h3>
                        </div>

                        {/* Description */}
                        <p
                            class="text-sm text-pangea-dark-blue/65 leading-relaxed mb-5"
                            data-i18n={pillar.descKey}
                        >
                            {pillar.descDefault}
                        </p>

                        {/* Sub-capabilities */}
                        <div class="flex flex-col gap-2.5 mb-5">
                            {pillar.subs.map((sub) => (
                                <div class="flex items-start gap-2">
                                    <svg
                                        class:list={[
                                            "w-4 h-4 shrink-0 mt-0.5",
                                            `text-${pillar.accent}`,
                                        ]}
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="m4.5 12.75 6 6 9-13.5"
                                        />
                                    </svg>
                                    <p class="text-sm text-pangea-dark-blue/80">
                                        <span
                                            class="font-semibold"
                                            data-i18n={sub.titleKey}
                                        >
                                            {sub.titleDefault}
                                        </span>
                                        <span class="text-pangea-dark-blue/60">
                                            {" — "}
                                        </span>
                                        <span
                                            class="text-pangea-dark-blue/60"
                                            data-i18n={sub.descKey}
                                        >
                                            {sub.descDefault}
                                        </span>
                                    </p>
                                </div>
                            ))}
                        </div>

                        {/* Product tags */}
                        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-pangea-light-grey/50 mt-auto">
                            {pillar.productsDefault
                                .split(",")
                                .map((productName) => {
                                    const prod = findProductByName(
                                        productName.trim(),
                                    );
                                    return prod ? (
                                        <a
                                            href={getProductUrl(
                                                prod,
                                                import.meta.env.BASE_URL,
                                            )}
                                            class:list={[
                                                "inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-colors duration-200",
                                                `bg-${pillar.accent}/8 text-${pillar.accent} hover:bg-${pillar.accent}/15`,
                                            ]}
                                            {...(isExternalProduct(prod)
                                                ? {
                                                      target: "_blank",
                                                      rel: "noopener noreferrer",
                                                  }
                                                : {})}
                                        >
                                            {prod.name}
                                        </a>
                                    ) : (
                                        <span
                                            class:list={[
                                                "inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-semibold",
                                                `bg-${pillar.accent}/8 text-${pillar.accent}`,
                                            ]}
                                        >
                                            {productName.trim()}
                                        </span>
                                    );
                                })}
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- 2 Spin-offs -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                spinoffs.map((spinoff, i) => (
                    <div
                        class:list={[
                            "reveal",
                            `delay-${(i + 4) * 100}`,
                            "bg-gradient-to-br from-pangea-dark-blue to-pangea-classic-blue rounded-2xl p-6 md:p-7 text-pangea-white relative overflow-hidden",
                        ]}
                    >
                        <div
                            class="absolute top-0 right-0 w-40 h-40 bg-pangea-sky-blue/10 rounded-full blur-3xl pointer-events-none"
                            aria-hidden="true"
                        />
                        <div class="relative z-10">
                            {/* Label + Badge */}
                            <div class="flex items-center gap-3 mb-3">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-pangea-sky-blue/70"
                                    data-i18n={spinoff.labelKey}
                                >
                                    Spin-off
                                </span>
                                <span
                                    class="px-2.5 py-0.5 rounded-full bg-pangea-white/10 text-[10px] font-semibold text-pangea-white/80"
                                    data-i18n={spinoff.badgeKey}
                                >
                                    {spinoff.badgeDefault}
                                </span>
                            </div>
                            {/* Name */}
                            <h3
                                class="text-xl font-bold text-pangea-white mb-2"
                                data-i18n={spinoff.nameKey}
                            >
                                {spinoff.nameDefault}
                            </h3>
                            {/* Description */}
                            <p
                                class="text-sm text-pangea-white/75 leading-relaxed mb-5"
                                data-i18n={spinoff.descKey}
                            >
                                {spinoff.descDefault}
                            </p>
                            {/* Features */}
                            <div class="flex flex-col gap-2">
                                {spinoff.feats.map((feat) => (
                                    <div class="flex items-center gap-2">
                                        <svg
                                            class="w-3.5 h-3.5 text-pangea-sky-blue shrink-0"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="m4.5 12.75 6 6 9-13.5"
                                            />
                                        </svg>
                                        <span
                                            class="text-sm text-pangea-white/85"
                                            data-i18n={feat.key}
                                        >
                                            {feat.default}
                                        </span>
                                    </div>
                                ))}
                            </div>
                            {/* External link CTA */}
                            <a
                                href={spinoff.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-pangea-sky-blue hover:text-pangea-white transition-colors duration-200 group/link"
                            >
                                <span>Visitar web</span>
                                <svg
                                    class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-0.5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                    />
                                </svg>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>


    </div>
</section>

<style>
    /* Safelist dynamic Tailwind classes used via template variables */
    .bg-pangea-classic-blue\/10,
    .bg-pangea-sky-blue\/10,
    .bg-pangea-calm-blue\/10 {
    }
    .bg-pangea-classic-blue\/8,
    .bg-pangea-sky-blue\/8,
    .bg-pangea-calm-blue\/8 {
    }
    .bg-pangea-classic-blue\/15,
    .bg-pangea-sky-blue\/15,
    .bg-pangea-calm-blue\/15 {
    }
    .text-pangea-classic-blue,
    .text-pangea-sky-blue,
    .text-pangea-calm-blue {
    }
    .hover\:border-pangea-classic-blue\/30,
    .hover\:border-pangea-sky-blue\/30,
    .hover\:border-pangea-calm-blue\/30 {
    }
</style>
