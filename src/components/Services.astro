// Pre-compute products per technology
const productsPerTech = technologies.map((tech) => getProductsByTag(tech.tag));

/*
 * Hexagon geometry (flat-top orientation)
 * viewBox: 0 0 600 540
 * Center: (300, 270), Radius: 230
 *
 * Vertices (clockwise from right):
 * v0 = (530, 270)   — right
 * v1 = (415, 469.2)  — bottom-right
 * v2 = (185, 469.2)  — bottom-left
 * v3 = (70,  270)    — left
 * v4 = (185, 70.8)   — top-left
 * v5 = (415, 70.8)   — top-right
 *
 * Sectors (triangles from center, clockwise from top):
 * S0 = top:          center → v4 → v5   → Data Utilities
 * S1 = top-right:    center → v5 → v0   → AI
 * S2 = bottom-right: center → v0 → v1   → Manufacturing
 * S3 = bottom:       center → v1 → v2   → Hardware
 * S4 = bottom-left:  center → v2 → v3   → Nano
 * S5 = top-left:     center → v3 → v4   → Bio
 */

const CX = 300;
const CY = 270;
const R = 230;

// Flat-top hex vertices
const vertices = [
    { x: CX + R, y: CY }, // v0 right
    { x: CX + R * 0.5, y: CY + R * 0.866 }, // v1 bottom-right
    { x: CX - R * 0.5, y: CY + R * 0.866 }, // v2 bottom-left
    { x: CX - R, y: CY }, // v3 left
    { x: CX - R * 0.5, y: CY - R * 0.866 }, // v4 top-left
    { x: CX + R * 0.5, y: CY - R * 0.866 }, // v5 top-right
];

// Sectors mapped to technologies: clockwise from top
// Each sector: [vertexA_index, vertexB_index] → triangle = center + vA + vB
const sectorVertices = [
    [4, 5], // top → Data
    [5, 0], // top-right → AI
    [0, 1], // bottom-right → Manufacturing
    [1, 2], // bottom → Hardware
    [2, 3], // bottom-left → Nano
    [3, 4], // top-left → Bio
];

// Content positions (70% from center toward edge midpoint)
const contentPositions = sectorVertices.map(([a, b]) => {
    const edgeMidX = (vertices[a].x + vertices[b].x) / 2;
    const edgeMidY = (vertices[a].y + vertices[b].y) / 2;
    return {
        x: CX + 0.62 * (edgeMidX - CX),
        y: CY + 0.62 * (edgeMidY - CY),
    };
});

// Build sector polygon strings
const sectorPolygons = sectorVertices.map(
    ([a, b]) =>
        `${CX},${CY} ${vertices[a].x.toFixed(1)},${vertices[a].y.toFixed(1)} ${vertices[b].x.toFixed(1)},${vertices[b].y.toFixed(1)}`,
);

// Outer hex polygon string
const outerHex = vertices
    .map((v) => `${v.x.toFixed(1)},${v.y.toFixed(1)}`)
    .join(" ");

// Separator lines (center → each vertex)
const separatorLines = vertices.map((v) => ({
    x1: CX,
    y1: CY,
    x2: v.x,
    y2: v.y,
}));
---

<section
    id="services"
    class="relative section-padding bg-pangea-light-grey/30 overflow-hidden"
>
    <!-- Background decorative elements -->
    <div
        class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute top-1/4 -right-40 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-1/4 -left-40 w-[400px] h-[400px] rounded-full bg-pangea-classic-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-12 md:mb-16">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-4"
                data-i18n="tech.label"
            >
                Tecnologías eXponenciales
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="tech.title">Nuestras</span>{" "}
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="tech.titleHighlight">Tecnologías</span
                >
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-5 delay-200"
                data-i18n="tech.subtitle"
            >
                Somos expertos en combinar y mezclar tecnologías eXponenciales
                para crear productos tecnológicos innovadores customizables para
                diversos casos de negocio y sectores.
            </p>
            <div class="reveal divider mx-auto mt-6 delay-300"></div>
        </div>

        <!-- Hexagon + Detail layout -->
        <div class="reveal delay-200 hex-layout">
            <!-- SVG Hexagon -->
            <div class="hex-wrapper">
                <svg
                    viewBox="0 0 600 540"
                    xmlns="http://www.w3.org/2000/svg"
                    class="hex-svg"
                    role="img"
                    aria-label="Hexágono de Tecnologías eXponenciales"
                >
                    <defs>
                        <!-- Glow filter for active sector -->
                        <filter
                            id="sectorGlow"
                            x="-20%"
                            y="-20%"
                            width="140%"
                            height="140%"
                        >
                            <feGaussianBlur
                                in="SourceGraphic"
                                stdDeviation="6"
                                result="blur"></feGaussianBlur>
                            <feMerge>
                                <feMergeNode in="blur"></feMergeNode>
                                <feMergeNode in="SourceGraphic"></feMergeNode>
                            </feMerge>
                        </filter>
                    </defs>

                    <!-- Sector fills (interactive triangles) -->
                    {
                        technologies.map((tech, i) => (
                            <polygon
                                points={sectorPolygons[i]}
                                fill={tech.hexColorLight}
                                stroke="none"
                                class="hex-sector"
                                data-sector={i}
                                data-color-light={tech.hexColorLight}
                                data-color-mid={tech.hexColorMid}
                                data-color-accent={tech.hexColor}
                            />
                        ))
                    }

                    <!-- Separator lines (center to vertices) -->
                    {
                        separatorLines.map((line) => (
                            <line
                                x1={line.x1}
                                y1={line.y1}
                                x2={line.x2}
                                y2={line.y2}
                                stroke="white"
                                stroke-width="2"
                                stroke-opacity="0.7"
                                class="pointer-events-none"
                            />
                        ))
                    }

                    <!-- Outer hexagon border -->
                    <polygon
                        points={outerHex}
                        fill="none"
                        stroke="#88B0D8"
                        stroke-width="2"
                        stroke-opacity="0.35"
                        class="pointer-events-none"></polygon>

                    <!-- Center decorative circle + label -->
                    <circle
                        cx={CX}
                        cy={CY}
                        r="44"
                        fill="white"
                        stroke="#88B0D8"
                        stroke-width="1.5"
                        stroke-opacity="0.3"
                        class="pointer-events-none"></circle>
                    <text
                        x={CX}
                        y={CY - 6}
                        text-anchor="middle"
                        dominant-baseline="middle"
                        class="hex-center-label pointer-events-none"
                        fill="#1F3042"
                    >
                        e<tspan font-weight="800">X</tspan>
                    </text>
                    <text
                        x={CX}
                        y={CY + 14}
                        text-anchor="middle"
                        dominant-baseline="middle"
                        class="hex-center-sublabel pointer-events-none"
                        fill="#88B0D8"
                    >
                        ponenciales
                    </text>

                    <!-- Icons + labels per sector -->
                    {
                        technologies.map((tech, i) => {
                            const pos = contentPositions[i];
                            const iconX = pos.x - 14;
                            const iconY = pos.y - 28;
                            return (
                                <g
                                    class="hex-sector-content pointer-events-none"
                                    data-sector-content={i}
                                >
                                    {/* Icon background circle */}
                                    <circle
                                        cx={pos.x}
                                        cy={pos.y - 16}
                                        r="20"
                                        fill={tech.hexColorLight}
                                        stroke={tech.hexColor}
                                        stroke-width="1"
                                        stroke-opacity="0.3"
                                    />
                                    {/* Icon */}
                                    <svg
                                        x={iconX}
                                        y={iconY}
                                        width="28"
                                        height="28"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke={tech.hexColor}
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d={tech.iconPath} />
                                    </svg>
                                    {/* Title — split into multiple lines for long names */}
                                    {tech.titleDefault.split(" ").length <=
                                    2 ? (
                                        <text
                                            x={pos.x}
                                            y={pos.y + 16}
                                            text-anchor="middle"
                                            dominant-baseline="middle"
                                            class="hex-label"
                                            fill="#1F3042"
                                            data-i18n={tech.titleKey}
                                        >
                                            {tech.titleDefault}
                                        </text>
                                    ) : (
                                        <>
                                            <text
                                                x={pos.x}
                                                y={pos.y + 12}
                                                text-anchor="middle"
                                                dominant-baseline="middle"
                                                class="hex-label"
                                                fill="#1F3042"
                                                data-i18n={tech.titleKey}
                                            >
                                                {tech.titleDefault
                                                    .split(" ")
                                                    .slice(0, -1)
                                                    .join(" ")}
                                            </text>
                                            <text
                                                x={pos.x}
                                                y={pos.y + 26}
                                                text-anchor="middle"
                                                dominant-baseline="middle"
                                                class="hex-label"
                                                fill="#1F3042"
                                            >
                                                {tech.titleDefault
                                                    .split(" ")
                                                    .slice(-1)
                                                    .join(" ")}
                                            </text>
                                        </>
                                    )}
                                </g>
                            );
                        })
                    }

                    <!-- Active sector highlight ring (animated) -->
                    <polygon
                        id="hexActiveOutline"
                        points={sectorPolygons[0]}
                        fill="none"
                        stroke={technologies[0].hexColor}
                        stroke-width="2.5"
                        stroke-opacity="0.5"
                        class="pointer-events-none transition-all duration-300"
                    ></polygon>
                </svg>
            </div>

            <!-- Detail Panel -->
            <div class="hex-detail" id="hexDetail">
                <!-- Active indicator dot -->
                <div class="hex-detail-indicator" id="hexDetailDot"></div>

                <div class="hex-detail-inner">
                    <h3 class="hex-detail-title" id="hexDetailTitle">
                        {technologies[0].titleDefault}
                    </h3>
                    <p class="hex-detail-description" id="hexDetailDesc">
                        {technologies[0].descriptionDefault}
                    </p>

                    <!-- Products per sector (one container per tech, toggled via JS) -->
                    {
                        technologies.map((tech, i) => {
                            const techProducts = productsPerTech[i];
                            return (
                                <div
                                    class={`hex-products-container ${i === 0 ? "" : "hidden"}`}
                                    data-products-for={i}
                                >
                                    <p
                                        class="text-[10px] font-bold uppercase tracking-[0.2em] text-pangea-dark-blue/40 mb-2.5 mt-1"
                                        data-i18n="tech.relatedProducts"
                                    >
                                        Productos relacionados
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        {techProducts.map((product) => {
                                            const href = getProductUrl(
                                                product,
                                                import.meta.env.BASE_URL,
                                            );
                                            const isExt =
                                                isExternalProduct(product);
                                            return (
                                                <a
                                                    href={href}
                                                    class="hex-product-chip group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 hover:-translate-y-0.5"
                                                    style={`border-color: ${tech.hexColor}25; background: ${tech.hexColor}08;`}
                                                    {...(isExt
                                                        ? {
                                                              target: "_blank",
                                                              rel: "noopener noreferrer",
                                                          }
                                                        : {})}
                                                >
                                                    <svg
                                                        class="w-3.5 h-3.5 shrink-0 opacity-50 group-hover:opacity-100 transition-opacity"
                                                        style={`color: ${tech.hexColor};`}
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                        stroke-width="1.5"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            d={product.icon}
                                                        />
                                                    </svg>
                                                    <span class="text-xs font-semibold text-pangea-dark-blue/70 group-hover:text-pangea-dark-blue transition-colors">
                                                        {product.name}
                                                    </span>
                                                    {isExt && (
                                                        <svg
                                                            class="w-2.5 h-2.5 text-pangea-dark-blue/30 shrink-0"
                                                            fill="none"
                                                            viewBox="0 0 24 24"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                                            />
                                                        </svg>
                                                    )}
                                                </a>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </div>

        <!-- Bottom CTA -->
        <div class="reveal delay-300 text-center mt-14 md:mt-18">
            <p
                class="text-base md:text-lg text-pangea-dark-blue/60 font-light mb-6"
                data-i18n="tech.cta.text"
            >
                ¿Buscas una solución a medida? Exploremos cómo podemos ayudarte.
            </p>
            <a href="#contact" class="btn-primary">
                <span data-i18n="tech.cta.button">Hablemos</span>
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
            </a>
        </div>
    </div>
</section>

<script>
    // ──────────────────────────────────────────────
    // Interactive Hexagon – sector hover / click
    // ──────────────────────────────────────────────

    interface TechData {
        titleKey: string;
        descriptionKey: string;
        tagsKey: string;
        titleDefault: string;
        descriptionDefault: string;
        tagsDefault: string;
        accentColor: string;
        hexColor: string;
    }

    const techData: TechData[] = [
        {
            titleKey: "tech.card1.title",
            descriptionKey: "tech.card1.description",
            tagsKey: "tech.card1.tags",
            titleDefault: "Data Utilities",
            descriptionDefault:
                "Big Data e Internet de las Cosas Industrial (IIoT). Captura, procesamiento y análisis de datos masivos para la toma de decisiones inteligente en entornos industriales.",
            tagsDefault:
                "Big Data,IIoT,Procesamiento de Datos,Monitorización Industrial",
            accentColor: "pangea-sky-blue",
            hexColor: "#66CCFF",
        },
        {
            titleKey: "tech.card2.title",
            descriptionKey: "tech.card2.description",
            tagsKey: "tech.card2.tags",
            titleDefault: "Inteligencia Artificial",
            descriptionDefault:
                "Deep learning, data analytics y modelos predictivos aplicados a la optimización de procesos industriales, calidad de producto y mantenimiento predictivo.",
            tagsDefault:
                "Deep Learning,Data Analytics,Modelos Predictivos,Optimización",
            accentColor: "pangea-classic-blue",
            hexColor: "#336699",
        },
        {
            titleKey: "tech.card3.title",
            descriptionKey: "tech.card3.description",
            tagsKey: "tech.card3.tags",
            titleDefault: "Fabricación Avanzada",
            descriptionDefault:
                "Impresión 3D y fabricación aditiva industrial. Diseño, prototipado rápido e industrialización de flujos de fabricación aditiva para personalización en masa.",
            tagsDefault:
                "Impresión 3D,Prototipado Rápido,Fabricación Aditiva,Diseño para AM",
            accentColor: "pangea-calm-blue",
            hexColor: "#88B0D8",
        },
        {
            titleKey: "tech.card4.title",
            descriptionKey: "tech.card4.description",
            tagsKey: "tech.card4.tags",
            titleDefault: "Hardware & Robótica",
            descriptionDefault:
                "Desarrollo de sensores customizados, sistemas robóticos y dispositivos hardware especializados para aplicaciones industriales específicas.",
            tagsDefault:
                "Sensores Custom,Robótica,Dispositivos IoT,Automatización",
            accentColor: "pangea-roast-sand",
            hexColor: "#C5BCA4",
        },
        {
            titleKey: "tech.card5.title",
            descriptionKey: "tech.card5.description",
            tagsKey: "tech.card5.tags",
            titleDefault: "NanoTecnología",
            descriptionDefault:
                "Aplicaciones del grafeno y nanomateriales avanzados. Mejora de propiedades de materiales, recubrimientos funcionales y nuevas soluciones a escala nanométrica.",
            tagsDefault:
                "Grafeno,Nanomateriales,Recubrimientos,Materiales Avanzados",
            accentColor: "pangea-sky-blue",
            hexColor: "#66CCFF",
        },
        {
            titleKey: "tech.card6.title",
            descriptionKey: "tech.card6.description",
            tagsKey: "tech.card6.tags",
            titleDefault: "BioTecnología",
            descriptionDefault:
                "CRISPR y bio-productos innovadores que aceleran drásticamente procesos industriales. Bio-sensores y soluciones biológicas para aplicaciones industriales.",
            tagsDefault:
                "CRISPR,Bio-sensores,Bio-productos,Procesos Biológicos",
            accentColor: "pangea-classic-blue",
            hexColor: "#336699",
        },
    ];

    function initHexagon() {
        const sectors =
            document.querySelectorAll<SVGPolygonElement>(".hex-sector");
        const sectorContents = document.querySelectorAll<SVGGElement>(
            ".hex-sector-content",
        );
        const activeOutline = document.getElementById(
            "hexActiveOutline",
        ) as SVGPolygonElement | null;
        const detailTitle = document.getElementById("hexDetailTitle");
        const detailDesc = document.getElementById("hexDetailDesc");
        const detailDot = document.getElementById("hexDetailDot");

        if (!detailTitle || !detailDesc) return;

        let activeIndex = 0;
        let isLocked = false;

        function getTranslation(key: string): string | null {
            const translations: Record<string, Record<string, string>> = (
                window as any
            ).__pangea_translations;
            const locale = localStorage.getItem("pangea-locale") || "es";
            if (translations?.[locale]?.[key]) {
                return translations[locale][key];
            }
            return null;
        }

        // Product containers per sector
        const productContainers = document.querySelectorAll<HTMLElement>(
            "[data-products-for]",
        );

        function activateSector(index: number) {
            if (index === activeIndex) return;
            activeIndex = index;
            const tech = techData[index];

            // Update sector fills
            sectors.forEach((sector, i) => {
                const light = sector.getAttribute("data-color-light") || "";
                const mid = sector.getAttribute("data-color-mid") || "";
                sector.setAttribute("fill", i === index ? mid : light);
                sector.style.transition = "fill 0.3s ease";
            });

            // Scale active sector content
            sectorContents.forEach((g, i) => {
                if (i === index) {
                    g.style.transform = "scale(1.08)";
                    g.style.transformOrigin = "center";
                    g.style.transition = "transform 0.3s ease";
                } else {
                    g.style.transform = "scale(1)";
                    g.style.transformOrigin = "center";
                    g.style.transition = "transform 0.3s ease";
                }
            });

            // Update active outline
            if (activeOutline) {
                const targetSector = sectors[index];
                if (targetSector) {
                    activeOutline.setAttribute(
                        "points",
                        targetSector.getAttribute("points") || "",
                    );
                    activeOutline.setAttribute("stroke", tech.hexColor);
                }
            }

            // Update detail panel with translations or defaults
            const title = getTranslation(tech.titleKey) || tech.titleDefault;
            const desc =
                getTranslation(tech.descriptionKey) || tech.descriptionDefault;

            detailTitle!.textContent = title;
            detailTitle!.style.color = tech.hexColor;

            detailDesc!.textContent = desc;

            // Show/hide product containers
            productContainers.forEach((container) => {
                const forIndex = container.getAttribute("data-products-for");
                if (forIndex === String(index)) {
                    container.classList.remove("hidden");
                } else {
                    container.classList.add("hidden");
                }
            });

            // Update indicator dot color
            if (detailDot) {
                detailDot.style.backgroundColor = tech.hexColor;
            }
        }

        // Sector hover
        sectors.forEach((sector, i) => {
            sector.addEventListener("mouseenter", () => {
                if (!isLocked) activateSector(i);
            });

            sector.addEventListener("click", () => {
                isLocked = activeIndex === i ? !isLocked : true;
                activateSector(i);
            });
        });

        // Reset on mouse leave from the SVG (only if not locked)
        const svg = document.querySelector(".hex-svg");
        if (svg) {
            svg.addEventListener("mouseleave", () => {
                if (!isLocked) {
                    // stay on current, don't reset
                }
            });
        }

        // Listen for locale changes
        window.addEventListener("locale-changed", () => {
            // Re-render detail for current active sector
            const tech = techData[activeIndex];
            const title = getTranslation(tech.titleKey) || tech.titleDefault;
            const desc =
                getTranslation(tech.descriptionKey) || tech.descriptionDefault;

            detailTitle!.textContent = title;
            detailDesc!.textContent = desc;
        });

        // Initialize first sector as active
        activateSector(0);

        // Auto-rotate on load (optional, nice touch)
        let rotateInterval: ReturnType<typeof setInterval> | null = null;

        function startAutoRotate() {
            rotateInterval = setInterval(() => {
                if (!isLocked) {
                    const next = (activeIndex + 1) % 6;
                    activateSector(next);
                }
            }, 4000);
        }

        function stopAutoRotate() {
            if (rotateInterval) {
                clearInterval(rotateInterval);
                rotateInterval = null;
            }
        }

        // Start auto-rotate, stop on any user interaction
        startAutoRotate();

        if (svg) {
            svg.addEventListener("mouseenter", stopAutoRotate);
            svg.addEventListener("mouseleave", () => {
                if (!isLocked) startAutoRotate();
            });
            svg.addEventListener("click", stopAutoRotate);
        }
    }

    document.addEventListener("DOMContentLoaded", initHexagon);
    document.addEventListener("astro:page-load", initHexagon);
</script>

