---
// Hero section – modern full viewport with video background, refined animations
---

<section
    id="hero"
    class="relative min-h-dvh flex items-center justify-center overflow-hidden"
>
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
        <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            class="hero-video w-full h-full object-cover"
        >
            <source
                src={`${import.meta.env.BASE_URL}videos/PANGEA_videoINTRO_FullHD_1920x1080.mp4`}
                type="video/mp4"
            />
        </video>
        <!-- Multi-layer overlay for depth -->
        <div
            class="absolute inset-0 bg-gradient-to-b from-pangea-dark-blue/90 via-pangea-dark-blue/50 to-pangea-dark-blue/95"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-r from-pangea-dark-blue/40 via-transparent to-pangea-dark-blue/40"
        >
        </div>
    </div>

    <!-- Subtle grid pattern overlay -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-[0.015]"
        aria-hidden="true"
        style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>'); background-size: 60px 60px;"
    >
    </div>

    <!-- Animated decorative elements -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none overflow-hidden"
        aria-hidden="true"
    >
        <!-- Floating orb top-right -->
        <div
            class="absolute -top-20 -right-20 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.04] blur-3xl animate-float"
        >
        </div>
        <!-- Floating orb bottom-left -->
        <div
            class="absolute -bottom-32 -left-32 w-[600px] h-[600px] rounded-full bg-pangea-calm-blue/[0.04] blur-3xl animate-float"
            style="animation-delay: -3s;"
        >
        </div>
    </div>

    <!-- Content -->
    <div
        class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 flex flex-col justify-center min-h-dvh py-28"
    >
        <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12 xl:gap-16">
        <div class="max-w-3xl lg:flex-1">
            <!-- Badge -->
            <div class="hero-reveal hero-delay-1 flex items-center gap-3 mb-8">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-pangea-white/10 border border-pangea-white/15 backdrop-blur-sm">
                    <svg class="w-4 h-4 text-pangea-sky-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                    <span class="text-xs sm:text-sm font-semibold tracking-wide text-pangea-white/90" data-i18n="hero.badge">Deep-Tech para Defensa</span>
                </div>
            </div>

            <!-- Tagline — big, left-aligned -->
            <h1
                class="hero-reveal hero-delay-2 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-pangea-white leading-[1.05] tracking-tight"
            >
                <span data-i18n="hero.tagline">La fábrica de activos</span>
                <br />
                <span
                    class="text-pangea-white"
                    data-i18n="hero.taglineHighlight">intangibles</span
                >
            </h1>

            <!-- Subtitle large -->
            <p
                class="hero-reveal hero-delay-3 text-xl sm:text-2xl md:text-3xl font-light text-pangea-white mt-5 sm:mt-6"
                data-i18n="hero.subtitleLarge"
            >
                Ingeniería del futuro con tecnologías exponenciales
            </p>

            <!-- Subtitle -->
            <p
                class="hero-reveal hero-delay-4 max-w-xl text-base sm:text-lg text-pangea-white/70 font-light leading-relaxed mt-4 sm:mt-5"
                data-i18n-html="hero.subtitle"
            >
                Tecnologías eXponenciales aplicadas a la <strong>Base Aérea Inteligente</strong>: conectamos capacidades deep-tech con <strong>AF1–AF6</strong> y casos de uso BACSI para acelerar despliegue, resiliencia y sostenimiento 4.0.
            </p>

            <!-- Capability tags -->
            <div class="hero-reveal hero-delay-5 flex flex-wrap gap-2 mt-6">
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag1">IA · Optimización</span>
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag2">IA · Visión Artificial</span>
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag3">IA · Inteligencia documental</span>
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag4">Materiales · Electrónica impresa</span>
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag5">Biotech · Vigilancia biológica</span>
                <span class="px-3 py-1.5 rounded-full bg-pangea-white/[0.08] border border-pangea-white/10 text-xs font-medium text-pangea-white/75" data-i18n="hero.tag6">Spin-offs · 61HEX & Arquea</span>
            </div>

            <!-- CTAs -->
            <div class="hero-reveal hero-delay-6 flex flex-wrap items-center gap-4 mt-8">
                <a href="#services" class="btn-primary group">
                    <span data-i18n="hero.cta.services">Explorar capacidades</span>
                    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                </a>
                <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-pangea-white/90 border border-pangea-white/20 hover:bg-pangea-white/10 hover:border-pangea-white/30 transition-all duration-300">
                    <span data-i18n="hero.cta.contact">Contacta con nosotros</span>
                </a>
            </div>
        </div>

        <!-- BACSI Logo -->
        <div class="hero-reveal hero-delay-5 hidden lg:flex items-center justify-center lg:flex-shrink-0 mt-10 lg:mt-0">
            <div class="bacsi-logo-wrapper relative w-64 xl:w-80">
                <!-- Bright backlight to lift logo from dark bg -->
                <div class="bacsi-glow absolute inset-[5%] rounded-full bg-white/[0.08] blur-2xl"></div>
                <img
                    src={`${import.meta.env.BASE_URL}images/bacsi-logo.png`}
                    alt="BACSI – Base Aérea Conectada, Sostenible e Inteligente"
                    class="bacsi-logo relative w-full h-auto"
                    loading="eager"
                />
            </div>
        </div>
    </div>
    </div>

    <!-- Scroll down indicator -->
    <a
        href="#about"
        class="hero-reveal hero-delay-7 scroll-cta absolute bottom-10 left-0 right-0 z-10 flex flex-col items-center gap-3 group cursor-pointer"
        aria-label="Scroll to next section"
    >
        <span
            class="text-[11px] uppercase tracking-[0.25em] text-pangea-white/50 font-semibold group-hover:text-pangea-white/90 transition-all duration-500"
            data-i18n="hero.scroll"
        >
            Descubrir más
        </span>
        <div class="scroll-arrow-wrap">
            <svg
                class="scroll-arrow w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 10l5 5 5-5"></path>
            </svg>
            <svg
                class="scroll-arrow scroll-arrow-2 w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 10l5 5 5-5"></path>
            </svg>
        </div>
    </a>
</section>

<script>
  document.querySelector('.scroll-cta')?.addEventListener('click', (e) => {
    e.preventDefault();
    const target = document.getElementById('about');
    if (!target) return;

    // Disable CSS smooth scroll to avoid conflict
    document.documentElement.style.scrollBehavior = 'auto';

    const start = window.scrollY;
    const end = target.getBoundingClientRect().top + start;
    const distance = end - start;
    const duration = 800;
    const startTime = performance.now();

    function easeInOutCubic(t: number) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      window.scrollTo(0, start + distance * easeInOutCubic(progress));
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        document.documentElement.style.scrollBehavior = '';
      }
    }

    requestAnimationFrame(step);
  });
</script>

<style>
    /* ── Video background ──────────────────────────── */
    .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Staggered reveal animation ────────────────── */
    .hero-reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-delay-1 {
        animation-delay: 0.1s;
    }
    .hero-delay-2 {
        animation-delay: 0.25s;
    }
    .hero-delay-3 {
        animation-delay: 0.4s;
    }
    .hero-delay-4 {
        animation-delay: 0.55s;
    }
    .hero-delay-5 {
        animation-delay: 0.7s;
    }
    .hero-delay-6 {
        animation-delay: 0.85s;
    }
    .hero-delay-7 {
        animation-delay: 1.1s;
    }

    @keyframes heroReveal {
        0% {
            opacity: 0;
            transform: translateY(24px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Scroll CTA ────────────────────────────────── */
    .scroll-cta {
        text-decoration: none;
    }

    .scroll-arrow-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        margin-top: -2px;
    }

    .scroll-arrow {
        color: rgba(255, 255, 255, 0.35);
        animation: scrollFade 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        transition: color 0.5s ease;
    }

    .scroll-arrow-2 {
        margin-top: -10px;
        animation-delay: 0.45s;
    }

    .group:hover .scroll-arrow {
        color: rgba(102, 204, 255, 0.9);
    }

    @keyframes scrollFade {
        0% {
            opacity: 0;
            transform: translateY(-6px);
        }
        30% {
            opacity: 1;
            transform: translateY(0);
        }
        70% {
            opacity: 1;
            transform: translateY(4px);
        }
        100% {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    /* ── Responsive height helpers ─────────────────── */
    .h-18 {
        height: 4.5rem;
    }
    .h-22 {
        height: 5.5rem;
    }
    .h-26 {
        height: 6.5rem;
    }

    /* ── BACSI logo effects ───────────────────────── */
    .bacsi-logo-wrapper {
        animation: bacsiFloat 6s ease-in-out infinite;
    }

    .bacsi-logo {
        filter: drop-shadow(0 0 40px rgba(255, 255, 255, 0.4))
                drop-shadow(0 0 80px rgba(102, 204, 255, 0.35))
                drop-shadow(0 0 120px rgba(102, 204, 255, 0.15))
                drop-shadow(0 10px 40px rgba(0, 0, 0, 0.6));
        transition: filter 0.5s ease, transform 0.5s ease;
    }

    .bacsi-logo-wrapper:hover .bacsi-logo {
        filter: drop-shadow(0 0 50px rgba(255, 255, 255, 0.55))
                drop-shadow(0 0 100px rgba(102, 204, 255, 0.45))
                drop-shadow(0 0 140px rgba(102, 204, 255, 0.2))
                drop-shadow(0 10px 44px rgba(0, 0, 0, 0.65));
        transform: scale(1.04);
    }

    .bacsi-glow {
        animation: bacsiPulse 4s ease-in-out infinite;
    }

    @keyframes bacsiPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50%      { opacity: 1;   transform: scale(1.08); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .animate-bounce-slow,
        .scroll-arrow {
            animation: none;
        }
        .bacsi-logo-wrapper,
        .bacsi-glow {
            animation: none;
        }
    }
</style>
