---
// Hero section – modern full viewport with video background, refined animations
---

<section
    id="hero"
    class="relative min-h-dvh flex items-center justify-center overflow-hidden"
>
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
        <video
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            class="hero-video w-full h-full object-cover"
        >
            <source
                src={`${import.meta.env.BASE_URL}videos/PANGEA_videoINTRO_FullHD_1920x1080.mp4`}
                type="video/mp4"
            />
        </video>
        <!-- Multi-layer overlay for depth -->
        <div
            class="absolute inset-0 bg-gradient-to-b from-pangea-dark-blue/90 via-pangea-dark-blue/50 to-pangea-dark-blue/95"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-r from-pangea-dark-blue/40 via-transparent to-pangea-dark-blue/40"
        >
        </div>
    </div>

    <!-- Subtle grid pattern overlay -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-[0.015]"
        aria-hidden="true"
        style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>'); background-size: 60px 60px;"
    >
    </div>

    <!-- Animated decorative elements -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none overflow-hidden"
        aria-hidden="true"
    >
        <!-- Floating orb top-right -->
        <div
            class="absolute -top-20 -right-20 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.04] blur-3xl animate-float"
        >
        </div>
        <!-- Floating orb bottom-left -->
        <div
            class="absolute -bottom-32 -left-32 w-[600px] h-[600px] rounded-full bg-pangea-calm-blue/[0.04] blur-3xl animate-float"
            style="animation-delay: -3s;"
        >
        </div>
        <!-- Accent line -->
        <div
            class="absolute top-1/3 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-sky-blue/[0.07] to-transparent"
        >
        </div>
        <div
            class="absolute bottom-1/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/[0.05] to-transparent"
        >
        </div>
    </div>

    <!-- Content -->
    <div
        class="relative z-10 section-container px-6 sm:px-10 flex flex-col items-center text-center gap-6 sm:gap-8"
    >
        <!-- Logo with glow effect -->
        <div class="hero-reveal hero-delay-1 relative">
            <div
                class="absolute inset-0 blur-3xl opacity-20 scale-150"
                style="background: radial-gradient(ellipse, #66CCFF 0%, transparent 70%);"
            >
            </div>
            <img
                src={`${import.meta.env.BASE_URL}Logo/TNP_logo_WHITE.png`}
                alt="TheNextPangea"
                class="relative h-14 sm:h-18 md:h-22 lg:h-26 w-auto drop-shadow-lg"
                loading="eager"
            />
        </div>

        <!-- Divider with animated width -->
        <div class="hero-reveal hero-delay-2 flex items-center gap-3">
            <div
                class="w-8 sm:w-12 h-px bg-gradient-to-r from-transparent to-pangea-sky-blue/50"
            >
            </div>
            <div class="w-2 h-2 rounded-full bg-pangea-sky-blue/60"></div>
            <div
                class="w-8 sm:w-12 h-px bg-gradient-to-l from-transparent to-pangea-sky-blue/50"
            >
            </div>
        </div>

        <!-- Tagline -->
        <h1
            class="hero-reveal hero-delay-3 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extralight tracking-wide text-pangea-white leading-tight"
        >
            <span data-i18n="hero.tagline">Expertos en Tecnologías</span>
            <br class="hidden sm:block" />
            <span
                class="font-black text-gradient"
                data-i18n="hero.taglineHighlight">eXponenciales</span
            >
        </h1>

        <!-- Subtitle -->
        <p
            class="hero-reveal hero-delay-4 max-w-2xl text-sm sm:text-base md:text-lg text-pangea-white/80 font-light leading-relaxed"
            data-i18n="hero.subtitle"
        >
            Somos expertos en combinar y mezclar tecnologías eXponenciales para
            crear productos tecnológicos innovadores y customizables para
            diversos casos de negocio y sectores.
        </p>

        <!-- Key Stats Bar -->
        <div
            class="hero-reveal hero-delay-5 flex flex-wrap items-center justify-center gap-6 sm:gap-10 mt-2 py-5 px-6 sm:px-10 rounded-2xl bg-pangea-white/[0.06] border border-pangea-white/[0.10] backdrop-blur-sm"
        >
            <div class="flex flex-col items-center">
                <span
                    class="text-2xl sm:text-3xl font-black text-pangea-white tabular-nums"
                    >26</span
                >
                <span
                    class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-pangea-white/70 mt-1 font-medium"
                    data-i18n="about.stat1.label"
                    >Laboratorios & Plantas Piloto</span
                >
            </div>
            <div
                class="w-px h-10 bg-pangea-white/10 hidden sm:block"
                aria-hidden="true"
            >
            </div>
            <div class="flex flex-col items-center">
                <span
                    class="text-2xl sm:text-3xl font-black text-pangea-white tabular-nums"
                    >100+</span
                >
                <span
                    class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-pangea-white/70 mt-1 font-medium"
                    data-i18n="about.stat2.label">Soluciones Desplegadas</span
                >
            </div>
            <div
                class="w-px h-10 bg-pangea-white/10 hidden sm:block"
                aria-hidden="true"
            >
            </div>
            <div class="flex flex-col items-center">
                <span
                    class="text-2xl sm:text-3xl font-black text-pangea-white tabular-nums"
                    >$1B</span
                >
                <span
                    class="text-[10px] sm:text-xs uppercase tracking-[0.15em] text-pangea-white/70 mt-1 font-medium"
                    data-i18n="about.stat3.label">Valor Creado</span
                >
            </div>
        </div>

        <!-- CTA Buttons -->
        <div
            class="hero-reveal hero-delay-6 flex flex-col sm:flex-row items-center gap-4 mt-2"
        >
            <a href="#services" class="group btn-primary">
                <span data-i18n="hero.cta.services"
                    >Descubre Nuestras Tecnologías</span
                >
                <svg
                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m4.5 5.25 7.5 7.5 7.5-7.5m-15 6 7.5 7.5 7.5-7.5"
                    ></path>
                </svg>
            </a>
            <a href="#contact" class="btn-secondary group">
                <span data-i18n="hero.cta.contact">Contáctanos</span>
                <svg
                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 opacity-60"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
            </a>
        </div>
    </div>

    <!-- Scroll down indicator -->
    <div
        class="hero-reveal hero-delay-7 absolute bottom-8 left-0 right-0 z-10 flex flex-col items-center gap-2"
    >
        <span
            class="text-[10px] uppercase tracking-[0.3em] text-pangea-white/50 font-medium"
            data-i18n="hero.scroll"
        >
            Scroll
        </span>
        <div class="scroll-indicator">
            <div class="scroll-dot"></div>
        </div>
    </div>
</section>

<style>
    /* ── Video background ──────────────────────────── */
    .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Staggered reveal animation ────────────────── */
    .hero-reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-delay-1 {
        animation-delay: 0.1s;
    }
    .hero-delay-2 {
        animation-delay: 0.25s;
    }
    .hero-delay-3 {
        animation-delay: 0.4s;
    }
    .hero-delay-4 {
        animation-delay: 0.55s;
    }
    .hero-delay-5 {
        animation-delay: 0.7s;
    }
    .hero-delay-6 {
        animation-delay: 0.85s;
    }
    .hero-delay-7 {
        animation-delay: 1.1s;
    }

    @keyframes heroReveal {
        0% {
            opacity: 0;
            transform: translateY(24px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Scroll indicator ──────────────────────────── */
    .scroll-indicator {
        width: 20px;
        height: 34px;
        border-radius: 999px;
        border: 1.5px solid rgba(255, 255, 255, 0.35);
        display: flex;
        justify-content: center;
        padding-top: 6px;
    }

    .scroll-dot {
        width: 3px;
        height: 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.7);
        animation: scrollBounce 2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    @keyframes scrollBounce {
        0%,
        100% {
            opacity: 0.5;
            transform: translateY(0);
        }
        50% {
            opacity: 1;
            transform: translateY(10px);
        }
    }

    /* ── Responsive height helpers ─────────────────── */
    .h-18 {
        height: 4.5rem;
    }
    .h-22 {
        height: 5.5rem;
    }
    .h-26 {
        height: 6.5rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .scroll-dot {
            animation: none;
        }
    }
</style>
