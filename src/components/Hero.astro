---
// Hero section – modern full viewport with video background, refined animations
---

<section
    id="hero"
    class="relative min-h-dvh flex items-center justify-center overflow-hidden"
>
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
        <video
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            class="hero-video w-full h-full object-cover"
        >
            <source
                src={`${import.meta.env.BASE_URL}videos/PANGEA_videoINTRO_FullHD_1920x1080.mp4`}
                type="video/mp4"
            />
        </video>
        <!-- Multi-layer overlay for depth -->
        <div
            class="absolute inset-0 bg-gradient-to-b from-pangea-dark-blue/90 via-pangea-dark-blue/50 to-pangea-dark-blue/95"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-r from-pangea-dark-blue/40 via-transparent to-pangea-dark-blue/40"
        >
        </div>
    </div>

    <!-- Subtle grid pattern overlay -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-[0.015]"
        aria-hidden="true"
        style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>'); background-size: 60px 60px;"
    >
    </div>

    <!-- Animated decorative elements -->
    <div
        class="absolute inset-0 z-[1] pointer-events-none overflow-hidden"
        aria-hidden="true"
    >
        <!-- Floating orb top-right -->
        <div
            class="absolute -top-20 -right-20 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.04] blur-3xl animate-float"
        >
        </div>
        <!-- Floating orb bottom-left -->
        <div
            class="absolute -bottom-32 -left-32 w-[600px] h-[600px] rounded-full bg-pangea-calm-blue/[0.04] blur-3xl animate-float"
            style="animation-delay: -3s;"
        >
        </div>
    </div>

    <!-- Content -->
    <div
        class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 flex flex-col justify-center min-h-dvh py-28"
    >
        <div class="max-w-3xl">
            <!-- Small logo badge -->
            <div class="hero-reveal hero-delay-1 flex items-center gap-3 mb-8">
                <img
                    src={`${import.meta.env.BASE_URL}Logo/TNP_anagrama_WHITE.png`}
                    alt="TheNextPangea"
                    class="relative h-8 sm:h-9 w-auto opacity-80"
                    loading="eager"
                />
                <div class="w-px h-6 bg-pangea-white/20"></div>
                <span class="text-xs sm:text-sm font-medium tracking-widest uppercase text-pangea-white/50">TheNextPangea S.L.</span>
            </div>

            <!-- Tagline — big, left-aligned -->
            <h1
                class="hero-reveal hero-delay-2 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-pangea-white leading-[1.05] tracking-tight"
            >
                <span data-i18n="hero.tagline">Expertos en Tecnologías</span>
                <br />
                <span
                    class="text-gradient"
                    data-i18n="hero.taglineHighlight">eXponenciales</span
                >
            </h1>

            <!-- Subtitle -->
            <p
                class="hero-reveal hero-delay-3 max-w-xl text-base sm:text-lg text-pangea-white/70 font-light leading-relaxed mt-6 sm:mt-8"
                data-i18n="hero.subtitle"
            >
                Somos expertos en combinar y mezclar tecnologías eXponenciales para
                crear productos tecnológicos innovadores y customizables para
                diversos casos de negocio y sectores.
            </p>


        </div>
    </div>

    <!-- Scroll down indicator -->
    <a
        href="#about"
        class="hero-reveal hero-delay-7 scroll-cta absolute bottom-10 left-0 right-0 z-10 flex flex-col items-center gap-3 group cursor-pointer"
        aria-label="Scroll to next section"
    >
        <span
            class="text-[11px] uppercase tracking-[0.25em] text-pangea-white/50 font-semibold group-hover:text-pangea-white/90 transition-all duration-500"
            data-i18n="hero.scroll"
        >
            Descubrir más
        </span>
        <div class="scroll-arrow-wrap">
            <svg
                class="scroll-arrow w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 10l5 5 5-5"></path>
            </svg>
            <svg
                class="scroll-arrow scroll-arrow-2 w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 10l5 5 5-5"></path>
            </svg>
        </div>
    </a>
</section>

<script>
  document.querySelector('.scroll-cta')?.addEventListener('click', (e) => {
    e.preventDefault();
    const target = document.getElementById('about');
    if (!target) return;

    // Disable CSS smooth scroll to avoid conflict
    document.documentElement.style.scrollBehavior = 'auto';

    const start = window.scrollY;
    const end = target.getBoundingClientRect().top + start;
    const distance = end - start;
    const duration = 800;
    const startTime = performance.now();

    function easeInOutCubic(t: number) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      window.scrollTo(0, start + distance * easeInOutCubic(progress));
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        document.documentElement.style.scrollBehavior = '';
      }
    }

    requestAnimationFrame(step);
  });
</script>

<style>
    /* ── Video background ──────────────────────────── */
    .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Staggered reveal animation ────────────────── */
    .hero-reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-delay-1 {
        animation-delay: 0.1s;
    }
    .hero-delay-2 {
        animation-delay: 0.25s;
    }
    .hero-delay-3 {
        animation-delay: 0.4s;
    }
    .hero-delay-4 {
        animation-delay: 0.55s;
    }
    .hero-delay-5 {
        animation-delay: 0.7s;
    }
    .hero-delay-6 {
        animation-delay: 0.85s;
    }
    .hero-delay-7 {
        animation-delay: 1.1s;
    }

    @keyframes heroReveal {
        0% {
            opacity: 0;
            transform: translateY(24px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Scroll CTA ────────────────────────────────── */
    .scroll-cta {
        text-decoration: none;
    }

    .scroll-arrow-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        margin-top: -2px;
    }

    .scroll-arrow {
        color: rgba(255, 255, 255, 0.35);
        animation: scrollFade 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        transition: color 0.5s ease;
    }

    .scroll-arrow-2 {
        margin-top: -10px;
        animation-delay: 0.45s;
    }

    .group:hover .scroll-arrow {
        color: rgba(102, 204, 255, 0.9);
    }

    @keyframes scrollFade {
        0% {
            opacity: 0;
            transform: translateY(-6px);
        }
        30% {
            opacity: 1;
            transform: translateY(0);
        }
        70% {
            opacity: 1;
            transform: translateY(4px);
        }
        100% {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    /* ── Responsive height helpers ─────────────────── */
    .h-18 {
        height: 4.5rem;
    }
    .h-22 {
        height: 5.5rem;
    }
    .h-26 {
        height: 6.5rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .animate-bounce-slow,
        .scroll-arrow {
            animation: none;
        }
    }
</style>
