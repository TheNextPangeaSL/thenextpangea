---
// Products section – showcases all TNP products in a grid with technology tags
import { products, categories, getProductTags, getProductUrl, isExternalProduct, functionalAreas, getProductAfs, afProductMapping } from "@/data/products";
---

<section
    id="products"
    class="relative min-h-dvh flex flex-col justify-center section-padding bg-pangea-light-grey/20 overflow-hidden"
>
    <!-- Background decoration -->
    <div
        class="absolute top-0 left-0 w-[400px] h-[400px] bg-pangea-calm-blue/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-0 right-0 w-[300px] h-[300px] bg-pangea-sky-blue/5 rounded-full blur-3xl translate-y-1/2 translate-x-1/2 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-12 md:mb-16">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-4"
                data-i18n="products.label"
            >
                Productos
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="products.title">Nuestros</span>
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="products.titleHighlight"
                >
                    Productos
                </span>
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-5 delay-200"
                data-i18n="products.subtitle"
            >
                Productos tecnológicos innovadores creados combinando tecnologías
                eXponenciales, customizables para diversos sectores industriales.
            </p>
        </div>

        <!-- Category Filters -->
        <div class="reveal flex flex-wrap items-center justify-center gap-2 mb-10 delay-300" id="product-filters">
            <button
                class="filter-btn active"
                data-filter="all"
                type="button"
            >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" />
                </svg>
                <span data-i18n="products.filterAll">Todos</span>
                <span class="filter-count">{products.length}</span>
            </button>
            {categories.map((cat) => {
                const count = products.filter(p => p.category === cat.id).length;
                return (
                    <button
                        class="filter-btn"
                        data-filter={cat.id}
                        type="button"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
                        </svg>
                        <span data-i18n={`products.filter_${cat.id}`} data-i18n-es={cat.label} data-i18n-en={cat.labelEn}>{cat.label}</span>
                        <span class="filter-count">{count}</span>
                    </button>
                );
            })}
        </div>

        <!-- AF Functional Area Filters -->
        <div class="reveal flex flex-wrap items-center justify-center gap-2 mb-10 delay-400" id="af-filters">
            <span class="text-xs font-semibold uppercase tracking-wider text-pangea-classic-blue/40 mr-1" data-i18n="products.filterByAF">
                Filtrar por Área Funcional
            </span>
            {functionalAreas.map((af) => {
                const count = (afProductMapping[af.id] || []).length;
                return (
                    <button
                        class="filter-btn af-filter-btn"
                        data-af-filter={af.id}
                        type="button"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d={af.icon} />
                        </svg>
                        <span data-i18n={`products.af.${af.id}`} data-i18n-es={af.label} data-i18n-en={af.labelEn}>{af.label}</span>
                        <span class="filter-count">{count}</span>
                    </button>
                );
            })}
        </div>

        <!-- No results message -->
        <p class="text-center text-pangea-classic-blue/50 text-sm py-8 hidden" id="products-no-results" data-i18n="products.noResults">
            No hay productos para este filtro
        </p>

        <!-- Products Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            {
                products.map((product, index) => {
                    const productTags = getProductTags(product);
                    const href = getProductUrl(product, import.meta.env.BASE_URL);
                    const isExternal = isExternalProduct(product);
                    const productAfs = getProductAfs(product.slug);
                    return (
                        <a
                            href={href}
                            class={`reveal group relative flex flex-col bg-pangea-white rounded-2xl border border-pangea-light-grey/60 p-6 transition-all duration-300 hover:shadow-pangea-lg hover:-translate-y-1 product-card delay-${((index % 4) + 1) * 100}`}
                            style={`--product-color: ${product.hexColor};`}
                            data-category={product.category}
                            data-af={productAfs.join(",")}
                            {...(isExternal
                                ? { target: "_blank", rel: "noopener noreferrer" }
                                : {})}
                        >
                            {/* Icon */}
                            <div
                                class="w-11 h-11 rounded-xl flex items-center justify-center mb-4 transition-colors duration-300"
                                style={`background: ${product.hexColor}12;`}
                            >
                                <svg
                                    class="w-5 h-5 transition-colors duration-300"
                                    style={`color: ${product.hexColor};`}
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={product.icon}
                                    />
                                </svg>
                            </div>

                            {/* Name + external indicator */}
                            <div class="flex items-center gap-2 mb-2">
                                <h3
                                    class="text-base font-bold text-pangea-dark-blue transition-colors duration-200"
                                    style={`--product-color: ${product.hexColor};`}
                                >
                                    {product.name}
                                </h3>
                                {isExternal && (
                                    <svg
                                        class="w-3.5 h-3.5 text-pangea-dark-blue/30 shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                        />
                                    </svg>
                                )}
                            </div>

                            {/* Tagline */}
                            <p class="text-xs text-pangea-classic-blue/60 leading-relaxed line-clamp-2 mb-4 flex-1">
                                {product.tagline}
                            </p>

                            {/* Tags */}
                            <div class="flex flex-wrap gap-1.5 mt-auto">
                                {productTags.map((tag) => (
                                    <span
                                        class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold leading-none product-tag"
                                        style={`color: ${product.hexColor}; background: ${product.hexColor}14;`}
                                        data-tag-label={tag.id}
                                        data-tag-label-es={tag.label}
                                        data-tag-label-en={tag.labelEn}
                                    >
                                        {tag.label}
                                    </span>
                                ))}
                            </div>

                            {/* Hover arrow */}
                            <div
                                class="mt-4 flex items-center gap-1 text-xs font-semibold transition-colors duration-200 product-cta"
                                style={`--product-color: ${product.hexColor};`}
                            >
                                <span data-i18n="products.viewProduct">
                                    {isExternal ? "Visitar web" : "Ver ficha"}
                                </span>
                                <svg
                                    class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="m8.25 4.5 7.5 7.5-7.5 7.5"
                                    />
                                </svg>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── Filter buttons ─────────────────────────────────── */
    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1;
        border-radius: 9999px;
        border: 1.5px solid rgba(0, 0, 0, 0.08);
        background: white;
        color: #64748b;
        cursor: pointer;
        transition: all 0.25s ease;
        white-space: nowrap;
    }
    .filter-btn:hover {
        border-color: rgba(0, 0, 0, 0.15);
        color: #334155;
        background: #f8fafc;
    }
    .filter-btn.active {
        background: #0f172a;
        color: white;
        border-color: #0f172a;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.18);
    }
    .filter-btn.active .filter-count {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    /* AF filter active state – uses classic blue accent */
    .af-filter-btn.active {
        background: #1a3a5c;
        color: white;
        border-color: #1a3a5c;
        box-shadow: 0 2px 8px rgba(26, 58, 92, 0.22);
    }

    .filter-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.25rem;
        height: 1.25rem;
        padding: 0 0.3rem;
        font-size: 0.625rem;
        font-weight: 700;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.06);
        color: #94a3b8;
        transition: all 0.25s ease;
    }

    /* ── Card filter animation ──────────────────────────── */
    .product-card {
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .product-card.card-hidden {
        opacity: 0;
        transform: scale(0.92);
        pointer-events: none;
        position: absolute;
        visibility: hidden;
    }
    .product-card.card-visible {
        opacity: 1;
        transform: scale(1);
    }

    /* Product-specific border on card hover */
    .product-card:hover {
        border-color: color-mix(in srgb, var(--product-color) 30%, transparent);
    }

    /* Product-specific color on title hover */
    .group:hover h3[style*="--product-color"] {
        color: var(--product-color);
    }

    /* Product-specific color on CTA */
    .product-cta {
        color: color-mix(in srgb, var(--product-color) 50%, transparent);
    }
    .group:hover .product-cta {
        color: var(--product-color);
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const filterContainer = document.getElementById("product-filters");
    const afContainer = document.getElementById("af-filters");
    const noResults = document.getElementById("products-no-results");
    if (!filterContainer || !afContainer) return;

    const catButtons = filterContainer.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const afButtons = afContainer.querySelectorAll<HTMLButtonElement>(".af-filter-btn");
    const grid = document.querySelector("#products .grid") as HTMLElement | null;
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".product-card"));

    let activeCatFilter = "all";
    let activeAfFilter: string | null = null; // null = no AF filter

    function applyFilters() {
        let visibleCount = 0;

        cards.forEach((card) => {
            const cardCategory = card.dataset.category || "";
            const cardAfs = (card.dataset.af || "").split(",").filter(Boolean);

            let shouldShow = true;

            if (activeAfFilter) {
                // AF filter is active – category filter is ignored
                shouldShow = cardAfs.includes(activeAfFilter);
            } else {
                // Category filter
                shouldShow = activeCatFilter === "all" || cardCategory === activeCatFilter;
            }

            if (shouldShow) {
                card.classList.remove("card-hidden");
                card.classList.add("card-visible");
                visibleCount++;
            } else {
                card.classList.remove("card-visible");
                card.classList.add("card-hidden");
            }
        });

        // Show/hide no-results message
        if (noResults) {
            noResults.classList.toggle("hidden", visibleCount > 0);
        }

        // Re-layout: hide filtered cards from flow
        requestAnimationFrame(() => {
            cards.forEach((card) => {
                card.style.display = card.classList.contains("card-hidden") ? "none" : "";
            });
        });
    }

    function updateButtonStates() {
        // Category buttons
        catButtons.forEach((btn) => {
            const isActive = !activeAfFilter && btn.dataset.filter === activeCatFilter;
            btn.classList.toggle("active", isActive);
        });

        // AF buttons
        afButtons.forEach((btn) => {
            btn.classList.toggle("active", btn.dataset.afFilter === activeAfFilter);
        });
    }

    // Category filter click
    catButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const filter = btn.dataset.filter;
            if (!filter) return;

            // Reset AF filter
            activeAfFilter = null;
            activeCatFilter = filter;

            // Show all first so animation works
            cards.forEach((card) => { card.style.display = ""; });

            requestAnimationFrame(() => {
                updateButtonStates();
                applyFilters();
            });
        });
    });

    // AF filter click
    afButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const af = btn.dataset.afFilter;
            if (!af) return;

            if (activeAfFilter === af) {
                // Toggle off → back to "all"
                activeAfFilter = null;
                activeCatFilter = "all";
            } else {
                activeAfFilter = af;
            }

            // Show all first so animation works
            cards.forEach((card) => { card.style.display = ""; });

            requestAnimationFrame(() => {
                updateButtonStates();
                applyFilters();
            });
        });
    });

    // Initial state
    cards.forEach((card) => card.classList.add("card-visible"));
});
</script>
