---

<section
    id="functional-areas"
    class="relative section-padding overflow-hidden"
>
    <!-- Background accents -->
    <div
        class="absolute top-1/3 -left-32 w-[400px] h-[400px] rounded-full bg-pangea-sky-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute bottom-1/4 -right-32 w-[350px] h-[350px] rounded-full bg-pangea-calm-blue/[0.03] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-8 md:mb-12">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-3"
                data-i18n="af.label"
            >
                BACSI
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="af.title"
                    >Aplicación operativa en las Áreas Funcionales</span
                >{" "}
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="af.titleHighlight">AF1–AF6</span
                >
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-3 delay-200"
                data-i18n="af.subtitle"
            >
                Nuestras soluciones se despliegan en distintos ámbitos
                funcionales de la base.
            </p>
            <div class="reveal divider mx-auto mt-4 delay-300"></div>
        </div>

        <!-- 6-card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {
                areas.map((area, i) => (
                    <div
                        class:list={[
                            "reveal",
                            `delay-${((i % 3) + 1) * 100}`,
                            "group bg-white rounded-2xl border border-pangea-light-grey/60 p-5 md:p-6",
                            "hover:border-pangea-classic-blue/25 hover:shadow-md transition-all duration-300",
                        ]}
                    >
                        {/* Icon + AF Number */}
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-9 h-9 rounded-lg bg-pangea-classic-blue/10 flex items-center justify-center shrink-0 overflow-hidden">
                                <svg
                                    class="w-4 h-4 text-pangea-classic-blue"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={area.icon}
                                    />
                                </svg>
                            </div>
                            <h3
                                class="text-sm font-bold text-pangea-dark-blue"
                                data-i18n={area.titleKey}
                            >
                                {area.titleDefault}
                            </h3>
                        </div>

                        {/* Description */}
                        <p
                            class="text-[13px] text-pangea-dark-blue/60 leading-relaxed"
                            data-i18n={area.descKey}
                        >
                            {area.descDefault}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
