---
// Navbar component for TheNextPangea landing page
// Features: modern mega menu for Products with tags, language switcher, mobile responsive
import {
    products,
    getProductTags,
    getProductUrl,
    isExternalProduct,
} from "@/data/products";
import { localeNames, defaultLocale } from "@/i18n/index";

const locales = Object.entries(localeNames) as [string, string][];
const base = import.meta.env.BASE_URL;
const isSubPage = Astro.url.pathname.includes("/productos/") || Astro.url.pathname.includes("/proyectos-de-investigacion");
const homeHref = isSubPage ? base : "#hero";
const sectionHref = (hash: string) => (isSubPage ? `${base}${hash}` : hash);
---

<nav
    id="navbar"
    class="fixed top-0 inset-x-0 z-50 nav-blur border-b border-pangea-white/10"
>
    <div
        class="max-w-7xl mx-auto flex items-center justify-between px-6 sm:px-10 py-4"
    >
        <!-- Logo -->
        <a href={homeHref} class="flex items-center shrink-0">
            <img
                src={`${import.meta.env.BASE_URL}Logo/TNP_logo_WHITE.png`}
                alt="TheNextPangea"
                class="h-8 sm:h-9 w-auto"
            />
        </a>

        <!-- Desktop Nav Links -->
        <div class="hidden lg:flex items-center gap-5 xl:gap-7">
            <a
                href={sectionHref("#about")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.about"
            >
                Sobre Nosotros
            </a>

            <!-- Productos Mega Menu Trigger + Panel wrapper -->
            <div class="relative" id="mega-menu-wrapper">
                <button
                    id="mega-menu-trigger"
                    class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200 inline-flex items-center gap-1.5 bg-transparent border-none cursor-pointer py-2"
                    aria-expanded="false"
                    aria-haspopup="true"
                >
                    <span data-i18n="nav.products">Productos</span>
                    <svg
                        class="w-3.5 h-3.5 transition-transform duration-300 mega-chevron"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                    </svg>
                </button>

                <!-- Mega Menu Panel (inside wrapper for seamless hover) -->
                <div
                    id="mega-menu"
                    class="mega-menu-panel fixed left-0 right-0 overflow-hidden pointer-events-none opacity-0 translate-y-2"
                    style="top: var(--navbar-bottom, 64px);"
                >
                    <div
                        class="mega-menu-inner border-t border-pangea-white/10"
                    >
                        <div class="max-w-7xl mx-auto px-6 sm:px-10 py-8">
                            {/* Compact product grid with tags */}
                            <div class="grid grid-cols-2 xl:grid-cols-3 gap-3">
                                {
                                    products.map((product) => {
                                        const productTags =
                                            getProductTags(product);
                                        const hasUrl = isExternalProduct(product);
                                        const Tag = hasUrl ? "a" : "div";
                                        return (
                                            <Tag
                                                {...(hasUrl ? { href: getProductUrl(product, import.meta.env.BASE_URL), target: "_blank", rel: "noopener noreferrer" } : {})}
                                                class="mega-product-link group flex items-start gap-3 px-3.5 py-3 rounded-xl transition-all duration-200 hover:bg-pangea-white/[0.06]"
                                            >
                                                <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-pangea-white/[0.06] group-hover:bg-pangea-white/10 transition-colors duration-200 shrink-0 mt-0.5">
                                                    <svg
                                                        class="w-[18px] h-[18px] text-pangea-white/50 group-hover:text-pangea-sky-blue transition-colors duration-200"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                        stroke-width="1.5"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            d={product.icon}
                                                        />
                                                    </svg>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-sm font-semibold text-pangea-white group-hover:text-pangea-sky-blue transition-colors duration-200">
                                                            {product.name}
                                                        </span>
                                                        {hasUrl && (
                                                        <svg
                                                            class="w-3.5 h-3.5 text-pangea-white/0 group-hover:text-pangea-sky-blue/60 transition-all duration-200 shrink-0 -translate-x-1 group-hover:translate-x-0"
                                                            fill="none"
                                                            viewBox="0 0 24 24"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                d="m8.25 4.5 7.5 7.5-7.5 7.5"
                                                            />
                                                        </svg>
                                                        )}
                                                    </div>
                                                    <div class="flex flex-wrap gap-1 mt-1.5">
                                                        {productTags.map(
                                                            (tag) => (
                                                                <span
                                                                    class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium leading-none ${tag.color} ${tag.textColor}`}
                                                                    data-tag-label={
                                                                        tag.id
                                                                    }
                                                                    data-tag-label-es={
                                                                        tag.label
                                                                    }
                                                                    data-tag-label-en={
                                                                        tag.labelEn
                                                                    }
                                                                >
                                                                    {tag.label}
                                                                </span>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            </Tag>
                                        );
                                    })
                                }
                            </div>

                            {/* Bottom bar */}
                            <div
                                class="mt-6 pt-5 border-t border-pangea-white/10 flex items-center justify-between"
                            >
                                <p class="text-xs text-pangea-calm-blue/40">
                                    <span data-i18n="nav.megaMenuFooter"
                                        >{products.length} productos tecnológicos
                                        · Tecnologías eXponenciales</span
                                    >
                                </p>
                                <a
                                    href={sectionHref("#services")}
                                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-pangea-sky-blue/70 hover:text-pangea-sky-blue transition-colors duration-200"
                                >
                                    <span data-i18n="nav.viewAllTech"
                                        >Ver todas las tecnologías</span
                                    >
                                    <svg
                                        class="w-3.5 h-3.5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                        ></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <a
                href={sectionHref("#services")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.technologies"
            >
                Tecnologías
            </a>
            <a
                href={sectionHref("#research")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.research"
            >
                I+D
            </a>
            <!-- Language Switcher (dropdown) -->
            <div class="relative ml-2" data-lang-dropdown>
                <button
                    class="lang-toggle group flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-pangea-white/15 bg-pangea-white/[0.06] hover:bg-pangea-white/[0.12] hover:border-pangea-white/25 transition-all duration-300"
                    aria-label="Change language"
                    aria-expanded="false"
                    data-lang-dropdown-trigger
                >
                    <svg class="w-3.5 h-3.5 text-pangea-white/50 group-hover:text-pangea-white/80 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9 9 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                    <span class="text-[11px] font-bold uppercase tracking-widest text-pangea-white/70 group-hover:text-pangea-white transition-colors" data-lang-current-label>{localeNames[defaultLocale]}</span>
                    <svg class="w-2.5 h-2.5 text-pangea-white/30 group-hover:text-pangea-white/60 transition-all duration-300 lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                <!-- Dropdown panel -->
                <div class="lang-dropdown-panel" data-lang-dropdown-panel>
                    {locales.map(([code, label]) => (
                        <button
                            class="lang-option"
                            data-lang-option={code}
                        >
                            <span class="lang-option-check" data-lang-check={code}>
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            </span>
                            <span class="text-[11px] font-bold uppercase tracking-widest">{label}</span>
                        </button>
                    ))}
                </div>
            </div>

            <a
                href={sectionHref("#contact")}
                class="ml-1 inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-pangea-cta-red text-pangea-white text-sm font-semibold border border-pangea-cta-red hover:bg-pangea-cta-red/90 hover:border-pangea-cta-red/80 hover:shadow-lg hover:shadow-pangea-cta-red/20 transition-all duration-300"
                data-i18n="nav.contactUs"
            >
                Contáctanos
            </a>
        </div>

        <!-- Mobile: Language Switcher + Hamburger -->
        <div class="lg:hidden flex items-center gap-2">
            <!-- Mobile Language Switcher (dropdown) -->
            <div class="relative" data-lang-dropdown>
                <button
                    class="lang-toggle group min-w-[44px] min-h-[44px] flex items-center justify-center gap-1 rounded-lg border border-pangea-white/15 bg-pangea-white/[0.06] hover:bg-pangea-white/[0.12] hover:border-pangea-white/25 transition-all duration-300 px-2.5"
                    aria-label="Change language"
                    aria-expanded="false"
                    data-lang-dropdown-trigger
                >
                    <svg class="w-4 h-4 text-pangea-white/50 group-hover:text-pangea-white/80 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9 9 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                    <span class="text-xs font-bold uppercase tracking-widest text-pangea-white/70 group-hover:text-pangea-white transition-colors" data-lang-current-label>{localeNames[defaultLocale]}</span>
                </button>
                <!-- Dropdown panel -->
                <div class="lang-dropdown-panel right-0" data-lang-dropdown-panel>
                    {locales.map(([code, label]) => (
                        <button
                            class="lang-option"
                            data-lang-option={code}
                        >
                            <span class="lang-option-check" data-lang-check={code}>
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            </span>
                            <span class="text-[11px] font-bold uppercase tracking-widest">{label}</span>
                        </button>
                    ))}
                </div>
            </div>

            <!-- Mobile Hamburger Button -->
            <button
                id="mobile-menu-btn"
                class="relative w-11 h-11 flex items-center justify-center rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/10 transition-colors duration-200"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
            >
                <svg
                    id="hamburger-icon"
                    class="w-6 h-6 transition-transform duration-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
                <svg
                    id="close-icon"
                    class="w-6 h-6 absolute transition-transform duration-300 scale-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18 18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MOBILE MENU PANEL
         ═══════════════════════════════════════════════════════════ -->
    <div
        id="mobile-menu"
        class="lg:hidden overflow-hidden max-h-0 transition-all duration-500 ease-in-out"
    >
        <div
            class="px-6 pb-6 pt-2 flex flex-col gap-1 border-t border-pangea-white/10 overflow-y-auto overscroll-contain"
            style="max-height: calc(100dvh - 70px);"
        >
            <a
                href={sectionHref("#about")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.about"
            >
                Sobre Nosotros
            </a>

            <!-- Mobile Products Accordion -->
            <div class="mobile-products-accordion">
                <button
                    id="mobile-products-btn"
                    class="flex items-center justify-between w-full py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium bg-transparent border-none cursor-pointer text-left"
                    aria-expanded="false"
                >
                    <span data-i18n="nav.products">Productos</span>
                    <svg
                        class="w-4 h-4 transition-transform duration-300 mobile-prod-chevron"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                    </svg>
                </button>
                <div
                    id="mobile-products-panel"
                    class="overflow-hidden max-h-0 transition-all duration-400 ease-in-out"
                >
                    <div class="px-2 pb-2 space-y-1">
                        {
                            products.map((product) => {
                                const productTags = getProductTags(product);
                                const hasUrl = isExternalProduct(product);
                                const MTag = hasUrl ? "a" : "div";
                                return (
                                    <MTag
                                        {...(hasUrl ? { href: getProductUrl(product, import.meta.env.BASE_URL), target: "_blank", rel: "noopener noreferrer" } : {})}
                                        class="mobile-nav-link flex items-center gap-2.5 py-2.5 px-3 rounded-lg text-pangea-white/70 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-sm"
                                    >
                                        <svg
                                            class="w-4 h-4 text-pangea-white/30 shrink-0"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d={product.icon}
                                            />
                                        </svg>
                                        <div class="flex-1 min-w-0">
                                            <span class="block font-medium">
                                                {product.name}
                                            </span>
                                            <div class="flex flex-wrap gap-1 mt-1">
                                                {productTags
                                                    .slice(0, 3)
                                                    .map((tag) => (
                                                        <span
                                                            class={`inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-medium leading-none ${tag.color} ${tag.textColor}`}
                                                            data-tag-label={
                                                                tag.id
                                                            }
                                                            data-tag-label-es={
                                                                tag.label
                                                            }
                                                            data-tag-label-en={
                                                                tag.labelEn
                                                            }
                                                        >
                                                            {tag.label}
                                                        </span>
                                                    ))}
                                            </div>
                                        </div>
                                    </MTag>
                                );
                            })
                        }
                    </div>
                </div>
            </div>

            <a
                href={sectionHref("#services")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.technologies"
            >
                Tecnologías
            </a>
            <a
                href={sectionHref("#research")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.research"
            >
                I+D
            </a>
            <div class="mt-3 px-4">
                <a
                    href={sectionHref("#contact")}
                    class="block text-center py-3 rounded-full bg-pangea-cta-red text-pangea-white text-sm font-semibold border border-pangea-cta-red hover:bg-pangea-cta-red/90 transition-all duration-300"
                    data-i18n="nav.contactUs"
                >
                    Contáctanos
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════════
     SCRIPTS
     ═══════════════════════════════════════════════════════════════ -->

<script>
    function initMobileMenu() {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");

        if (!btn || !menu || !hamburgerIcon || !closeIcon) return;

        let isOpen = false;

        function toggleMenu() {
            isOpen = !isOpen;
            btn!.setAttribute("aria-expanded", String(isOpen));

            if (isOpen) {
                menu!.style.maxHeight = menu!.scrollHeight + "px";
                hamburgerIcon!.classList.add("scale-0");
                closeIcon!.classList.remove("scale-0");
                closeIcon!.classList.add("scale-100");
            } else {
                menu!.style.maxHeight = "0px";
                hamburgerIcon!.classList.remove("scale-0");
                closeIcon!.classList.add("scale-0");
                closeIcon!.classList.remove("scale-100");
            }
        }

        function closeMenu() {
            if (!isOpen) return;
            isOpen = false;
            btn!.setAttribute("aria-expanded", "false");
            menu!.style.maxHeight = "0px";
            hamburgerIcon!.classList.remove("scale-0");
            closeIcon!.classList.add("scale-0");
            closeIcon!.classList.remove("scale-100");
        }

        btn.addEventListener("click", toggleMenu);

        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (!btn.contains(target) && !menu.contains(target)) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeMenu();
        });
    }

    function initMobileProductsAccordion() {
        const btn = document.getElementById("mobile-products-btn");
        const panel = document.getElementById("mobile-products-panel");
        const mobileMenu = document.getElementById("mobile-menu");
        if (!btn || !panel) return;

        let isOpen = false;
        const chevron = btn.querySelector(".mobile-prod-chevron");

        function updateParentHeight() {
            if (mobileMenu) {
                mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
                // After transition, recalculate to account for expanded content
                setTimeout(() => {
                    if (mobileMenu.style.maxHeight !== "0px") {
                        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
                    }
                }, 420);
            }
        }

        btn.addEventListener("click", () => {
            isOpen = !isOpen;
            btn.setAttribute("aria-expanded", String(isOpen));

            if (isOpen) {
                panel.style.maxHeight = panel.scrollHeight + "px";
                chevron?.classList.add("rotate-180");
            } else {
                panel.style.maxHeight = "0px";
                chevron?.classList.remove("rotate-180");
            }
            updateParentHeight();
        });
    }

    function initMegaMenu() {
        const trigger = document.getElementById("mega-menu-trigger");
        const megaMenu = document.getElementById("mega-menu");
        const wrapper = document.getElementById("mega-menu-wrapper");
        const navbar = document.getElementById("navbar");
        if (!trigger || !megaMenu || !wrapper || !navbar) return;

        const _trigger = trigger;
        const _megaMenu = megaMenu;
        const _wrapper = wrapper;
        const _navbar = navbar;

        let isOpen = false;
        let closeTimeout: ReturnType<typeof setTimeout> | null = null;
        const chevron = _trigger.querySelector(".mega-chevron");

        // Dynamically position mega menu below the navbar
        function updateMenuPosition() {
            const navRect = _navbar.getBoundingClientRect();
            _megaMenu.style.top = navRect.bottom + "px";
        }

        function openMenu() {
            if (closeTimeout) {
                clearTimeout(closeTimeout);
                closeTimeout = null;
            }
            if (isOpen) return;
            isOpen = true;
            updateMenuPosition();
            _trigger.setAttribute("aria-expanded", "true");
            _megaMenu.classList.remove(
                "pointer-events-none",
                "opacity-0",
                "translate-y-2",
            );
            _megaMenu.classList.add(
                "pointer-events-auto",
                "opacity-100",
                "translate-y-0",
            );
            chevron?.classList.add("rotate-180");
        }

        function closeMenu() {
            if (!isOpen) return;
            isOpen = false;
            _trigger.setAttribute("aria-expanded", "false");
            _megaMenu.classList.add(
                "pointer-events-none",
                "opacity-0",
                "translate-y-2",
            );
            _megaMenu.classList.remove(
                "pointer-events-auto",
                "opacity-100",
                "translate-y-0",
            );
            chevron?.classList.remove("rotate-180");
        }

        function scheduleClose(delay = 350) {
            closeTimeout = setTimeout(closeMenu, delay);
        }

        function cancelClose() {
            if (closeTimeout) {
                clearTimeout(closeTimeout);
                closeTimeout = null;
            }
        }

        // --- Hover behavior on the wrapper (contains trigger + mega menu) ---
        // The mega menu is a child of the wrapper, so hovering from trigger to menu
        // never leaves the wrapper — no gap problem.
        _wrapper.addEventListener("mouseenter", () => {
            cancelClose();
            openMenu();
        });

        _wrapper.addEventListener("mouseleave", () => {
            scheduleClose();
        });

        // Also handle the mega menu panel itself (it's fixed-positioned, so technically
        // the mouse can be over it without being over the wrapper)
        _megaMenu.addEventListener("mouseenter", () => {
            cancelClose();
        });

        _megaMenu.addEventListener("mouseleave", () => {
            scheduleClose();
        });

        // Click toggle for accessibility
        _trigger.addEventListener("click", (e) => {
            e.preventDefault();
            if (isOpen) {
                closeMenu();
            } else {
                openMenu();
            }
        });

        // Close on Escape
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeMenu();
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (
                !_trigger.contains(target) &&
                !_megaMenu.contains(target) &&
                !_wrapper.contains(target)
            ) {
                closeMenu();
            }
        });

        // Close mega menu when a link inside is clicked
        _megaMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        initMobileMenu();
        initMobileProductsAccordion();
        initMegaMenu();
    });
    document.addEventListener("astro:page-load", () => {
        initMobileMenu();
        initMobileProductsAccordion();
        initMegaMenu();
    });
</script>

