---
// Navbar component for TheNextPangea landing page
// Features: language switcher, mobile responsive
import { localeNames, defaultLocale } from "@/i18n/index";

const locales = Object.entries(localeNames) as [string, string][];
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHomePage = pathname === base.replace(/\/+$/, "") || pathname === "/";
const isSubPage = !isHomePage;
const homeHref = isSubPage ? base : "#hero";
const sectionHref = (hash: string) => (isSubPage ? `${base}${hash}` : hash);
---

<nav
    id="navbar"
    class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
    data-is-subpage={isSubPage ? "true" : undefined}
>
    <div
        class="max-w-7xl mx-auto flex items-center justify-between px-6 sm:px-10 py-4"
    >
        <!-- Logo -->
        <a href={homeHref} class="flex items-center shrink-0">
            <img
                src={`${import.meta.env.BASE_URL}Logo/TNP_logo_WHITE.png`}
                alt="TheNextPangea"
                class="h-8 sm:h-9 w-auto"
            />
        </a>

        <!-- Desktop Nav Links -->
        <div class="hidden lg:flex items-center gap-5 xl:gap-7">
            <a
                href={sectionHref("#about")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.about"
            >
                Sobre Nosotros
            </a>

            <a
                href={sectionHref("#services")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.technologies"
            >
                Tecnologías
            </a>

            <a
                href={sectionHref("#projects-carousel")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.products"
            >
                Productos
            </a>
            <a
                href={sectionHref("#research")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.research"
            >
                I+D
            </a>
            <a
                href={sectionHref("#contact")}
                class="nav-link text-sm font-medium text-pangea-white/80 hover:text-pangea-sky-blue transition-colors duration-200"
                data-i18n="nav.contact"
            >
                Contacto
            </a>
            <!-- Language Switcher (dropdown) -->
            <div class="relative ml-2" data-lang-dropdown>
                <button
                    class="lang-toggle group flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-pangea-white/15 bg-pangea-white/[0.06] hover:bg-pangea-white/[0.12] hover:border-pangea-white/25 transition-all duration-300"
                    aria-label="Change language"
                    aria-expanded="false"
                    data-lang-dropdown-trigger
                >
                    <svg class="w-3.5 h-3.5 text-pangea-white/50 group-hover:text-pangea-white/80 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9 9 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                    <span class="text-[11px] font-bold uppercase tracking-widest text-pangea-white/70 group-hover:text-pangea-white transition-colors" data-lang-current-label>{localeNames[defaultLocale]}</span>
                    <svg class="w-2.5 h-2.5 text-pangea-white/30 group-hover:text-pangea-white/60 transition-all duration-300 lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                <!-- Dropdown panel -->
                <div class="lang-dropdown-panel" data-lang-dropdown-panel>
                    {locales.map(([code, label]) => (
                        <button
                            class="lang-option"
                            data-lang-option={code}
                        >
                            <span class="lang-option-check" data-lang-check={code}>
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            </span>
                            <span class="text-[11px] font-bold uppercase tracking-widest">{label}</span>
                        </button>
                    ))}
                </div>
            </div>

        </div>

        <!-- Mobile: Language Switcher + Hamburger -->
        <div class="lg:hidden flex items-center gap-2">
            <!-- Mobile Language Switcher (dropdown) -->
            <div class="relative" data-lang-dropdown>
                <button
                    class="lang-toggle group min-w-[44px] min-h-[44px] flex items-center justify-center gap-1 rounded-lg border border-pangea-white/15 bg-pangea-white/[0.06] hover:bg-pangea-white/[0.12] hover:border-pangea-white/25 transition-all duration-300 px-2.5"
                    aria-label="Change language"
                    aria-expanded="false"
                    data-lang-dropdown-trigger
                >
                    <svg class="w-4 h-4 text-pangea-white/50 group-hover:text-pangea-white/80 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9 9 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                    <span class="text-xs font-bold uppercase tracking-widest text-pangea-white/70 group-hover:text-pangea-white transition-colors" data-lang-current-label>{localeNames[defaultLocale]}</span>
                </button>
                <!-- Dropdown panel -->
                <div class="lang-dropdown-panel right-0" data-lang-dropdown-panel>
                    {locales.map(([code, label]) => (
                        <button
                            class="lang-option"
                            data-lang-option={code}
                        >
                            <span class="lang-option-check" data-lang-check={code}>
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            </span>
                            <span class="text-[11px] font-bold uppercase tracking-widest">{label}</span>
                        </button>
                    ))}
                </div>
            </div>

            <!-- Mobile Hamburger Button -->
            <button
                id="mobile-menu-btn"
                class="relative w-11 h-11 flex items-center justify-center rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/10 transition-colors duration-200"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
            >
                <svg
                    id="hamburger-icon"
                    class="w-6 h-6 transition-transform duration-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
                <svg
                    id="close-icon"
                    class="w-6 h-6 absolute transition-transform duration-300 scale-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18 18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         MOBILE MENU PANEL
         ═══════════════════════════════════════════════════════════ -->
    <div
        id="mobile-menu"
        class="lg:hidden overflow-hidden max-h-0 transition-all duration-500 ease-in-out"
    >
        <div
            class="px-6 pb-6 pt-2 flex flex-col gap-1 border-t border-pangea-white/10 overflow-y-auto overscroll-contain"
            style="max-height: calc(100dvh - 70px);"
        >
            <a
                href={sectionHref("#about")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.about"
            >
                Sobre Nosotros
            </a>

            <a
                href={sectionHref("#services")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.technologies"
            >
                Tecnologías
            </a>

            <a
                href={sectionHref("#projects-carousel")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.products"
            >
                Productos
            </a>
            <a
                href={sectionHref("#research")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.research"
            >
                I+D
            </a>
            <a
                href={sectionHref("#contact")}
                class="mobile-nav-link block py-3 px-4 rounded-lg text-pangea-white/80 hover:text-pangea-white hover:bg-pangea-white/5 transition-all duration-200 text-base font-medium"
                data-i18n="nav.contact"
            >
                Contacto
            </a>
        </div>
    </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════════
     SCRIPTS
     ═══════════════════════════════════════════════════════════════ -->

<script>
    function initMobileMenu() {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        const nav = document.getElementById("navbar");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");

        if (!btn || !menu || !hamburgerIcon || !closeIcon) return;

        let isOpen = false;

        function forceNavSolid(solid: boolean) {
            if (!nav) return;
            if (solid) {
                nav.classList.add("nav-blur", "border-b", "border-pangea-white/10");
            } else {
                // Let scroll handler decide
                window.dispatchEvent(new Event("scroll"));
            }
        }

        function toggleMenu() {
            isOpen = !isOpen;
            btn!.setAttribute("aria-expanded", String(isOpen));
            forceNavSolid(isOpen);

            if (isOpen) {
                menu!.style.maxHeight = menu!.scrollHeight + "px";
                hamburgerIcon!.classList.add("scale-0");
                closeIcon!.classList.remove("scale-0");
                closeIcon!.classList.add("scale-100");
            } else {
                menu!.style.maxHeight = "0px";
                hamburgerIcon!.classList.remove("scale-0");
                closeIcon!.classList.add("scale-0");
                closeIcon!.classList.remove("scale-100");
            }
        }

        function closeMenu() {
            if (!isOpen) return;
            isOpen = false;
            btn!.setAttribute("aria-expanded", "false");
            menu!.style.maxHeight = "0px";
            hamburgerIcon!.classList.remove("scale-0");
            closeIcon!.classList.add("scale-0");
            closeIcon!.classList.remove("scale-100");
            forceNavSolid(false);
        }

        btn.addEventListener("click", toggleMenu);

        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (!btn.contains(target) && !menu.contains(target)) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeMenu();
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        initMobileMenu();
    });
    document.addEventListener("astro:page-load", () => {
        initMobileMenu();
    });

    /* ── Navbar scroll behaviour ─────────────────── */
    function initNavScroll() {
        const nav = document.getElementById("navbar");
        if (!nav) return;

        const isSubPage = nav.hasAttribute("data-is-subpage");

        function update() {
            const scrolled = window.scrollY > 40;
            // On sub-pages always show solid bg
            const solid = scrolled || isSubPage;
            nav!.classList.toggle("nav-blur", solid);
            nav!.classList.toggle("border-b", solid);
            nav!.classList.toggle("border-pangea-white/10", solid);
        }

        update(); // initial state
        window.addEventListener("scroll", update, { passive: true });
    }

    initNavScroll();
    document.addEventListener("astro:after-swap", initNavScroll);
</script>

<!-- ═══════════════════════════════════════════════════════════════
     STYLES
     ═══════════════════════════════════════════════════════════════ -->

<style>
    .nav-link {
        position: relative;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background-color: #66ccff;
        border-radius: 999px;
        transition: width 0.3s ease;
    }

    .nav-link:hover::after {
        width: 100%;
    }

    /* Language Dropdown */
    .lang-toggle {
        cursor: pointer;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .lang-toggle:focus-visible {
        outline: 2px solid #66ccff;
        outline-offset: 2px;
    }

    .lang-chevron {
        transition: transform 0.2s ease;
    }

    [data-lang-dropdown].open .lang-chevron {
        transform: rotate(180deg);
    }

    .lang-dropdown-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        min-width: 100%;
        padding: 4px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(31, 48, 66, 0.95);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
        opacity: 0;
        visibility: hidden;
        transform: translateX(-50%) translateY(-4px) scale(0.97);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 200;
    }

    .lang-dropdown-panel.right-0 {
        left: auto;
        right: 0;
        transform: translateX(0) translateY(-4px) scale(0.97);
    }

    [data-lang-dropdown].open .lang-dropdown-panel {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0) scale(1);
    }

    [data-lang-dropdown].open .lang-dropdown-panel.right-0 {
        transform: translateX(0) translateY(0) scale(1);
    }

    .lang-option {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 12px;
        border-radius: 7px;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
        white-space: nowrap;
    }

    .lang-option:hover {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.95);
    }

    .lang-option.active {
        color: #66ccff;
    }

    .lang-option-check {
        width: 14px;
        height: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.15s ease;
        color: #66ccff;
    }

    .lang-option.active .lang-option-check {
        opacity: 1;
    }

    /* line-clamp utility for 2 lines */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
