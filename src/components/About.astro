---
// About section – compact company overview with mission, awards, and stats

const clients = [
  { name: "Airbus", logo: "/clientes/airbus.png" },
  { name: "ArcelorMittal", logo: "/clientes/arcelormittal.png" },
  { name: "Ejército del Aire y del Espacio", logo: "/clientes/ejercito_del_aire.png" },
  { name: "Enagás", logo: "/clientes/enagas.png" },
  { name: "ESA – European Space Agency", logo: "/clientes/esa.svg" },
  { name: "Moeve", logo: "/clientes/moeve.png" },
];
---

<section
    id="about"
    class="relative min-h-dvh flex flex-col justify-center section-padding bg-pangea-white overflow-hidden"
>
    <!-- Subtle background decoration -->
    <div
        class="absolute top-0 right-0 w-[400px] h-[400px] bg-pangea-calm-blue/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Top row: Description + Mission side by side -->
        <div
            class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 mb-12 md:mb-16"
        >
            <!-- Left: Company description (3 cols) -->
            <div class="lg:col-span-3 flex flex-col justify-center">
                <span
                    class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-4"
                    data-i18n="about.label"
                >
                    Sobre Nosotros
                </span>
                <h2 class="reveal section-title delay-100 !text-left !mb-5">
                    <span data-i18n="about.title">Qué es</span>{" "}
                    <span
                        class="text-pangea-classic-blue"
                        data-i18n="about.titleHighlight">TheNextPangea</span
                    >
                </h2>
                <p
                    class="reveal text-base md:text-lg leading-relaxed text-pangea-dark-blue/75 font-light delay-100"
                    data-i18n-html="about.p1"
                >
                    Empresa de base tecnológica centrada en sectores
                    industriales, promovida por <strong
                        class="font-semibold text-pangea-dark-blue"
                        >ArcelorMittal Innovación</strong
                    > y la <strong class="font-semibold text-pangea-dark-blue"
                        >Universidad Nebrija</strong
                    >. Con más de <strong
                        class="font-semibold text-pangea-dark-blue"
                        >50 profesionales</strong
                    > y <strong class="font-semibold text-pangea-dark-blue"
                        >75+ años de experiencia acumulada</strong
                    >, creamos productos tecnológicos customizables combinando
                    tecnologías eXponenciales. Ya hemos creado 2 spinoffs: <strong
                        class="font-semibold text-pangea-dark-blue"
                        >Arquea Biological Innovations</strong
                    > y <strong class="font-semibold text-pangea-dark-blue"
                        >HEX61</strong
                    >.
                </p>

                <!-- Awards inline -->
                <div
                    class="reveal delay-200 flex flex-wrap items-center gap-2 mt-5"
                >
                    <a
                        href="https://www.lavozdeasturias.es/noticia/inasturias/2024/10/04/empresa-asturiana-cambiando-mundo-segun-revista-forbes/00031728031242606369670.htm"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-pangea-dark-blue/5 border border-pangea-dark-blue/10 hover:border-pangea-classic-blue/30 hover:bg-pangea-classic-blue/5 transition-all duration-300 group"
                    >
                        <svg
                            class="w-3.5 h-3.5 text-pangea-classic-blue shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
                            ></path>
                        </svg>
                        <span
                            class="text-[11px] font-semibold text-pangea-dark-blue/70 group-hover:text-pangea-classic-blue transition-colors"
                            data-i18n="about.badge.forbes"
                            >Forbes — Pyme innovadora 2024</span
                        >
                    </a>
                    <a
                        href="https://www.elcomercio.es/tecnologia/asturias-innova/gondan-zitron-thenextpangea-iuopa-ejemplo-innovacion-excelencia-premios-asturias-innova-20260203224635-nt.html"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-pangea-dark-blue/5 border border-pangea-dark-blue/10 hover:border-pangea-classic-blue/30 hover:bg-pangea-classic-blue/5 transition-all duration-300 group"
                    >
                        <svg
                            class="w-3.5 h-3.5 text-pangea-sky-blue shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-4.5A3.375 3.375 0 0 0 13.125 12h-2.25A3.375 3.375 0 0 0 7.5 14.25v4.5m6-6V6.75m0 0a2.25 2.25 0 1 0-4.5 0m4.5 0a2.25 2.25 0 1 1-4.5 0"
                            ></path>
                        </svg>
                        <span
                            class="text-[11px] font-semibold text-pangea-dark-blue/70 group-hover:text-pangea-classic-blue transition-colors"
                            data-i18n="about.badge.innova"
                            >AsturiasInnova+ 2025</span
                        >
                    </a>
                    <a
                        href="https://www.lavozdeasturias.es/noticia/asturias/2026/02/03/indra-piedrafita-the-next-pangea-incorporan-asturias-hub-defensa/00031770133254083908829.htm"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-pangea-dark-blue/5 border border-pangea-dark-blue/10 hover:border-pangea-classic-blue/30 hover:bg-pangea-classic-blue/5 transition-all duration-300 group"
                    >
                        <svg
                            class="w-3.5 h-3.5 text-pangea-calm-blue shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                            ></path>
                        </svg>
                        <span
                            class="text-[11px] font-semibold text-pangea-dark-blue/70 group-hover:text-pangea-classic-blue transition-colors"
                            data-i18n="about.badge.defense">Hub Defensa</span
                        >
                    </a>
                </div>
            </div>

            <!-- Right: Mission card (2 cols) -->
            <div class="lg:col-span-2 flex items-center">
                <div
                    class="reveal delay-300 w-full p-6 md:p-8 rounded-2xl bg-gradient-to-br from-pangea-dark-blue to-pangea-classic-blue text-pangea-white relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-pangea-sky-blue/10 rounded-full blur-2xl pointer-events-none"
                        aria-hidden="true"
                    >
                    </div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-3">
                            <svg
                                class="w-5 h-5 text-pangea-sky-blue shrink-0"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"
                                ></path>
                            </svg>
                            <h3
                                class="text-sm font-bold uppercase tracking-widest text-pangea-sky-blue"
                                data-i18n="about.mission.label"
                            >
                                Nuestra Misión
                            </h3>
                        </div>
                        <p
                            class="text-base md:text-lg font-light leading-relaxed text-pangea-white/90"
                            data-i18n="about.mission.text"
                        >
                            Cuando dos o más tecnologías eXponenciales son
                            aplicadas a una necesidad industrial o social
                            compleja — la oportunidad de crear soluciones
                            diferenciadoras se incrementa drásticamente.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats strip – compact horizontal row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4">
            <div
                class="reveal delay-100 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                    data-i18n="about.stat1.value"
                >
                    26
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat1.label"
                >
                    Labs & Plantas Piloto
                </p>
            </div>
            <div
                class="reveal delay-150 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                >
                    <span data-i18n="about.stat2.value">100+</span>
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat2.label"
                >
                    Soluciones Desplegadas
                </p>
            </div>
            <div
                class="reveal delay-200 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                    data-i18n="about.stat3.value"
                >
                    $1B
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat3.label"
                >
                    Valor Creado
                </p>
            </div>
            <div
                class="reveal delay-250 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                >
                    <span data-i18n="about.stat4.value">75+</span>
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat4.label"
                >
                    Años Experiencia
                </p>
            </div>
            <div
                class="reveal delay-300 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                    data-i18n="about.stat5.value"
                >
                    50+
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat5.label"
                >
                    Profesionales
                </p>
            </div>
            <div
                class="reveal delay-350 text-center py-5 px-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey hover:border-pangea-calm-blue/30 transition-all duration-300"
            >
                <p
                    class="text-2xl md:text-3xl font-bold text-pangea-dark-blue tracking-tight"
                    data-i18n="about.stat6.value"
                >
                    2
                </p>
                <p
                    class="mt-1 text-[11px] text-pangea-dark-blue/55 font-medium leading-tight"
                    data-i18n="about.stat6.label"
                >
                    Spinoffs Creadas
                </p>
            </div>
        </div>

        <!-- Clients marquee – "Ya confían en nosotros" -->
        <div class="mt-16 md:mt-24">
            <h3 class="reveal text-center text-sm font-bold uppercase tracking-[0.2em] text-pangea-classic-blue/70 mb-8 md:mb-10">
                <span data-i18n="clients.title">Ya confían en</span>{" "}
                <span data-i18n="clients.titleHighlight">Nosotros</span>
            </h3>

            <div class="reveal delay-100 relative overflow-x-clip">
                <!-- Scrolling track -->
                <div class="logos-marquee flex items-center gap-12 sm:gap-16 md:gap-20 py-4">
                    {clients.map((client) => (
                        <div class="logo-item flex-shrink-0 flex items-center justify-center h-10 sm:h-12 md:h-14 w-28 sm:w-36 md:w-44 grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-500" data-tooltip={client.name}>
                            <img src={client.logo} alt={client.name} class="max-h-full max-w-full object-contain pointer-events-none" loading="lazy" decoding="async" />
                        </div>
                    ))}
                    {clients.map((client) => (
                        <div class="logo-item flex-shrink-0 flex items-center justify-center h-10 sm:h-12 md:h-14 w-28 sm:w-36 md:w-44 grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-500" data-tooltip={client.name} aria-hidden="true">
                            <img src={client.logo} alt="" class="max-h-full max-w-full object-contain pointer-events-none" loading="lazy" decoding="async" />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
  .logos-marquee {
    animation: scroll-logos 30s linear infinite;
    width: max-content;
  }
  .logos-marquee:hover {
    animation-play-state: paused;
  }

  /* Custom tooltip */
  .logo-item[data-tooltip] {
    position: relative;
  }
  .logo-item[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    padding: 4px 10px;
    border-radius: 6px;
    background: #1F3042;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 20;
  }
  .logo-item[data-tooltip]:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @keyframes scroll-logos {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos-marquee {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .logo-item[aria-hidden="true"] {
      display: none;
    }
  }
</style>
