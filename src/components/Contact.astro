---
// Contact section – contact form + company information
// Updated with i18n support via data-i18n attributes
---

<section
    id="contact"
    class="relative min-h-dvh flex flex-col justify-center section-padding bg-pangea-white overflow-hidden"
>
    <!-- Background decorative elements -->
    <div
        class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pangea-calm-blue/20 to-transparent"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full bg-pangea-sky-blue/[0.04] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div
        class="absolute -bottom-40 -right-40 w-[600px] h-[600px] rounded-full bg-pangea-classic-blue/[0.04] blur-3xl pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-8 md:mb-10">
            <span
                class="reveal inline-block text-xs font-bold uppercase tracking-[0.25em] text-pangea-classic-blue mb-3"
                data-i18n="contact.label"
            >
                Contacto
            </span>
            <h2 class="reveal section-title delay-100">
                <span data-i18n="contact.title">Construyamos</span>
                <span
                    class="text-pangea-classic-blue"
                    data-i18n="contact.titleHighlight">Juntos</span
                >
            </h2>
            <p
                class="reveal section-subtitle mx-auto mt-3 delay-200"
                data-i18n="contact.subtitle"
            >
                ¿Tienes un proyecto en mente o quieres explorar cómo podemos
                ayudarte? Escríbenos y comencemos una conversación.
            </p>
            <div class="reveal divider mx-auto mt-4 delay-300"></div>
        </div>

        <!-- Two-column layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

            <!-- Contact Form (7 cols) -->
            <div class="reveal lg:col-span-7">
                <form
                    id="contact-form"
                    class="bg-pangea-white rounded-2xl shadow-pangea-lg border border-pangea-light-grey/60 p-6 md:p-8"
                    novalidate
                >
                    <!-- Honeypot: hidden from humans, bots fill it in and get silently discarded -->
                    <div class="absolute w-px h-px -left-[9999px] overflow-hidden" aria-hidden="true">
                        <label for="website">No rellenar</label>
                        <input
                            type="text"
                            id="website"
                            name="website"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </div>
                    <!-- Name + Email row -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="full-name"
                                class="text-xs font-bold uppercase tracking-widest text-pangea-dark-blue/60"
                            >
                                <span data-i18n="contact.form.name">Nombre completo</span>
                                <span class="text-red-400">*</span>
                            </label>
                            <input
                                type="text"
                                id="full-name"
                                name="full-name"
                                required
                                placeholder="Juan García"
                                data-i18n-placeholder="contact.form.namePlaceholder"
                                class="w-full px-4 py-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey text-pangea-dark-blue text-sm placeholder:text-pangea-dark-blue/30 focus:outline-none focus:border-pangea-classic-blue focus:ring-2 focus:ring-pangea-classic-blue/20 transition-all duration-200"
                            />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="email"
                                class="text-xs font-bold uppercase tracking-widest text-pangea-dark-blue/60"
                            >
                                <span data-i18n="contact.form.email">Correo Electrónico</span>
                                <span class="text-red-400">*</span>
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                placeholder="juan.garcia@empresa.com"
                                class="w-full px-4 py-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey text-pangea-dark-blue text-sm placeholder:text-pangea-dark-blue/30 focus:outline-none focus:border-pangea-classic-blue focus:ring-2 focus:ring-pangea-classic-blue/20 transition-all duration-200"
                            />
                        </div>
                    </div>

                    <!-- Company + Subject row -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="company"
                                class="text-xs font-bold uppercase tracking-widest text-pangea-dark-blue/60"
                                data-i18n="contact.form.company"
                            >
                                Empresa / Organización
                            </label>
                            <input
                                type="text"
                                id="company"
                                name="company"
                                placeholder="Organismo / Empresa"
                                data-i18n-placeholder="contact.form.companyPlaceholder"
                                class="w-full px-4 py-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey text-pangea-dark-blue text-sm placeholder:text-pangea-dark-blue/30 focus:outline-none focus:border-pangea-classic-blue focus:ring-2 focus:ring-pangea-classic-blue/20 transition-all duration-200"
                            />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="subject"
                                class="text-xs font-bold uppercase tracking-widest text-pangea-dark-blue/60"
                            >
                                <span data-i18n="contact.form.subject">Me interesa...</span>
                                <span class="text-red-400">*</span>
                            </label>
                            <select
                                id="subject"
                                name="subject"
                                required
                                class="w-full px-4 py-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey text-pangea-dark-blue text-sm focus:outline-none focus:border-pangea-classic-blue focus:ring-2 focus:ring-pangea-classic-blue/20 transition-all duration-200 appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%231F3042%22%20fill-opacity%3D%220.4%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_1rem_center] bg-no-repeat"
                            >
                                <option value="" disabled selected data-i18n="contact.form.subjectPlaceholder">Selecciona un tema</option>
                                <option value="explore" data-i18n="contact.form.subjectOpt.explore">Explorar capacidades</option>
                                <option value="demo" data-i18n="contact.form.subjectOpt.demo">Solicitar demo</option>
                                <option value="bacsi" data-i18n="contact.form.subjectOpt.bacsi">BACSI 2026</option>
                                <option value="rd" data-i18n="contact.form.subjectOpt.rd">Colaboración I+D</option>
                            </select>
                        </div>
                    </div>

                    <!-- Message -->
                    <div class="flex flex-col gap-1.5 mb-5">
                        <label
                            for="message"
                            class="text-xs font-bold uppercase tracking-widest text-pangea-dark-blue/60"
                        >
                            <span data-i18n="contact.form.message"
                                >Tu Mensaje</span
                            >
                            <span class="text-red-400">*</span>
                        </label>
                        <textarea
                            id="message"
                            name="message"
                            rows="3"
                            required
                            placeholder="Cuéntanos sobre tu proyecto, desafío o idea..."
                            data-i18n-placeholder="contact.form.messagePlaceholder"
                            class="w-full px-4 py-3 rounded-xl bg-pangea-light-grey/40 border border-pangea-light-grey text-pangea-dark-blue text-sm placeholder:text-pangea-dark-blue/30 focus:outline-none focus:border-pangea-classic-blue focus:ring-2 focus:ring-pangea-classic-blue/20 transition-all duration-200 resize-y min-h-[80px]"
                        ></textarea>
                    </div>

                    <!-- Privacy note + Submit -->
                    <div
                        class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
                    >
                        <p
                            class="text-[11px] text-pangea-dark-blue/60 leading-relaxed max-w-xs"
                            data-i18n-html="contact.form.privacy"
                        >
                            Al enviar este formulario, aceptas nuestra
                            <a
                                href="#"
                                class="underline hover:text-pangea-classic-blue transition-colors"
                                >política de privacidad</a
                            >. Nunca compartiremos tus datos con terceros.
                        </p>
                        <button
                            type="submit"
                            class="btn-primary shrink-0 group"
                        >
                            <span data-i18n="contact.form.submit"
                                >Enviar</span
                            >
                            <svg
                                class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                                ></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Success message (hidden by default) -->
                    <div
                        id="form-success"
                        class="hidden mt-6 p-5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-start gap-3"
                    >
                        <svg
                            class="w-5 h-5 shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            ></path>
                        </svg>
                        <div>
                            <p
                                class="font-semibold"
                                data-i18n="contact.form.success.title"
                            >
                                ¡Mensaje enviado correctamente!
                            </p>
                            <p
                                class="mt-1 text-emerald-600 text-xs"
                                data-i18n="contact.form.success.text"
                            >
                                Gracias por contactarnos. Te responderemos en
                                24-48 horas.
                            </p>
                        </div>
                    </div>

                    <!-- Error message (hidden by default) -->
                    <div
                        id="form-error"
                        class="hidden mt-6 p-5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3"
                    >
                        <svg
                            class="w-5 h-5 shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
                            ></path>
                        </svg>
                        <div>
                            <p
                                class="font-semibold"
                                data-i18n="contact.form.error.title"
                            >
                                Por favor, completa todos los campos
                                obligatorios.
                            </p>
                            <p
                                class="mt-1 text-red-600 text-xs"
                                data-i18n="contact.form.error.text"
                            >
                                Revisa los campos resaltados arriba e inténtalo
                                de nuevo.
                            </p>
                        </div>
                    </div>

                    <!-- Delivery failure message (network / server), hidden by default -->
                    <div
                        id="form-send-error"
                        class="hidden mt-6 p-5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm flex items-start gap-3"
                    >
                        <svg
                            class="w-5 h-5 shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
                            ></path>
                        </svg>
                        <div>
                            <p
                                class="font-semibold"
                                data-i18n="contact.form.sendError.title"
                            >
                                No se ha podido enviar tu mensaje.
                            </p>
                            <p
                                class="mt-1 text-amber-700 text-xs"
                                data-i18n="contact.form.sendError.text"
                            >
                                Ha ocurrido un problema de conexión. Inténtalo
                                de nuevo en unos minutos o escríbenos
                                directamente a contact@thenextpangea.com.
                            </p>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Contact Information (5 cols) -->
            <div class="reveal-right delay-200 lg:col-span-5">
                <div class="lg:pl-4">
                    <h3 class="text-lg font-bold text-pangea-dark-blue mb-2" data-i18n="contact.info.title">Información de Contacto</h3>

                    <div class="flex flex-col gap-5">
                        <!-- Email -->
                        <a href="mailto:contact@thenextpangea.com" class="group flex items-center gap-4 hover:translate-x-1 transition-transform duration-300">
                            <div class="w-11 h-11 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center shrink-0 group-hover:bg-pangea-classic-blue/20 transition-colors duration-300">
                                <svg class="w-5 h-5 text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-wider text-pangea-classic-blue/60" data-i18n="contact.info.email">Email</p>
                                <p class="text-sm font-medium text-pangea-dark-blue/80 group-hover:text-pangea-classic-blue transition-colors duration-200">contact@thenextpangea.com</p>
                            </div>
                        </a>

                        <!-- Phone -->
                        <a href="tel:+34900943212" class="group flex items-center gap-4 hover:translate-x-1 transition-transform duration-300">
                            <div class="w-11 h-11 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center shrink-0 group-hover:bg-pangea-classic-blue/20 transition-colors duration-300">
                                <svg class="w-5 h-5 text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-wider text-pangea-classic-blue/60" data-i18n="contact.info.phone">Teléfono</p>
                                <p class="text-sm font-medium text-pangea-dark-blue/80 group-hover:text-pangea-classic-blue transition-colors duration-200">+34 900 943 212</p>
                            </div>
                        </a>

                        <!-- Location -->
                        <a href="https://maps.app.goo.gl/4skGQ5wFbEkc75gL6" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 hover:translate-x-1 transition-transform duration-300">
                            <div class="w-11 h-11 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center shrink-0 group-hover:bg-pangea-classic-blue/20 transition-colors duration-300">
                                <svg class="w-5 h-5 text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-wider text-pangea-classic-blue/60" data-i18n="contact.info.location">Ubicación</p>
                                <p class="text-sm font-medium text-pangea-dark-blue/80 group-hover:text-pangea-classic-blue transition-colors duration-200" data-i18n="contact.info.locationValue">Residencia la Granda, 33468 Bardasquera, Asturias</p>
                            </div>
                        </a>

                        <!-- LinkedIn -->
                        <a href="https://www.linkedin.com/company/thenextpangea" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 hover:translate-x-1 transition-transform duration-300">
                            <div class="w-11 h-11 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center shrink-0 group-hover:bg-pangea-classic-blue/20 transition-colors duration-300">
                                <svg class="w-5 h-5 text-pangea-classic-blue" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-wider text-pangea-classic-blue/60" data-i18n="contact.info.linkedin">LinkedIn</p>
                                <p class="text-sm font-medium text-pangea-dark-blue/80 group-hover:text-pangea-classic-blue transition-colors duration-200">TheNextPangea</p>
                            </div>
                        </a>
                    </div>

                    <!-- Separator -->
                    <div class="my-6 h-px bg-gradient-to-r from-pangea-light-grey via-pangea-light-grey/60 to-transparent"></div>

                    <!-- Hours -->
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-xl bg-pangea-classic-blue/10 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5 text-pangea-classic-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-pangea-classic-blue/60" data-i18n="contact.info.hours">Horario</p>
                            <p class="text-sm font-medium text-pangea-dark-blue/80" data-i18n-html="contact.info.hoursValue">L – J: 8:00 – 17:15 &nbsp;·&nbsp; V: 8:00 – 14:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { t, getLocale } from "../i18n";

    // API Gateway endpoint in front of the bacsi-contact-form Lambda, which
    // relays the form through SES. Public by nature — it ends up in this bundle
    // either way — so it is checked in as the default and PUBLIC_CONTACT_ENDPOINT
    // only needs setting to point a build somewhere else.
    const ENDPOINT =
        import.meta.env.PUBLIC_CONTACT_ENDPOINT ??
        "https://9ryn41h3t1.execute-api.eu-west-3.amazonaws.com/";

    function initContactForm() {
        const form = document.getElementById(
            "contact-form",
        ) as HTMLFormElement | null;
        const successMsg = document.getElementById("form-success");
        const errorMsg = document.getElementById("form-error");
        const sendErrorMsg = document.getElementById("form-send-error");

        if (!form || !successMsg || !errorMsg || !sendErrorMsg) return;

        const submitBtn = form.querySelector(
            'button[type="submit"]',
        ) as HTMLButtonElement | null;
        const submitLabel = submitBtn?.querySelector(
            '[data-i18n="contact.form.submit"]',
        ) as HTMLElement | null;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Simple client-side validation
            const fullName = (
                form.querySelector("#full-name") as HTMLInputElement
            )?.value.trim();
            const email = (
                form.querySelector("#email") as HTMLInputElement
            )?.value.trim();
            const company = (
                form.querySelector("#company") as HTMLInputElement
            )?.value.trim();
            const subject = (
                form.querySelector("#subject") as HTMLSelectElement
            )?.value;
            const message = (
                form.querySelector("#message") as HTMLTextAreaElement
            )?.value.trim();
            const website = (
                form.querySelector("#website") as HTMLInputElement
            )?.value;

            // Hide previous messages
            successMsg.classList.add("hidden");
            errorMsg.classList.add("hidden");
            sendErrorMsg.classList.add("hidden");

            // Remove previous error highlights
            form.querySelectorAll(".border-red-400").forEach((el) => {
                el.classList.remove("border-red-400");
                el.classList.add("border-pangea-light-grey");
            });

            const requiredFields = [
                {
                    el: form.querySelector("#full-name") as HTMLElement,
                    value: fullName,
                },
                {
                    el: form.querySelector("#email") as HTMLElement,
                    value: email,
                },
                {
                    el: form.querySelector("#subject") as HTMLElement,
                    value: subject,
                },
                {
                    el: form.querySelector("#message") as HTMLElement,
                    value: message,
                },
            ];

            let hasError = false;

            requiredFields.forEach(({ el, value }) => {
                if (!value) {
                    hasError = true;
                    if (el) {
                        el.classList.remove("border-pangea-light-grey");
                        el.classList.add("border-red-400");
                    }
                }
            });

            // Simple email validation
            if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                hasError = true;
                const emailField = form.querySelector("#email") as HTMLElement;
                if (emailField) {
                    emailField.classList.remove("border-pangea-light-grey");
                    emailField.classList.add("border-red-400");
                }
            }

            if (hasError) {
                errorMsg.classList.remove("hidden");
                errorMsg.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                });
                return;
            }

            // Send to the Lambda relay, which delivers the mail via SES.
            const locale = getLocale();
            const originalLabel = submitLabel?.textContent;
            if (submitBtn) submitBtn.disabled = true;
            if (submitLabel) {
                submitLabel.textContent = t(locale, "contact.form.sending");
            }

            let delivered = false;

            try {
                if (!ENDPOINT) {
                    throw new Error(
                        "PUBLIC_CONTACT_ENDPOINT is not set — the form has nowhere to send to.",
                    );
                }

                const response = await fetch(ENDPOINT, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        name: fullName,
                        email,
                        company,
                        subject,
                        message,
                        website,
                    }),
                });

                delivered = response.ok;
                if (!delivered) {
                    console.error("Contact form rejected:", response.status);
                }
            } catch (err) {
                console.error("Contact form request failed:", err);
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (submitLabel && originalLabel) {
                    submitLabel.textContent = originalLabel;
                }
            }

            // Only claim success when the message actually went out.
            const feedback = delivered ? successMsg : sendErrorMsg;
            if (delivered) form.reset();

            feedback.classList.remove("hidden");
            feedback.scrollIntoView({ behavior: "smooth", block: "nearest" });

            setTimeout(() => {
                feedback.classList.add("hidden");
            }, 8000);
        });

        // Remove error highlight on input focus
        form.querySelectorAll("input, select, textarea").forEach((field) => {
            field.addEventListener("focus", () => {
                field.classList.remove("border-red-400");
                field.classList.add("border-pangea-light-grey");
            });
        });
    }

    document.addEventListener("DOMContentLoaded", initContactForm);
    document.addEventListener("astro:page-load", initContactForm);
</script>

<style>
    /* Custom focus ring animation for form fields */
    #contact-form input:focus,
    #contact-form select:focus,
    #contact-form textarea:focus {
        box-shadow: 0 0 0 3px rgba(51, 102, 153, 0.1);
    }

    /* Subtle field entry animation */
    #contact-form input,
    #contact-form select,
    #contact-form textarea {
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    #contact-form input:hover,
    #contact-form select:hover,
    #contact-form textarea:hover {
        border-color: rgba(136, 176, 216, 0.4);
    }

    /* Error state animation */
    .border-red-400 {
        animation: shake 0.4s ease-in-out;
    }

    @keyframes shake {
        0%,
        100% {
            transform: translateX(0);
        }
        20%,
        60% {
            transform: translateX(-4px);
        }
        40%,
        80% {
            transform: translateX(4px);
        }
    }
</style>
