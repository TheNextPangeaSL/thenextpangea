# Local testing only. Copy to lambda/contact/.env and fill in.
# .env is gitignored — never commit real values.
#
# In production these are set as Lambda environment variables in the AWS
# console, and SMTP_PASS should come from Secrets Manager (see README).

SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAIL_FROM=iam@thenextpangea.com
MAIL_TO=contact@thenextpangea.com
ALLOWED_ORIGIN=https://bacsi.thenextpangea.com
