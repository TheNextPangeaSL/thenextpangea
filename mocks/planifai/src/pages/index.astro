---
import Layout from "@/layouts/Layout.astro";
import OptimizationVisual from "@/components/OptimizationVisual.astro";
import PlatformDiagram from "@/components/PlatformDiagram.astro";
---

<Layout>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- NAVBAR                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <nav
        slot="nav"
        class="fixed top-0 inset-x-0 z-50 nav-blur border-b border-surface-300/60"
        id="navbar"
    >
        <div class="max-w-7xl mx-auto flex items-center justify-between px-6 sm:px-10 py-3.5">
            <!-- Logo -->
            <a href="#" class="flex items-center gap-2.5 group">
                <div class="w-8 h-8 rounded-lg bg-planif-600 flex items-center justify-center group-hover:bg-planif-700 transition-colors">
                    <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6.75" />
                    </svg>
                </div>
                <span class="text-lg font-bold text-slate-800 group-hover:text-planif-700 transition-colors">Planif<span class="text-planif-600">AI</span></span>
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-500">
                <a href="#features" class="hover:text-planif-700 transition-colors">Features</a>
                <a href="#pillars" class="hover:text-planif-700 transition-colors">Platform</a>
                <a href="#how-it-works" class="hover:text-planif-700 transition-colors">How it works</a>
                <a href="#applications" class="hover:text-planif-700 transition-colors">Applications</a>
                <a href="#contact" class="btn-planif !py-2.5 !px-5 !text-sm !rounded-lg">Contact Us</a>
            </div>

            <!-- Mobile menu button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-surface-100 transition-colors"
                aria-label="Toggle menu"
            >
                <svg class="w-5 h-5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-surface-300/60 bg-white px-6 py-4">
            <div class="flex flex-col gap-3 text-sm font-medium text-slate-600">
                <a href="#features" class="py-2 hover:text-planif-700 transition-colors">Features</a>
                <a href="#pillars" class="py-2 hover:text-planif-700 transition-colors">Platform</a>
                <a href="#how-it-works" class="py-2 hover:text-planif-700 transition-colors">How it works</a>
                <a href="#applications" class="py-2 hover:text-planif-700 transition-colors">Applications</a>
                <a href="#contact" class="btn-planif !text-sm mt-2">Contact Us</a>
            </div>
        </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HERO                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="relative min-h-[92vh] flex items-center pt-20 pb-16 overflow-hidden grid-pattern">
        <!-- Decorative glows -->
        <div class="hero-glow w-[500px] h-[500px] bg-planif-300 top-[-10%] right-[-5%]"></div>
        <div class="hero-glow w-[400px] h-[400px] bg-planif-400 bottom-[-10%] left-[-8%]"></div>
        <div class="hero-glow w-[250px] h-[250px] bg-planif-200 top-[30%] left-[20%]"></div>

        <div class="max-w-7xl mx-auto px-6 sm:px-10 w-full">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Left: Text -->
                <div class="max-w-xl">
                    <div class="section-label mb-6 animate-fade-in">
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        Integrated Resource Optimization Platform
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6 animate-slide-up">
                        Anticipate. Plan.<br />
                        <span class="gradient-text">Optimize.</span>
                    </h1>

                    <p class="text-lg text-slate-500 leading-relaxed mb-10 animate-slide-up" style="animation-delay:0.15s; opacity:0;">
                        PlanifAI integrates demand forecasting, process modeling and multi-objective optimization into a single platform — transforming real operational data into optimal decisions.
                    </p>

                    <div class="flex flex-wrap gap-4 animate-slide-up" style="animation-delay:0.3s; opacity:0;">
                        <a href="#contact" class="btn-planif">
                            Request a Demo
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                        </a>
                        <a href="#pillars" class="btn-planif-outline">
                            Explore Platform
                        </a>
                    </div>
                </div>

                <!-- Right: Visual -->
                <div class="hidden lg:flex items-center justify-center relative animate-fade-in" style="animation-delay:0.2s; opacity:0;">
                    <OptimizationVisual />
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TRUST INDICATORS / QUICK STATS                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="py-12 bg-white border-y border-surface-300/60">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div class="reveal">
                    <div class="stat-number">+30%</div>
                    <div class="text-sm text-slate-500 mt-1">Resource utilization improvement</div>
                </div>
                <div class="reveal reveal-delay-1">
                    <div class="stat-number">-40%</div>
                    <div class="text-sm text-slate-500 mt-1">Reduction in planning time</div>
                </div>
                <div class="reveal reveal-delay-2">
                    <div class="stat-number">Multi</div>
                    <div class="text-sm text-slate-500 mt-1">Objective optimization</div>
                </div>
                <div class="reveal reveal-delay-3">
                    <div class="stat-number">Real‑time</div>
                    <div class="text-sm text-slate-500 mt-1">Rescheduling on disruptions</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FEATURES (4 CARDS)                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="features" class="py-24 sm:py-32">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="text-center mb-16 max-w-2xl mx-auto">
                <div class="section-label mx-auto mb-5 reveal">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                    </svg>
                    Key Capabilities
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 reveal">
                    All-in-one planning with <span class="gradient-text">PlanifAI</span>
                </h2>
                <p class="text-slate-500 text-lg reveal">
                    From forecasting demand to optimizing resources — one platform that covers the entire decision cycle.
                </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1: Demand Forecasting -->
                <div class="feature-card reveal">
                    <div class="icon-box icon-box-light mb-5">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Demand Forecasting</h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Advanced models handle intermittent, erratic and highly variable consumption patterns with superior accuracy.
                    </p>
                </div>

                <!-- Feature 2: Process Modeling -->
                <div class="feature-card reveal reveal-delay-1">
                    <div class="icon-box icon-box-light mb-5">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0L12 17.25 6.429 14.25m11.142 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Process Modeling</h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Model plants, production lines, equipment, staff and materials — every task with its dependencies and constraints.
                    </p>
                </div>

                <!-- Feature 3: Multi-objective Optimization -->
                <div class="feature-card reveal reveal-delay-2">
                    <div class="icon-box icon-box-light mb-5">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6.75" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Multi-objective Optimization</h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Minimize delays, reduce costs, maximize asset utilization or cut operational risks — simultaneously.
                    </p>
                </div>

                <!-- Feature 4: Adaptive Re-scheduling -->
                <div class="feature-card reveal reveal-delay-3">
                    <div class="icon-box icon-box-light mb-5">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Adaptive Re-scheduling</h3>
                    <p class="text-sm text-slate-500 leading-relaxed">
                        Probabilistic uncertainty handling and partial re-scheduling keep plans optimal when disruptions occur.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FOUR PILLARS (DETAILED FEATURES)                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="pillars" class="py-24 sm:py-32 bg-white">
        <div class="max-w-7xl mx-auto px-6 sm:px-10">
            <div class="text-center mb-20 max-w-2xl mx-auto">
                <div class="section-label mx-auto mb-5 reveal">
                    The PlanifAI Platform
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 reveal">
                    Four pillars of <span class="gradient-text">intelligent planning</span>
                </h2>
                <p class="text-slate-500 text-lg reveal">
                    An end-to-end system that combines supply chain expertise with a differential algorithmic core.
                </p>
            </div>

            <!-- Pillar 1: Demand Forecasting -->
            <div class="mb-24 reveal">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <div class="icon-box icon-box-brand">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
                                </svg>
                            </div>
                            <span class="text-xs font-bold uppercase tracking-wider text-planif-700">Prediction</span>
                        </div>
                        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-4">
                            Demand forecasting &amp; anticipation
                        </h3>
                        <p class="text-slate-500 leading-relaxed mb-6">
                            Our advanced prediction models work with complex consumption patterns — intermittent, erratic or highly variable — delivering estimates far more precise than traditional methods.
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-planif-700 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-sm text-slate-600">Anticipate demand variations through large-scale data analysis</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-planif-700 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-sm text-slate-600">Optimize stock levels and improve product availability</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-planif-700 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-sm text-slate-600">Avoid over-provisioning and stockouts simultaneously</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Visual: Forecast chart mockup -->
                    <div class="relative">
                        <div class="glass rounded-2xl p-8 relative z-10">
                            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">Demand Forecast</div>
                            <!-- Chart bars -->
                            <div class="flex items-end gap-2 mb-4" style="height: 176px;">
                                {[40, 55, 35, 65, 50, 72, 60, 80, 68, 90, 75, 85].map((v, i) => (
                                    <div class="flex-1 flex flex-col justify-end items-center h-full">
                                        <div
                                            class="w-full rounded-t-md transition-all duration-300"
                                            style={`height: ${v}%; background: ${i >= 8 ? 'linear-gradient(to top, #244ded, #5e96fc)' : '#e5e7eb'};`}
                                        />
                                        <span class="text-[10px] text-slate-400 mt-1 shrink-0">{['J','F','M','A','M','J','J','A','S','O','N','D'][i]}</span>
                                    </div>
                                ))}
                            </div>
                            <div class="flex items-center gap-4 text-xs text-slate-400">
                                <div class="flex items-center gap-1.5">
                                    <div class="w-3 h-3 rounded-sm bg-surface-300"></div>
                                    <span>Historical</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <div class="w-3 h-3 rounded-sm bg-gradient-to-t from-planif-700 to-planif-400"></div>
                                    <span>Predicted</span>
                                </div>
                            </div>

                            <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-xl flex items-center gap-2">
                                <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-xs text-green-800 font-medium">Forecast confidence 94.2% — MAPE 3.8%</span>
                            </div>
                        </div>
                        <div class="absolute -inset-3 bg-gradient-to-br from-planif-100 to-planif-50 rounded-3xl -z-10 opacity-60"></div>
                    </div>
                </div>
            </div>

            <!-- Pillar 2: Process Modeling -->
            <div class="mb-24 reveal">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <!-- Visual: Process diagram -->
                    <div class="order-2 lg:order-1 relative">
                        <div class="glass rounded-2xl p-8 relative z-10">
                            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Process model</div>
                            <div class="space-y-4">
                                <!-- Plant row -->
                                <div class="flex items-center gap-3 p-3 bg-surface-100 rounded-xl border border-surface-300">
                                    <div class="w-10 h-10 rounded-lg bg-planif-700 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm font-bold text-slate-800">Plant A — Line 1</div>
                                        <div class="text-xs text-slate-400">3 machines &middot; 12 operators &middot; Calendar active</div>
                                    </div>
                                    <div class="text-xs font-mono font-semibold text-planif-700 bg-planif-50 px-2 py-0.5 rounded-md">Active</div>
                                </div>
                                <!-- Task dependencies -->
                                <div class="flex items-center gap-3 p-3 bg-surface-100 rounded-xl border border-surface-300">
                                    <div class="w-10 h-10 rounded-lg bg-planif-700 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm font-bold text-slate-800">Task Dependencies</div>
                                        <div class="text-xs text-slate-400">Duration, precedences, capacity constraints</div>
                                    </div>
                                    <div class="text-xs font-mono text-slate-400 bg-surface-200 px-2 py-0.5 rounded-md">24 tasks</div>
                                </div>
                                <!-- Materials -->
                                <div class="flex items-center gap-3 p-3 bg-surface-100 rounded-xl border border-surface-300">
                                    <div class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm font-bold text-slate-800">Materials & Resources</div>
                                        <div class="text-xs text-slate-400">Stock, BOM, availability calendars</div>
                                    </div>
                                    <div class="text-xs font-mono text-slate-400 bg-surface-200 px-2 py-0.5 rounded-md">148 items</div>
                                </div>
                            </div>
                        </div>
                        <div class="absolute -inset-3 bg-gradient-to-br from-planif-50 to-surface-100 rounded-3xl -z-10 opacity-60"></div>
                    </div>

                    <div class="order-1 lg:order-2">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="icon-box icon-box-brand">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0L12 17.25 6.429 14.25m11.142 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25" />
                                </svg>
                            </div>
                            <span class="text-xs font-bold uppercase tracking-wider text-planif-700">Modeling</span>
                        </div>
                        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-4">
                            Comprehensive process modeling
                        </h3>
