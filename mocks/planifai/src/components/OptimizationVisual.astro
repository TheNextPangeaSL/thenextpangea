---
/**
 * OptimizationVisual — Hero section animated SVG
 * Shows a stylized Gantt-chart / resource optimizer visualization
 */
---

<div class="relative w-full max-w-lg mx-auto">
    <!-- Background glow -->
    <div class="absolute inset-0 bg-gradient-to-br from-planif-200/40 to-planif-100/20 rounded-3xl blur-3xl -z-10 animate-pulse-soft"></div>

    <div class="glass rounded-2xl p-6 sm:p-8 relative overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-planif-700 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6.75" />
                    </svg>
                </div>
                <div>
                    <div class="text-sm font-bold text-slate-800">Resource Optimizer</div>
                    <div class="text-xs text-slate-400">PlanifAI Engine v3.2</div>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse-soft"></div>
                <span class="text-xs font-semibold text-green-600">Running</span>
            </div>
        </div>

        <!-- Mini Gantt chart -->
        <div class="space-y-2.5 mb-6">
            <div class="flex items-center gap-2">
                <span class="text-[10px] text-slate-400 w-10 text-right font-mono">Line 1</span>
                <div class="flex-1 flex gap-1 h-6">
                    <div class="rounded bg-planif-500 flex-[3] animate-fade-in" style="animation-delay:0.2s; opacity:0;"></div>
                    <div class="rounded bg-planif-300 flex-[2] animate-fade-in" style="animation-delay:0.4s; opacity:0;"></div>
                    <div class="rounded bg-planif-600 flex-[4] animate-fade-in" style="animation-delay:0.6s; opacity:0;"></div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-[10px] text-slate-400 w-10 text-right font-mono">Line 2</span>
                <div class="flex-1 flex gap-1 h-6">
                    <div class="rounded bg-planif-400 flex-[2] animate-fade-in" style="animation-delay:0.3s; opacity:0;"></div>
                    <div class="rounded bg-planif-600 flex-[5] animate-fade-in" style="animation-delay:0.5s; opacity:0;"></div>
                    <div class="rounded bg-planif-300 flex-[2] animate-fade-in" style="animation-delay:0.7s; opacity:0;"></div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-[10px] text-slate-400 w-10 text-right font-mono">Line 3</span>
                <div class="flex-1 flex gap-1 h-6">
                    <div class="rounded bg-planif-300 flex-[4] animate-fade-in" style="animation-delay:0.4s; opacity:0;"></div>
                    <div class="rounded bg-planif-500 flex-[3] animate-fade-in" style="animation-delay:0.6s; opacity:0;"></div>
                    <div class="rounded bg-planif-400 flex-[2] animate-fade-in" style="animation-delay:0.8s; opacity:0;"></div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-[10px] text-slate-400 w-10 text-right font-mono">Maint.</span>
                <div class="flex-1 flex gap-1 h-6">
                    <div class="rounded bg-amber-300 flex-[1] animate-fade-in" style="animation-delay:0.5s; opacity:0;"></div>
                    <div class="rounded bg-surface-200 flex-[3]"></div>
                    <div class="rounded bg-amber-300 flex-[1] animate-fade-in" style="animation-delay:0.7s; opacity:0;"></div>
                    <div class="rounded bg-surface-200 flex-[4]"></div>
                </div>
            </div>
        </div>

        <!-- Metrics row -->
        <div class="grid grid-cols-3 gap-3">
            <div class="bg-surface-100 rounded-xl p-3 text-center border border-surface-300">
                <div class="text-lg font-bold font-mono text-planif-700">94%</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Utilization</div>
            </div>
            <div class="bg-surface-100 rounded-xl p-3 text-center border border-surface-300">
                <div class="text-lg font-bold font-mono text-planif-700">-38%</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Delays</div>
            </div>
            <div class="bg-surface-100 rounded-xl p-3 text-center border border-surface-300">
                <div class="text-lg font-bold font-mono text-planif-700">2.1s</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Solve time</div>
            </div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -top-1 -right-1 bg-planif-700 text-white text-[10px] font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl shadow-md">
            AI-Powered
        </div>
    </div>
</div>
