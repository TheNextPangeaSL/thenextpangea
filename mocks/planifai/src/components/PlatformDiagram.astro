---
/**
 * PlatformDiagram — Shows the unified predict → model → optimize flow
 * Pure CSS + SVG, no JS dependencies
 */
---

<div class="max-w-4xl mx-auto">
    <div class="grid md:grid-cols-3 gap-6 relative">
        <!-- Connector lines (desktop only) -->
        <svg class="hidden md:block absolute inset-0 w-full h-full pointer-events-none z-0" preserveAspectRatio="none">
            <!-- Left to center -->
            <line x1="33.3%" y1="50%" x2="36.6%" y2="50%" stroke="#bed5ff" stroke-width="2" stroke-dasharray="6 4">
                <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="2s" repeatCount="indefinite" />
            </line>
            <!-- Center to right -->
            <line x1="63.3%" y1="50%" x2="66.6%" y2="50%" stroke="#bed5ff" stroke-width="2" stroke-dasharray="6 4">
                <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="2s" repeatCount="indefinite" />
            </line>
        </svg>

        <!-- Predict -->
        <div class="pillar-card text-center relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-planif-600 to-planif-500 text-white flex items-center justify-center mx-auto mb-5 shadow-lg shadow-planif-600/20">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
                </svg>
            </div>
            <h4 class="text-lg font-bold text-slate-800 mb-2">Predict</h4>
            <p class="text-sm text-slate-500 leading-relaxed">
                AI-powered demand forecasting that handles complex, intermittent consumption patterns.
            </p>
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Time series</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">External data</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Anomalies</span>
            </div>
        </div>

        <!-- Model -->
        <div class="pillar-card text-center relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-planif-600 to-planif-500 text-white flex items-center justify-center mx-auto mb-5 shadow-lg shadow-planif-600/20">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0L12 17.25 6.429 14.25m11.142 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25" />
                </svg>
            </div>
            <h4 class="text-lg font-bold text-slate-800 mb-2">Model</h4>
            <p class="text-sm text-slate-500 leading-relaxed">
                Define resources, constraints, dependencies and calendars as a structured digital twin.
            </p>
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Plants</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Constraints</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Calendars</span>
            </div>
        </div>

        <!-- Optimize -->
        <div class="pillar-card text-center relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-planif-600 to-planif-500 text-white flex items-center justify-center mx-auto mb-5 shadow-lg shadow-planif-600/20">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
                </svg>
            </div>
            <h4 class="text-lg font-bold text-slate-800 mb-2">Optimize</h4>
            <p class="text-sm text-slate-500 leading-relaxed">
                Multi-objective engine finds Pareto-optimal schedules, balancing competing goals under uncertainty.
            </p>
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Scheduling</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Pareto</span>
                <span class="text-[11px] bg-planif-50 text-planif-700 px-2 py-0.5 rounded font-medium">Re-schedule</span>
            </div>
        </div>
    </div>

    <!-- Bottom: Result bar -->
    <div class="mt-8 glass rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 sm:gap-10">
        <div class="flex items-center gap-3 flex-shrink-0">
            <div class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div>
                <div class="text-sm font-bold text-slate-800">Optimal Plan Generated</div>
                <div class="text-xs text-slate-400">All constraints satisfied — ready for execution</div>
            </div>
        </div>
        <div class="flex-1 grid grid-cols-3 gap-4 text-center">
            <div>
                <div class="text-lg font-bold font-mono text-planif-700">94%</div>
                <div class="text-[10px] text-slate-400">Resource util.</div>
            </div>
            <div>
                <div class="text-lg font-bold font-mono text-planif-700">0</div>
                <div class="text-[10px] text-slate-400">Constraint violations</div>
            </div>
            <div>
                <div class="text-lg font-bold font-mono text-planif-700">4.2s</div>
                <div class="text-[10px] text-slate-400">Compute time</div>
            </div>
        </div>
    </div>
</div>
